# Clave de Google AI Studio para Bluddie (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Supabase (opcional). Sin estas dos variables el sitio funciona en modo demo, con los datos en el navegador.
# Project Settings → API: la URL del proyecto y la clave publicable (anon). Son públicas: la seguridad la dan las reglas RLS.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
