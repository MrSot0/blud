---
// src/components/Navbar.astro
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { infoTopics, infoHref } from '../data/info';

// Compatibilidad y Centros se recorren desde la portada; el menú prioriza las páginas.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const inInfo = path.startsWith('/informate');
const linkClass =
  'nav-link relative rounded-control px-3 py-2 text-[0.9375rem] font-medium text-ink-2 transition-colors duration-200 hover:text-ink';
const mobileLinkClass =
  'mobile-nav-link flex items-center justify-between border-b border-line py-4 text-lg font-semibold text-ink aria-[current=page]:text-accent-ink';
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full border-b border-line bg-surface/85 backdrop-blur-lg supports-[not(backdrop-filter:blur(0))]:bg-surface"
>
  <div class="container-blud flex h-16 items-center justify-between gap-6">
    <Logo />

    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center gap-1">
        <li>
          <a href="/#que-es" data-nav-link="que-es" class={linkClass}>¿Qué es BLUD?</a>
        </li>

        <!-- Infórmate: menú desplegable -->
        <li class="relative" data-info-menu>
          <button
            type="button"
            id="info-trigger"
            aria-expanded="false"
            aria-controls="info-panel"
            aria-current={inInfo ? 'page' : undefined}
            class={`${linkClass} inline-flex items-center gap-1`}
          >
            Infórmate
            <Icon name="caret-down" class="info-caret size-3.5" />
          </button>

          <div id="info-panel" class="info-panel absolute left-1/2 top-full z-10 pt-3" data-open="false">
            <div class="panel w-[34rem] overflow-hidden p-2">
              <ul class="grid gap-0.5">
                {infoTopics.map((topic, i) => (
                  <li class="info-item" style={`--i:${i}`}>
                    <a
                      href={infoHref(topic.slug)}
                      aria-current={path === infoHref(topic.slug) ? 'page' : undefined}
                      class="group flex items-start gap-3.5 rounded-control p-3 transition-colors duration-150 hover:bg-sunken aria-[current=page]:bg-accent-soft"
                    >
                      <span class="grid size-10 shrink-0 place-items-center rounded-[10px] bg-sunken text-ink-2 transition-colors duration-200 group-hover:bg-accent group-hover:text-white group-aria-[current=page]:bg-accent group-aria-[current=page]:text-white">
                        <Icon name={topic.icon} class="size-5" />
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[0.9375rem] font-semibold text-ink">{topic.title}</span>
                        <span class="mt-0.5 block text-sm leading-snug text-ink-3">{topic.short}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <a
                href="/informate"
                class="mt-1 flex items-center justify-between rounded-control border-t border-line px-3 py-3 text-sm font-semibold text-accent-ink transition-colors hover:bg-sunken"
              >
                Ver todo en Infórmate
                <Icon name="arrow-right" class="size-4" />
              </a>
            </div>
          </div>
        </li>

        <li>
          <a href="/elegibilidad" aria-current={path === '/elegibilidad' ? 'page' : undefined} class={linkClass}>Elegibilidad</a>
        </li>
        <li>
          <a href="/#faq" data-nav-link="faq" class={linkClass}>Preguntas</a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <div class="mr-1 hidden items-center gap-2 lg:flex">
        <a
          href="/login"
          aria-current={path === '/login' ? 'page' : undefined}
          class="rounded-control px-3 py-2 text-[0.9375rem] font-medium text-ink-2 transition-colors hover:text-ink aria-[current=page]:text-accent-ink"
        >
          Iniciar sesión
        </a>
        <a href="/register" class="btn btn-primary btn-sm">Quiero ser donante</a>
      </div>

      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle relative grid size-10 place-items-center rounded-control text-ink-2 transition-colors duration-200 hover:bg-sunken hover:text-ink active:scale-95"
        aria-label="Cambiar a modo oscuro"
        title="Cambiar a modo oscuro"
      >
        <span class="theme-icon theme-icon-sun" aria-hidden="true"><Icon name="sun" class="size-[1.3rem]" /></span>
        <span class="theme-icon theme-icon-moon" aria-hidden="true"><Icon name="moon" class="size-[1.2rem]" /></span>
      </button>

      <button
        type="button"
        id="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-11 place-items-center rounded-control text-ink transition-colors hover:bg-sunken lg:hidden"
      >
        <span class="sr-only" data-menu-label>Abrir menú</span>
        <span data-icon-open><Icon name="list" class="size-6" /></span>
        <span data-icon-close class="hidden"><Icon name="x" class="size-6" /></span>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="mobile-menu grid border-line bg-surface lg:hidden" data-open="false">
    <div class="overflow-hidden">
      <nav class="container-blud flex max-h-[calc(100dvh-4rem)] flex-col overflow-y-auto pb-6 pt-2" aria-label="Navegación móvil">
        <ul class="flex flex-col">
          <li>
            <a href="/#que-es" class={mobileLinkClass}>
              ¿Qué es BLUD?
              <Icon name="arrow-right" class="size-5 text-ink-3" />
            </a>
          </li>
          <li class="border-b border-line py-4">
            <a
              href="/informate"
              aria-current={path === '/informate' ? 'page' : undefined}
              class="mobile-nav-link flex items-center justify-between text-lg font-semibold text-ink aria-[current=page]:text-accent-ink"
            >
              Infórmate
              <Icon name="arrow-right" class="size-5 text-ink-3" />
            </a>
            <ul class="mt-3 grid gap-1">
              {infoTopics.map((topic) => (
                <li>
                  <a
                    href={infoHref(topic.slug)}
                    aria-current={path === infoHref(topic.slug) ? 'page' : undefined}
                    class="mobile-nav-link flex items-center gap-3 rounded-control px-2 py-2 text-[0.9375rem] font-medium text-ink-2 aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent-ink"
                  >
                    <Icon name={topic.icon} class="size-5 text-ink-3" />
                    {topic.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
          <li>
            <a href="/elegibilidad" aria-current={path === '/elegibilidad' ? 'page' : undefined} class={mobileLinkClass}>
              Elegibilidad
              <Icon name="arrow-right" class="size-5 text-ink-3" />
            </a>
          </li>
          <li>
            <a href="/#faq" class={mobileLinkClass}>
              Preguntas
              <Icon name="arrow-right" class="size-5 text-ink-3" />
            </a>
          </li>
        </ul>
        <div class="mt-6 grid grid-cols-2 gap-3">
          <a href="/login" class="mobile-nav-link btn btn-secondary">Iniciar sesión</a>
          <a href="/register" class="mobile-nav-link btn btn-primary">Quiero ser donante</a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  .mobile-menu {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 320ms var(--ease-out),
      visibility 0s linear 320ms;
  }
  .mobile-menu[data-open="true"] {
    grid-template-rows: 1fr;
    visibility: visible;
    border-bottom-width: 1px;
    transition: grid-template-rows 320ms var(--ease-out);
  }

  /* Indicador de sección o página activa */
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease-out);
  }
  .nav-link[aria-current] {
    color: var(--ink);
  }
  .nav-link[aria-current]::after {
    transform: scaleX(1);
  }

  /* Menú Infórmate: aparece desde arriba, con los temas escalonados. */
  .info-panel {
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, -6px) scale(0.98);
    transform-origin: top center;
    transition:
      opacity 160ms ease,
      transform 220ms var(--ease-out),
      visibility 0s linear 220ms;
  }
  .info-panel[data-open="true"] {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
    transition:
      opacity 180ms ease,
      transform 260ms var(--ease-out);
  }
  .info-item {
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 200ms ease, transform 260ms var(--ease-out);
  }
  .info-panel[data-open="true"] .info-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(40ms + var(--i) * 30ms);
  }
  .info-caret {
    transition: transform 240ms var(--ease-out);
  }
  #info-trigger[aria-expanded="true"] .info-caret {
    transform: rotate(180deg);
  }

  /* Botón de tema: el sol gira y se oculta mientras la luna entra, y viceversa. */
  .theme-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition:
      transform 520ms var(--ease-out),
      opacity 240ms ease;
  }
  .theme-icon-sun { transform: rotate(0) scale(1); opacity: 1; }
  .theme-icon-moon { transform: rotate(-100deg) scale(0.4); opacity: 0; }
  :global(:root[data-theme="dark"]) .theme-icon-sun { transform: rotate(100deg) scale(0.4); opacity: 0; }
  :global(:root[data-theme="dark"]) .theme-icon-moon { transform: rotate(0) scale(1); opacity: 1; }

  @media (hover: hover) {
    .theme-toggle:hover .theme-icon-sun :global(svg) { animation: sun-spin 1.2s var(--ease-out); }
    .theme-toggle:hover .theme-icon-moon :global(svg) { animation: moon-tilt 900ms var(--ease-out); }
  }
  @keyframes sun-spin {
    from { transform: rotate(0); }
    to { transform: rotate(90deg); }
  }
  @keyframes moon-tilt {
    0%, 100% { transform: rotate(0); }
    40% { transform: rotate(-18deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-icon { transition: opacity 150ms ease; transform: none !important; }
    .info-panel, .info-panel[data-open="true"] { transform: translate(-50%, 0); }
    .info-item { transform: none; }
  }
</style>

<script>
  const root = document.documentElement;

  // ----- Tema claro / oscuro -----
  const themeBtn = document.getElementById('theme-toggle');

  const currentTheme = () => (root.dataset.theme === 'dark' ? 'dark' : 'light');

  const syncThemeLabel = () => {
    const label = currentTheme() === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';
    themeBtn?.setAttribute('aria-label', label);
    themeBtn?.setAttribute('title', label);
  };

  const applyTheme = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('blud-theme', theme);
    } catch {}
    syncThemeLabel();
  };

  themeBtn?.addEventListener('click', (event) => {
    const button = event.currentTarget as HTMLElement;
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };

    if (!doc.startViewTransition || reduce) {
      applyTheme(next);
      return;
    }

    const rect = button.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.style.setProperty('--vt-x', `${x}px`);
    root.style.setProperty('--vt-y', `${y}px`);
    root.style.setProperty('--vt-r', `${r}px`);
    root.classList.add('theme-vt');

    doc.startViewTransition(() => applyTheme(next)).finished.finally(() => {
      root.classList.remove('theme-vt');
    });
  });

  syncThemeLabel();
  new MutationObserver(syncThemeLabel).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

  // ----- Menú Infórmate (escritorio) -----
  const infoMenu = document.querySelector<HTMLElement>('[data-info-menu]');
  const infoTrigger = document.getElementById('info-trigger');
  const infoPanel = document.getElementById('info-panel');

  if (infoMenu && infoTrigger && infoPanel) {
    let hoverTimer = 0;
    const isOpen = () => infoTrigger.getAttribute('aria-expanded') === 'true';
    const setInfoOpen = (open: boolean) => {
      infoTrigger.setAttribute('aria-expanded', String(open));
      infoPanel.dataset.open = String(open);
    };

    infoTrigger.addEventListener('click', () => setInfoOpen(!isOpen()));

    // Con ratón se abre al pasar por encima, con una pequeña pausa para no parpadear.
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    infoMenu.addEventListener('pointerenter', () => {
      if (!canHover.matches) return;
      clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => setInfoOpen(true), 90);
    });
    infoMenu.addEventListener('pointerleave', () => {
      if (!canHover.matches) return;
      clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => setInfoOpen(false), 180);
    });

    infoMenu.addEventListener('focusout', (e) => {
      if (!infoMenu.contains(e.relatedTarget as Node)) setInfoOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !infoMenu.contains(e.target as Node)) setInfoOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setInfoOpen(false);
        infoTrigger.focus();
      }
    });
  }

  // ----- Menú móvil -----
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuBtn && mobileMenu) {
    const label = menuBtn.querySelector('[data-menu-label]');
    const iconOpen = menuBtn.querySelector('[data-icon-open]');
    const iconClose = menuBtn.querySelector('[data-icon-close]');

    const setOpen = (open: boolean) => {
      menuBtn.setAttribute('aria-expanded', String(open));
      mobileMenu.dataset.open = String(open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    };

    menuBtn.addEventListener('click', () => {
      setOpen(menuBtn.getAttribute('aria-expanded') !== 'true');
    });

    mobileMenu.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        menuBtn.focus();
      }
    });

    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // ----- Sección activa en la portada -----
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sections = Array.from(links)
    .map((link) => document.getElementById(link.dataset.navLink || ''))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length && 'IntersectionObserver' in window) {
    const setActive = (id: string | null) => {
      links.forEach((link) => {
        if (link.dataset.navLink === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    sections.forEach((section) => io.observe(section));
  }
</script>
