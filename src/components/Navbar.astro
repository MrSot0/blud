---
// Navbar.astro - Navegación principal de BLUD (Fondo Verde con Botón Donar)
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-blud-dark-teal/95 backdrop-blur-md transition-all shadow-lg">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 h-20">
    
    <!-- Logo BLUD -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blud-brick-ember text-white font-extrabold text-xl shadow-lg shadow-blud-brick-ember/40 group-hover:scale-105 transition-transform">
        B
      </div>
      <span class="font-sans text-2xl font-black tracking-tight text-white">
        BLUD<span class="text-blud-flag-red">.</span>
      </span>
    </a>

    <!-- Enlaces de navegación desktop (secciones principales) -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-bold uppercase tracking-wider text-blud-alabaster/90">
      <a href="#que-es" class="hover:text-white transition-colors">¿Qué es?</a>
      <a href="#compatibilidad" class="hover:text-white transition-colors">Compatibilidad</a>
      <a href="#test" class="hover:text-white transition-colors">Test de Aptitud</a>
      <a href="#centros" class="hover:text-white transition-colors">Centros</a>
      <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
    </nav>

    <!-- Botones de Acción (Donar + Login + Registro) -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Botón Donar -->
      <a 
        href="#test" 
        class="px-4 py-2.5 rounded-xl bg-blud-brick-ember hover:bg-blud-flag-red text-white font-extrabold text-xs transition-all shadow-md shadow-blud-brick-ember/30 active:scale-95 flex items-center gap-1.5"
      >
        Donar
      </a>

      <!-- Botón Inicia Sesión -->
      <a 
        href="/login" 
        class="px-4 py-2.5 rounded-xl border border-white/20 bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition-all hover:border-white/40 active:scale-95"
      >
        Inicia Sesión
      </a>

      <!-- Botón Regístrate -->
      <a 
        href="/register" 
        class="px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-blud-dark-teal font-bold text-xs transition-all shadow-md active:scale-95"
      >
        Regístrate
      </a>
    </div>

    <!-- Botón Menú Hamburguesa para Móviles -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden flex h-10 w-10 items-center justify-center rounded-xl border border-white/20 bg-white/10 text-white hover:bg-white/20"
      aria-label="Abrir menú"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

  </div>

  <!-- Menú Desplegable Móvil -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-blud-dark-teal px-4 pt-4 pb-6 space-y-4">
    <nav class="flex flex-col space-y-3 text-sm font-semibold text-blud-alabaster">
      <a href="#que-es" class="mobile-nav-link hover:text-white py-1">¿Qué es?</a>
      <a href="#compatibilidad" class="mobile-nav-link hover:text-white py-1">Compatibilidad</a>
      <a href="#test" class="mobile-nav-link hover:text-white py-1">Test de Aptitud</a>
      <a href="#centros" class="mobile-nav-link hover:text-white py-1">Centros</a>
      <a href="#faq" class="mobile-nav-link hover:text-white py-1">FAQ</a>
    </nav>
    <div class="pt-4 border-t border-white/10 flex flex-col gap-2.5">
      <a 
        href="#test" 
        class="mobile-nav-link w-full text-center py-2.5 rounded-xl bg-blud-brick-ember text-white font-extrabold text-xs shadow-md"
      >
        Donar
      </a>
      <a 
        href="/login" 
        class="w-full text-center py-2.5 rounded-xl border border-white/20 bg-white/10 text-white font-bold text-xs"
      >
        Inicia Sesión
      </a>
      <a 
        href="/register" 
        class="w-full text-center py-2.5 rounded-xl bg-white text-blud-dark-teal font-bold text-xs"
      >
        Regístrate
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });

      links.forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
        });
      });
    }
  });
</script>