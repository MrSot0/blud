---
// src/components/Navbar.astro
const navLinks = [
  { href: "/#que-es", label: "¿Qué es BLUD?" },
  { href: "/#compatibilidad", label: "Compatibilidad" },
  { href: "/#elegibilidad", label: "Test de Elegibilidad" },
  { href: "/#mapa", label: "Bancos de Sangre" },
  { href: "/#faq", label: "Preguntas Frecuentes" },
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur-md transition-colors duration-300 shadow-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 h-20">
    
    <!-- Logo de la Marca -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-blud-flag-red/50 rounded-xl p-1">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blud-brick-ember text-white shadow-md shadow-blud-brick-ember/20 group-hover:scale-105 transition-transform duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
        </svg>
      </div>
      <span class="font-sans text-2xl font-black tracking-tight text-slate-900">
        BLUD<span class="text-blud-flag-red">.</span>
      </span>
    </a>

    <!-- Enlaces de Navegación Desktop -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-semibold text-slate-700 hover:text-blud-flag-red transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Acciones / Autenticación Desktop -->
    <div class="hidden lg:flex items-center gap-4">
      <a
        href="/login"
        class="text-sm font-semibold text-slate-700 hover:text-blud-flag-red transition-colors duration-200 px-4 py-2"
      >
        Iniciar Sesión
      </a>
      <a
        href="/register"
        class="rounded-xl bg-blud-brick-ember hover:bg-blud-flag-red px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-blud-brick-ember/20 hover:shadow-lg hover:shadow-blud-flag-red/30 transition-all duration-200 active:scale-95"
      >
        Registrarse
      </a>
    </div>

    <!-- Botón Hamburger Mobile -->
    <button
      type="button"
      id="mobile-menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
      class="lg:hidden p-2 rounded-xl text-slate-600 hover:text-blud-flag-red hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blud-flag-red/50 transition-colors"
    >
      <svg id="hamburger-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="close-icon" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Desplegable Menú Mobile -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-slate-200 bg-white/98 backdrop-blur-xl px-4 pb-6 pt-2 shadow-lg">
    <nav class="flex flex-col space-y-2" aria-label="Navegación móvil">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link rounded-xl px-4 py-3 text-base font-semibold text-slate-700 hover:bg-slate-100 hover:text-blud-flag-red transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4 border-t border-slate-200 flex flex-col gap-3">
        <a
          href="/login"
          class="mobile-nav-link text-center rounded-xl border border-slate-300 py-3 text-base font-semibold text-slate-700 hover:bg-slate-100 hover:text-blud-flag-red transition-colors"
        >
          Iniciar Sesión
        </a>
        <a
          href="/register"
          class="mobile-nav-link text-center rounded-xl bg-blud-brick-ember py-3 text-base font-bold text-white shadow-md shadow-blud-brick-ember/20 active:scale-98 transition-all"
        >
          Registrarse
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (!menuBtn || !mobileMenu) return;

    const toggleMenu = () => {
      const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isOpen).toString());
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    };

    menuBtn.addEventListener('click', toggleMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });
  });
</script>
