---
import Icon from '../Icon.astro';

const labPhoto = "https://images.unsplash.com/photo-1579154204601-01588f351e67";
const labSrc = (w: number) => `${labPhoto}?q=70&w=${w}&auto=format&fit=crop`;

// Vista previa de la matriz: tipos que O- puede recibir (solo O-) frente al resto.
const previewTypes = ["O-", "O+", "A-", "A+", "B-", "B+", "AB-", "AB+"];
const pretty = (t: string) => t.replace('-', '−');
---

<section id="que-es" class="relative pb-24 pt-24 lg:pb-32 lg:pt-32">
  <div class="container-blud">
    <div class="max-w-3xl" data-reveal>
      <h2 class="section-title">¿Qué es BLUD?</h2>
      <p class="section-lead">
        Un ecosistema digital para que donar sangre sea más rápido y más claro: reduce los tiempos de
        respuesta en situaciones críticas y coordina a donantes y centros médicos en una sola red.
      </p>
    </div>

    <div class="mt-14 grid gap-4 lg:mt-16 lg:grid-cols-12 lg:grid-rows-[auto_auto] lg:gap-5">
      <!-- Red de bancos de sangre: foto real -->
      <article
        class="group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-panel bg-night p-7 text-white lg:col-span-7 lg:row-span-2 lg:min-h-[34rem] lg:p-10"
        data-reveal
      >
        <img
          src={labSrc(1200)}
          srcset={`${labSrc(640)} 640w, ${labSrc(1200)} 1200w`}
          sizes="(min-width: 1024px) 58vw, 100vw"
          alt="Técnica de laboratorio trabajando en un banco de sangre con equipos de análisis"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,transparent_20%,rgb(26_32_44/0.7)_55%,rgb(26_32_44/0.96)_100%)]" aria-hidden="true"></div>

        <span class="mb-5 grid size-11 place-items-center rounded-control bg-white/12 text-white backdrop-blur-md">
          <Icon name="map-trifold" class="size-6" />
        </span>
        <h3 class="text-2xl font-bold tracking-[-0.03em] lg:text-3xl">Red de bancos de sangre</h3>
        <p class="mt-3 max-w-md leading-relaxed text-white/80">
          Hospitales, clínicas y bancos de sangre verificados en un mapa, con su dirección, su contacto y
          cómo llegar.
        </p>
        <a href="#centros" class="mt-6 inline-flex w-fit items-center gap-2 font-semibold text-white underline decoration-white/40 underline-offset-[6px] hover:decoration-white">
          Ver centros conectados
          <Icon name="arrow-right" class="size-4" />
        </a>
      </article>

      <!-- Conexión inmediata: patrón de ondas en tono de marca -->
      <article
        class="relative isolate overflow-hidden rounded-panel border border-accent/15 bg-accent-soft p-7 lg:col-span-5 lg:p-9"
        data-reveal
        style="--reveal-delay:1"
      >
        <div class="ripple pointer-events-none absolute -right-24 -top-24 -z-10 size-72" aria-hidden="true"></div>
        <span class="grid size-11 place-items-center rounded-control bg-accent text-white">
          <Icon name="bell-ringing" class="size-6" />
        </span>
        <h3 class="mt-8 text-2xl font-bold tracking-[-0.03em] text-ink">Conexión inmediata</h3>
        <p class="mt-3 max-w-md leading-relaxed text-ink-2">
          Vinculamos de forma automática a donantes voluntarios con pacientes y bancos de sangre que
          necesitan atención urgente.
        </p>
      </article>

      <!-- Compatibilidad: vista previa real de la matriz -->
      <article
        class="rounded-panel border border-line bg-surface p-7 lg:col-span-5 lg:p-9"
        data-reveal
        style="--reveal-delay:2"
      >
        <div class="flex items-start justify-between gap-6">
          <span class="grid size-11 place-items-center rounded-control bg-sunken text-ink">
            <Icon name="intersect-three" class="size-6" />
          </span>
          <ul class="grid grid-cols-4 gap-1.5" aria-hidden="true">
            {previewTypes.map((type) => (
              <li
                class:list={[
                  'grid h-8 w-11 place-items-center rounded-lg font-mono text-xs font-semibold',
                  type === 'O-' ? 'bg-accent text-white' : 'border border-line text-ink-3',
                ]}
              >
                {pretty(type)}
              </li>
            ))}
          </ul>
        </div>
        <h3 class="mt-8 text-2xl font-bold tracking-[-0.03em] text-ink">Algoritmo de compatibilidad</h3>
        <p class="mt-3 max-w-md leading-relaxed text-ink-2">
          Cruza tipo de sangre y factor Rh para proponerte solo donaciones compatibles. Las pruebas
          finales siguen en manos del hospital.
        </p>
        <a href="#compatibilidad" class="link-arrow mt-5">
          Consultar la matriz
          <Icon name="arrow-right" class="size-4" />
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .ripple {
    border-radius: 999px;
    background: repeating-radial-gradient(
      circle at center,
      color-mix(in srgb, var(--accent) 16%, transparent) 0 1px,
      transparent 1px 22px
    );
    mask-image: radial-gradient(circle at center, #000 30%, transparent 70%);
  }
</style>
