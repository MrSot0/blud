---
import Icon from '../Icon.astro';
import DropField from '../DropField.astro';

const labPhoto = "https://images.unsplash.com/photo-1579154204601-01588f351e67";
const labSrc = (w: number) => `${labPhoto}?q=70&w=${w}&auto=format&fit=crop`;

// Vista previa de la matriz: tipos que O- puede recibir (solo O-) frente al resto.
const previewTypes = ["O-", "O+", "A-", "A+", "B-", "B+", "AB-", "AB+"];
const pretty = (t: string) => t.replace('-', '−');
// Quién puede donar a cada receptor (glóbulos rojos); alimenta la vista previa interactiva.
const donorsFor: Record<string, string[]> = {
  'O-': ['O-'], 'O+': ['O+', 'O-'], 'A-': ['A-', 'O-'], 'A+': ['A+', 'A-', 'O+', 'O-'],
  'B-': ['B-', 'O-'], 'B+': ['B+', 'B-', 'O+', 'O-'], 'AB-': ['AB-', 'A-', 'B-', 'O-'],
  'AB+': ['AB+', 'AB-', 'A+', 'A-', 'B+', 'B-', 'O+', 'O-'],
};
const spoken = (t: string) => t.replace('-', ' negativo').replace('+', ' positivo');
---

<section id="que-es" class="relative isolate overflow-hidden pb-24 pt-24 lg:pb-32 lg:pt-32 stripe-pattern-section">
  <DropField seed={1} />
  <div class="container-blud relative z-10">
    <div class="section-head" data-reveal>
      <h2 class="section-title">¿Qué es <span class="text-accent">BLUD</span>?</h2>
      <p class="section-lead">
        Un ecosistema digital para que donar sangre sea más rápido y más claro: reduce los tiempos de
        respuesta en situaciones críticas y coordina a donantes y centros médicos en una sola red.
      </p>
      <a href="/proceso" class="link-arrow mt-5 justify-center">Mira el viaje de una bolsa de sangre, de tu brazo al paciente</a>
    </div>

    <div class="mt-14 grid gap-4 lg:mt-16 lg:grid-cols-12 lg:grid-rows-[auto_auto] lg:gap-5">
      <!-- Red de bancos de sangre: foto real -->
      <article
        class="wi-card group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-panel bg-night p-7 text-white lg:col-span-7 lg:row-span-2 lg:min-h-[34rem] lg:p-10"
        data-reveal
      >
        <img
          src={labSrc(1200)}
          srcset={`${labSrc(640)} 640w, ${labSrc(1200)} 1200w`}
          sizes="(min-width: 1024px) 58vw, 100vw"
          alt="Técnica de laboratorio trabajando en un banco de sangre con equipos de análisis"
          loading="lazy"
          decoding="async"
          class="wi-foto absolute inset-0 -z-10 size-full object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,transparent_20%,rgb(26_32_44/0.7)_55%,rgb(26_32_44/0.96)_100%)]" aria-hidden="true"></div>

        <span class="absolute right-6 top-6 inline-flex items-center gap-2 rounded-full bg-white/14 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-md lg:right-8 lg:top-8">
          <span class="live-dot text-[#7CF0A5]" aria-hidden="true"></span>
          Red activa
        </span>
        <span class="wi-icono mb-5 grid size-11 place-items-center rounded-control bg-white/12 text-white backdrop-blur-md">
          <Icon name="map-trifold" class="size-6" />
        </span>
        <h3 class="text-2xl font-bold tracking-[-0.03em] lg:text-3xl">Red de bancos de sangre</h3>
        <p class="mt-3 max-w-md leading-relaxed text-white/80">
          Hospitales, clínicas y bancos de sangre verificados en un mapa, con su dirección, su contacto y
          cómo llegar.
        </p>
        <a href="#centros" class="wi-flecha mt-6 inline-flex w-fit items-center gap-2 font-semibold text-white underline decoration-white/40 underline-offset-[6px] hover:decoration-white">
          Ver centros conectados
          <Icon name="arrow-right" class="size-4" />
        </a>
      </article>

      <!-- Conexión inmediata: patrón de ondas en tono de marca -->
      <article
        class="wi-card relative isolate overflow-hidden rounded-panel border border-accent/15 bg-accent-soft p-7 lg:col-span-5 lg:p-9"
        data-reveal
        style="--reveal-delay:1"
      >
        <div class="ripple pointer-events-none absolute -right-24 -top-24 -z-10 size-72" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -right-8 -top-8 -z-10 size-40" aria-hidden="true">
          <i class="onda"></i><i class="onda" style="animation-delay:-1.1s"></i><i class="onda" style="animation-delay:-2.2s"></i>
        </div>
        <span class="wi-icono wi-campana grid size-11 place-items-center rounded-control bg-accent text-white">
          <Icon name="bell-ringing" class="size-6" />
        </span>
        <h3 class="mt-8 text-2xl font-bold tracking-[-0.03em] text-ink">Conexión inmediata</h3>
        <p class="mt-3 max-w-md leading-relaxed text-ink-2">
          Vinculamos de forma automática a donantes voluntarios con pacientes y bancos de sangre que
          necesitan atención urgente.
        </p>
        <!-- Un pulso viaja del donante al paciente -->
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-accent-ink" aria-hidden="true">
          <span class="rounded-full bg-white/70 px-2.5 py-1">Donante</span>
          <span class="enlace relative h-0.5 flex-1 overflow-hidden rounded-full bg-accent/20"><i></i></span>
          <span class="rounded-full bg-white/70 px-2.5 py-1">Paciente</span>
        </div>
      </article>

      <!-- Compatibilidad: vista previa real de la matriz -->
      <article
        class="wi-card relative isolate overflow-hidden rounded-panel border border-line bg-surface p-7 lg:col-span-5 lg:p-9" id="wi-compat"
        data-reveal
        style="--reveal-delay:2"
      >
        <div class="flex items-start justify-between gap-6">
          <span class="grid size-11 place-items-center rounded-control bg-sunken text-ink">
            <Icon name="intersect-three" class="size-6" />
          </span>
          <ul class="grid grid-cols-4 gap-1.5" role="group" aria-label="Elige un receptor para ver quién puede donarle">
            {previewTypes.map((type) => (
              <li>
                <button type="button" class="wi-tipo grid h-8 w-11 place-items-center rounded-lg border border-line font-mono text-xs font-semibold text-ink-3" data-tipo={type} data-donantes={donorsFor[type].join(',')} aria-label={`Receptor ${spoken(type)}`} aria-pressed="false">
                  {pretty(type)}
                </button>
              </li>
            ))}
          </ul>
        </div>
        <h3 class="mt-8 text-2xl font-bold tracking-[-0.03em] text-ink">Algoritmo de compatibilidad</h3>
        <p class="mt-3 max-w-md leading-relaxed text-ink-2">
          Cruza tipo de sangre y factor Rh para proponerte solo donaciones compatibles. Las pruebas
          finales siguen en manos del hospital.
        </p>
        <p class="mt-4 rounded-lg bg-sunken px-3 py-2 font-mono text-xs text-ink-2" id="wi-leyenda">Receptor <b class="text-accent">O−</b> ← recibe de: O−</p>
        <a href="#compatibilidad" class="link-arrow mt-5">
          Consultar la matriz
          <Icon name="arrow-right" class="size-4" />
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .ripple {
    border-radius: 999px;
    background: repeating-radial-gradient(
      circle at center,
      color-mix(in srgb, var(--accent) 16%, transparent) 0 1px,
      transparent 1px 22px
    );
    mask-image: radial-gradient(circle at center, #000 30%, transparent 70%);
  }

  /* Tarjetas: se elevan al pasar el cursor y una luz suave sigue al puntero. */
  .wi-card { transition: translate 350ms var(--ease-out), box-shadow 350ms var(--ease-out); }
  .wi-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%);
    transition: opacity 300ms;
  }
  @media (hover: hover) {
    .wi-card:hover { translate: 0 -5px; box-shadow: 0 28px 50px -28px rgb(122 9 16 / 0.35); }
    .wi-card:hover::after { opacity: 1; }
    .wi-card:hover .wi-icono { transform: rotate(-6deg) scale(1.08); }
    .wi-card:hover .wi-flecha :global(svg) { transform: translateX(5px); }
  }
  .wi-icono { transition: transform 350ms var(--ease-out); }
  .wi-flecha :global(svg) { transition: transform 250ms var(--ease-out); }

  /* Foto: un zoom lento y continuo (Ken Burns). */
  .wi-foto { animation: wi-zoom 22s ease-in-out infinite alternate; }
  @keyframes wi-zoom { from { transform: scale(1) translate(0, 0); } to { transform: scale(1.09) translate(-1.5%, -1%); } }

  /* Conexión inmediata: ondas que salen de la esquina y una campana que suena. */
  .onda { position: absolute; inset: 0; border-radius: 999px; border: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); animation: onda 3.3s ease-out infinite; }
  @keyframes onda { from { transform: scale(0.25); opacity: 0.9; } to { transform: scale(1.35); opacity: 0; } }
  .wi-campana :global(svg) { transform-origin: 50% 12%; animation: campana 4s ease-in-out infinite; }
  @keyframes campana { 0%, 62%, 100% { rotate: 0deg; } 68% { rotate: 16deg; } 74% { rotate: -14deg; } 80% { rotate: 10deg; } 86% { rotate: -6deg; } 92% { rotate: 0deg; } }
  .enlace i { position: absolute; top: 0; left: 0; height: 100%; width: 34%; border-radius: 999px; background: var(--accent); animation: viaja 2.2s var(--ease-in-out) infinite; }
  @keyframes viaja { from { transform: translateX(-110%); } to { transform: translateX(300%); } }

  /* Compatibilidad: receptor elegido y sus donantes. */
  .wi-tipo { cursor: pointer; transition: background 200ms, color 200ms, border-color 200ms, transform 200ms var(--ease-out); }
  .wi-tipo:hover { border-color: var(--ink-3); color: var(--ink); }
  .wi-tipo:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .wi-tipo[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: #fff; transform: scale(1.1); }
  .wi-tipo[data-donante='true'] { background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 40%, transparent); color: var(--accent-ink); animation: wi-pop 380ms var(--ease-out); }
  @keyframes wi-pop { 40% { transform: scale(1.14); } }

  @media (prefers-reduced-motion: reduce) {
    .wi-foto, .onda, .wi-campana :global(svg), .enlace i, .wi-tipo { animation: none !important; }
    .wi-card:hover { translate: none; }
  }
</style>

<script>
  const root = document.getElementById('wi-compat');
  if (root) {
    const tipos = [...root.querySelectorAll<HTMLButtonElement>('.wi-tipo')];
    const leyenda = document.getElementById('wi-leyenda')!;
    const bonito = (t: string) => t.replace('-', '−');
    let actual = 0;
    let pausado = false;
    const elegir = (i: number) => {
      actual = i;
      const donantes = (tipos[i].dataset.donantes || '').split(',');
      tipos.forEach((b, j) => {
        b.setAttribute('aria-pressed', String(j === i));
        if (donantes.includes(b.dataset.tipo || '') && j !== i) b.dataset.donante = 'true';
        else delete b.dataset.donante;
      });
      leyenda.innerHTML = `Receptor <b class="text-accent">${bonito(tipos[i].dataset.tipo || '')}</b> ← recibe de: ${donantes.map(bonito).join(', ')}`;
    };
    tipos.forEach((b, i) => {
      b.addEventListener('click', () => { pausado = true; elegir(i); });
      b.addEventListener('pointerenter', () => { if (!pausado) elegir(i); });
    });
    elegir(0);
    // Recorre los tipos solo, mientras la tarjeta se ve y nadie ha elegido uno.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let visible = false;
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.3 }).observe(root);
      setInterval(() => { if (visible && !pausado && !root.matches(':hover')) elegir((actual + 1) % tipos.length); }, 1800);
    }
  }

  // Luz que sigue al puntero en las tarjetas.
  document.querySelectorAll<HTMLElement>('.wi-card').forEach((card) =>
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    })
  );
</script>
