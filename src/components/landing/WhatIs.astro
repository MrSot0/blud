---
const features = [
  {
    icon: "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z",
    title: "Conexión Inmediata",
    description: "Vinculamos de manera automatizada a donantes voluntarios con pacientes y bancos de sangre que requieren atención urgente.",
  },
  {
    icon: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z",
    title: "Red de Bancos de Sangre",
    description: "Mapeo geolocalizado e inventario en vivo para visualizar la disponibilidad de tipos sanguíneos en hospitales y clínicas.",
  },
  {
    icon: "M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z",
    title: "Algoritmo de Compatibilidad",
    description: "Análisis rápido de tipo de sangre y factor Rh para garantizar donaciones seguras y cruzamientos de compatibilidad sin margen de error.",
  },
];
---

<section id="que-es" class="relative overflow-hidden bg-[#ffffff] py-20 lg:py-28">
  
  <!-- Gotas Flotantes Animadas (Múltiples SVG de tamaño reducido) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <!-- Gota 1: Superior Izquierda -->
    <div class="absolute top-6 left-8 text-blud-flag-red/15 animate-float-slow">
      <svg class="h-10 w-10 fill-current" viewBox="0 0 24 24">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
      </svg>
    </div>

    <!-- Gota 2: Superior Centro-Derecha -->
    <div class="absolute top-12 left-1/2 text-blud-brick-ember/15 animate-float-delayed">
      <svg class="h-14 w-14 fill-current" viewBox="0 0 24 24">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
      </svg>
    </div>

    <!-- Gota 3: Superior Derecha -->
    <div class="absolute top-10 right-12 text-blud-flag-red/10 animate-float-reverse">
      <svg class="h-12 w-12 fill-current" viewBox="0 0 24 24">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
      </svg>
    </div>

    <!-- Gota 4: Centro Izquierda -->
    <div class="absolute top-1/2 left-6 text-blud-brick-ember/15 animate-float-slow">
      <svg class="h-12 w-12 fill-current" viewBox="0 0 24 24">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
      </svg>
    </div>

    <!-- Gota 5: Centro Derecha -->
    <div class="absolute top-1/2 right-8 text-blud-flag-red/15 animate-float-delayed">
      <svg class="h-16 w-16 fill-current" viewBox="0 0 24 24">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
      </svg>
    </div>

    <!-- Gota 6: Inferior Izquierda -->
    <div class="absolute bottom-12 left-1/4 text-blud-flag-red/10 animate-float-reverse">
      <svg class="h-10 w-10 fill-current" viewBox="0 0 24 24">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
      </svg>
    </div>

    <!-- Gota 7: Inferior Centro -->
    <div class="absolute bottom-8 left-2/3 text-blud-brick-ember/15 animate-float-slow">
      <svg class="h-14 w-14 fill-current" viewBox="0 0 24 24">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
      </svg>
    </div>

    <!-- Gota 8: Inferior Derecha -->
    <div class="absolute bottom-6 right-12 text-blud-flag-red/15 animate-float-delayed">
      <svg class="h-10 w-10 fill-current" viewBox="0 0 24 24">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
      </svg>
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la Sección -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h2 class="text-3xl font-black text-slate-900 sm:text-4xl lg:text-5xl tracking-tight">
        ¿Qué es <span class="text-blud-flag-red">BLUD</span>?
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Un ecosistema digital diseñado para optimizar el proceso de donación de sangre, reducir los tiempos de respuesta en situaciones críticas y coordinar eficientemente la red de donantes y centros médicos.
      </p>
    </div>

    <!-- Grid de Características principales (Contenido Centrado) -->
    <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-3">
      {features.map((item) => (
        <div class="group relative flex flex-col items-center text-center rounded-2xl bg-white p-8 shadow-sm border border-slate-200/80 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-blud-flag-red/30">
          <!-- Icono Centrado -->
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-blud-flag-red/10 text-blud-flag-red group-hover:bg-blud-flag-red group-hover:text-white transition-colors duration-300 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 fill-current" viewBox="0 0 24 24">
              <path d={item.icon}></path>
            </svg>
          </div>

          <!-- Contenido Centrado -->
          <h3 class="mt-6 text-xl font-bold text-slate-900 group-hover:text-blud-flag-red transition-colors duration-200">
            {item.title}
          </h3>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed max-w-sm">
            {item.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  @keyframes floatSlow {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(4deg);
    }
  }

  @keyframes floatDelayed {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-16px) rotate(-6deg);
    }
  }

  @keyframes floatReverse {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(10px) rotate(3deg);
    }
  }

  .animate-float-slow {
    animation: floatSlow 6s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: floatDelayed 8s ease-in-out infinite 2s;
  }

  .animate-float-reverse {
    animation: floatReverse 7s ease-in-out infinite 1s;
  }
</style>
