---
import Icon from '../Icon.astro';

// Fotos reales de donación de sangre (Unsplash). Se alternan con fundido y zoom lento.
// Para usar video, añade el archivo en /public/hero/ y un <video> equivalente en .hero-slide.
const slides = [
  { id: "photo-1615461066841-6116e61058f4", pos: "72% center" },
  { id: "photo-1536856136534-bb679c52a9aa", pos: "center" },
  { id: "photo-1615461065929-4f8ffed6ca40", pos: "75% center" },
  { id: "photo-1753011399874-e4fa3ec22645", pos: "70% center" },
  { id: "photo-1615461066159-fea0960485d5", pos: "70% center" },
];
const src = (id: string, w: number) => `https://images.unsplash.com/${id}?q=72&w=${w}&auto=format&fit=crop`;
const srcset = (id: string) => `${src(id, 768)} 768w, ${src(id, 1280)} 1280w, ${src(id, 1920)} 1920w`;

const facts = [
  { value: "3", unit: "personas", text: "pueden recibir ayuda de una sola donación." },
  { value: "450", unit: "ml", text: "se extraen. Tu cuerpo repone ese volumen en pocas semanas." },
  { value: "10", unit: "min", text: "dura la extracción. La visita completa toma cerca de una hora." },
];
---

<section id="inicio" class="hero relative isolate overflow-hidden bg-blud-shadow-grey text-white" data-hero>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    {slides.map((slide, i) => (
      <div class="hero-slide" data-state={i === 0 ? 'active' : ''} style={`--kx:${i % 2 === 0 ? '-2%' : '2%'}`}>
        {i === 0 ? (
          <img
            src={src(slide.id, 1600)}
            srcset={srcset(slide.id)}
            sizes="100vw"
            alt=""
            fetchpriority="high"
            decoding="async"
            style={`object-position:${slide.pos}`}
          />
        ) : (
          <img
            data-src={src(slide.id, 1600)}
            data-srcset={srcset(slide.id)}
            sizes="100vw"
            alt=""
            decoding="async"
            style={`object-position:${slide.pos}`}
          />
        )}
      </div>
    ))}
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(26_32_44/0.55)_0%,rgb(26_32_44/0.88)_55%,#1A202C_100%)] lg:bg-[linear-gradient(90deg,#1A202C_0%,rgb(26_32_44/0.94)_34%,rgb(26_32_44/0.55)_62%,rgb(0_95_115/0.25)_100%)]"></div>
    <div class="grain absolute inset-0"></div>
  </div>

  <div class="container-blud grid min-h-[min(calc(100dvh-4rem),50rem)] items-center pb-36 pt-20 lg:grid-cols-12 lg:pb-40">
    <div class="lg:col-span-9 xl:col-span-8">
      <h1
        class="hero-in text-[clamp(2.625rem,1.3rem+4.2vw,4.5rem)] font-extrabold leading-[0.98] tracking-[-0.045em]"
        style="--i:0"
      >
        <span class="lg:whitespace-nowrap">Conectando donantes,</span>
        <span class="block text-[#F2605A]">salvando vidas.</span>
      </h1>

      <p class="hero-in mt-6 max-w-[34rem] text-lg leading-relaxed text-white/80 sm:text-xl" style="--i:1">
        Encuentra centros cercanos, atiende solicitudes de emergencia o agenda tu cita en minutos.
      </p>

      <div class="hero-in mt-10 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-7" style="--i:2">
        <a href="/register" class="btn btn-primary btn-lg group">
          Quiero ser donante
          <Icon name="arrow-right" class="size-5 transition-transform duration-200 ease-out group-hover:translate-x-0.5" />
        </a>
        <a
          href="/elegibilidad"
          class="inline-flex items-center gap-2 font-semibold text-white/90 underline decoration-white/30 underline-offset-[6px] transition-colors hover:text-white hover:decoration-white"
        >
          ¿Puedo donar? Haz el test
        </a>
      </div>
    </div>
  </div>

  <!-- Controles del fondo: pausa y selección de imagen -->
  <div class="container-blud pointer-events-none absolute inset-x-0 bottom-28 flex justify-end lg:bottom-32">
    <div class="hero-in pointer-events-auto flex items-center gap-3" style="--i:3">
      <div class="flex items-center gap-1.5" role="group" aria-label="Imágenes de fondo">
        {slides.map((_, i) => (
          <button
            type="button"
            class="hero-bar group relative h-6 w-7 sm:w-9"
            data-go={i}
            aria-label={`Ver imagen ${i + 1} de ${slides.length}`}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <span class="absolute inset-x-0 top-1/2 h-[3px] -translate-y-1/2 overflow-hidden rounded-full bg-white/25 transition-colors group-hover:bg-white/40">
              <span class="hero-bar-fill absolute inset-0 origin-left rounded-full bg-white"></span>
            </span>
          </button>
        ))}
      </div>
      <button
        type="button"
        id="hero-toggle"
        class="grid size-9 place-items-center rounded-full border border-white/20 bg-white/10 text-white backdrop-blur-md transition-colors hover:bg-white/20"
        aria-label="Pausar imágenes de fondo"
      >
        <span data-icon-pause><Icon name="pause" class="size-3.5" /></span>
        <span data-icon-play class="hidden"><Icon name="play" class="size-3.5" /></span>
      </button>
    </div>
  </div>
</section>

<!-- Datos clave: solapan el borde inferior del hero -->
<div class="container-blud relative z-10 -mt-20">
  <ul class="panel grid divide-y divide-line sm:grid-cols-3 sm:divide-x sm:divide-y-0" aria-label="Datos sobre la donación">
    {facts.map((fact, i) => (
      <li class="flex flex-col gap-3 p-6 lg:p-8" data-reveal style={`--reveal-delay:${i}`}>
        <p class="flex items-baseline gap-1.5 text-ink">
          <span class="text-5xl font-bold tracking-[-0.05em] tabular">{fact.value}</span>
          <span class="font-mono text-sm font-medium uppercase text-accent-ink">{fact.unit}</span>
        </p>
        <p class="max-w-[28ch] text-[0.9375rem] leading-relaxed text-ink-2">{fact.text}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .hero {
    --slide-duration: 6500ms;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1400ms ease;
  }
  .hero-slide[data-state="active"] {
    opacity: 1;
  }
  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1);
  }
  /* El zoom continúa mientras la imagen sale para que el fundido no salte. */
  .hero-slide[data-state="active"] img,
  .hero-slide[data-state="leaving"] img {
    animation: hero-kenburns calc(var(--slide-duration) + 2200ms) linear both;
  }
  .hero.is-paused .hero-slide img {
    animation-play-state: paused;
  }
  @keyframes hero-kenburns {
    from { transform: scale(1.12) translate3d(var(--kx), 0, 0); }
    to { transform: scale(1.01) translate3d(0, 0, 0); }
  }

  .hero-bar-fill {
    transform: scaleX(0);
  }
  .hero-bar[aria-current="true"] .hero-bar-fill {
    animation: hero-progress var(--slide-duration) linear both;
  }
  .hero-bar.is-done .hero-bar-fill {
    transform: scaleX(1);
  }
  .hero.is-paused .hero-bar-fill {
    animation-play-state: paused;
  }
  @keyframes hero-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .hero-in {
    animation: hero-in 900ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--i) * 90ms);
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide { transition-duration: 300ms; }
    .hero-slide img, .hero-slide[data-state] img { animation: none; transform: none; }
    .hero-bar[aria-current="true"] .hero-bar-fill { animation: none; transform: scaleX(1); }
    .hero-in { animation: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('.hero-slide'));
    const bars = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-go]'));
    const toggle = hero.querySelector<HTMLButtonElement>('#hero-toggle');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Duración de cada imagen; se comparte con el CSS (barra de progreso y zoom).
    const DURATION = 6500;
    hero.style.setProperty('--slide-duration', `${DURATION}ms`);

    let index = 0;
    let timer = 0;
    let remaining = DURATION;
    let startedAt = 0;
    let userPaused = reduceMotion;
    let onScreen = true;

    const loadSlide = (i: number): Promise<void> => {
      const img = slides[i]?.querySelector('img');
      if (!img) return Promise.resolve();
      if (img.dataset.src) {
        img.srcset = img.dataset.srcset || '';
        img.src = img.dataset.src;
        delete img.dataset.src;
        delete img.dataset.srcset;
      }
      return img.decode().catch(() => undefined);
    };

    const isRunning = () => !userPaused && onScreen && !document.hidden;

    const updateBars = () => {
      bars.forEach((bar, i) => {
        bar.classList.toggle('is-done', i < index);
        if (i === index) {
          // Reinicia la animación de progreso de la barra activa.
          bar.removeAttribute('aria-current');
          void bar.offsetWidth;
          bar.setAttribute('aria-current', 'true');
        } else {
          bar.removeAttribute('aria-current');
        }
      });
    };

    const stopTimer = () => {
      if (!timer) return;
      clearTimeout(timer);
      timer = 0;
      remaining = Math.max(0, remaining - (performance.now() - startedAt));
    };

    const startTimer = () => {
      clearTimeout(timer);
      startedAt = performance.now();
      timer = window.setTimeout(() => {
        timer = 0;
        goTo(index + 1);
      }, remaining);
    };

    const sync = () => {
      hero.classList.toggle('is-paused', !isRunning());
      if (isRunning()) {
        if (!timer) startTimer();
      } else {
        stopTimer();
      }
    };

    const goTo = async (target: number) => {
      const next = (target + slides.length) % slides.length;
      if (next === index) return;
      await loadSlide(next);

      const prev = slides[index];
      prev.dataset.state = 'leaving';
      window.setTimeout(() => {
        if (prev.dataset.state === 'leaving') prev.dataset.state = '';
      }, 1500);

      index = next;
      slides[index].dataset.state = 'active';
      remaining = DURATION;
      updateBars();
      clearTimeout(timer);
      timer = 0;
      sync();
      loadSlide((index + 1) % slides.length);
    };

    const setPaused = (paused: boolean) => {
      userPaused = paused;
      toggle?.setAttribute('aria-label', paused ? 'Reanudar imágenes de fondo' : 'Pausar imágenes de fondo');
      toggle?.querySelector('[data-icon-pause]')?.classList.toggle('hidden', paused);
      toggle?.querySelector('[data-icon-play]')?.classList.toggle('hidden', !paused);
      sync();
    };

    toggle?.addEventListener('click', () => setPaused(!userPaused));
    bars.forEach((bar) => bar.addEventListener('click', () => goTo(Number(bar.dataset.go))));
    document.addEventListener('visibilitychange', sync);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        onScreen = entries[0]?.isIntersecting ?? true;
        sync();
      }).observe(hero);
    }

    setPaused(userPaused);
    // Precarga la segunda imagen cuando el navegador esté libre.
    if ('requestIdleCallback' in window) window.requestIdleCallback(() => loadSlide(1));
    else setTimeout(() => loadSlide(1), 1200);
  }
</script>
