---
// Lista de imágenes de alta calidad enfocadas en salud y donación de sangre
const backgroundImages = [
  "https://images.unsplash.com/photo-1615461066841-6116e61058f4?q=80&w=1920&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1579154204601-01588f351e67?q=80&w=1920&auto=format&fit=crop",
  "https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?q=80&w=1920&auto=format&fit=crop"
];
---

<section class="relative flex min-h-[calc(100vh-4.5rem)] w-full items-center justify-center bg-blud-shadow-grey px-6 overflow-hidden text-center py-20">
  
  <!-- Contenedor del Carrusel de Imágenes con Fade -->
  <div class="absolute inset-0 z-0">
    {backgroundImages.map((img, index) => (
      <div 
        class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
      >
        <img 
          src={img} 
          alt={`Donación de sangre Blud ${index + 1}`} 
          class="h-full w-full object-cover scale-105"
        />
      </div>
    ))}

    <!-- Capa de transparencia con gradiente (50%, 55%, 45%) -->
    <div class="absolute inset-0 z-10 bg-blud-shadow-grey/50 backdrop-blur-[2px]"></div>
    <div class="absolute inset-0 z-10 bg-gradient-to-t from-blud-shadow-grey/50 via-blud-shadow-grey/55 to-blud-dark-teal/45"></div>
  </div>

  <!-- Destellos decorativos de fondo -->
  <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-blud-brick-ember/20 blur-3xl pointer-events-none z-10"></div>
  <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-blud-dark-teal/25 blur-3xl pointer-events-none z-10"></div>

  <!-- Contenedor Principal Centrado -->
  <div class="mx-auto flex max-w-3xl flex-col items-center relative z-20">

    <!-- Título principal -->
    <h1 class="font-sans text-4xl font-extrabold leading-tight text-white sm:text-5xl md:text-6xl tracking-tight drop-shadow-xl">
      Conectando donantes, <span class="text-blud-flag-red">salvando vidas</span>
    </h1>
    
    <!-- Párrafo descriptivo -->
    <p class="mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-blud-alabaster/95 drop-shadow-md font-normal">
      Optimizamos la búsqueda e intermediación de donaciones de sangre. Encuentra centros cercanos, atiende solicitudes de emergencia o agenda tu cita en minutos.
    </p>
    
    <!-- Botón de Acción Único -->
    <div class="mt-10 flex justify-center">
      <a 
        href="#donar" 
        class="inline-flex items-center justify-center rounded-2xl bg-blud-brick-ember px-8 py-4 font-sans text-base font-bold text-white shadow-2xl shadow-blud-brick-ember/40 transition-all duration-300 hover:scale-105 hover:bg-blud-oxblood hover:shadow-blud-brick-ember/60 active:scale-95"
      >
        Quiero ser donante
      </a>
    </div>

  </div>
</section>

<!-- Script para rotar las imágenes con efecto Fade -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.hero-slide');
    if (slides.length === 0) return;

    let currentIndex = 0;
    const intervalTime = 5000;

    setInterval(() => {
      slides[currentIndex].classList.remove('opacity-100');
      slides[currentIndex].classList.add('opacity-0');

      currentIndex = (currentIndex + 1) % slides.length;

      slides[currentIndex].classList.remove('opacity-0');
      slides[currentIndex].classList.add('opacity-100');
    }, intervalTime);
  });
</script>