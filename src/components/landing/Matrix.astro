---
const bloodTypes = ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"];

// Matriz de compatibilidad para Donantes y Receptores
const compatibilityData = [
  { type: "O-", giveTo: ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"], receiveFrom: ["O-"], isUniversalDonor: true },
  { type: "O+", giveTo: ["O+", "A+", "B+", "AB+"], receiveFrom: ["O+", "O-"] },
  { type: "A-", giveTo: ["A+", "A-", "AB+", "AB-"], receiveFrom: ["A-", "O-"] },
  { type: "A+", giveTo: ["A+", "AB+"], receiveFrom: ["A+", "A-", "O+", "O-"] },
  { type: "B-", giveTo: ["B+", "B-", "AB+", "AB-"], receiveFrom: ["B-", "O-"] },
  { type: "B+", giveTo: ["B+", "AB+"], receiveFrom: ["B+", "B-", "O+", "O-"] },
  { type: "AB-", giveTo: ["AB+", "AB-"], receiveFrom: ["AB-", "A-", "B-", "O-"] },
  { type: "AB+", giveTo: ["AB+"], receiveFrom: ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"], isUniversalReceiver: true },
];
---

<section id="compatibilidad" class="relative overflow-hidden bg-[#f7f7f7] py-20 lg:py-28">
  
  <!-- Patrón de Rejilla de Fondo (Black Grid Overlay) -->
  <div 
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#0000000a_1px,transparent_1px),linear-gradient(to_bottom,#0000000a_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la Sección -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block rounded-full bg-blud-flag-red/10 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-blud-flag-red">
        Algoritmo Biológico
      </span>
      <h2 class="text-3xl font-black text-slate-900 sm:text-4xl lg:text-5xl tracking-tight">
        Matriz de <span class="text-blud-flag-red">Compatibilidad</span> Sanguínea
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Selecciona un tipo de sangre para evaluar al instante las compatibilidades de donación y recepción de componentes sanguíneos.
      </p>
    </div>

    <!-- Selector Interactivo de Tipo de Sangre -->
    <div class="mt-12 flex flex-wrap justify-center gap-2 sm:gap-3">
      {bloodTypes.map((type, idx) => (
        <button
          type="button"
          data-type={type}
          class={`matrix-btn transition-all duration-200 px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base border ${
            idx === 0
              ? "bg-blud-flag-red text-white border-blud-flag-red shadow-md shadow-blud-flag-red/20 scale-105"
              : "bg-white text-slate-700 border-slate-300 hover:border-blud-flag-red hover:text-blud-flag-red shadow-sm"
          }`}
        >
          {type}
        </button>
      ))}
    </div>

    <!-- Matriz Visual / Tabla de Transfusión -->
    <div class="mt-12 rounded-2xl bg-white/90 border border-slate-200/80 p-6 sm:p-8 shadow-xl backdrop-blur-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-center border-collapse">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="py-4 px-3 text-xs font-black uppercase tracking-wider text-slate-500 text-left">
                Tipo Sanguíneo
              </th>
              <th class="py-4 px-3 text-xs font-black uppercase tracking-wider text-slate-500">
                Puede Donar A
              </th>
              <th class="py-4 px-3 text-xs font-black uppercase tracking-wider text-slate-500">
                Puede Recibir De
              </th>
              <th class="py-4 px-3 text-xs font-black uppercase tracking-wider text-slate-500">
                Atributo Especial
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {compatibilityData.map((item, idx) => (
              <tr 
                id={`row-${item.type}`}
                class={`matrix-row transition-colors duration-200 ${idx === 0 ? "bg-slate-50/80 font-semibold" : "hover:bg-slate-50/50"}`}
              >
                <!-- Tipo de sangre -->
                <td class="py-4 px-3 text-left font-black text-slate-900 text-lg">
                  <span class="inline-flex items-center justify-center h-9 w-12 rounded-lg bg-slate-100 text-slate-900 shadow-xs border border-slate-200">
                    {item.type}
                  </span>
                </td>

                <!-- Puede Donar A -->
                <td class="py-4 px-3">
                  <div class="flex flex-wrap justify-center gap-1.5">
                    {item.giveTo.map((target) => (
                      <span class="inline-block rounded-md bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700 border border-slate-200/60">
                        {target}
                      </span>
                    ))}
                  </div>
                </td>

                <!-- Puede Recibir De -->
                <td class="py-4 px-3">
                  <div class="flex flex-wrap justify-center gap-1.5">
                    {item.receiveFrom.map((source) => (
                      <span class="inline-block rounded-md bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700 border border-slate-200/60">
                        {source}
                      </span>
                    ))}
                  </div>
                </td>

                <!-- Tag Especial -->
                <td class="py-4 px-3">
                  {item.isUniversalDonor && (
                    <span class="inline-block rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-extrabold text-emerald-600 border border-emerald-200">
                      Donante Universal
                    </span>
                  )}
                  {item.isUniversalReceiver && (
                    <span class="inline-block rounded-full bg-blue-500/10 px-3 py-1 text-xs font-extrabold text-blue-600 border border-blue-200">
                      Receptor Universal
                    </span>
                  )}
                  {!item.isUniversalDonor && !item.isUniversalReceiver && (
                    <span class="text-xs text-slate-400 font-medium">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const buttons = document.querySelectorAll(".matrix-btn");
    const rows = document.querySelectorAll(".matrix-row");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selectedType = btn.getAttribute("data-type");

        // Actualizar estados de botones
        buttons.forEach((b) => {
          b.classList.remove("bg-blud-flag-red", "text-white", "border-blud-flag-red", "shadow-md", "shadow-blud-flag-red/20", "scale-105");
          b.classList.add("bg-white", "text-slate-700", "border-slate-300", "shadow-sm");
        });

        btn.classList.remove("bg-white", "text-slate-700", "border-slate-300", "shadow-sm");
        btn.classList.add("bg-blud-flag-red", "text-white", "border-blud-flag-red", "shadow-md", "shadow-blud-flag-red/20", "scale-105");

        // Destacar la fila correspondiente
        rows.forEach((row) => {
          if (row.id === `row-${selectedType}`) {
            row.classList.add("bg-slate-100/90", "ring-2", "ring-blud-flag-red/30");
          } else {
            row.classList.remove("bg-slate-100/90", "ring-2", "ring-blud-flag-red/30");
          }
        });
      });
    });
  });
</script>
