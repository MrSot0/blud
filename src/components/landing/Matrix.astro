---
// Matrix.astro - Matriz Interactiva de Compatibilidad Sanguínea para BLUD
const bloodGroups = ["O-", "O+", "A-", "A+", "B-", "B+", "AB-", "AB+"];
---

<section id="compatibilidad" class="relative py-20 sm:py-24 bg-blud-grid overflow-hidden border-t border-slate-800">

  <div class="mx-auto max-w-5xl px-4 md:px-8 relative z-10">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="font-sans text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Matriz de <span class="text-blud-flag-red">Compatibilidad</span>
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-400 leading-relaxed">
        Descubre al instante a qué grupos sanguíneos puedes salvar la vida y de quiénes puedes recibir donaciones de forma segura.
      </p>
    </div>

    <!-- Tarjeta Principal (Ligeramente más clara que el fondo bg-slate-900) -->
    <div class="rounded-3xl border border-slate-700/80 bg-slate-800/80 p-6 sm:p-10 shadow-2xl shadow-black/40 relative overflow-hidden backdrop-blur-md">
      
      <!-- Selector de Tipo de Sangre -->
      <div class="mb-10">
        <label class="block text-xs font-bold uppercase tracking-widest text-slate-400 text-center mb-5">
          Haz clic en tu tipo de sangre:
        </label>

        <div class="grid grid-cols-4 sm:grid-cols-8 gap-3">
          {bloodGroups.map((group, index) => (
            <button
              type="button"
              data-matrix-btn={group}
              class={`matrix-btn relative group overflow-hidden py-3.5 px-2 rounded-2xl font-sans font-black text-lg sm:text-xl transition-all duration-300 border ${
                index === 0 
                  ? 'bg-blud-brick-ember text-white border-blud-brick-ember shadow-lg shadow-blud-brick-ember/40 scale-105' 
                  : 'bg-slate-700/60 text-slate-200 border-slate-600/80 hover:bg-slate-700 hover:border-slate-500 hover:scale-105'
              }`}
            >
              <span class="relative z-10">{group}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Banner Informativo Dinámico (Rol Especial) -->
      <div id="role-banner" class="mb-8 rounded-2xl bg-slate-900/90 border border-teal-500/30 p-4 flex items-center justify-between gap-4 transition-all duration-300">
        <div class="flex items-center gap-3.5">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blud-dark-teal text-white shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
            </svg>
          </div>
          <div>
            <h4 id="role-title" class="font-sans text-sm font-bold text-white">Donante Universal</h4>
            <p id="role-desc" class="text-xs text-slate-400">Tu sangre (O-) puede ser transfundida a cualquier persona en emergencias.</p>
          </div>
        </div>
      </div>

      <!-- Resultados de Compatibilidad en 2 Columnas Interactivas -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Columna: Puede Donar A -->
        <div class="group rounded-2xl bg-slate-900/60 border border-slate-700/70 p-6 transition-all duration-300 hover:border-emerald-500/50 hover:bg-slate-900/80">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
              </div>
              <div>
                <h3 class="font-sans text-base font-bold text-white">Puedes donar a:</h3>
                <span id="give-count" class="text-xs text-slate-400 font-mono">8 de 8 grupos</span>
              </div>
            </div>
          </div>

          <div id="give-to-list" class="flex flex-wrap gap-2.5 pt-2 min-h-[4rem] items-center">
            <!-- Inyectado mediante JS -->
          </div>
        </div>

        <!-- Columna: Puede Recibir De -->
        <div class="group rounded-2xl bg-slate-900/60 border border-slate-700/70 p-6 transition-all duration-300 hover:border-teal-500/50 hover:bg-slate-900/80">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-teal-500/10 text-teal-400 border border-teal-500/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              </div>
              <div>
                <h3 class="font-sans text-base font-bold text-white">Puedes recibir de:</h3>
                <span id="receive-count" class="text-xs text-slate-400 font-mono">1 de 8 grupos</span>
              </div>
            </div>
          </div>

          <div id="receive-from-list" class="flex flex-wrap gap-2.5 pt-2 min-h-[4rem] items-center">
            <!-- Inyectado mediante JS -->
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Datos de compatibilidad e información contextual
  const matrixData: Record<string, { give: string[], receive: string[], role: string, desc: string }> = {
    "O-": {
      give: ["O-", "O+", "A-", "A+", "B-", "B+", "AB-", "AB+"],
      receive: ["O-"],
      role: "Donante Universal de Glóbulos Rojos",
      desc: "Eres un perfil crítico. Tu sangre se utiliza en urgencias cuando no hay tiempo de verificar el tipo del paciente."
    },
    "O+": {
      give: ["O+", "A+", "B+", "AB+"],
      receive: ["O-", "O+"],
      role: "Donante Más Requerido",
      desc: "Es el tipo de sangre más común. Alrededor del 38% de la población la posee y se necesita a diario."
    },
    "A-": {
      give: ["A-", "A+", "AB-", "AB+"],
      receive: ["O-", "A-"],
      role: "Donante para Grupos A y AB",
      desc: "Puedes ayudar a personas de tipo A y AB tanto negativos como positivos."
    },
    "A+": {
      give: ["A+", "AB+"],
      receive: ["O-", "O+", "A-", "A+"],
      role: "Receptor Amplio de Tipos Comunes",
      desc: "Un tipo de sangre vital. Aproximadamente 1 de cada 3 personas es A+."
    },
    "B-": {
      give: ["B-", "B+", "AB-", "AB+"],
      receive: ["O-", "B-"],
      role: "Grupo Sanguíneo Escaso",
      desc: "Menos del 2% de la población mundial tiene B-, por lo que tus donaciones son sumamente apreciadas."
    },
    "B+": {
      give: ["B+", "AB+"],
      receive: ["O-", "O+", "B-", "B+"],
      role: "Donante Compatible con B+ y AB+",
      desc: "Puedes recibir transfusiones de cualquier tipo B u O."
    },
    "AB-": {
      give: ["AB-", "AB+"],
      receive: ["O-", "A-", "B-", "AB-"],
      role: "El Tipo de Sangre Más Raro",
      desc: "Presente en menos del 1% de la población. Además, eres donante universal de plasma."
    },
    "AB+": {
      give: ["AB+"],
      receive: ["O-", "O+", "A-", "A+", "B-", "B+", "AB-", "AB+"],
      role: "Receptor Universal",
      desc: "Puedes recibir glóbulos rojos de cualquier grupo sanguíneo sin reacciones adversas."
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-matrix-btn]');
    const giveContainer = document.getElementById('give-to-list');
    const receiveContainer = document.getElementById('receive-from-list');
    const giveCount = document.getElementById('give-count');
    const receiveCount = document.getElementById('receive-count');
    const roleTitle = document.getElementById('role-title');
    const roleDesc = document.getElementById('role-desc');

    function renderBadges(container: HTMLElement | null, items: string[], activeType: string) {
      if (!container) return;
      
      container.innerHTML = items.map(item => {
        const isSelf = item === activeType;
        return `
          <span class="inline-flex items-center px-3.5 py-1.5 rounded-xl text-sm font-extrabold transition-all duration-300 transform scale-95 opacity-0 animate-fade-in ${
            isSelf 
              ? 'bg-blud-brick-ember text-white border border-blud-flag-red shadow-md scale-105' 
              : 'bg-slate-800 text-slate-200 border border-slate-700 hover:border-slate-500'
          }">
            ${item}
          </span>
        `;
      }).join('');

      setTimeout(() => {
        container.querySelectorAll('span').forEach(span => {
          span.classList.remove('scale-95', 'opacity-0');
          span.classList.add('scale-100', 'opacity-100');
        });
      }, 50);
    }

    function updateMatrix(type: string) {
      buttons.forEach(btn => {
        const isSelected = btn.dataset.matrixBtn === type;
        if (isSelected) {
          btn.className = "matrix-btn relative group overflow-hidden py-3.5 px-2 rounded-2xl font-sans font-black text-lg sm:text-xl transition-all duration-300 border bg-blud-brick-ember text-white border-blud-brick-ember shadow-lg shadow-blud-brick-ember/40 scale-105";
        } else {
          btn.className = "matrix-btn relative group overflow-hidden py-3.5 px-2 rounded-2xl font-sans font-black text-lg sm:text-xl transition-all duration-300 border bg-slate-700/60 text-slate-200 border-slate-600/80 hover:bg-slate-700 hover:border-slate-500 hover:scale-105";
        }
      });

      const info = matrixData[type];
      if (info) {
        renderBadges(giveContainer, info.give, type);
        renderBadges(receiveContainer, info.receive, type);

        if (giveCount) giveCount.textContent = `${info.give.length} de 8 grupos`;
        if (receiveCount) receiveCount.textContent = `${info.receive.length} de 8 grupos`;

        if (roleTitle) roleTitle.textContent = info.role;
        if (roleDesc) roleDesc.textContent = info.desc;
      }
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.dataset.matrixBtn;
        if (type) updateMatrix(type);
      });
    });

    updateMatrix("O-");
  });
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.25s ease-out forwards;
  }
</style>