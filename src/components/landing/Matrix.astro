---
import Icon from '../Icon.astro';

const bloodTypes = ["O-", "O+", "A-", "A+", "B-", "B+", "AB-", "AB+"] as const;
type BloodType = (typeof bloodTypes)[number];

interface Compat {
  giveTo: BloodType[];
  receiveFrom: BloodType[];
  isUniversalDonor?: boolean;
  isUniversalReceiver?: boolean;
}

// Compatibilidad de glóbulos rojos (ABO + Rh).
const matrix: Record<BloodType, Compat> = {
  "O-": { giveTo: ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"], receiveFrom: ["O-"], isUniversalDonor: true },
  "O+": { giveTo: ["O+", "A+", "B+", "AB+"], receiveFrom: ["O+", "O-"] },
  "A-": { giveTo: ["A+", "A-", "AB+", "AB-"], receiveFrom: ["A-", "O-"] },
  "A+": { giveTo: ["A+", "AB+"], receiveFrom: ["A+", "A-", "O+", "O-"] },
  "B-": { giveTo: ["B+", "B-", "AB+", "AB-"], receiveFrom: ["B-", "O-"] },
  "B+": { giveTo: ["B+", "AB+"], receiveFrom: ["B+", "B-", "O+", "O-"] },
  "AB-": { giveTo: ["AB+", "AB-"], receiveFrom: ["AB-", "A-", "B-", "O-"] },
  "AB+": { giveTo: ["AB+"], receiveFrom: ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"], isUniversalReceiver: true },
};

const initial: BloodType = "O-";
const pretty = (t: string) => t.replace('-', '−');
const spoken = (t: string) => t.replace('-', ' negativo').replace('+', ' positivo');

const strips = [
  { key: 'giveTo', title: 'Puede donar a' },
  { key: 'receiveFrom', title: 'Puede recibir de' },
] as const;
---

<section id="compatibilidad" class="py-24 lg:py-32" data-matrix={JSON.stringify(matrix)}>
  <div class="container-blud">
    <div class="max-w-3xl" data-reveal>
      <h2 class="section-title">Matriz de compatibilidad sanguínea</h2>
      <p class="section-lead">
        Toca un tipo de sangre para ver al instante a quién puede donar y de quién puede recibir.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-12 lg:gap-8">
      <!-- Selector -->
      <div class="lg:col-span-5" data-reveal>
        <fieldset>
          <legend class="mb-4 text-sm font-semibold text-ink">Elige un tipo de sangre</legend>
          <div class="grid grid-cols-4 gap-2 sm:gap-3">
            {bloodTypes.map((type) => (
              <label class="type-tile relative cursor-pointer">
                <input
                  type="radio"
                  name="matrix-blood-type"
                  value={type}
                  checked={type === initial}
                  class="peer sr-only"
                />
                <span
                  class="flex h-20 items-center justify-center rounded-control border border-line-strong bg-surface text-2xl font-bold tracking-[-0.04em] text-ink transition-[background-color,border-color,color,transform] duration-200 ease-out peer-checked:border-accent peer-checked:bg-accent peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent active:scale-[0.96] sm:h-24 sm:text-3xl"
                  aria-hidden="true"
                >
                  {pretty(type)}
                </span>
                <span class="sr-only">Tipo {spoken(type)}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-6 flex gap-3 rounded-control bg-sunken p-4 text-sm leading-relaxed text-ink-2">
          <Icon name="info" class="mt-0.5 size-5 shrink-0 text-ink-3" />
          <p>
            Estas reglas corresponden a glóbulos rojos. El plasma y las plaquetas siguen reglas distintas,
            y el banco de sangre siempre confirma con pruebas cruzadas.
          </p>
        </div>
      </div>

      <!-- Resultado -->
      <div class="panel p-6 sm:p-8 lg:col-span-7" data-reveal style="--reveal-delay:1">
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-6">
          <div>
            <p class="text-sm font-medium text-ink-3">Tipo evaluado</p>
            <p id="res-type" class="res-type mt-1 text-7xl font-extrabold leading-none tracking-[-0.06em] text-ink">
              {pretty(initial)}
            </p>
          </div>
          <p id="res-tag" class="min-h-8">
            {matrix[initial].isUniversalDonor && (
              <span class="inline-flex items-center gap-1.5 rounded-lg bg-ok-soft px-3 py-1.5 text-sm font-bold text-ok">
                <Icon name="check-circle" class="size-4" /> Donante universal
              </span>
            )}
          </p>
        </div>

        {strips.map((strip) => (
          <div class="mt-6">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-base font-semibold text-ink">{strip.title}</h3>
              <p class="text-sm text-ink-3">
                <span class="font-semibold text-ink tabular" data-count={strip.key}>{matrix[initial][strip.key].length}</span> de 8 grupos
              </p>
            </div>
            <ul class="mt-3 grid grid-cols-4 gap-1.5 sm:grid-cols-8" data-strip={strip.key}>
              {bloodTypes.map((type, i) => {
                const on = matrix[initial][strip.key].includes(type);
                return (
                  <li
                    data-type={type}
                    data-on={String(on)}
                    class="compat-cell flex h-12 flex-col items-center justify-center rounded-lg border font-mono text-sm font-semibold"
                    style={`--i:${i}`}
                  >
                    <span aria-hidden="true">{pretty(type)}</span>
                    <span class="sr-only" data-sr>{`${spoken(type)}: ${on ? 'compatible' : 'no compatible'}`}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}

        <p id="res-message" class="mt-7 border-t border-line pt-6 text-[0.9375rem] leading-relaxed text-ink-2" aria-live="polite">
          El tipo <strong class="text-ink">O−</strong> puede donar a los 8 grupos y recibir de O−.
          Sus glóbulos rojos sirven para cualquier paciente.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .compat-cell {
    transition:
      background-color 240ms var(--ease-out),
      border-color 240ms var(--ease-out),
      color 240ms var(--ease-out),
      opacity 240ms var(--ease-out);
    transition-delay: calc(var(--i) * 18ms);
  }
  .compat-cell[data-on="true"] {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent-ink);
  }
  .compat-cell[data-on="false"] {
    background: transparent;
    border-color: var(--line);
    border-style: dashed;
    color: var(--ink-3);
    opacity: 0.7;
  }
  .res-type.swap {
    animation: type-swap 360ms var(--ease-out);
  }
  @keyframes type-swap {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  import { iconSvg } from '../../lib/icons';

  type Compat = {
    giveTo: string[];
    receiveFrom: string[];
    isUniversalDonor?: boolean;
    isUniversalReceiver?: boolean;
  };

  const section = document.getElementById('compatibilidad');
  const matrix: Record<string, Compat> = JSON.parse(section?.dataset.matrix || '{}');

  const pretty = (t: string) => t.replace('-', '−');
  const spoken = (t: string) => t.replace('-', ' negativo').replace('+', ' positivo');
  const joinTypes = (list: string[]) => list.map(pretty).join(', ');

  const resType = document.getElementById('res-type');
  const resTag = document.getElementById('res-tag');
  const resMessage = document.getElementById('res-message');

  function update(type: string) {
    const info = matrix[type];
    if (!info) return;

    if (resType) {
      resType.textContent = pretty(type);
      resType.classList.remove('swap');
      void resType.offsetWidth;
      resType.classList.add('swap');
    }

    (['giveTo', 'receiveFrom'] as const).forEach((key) => {
      const list = info[key];
      const count = document.querySelector(`[data-count="${key}"]`);
      if (count) count.textContent = String(list.length);
      document.querySelectorAll<HTMLElement>(`[data-strip="${key}"] [data-type]`).forEach((cell) => {
        const cellType = cell.dataset.type || '';
        const on = list.includes(cellType);
        cell.dataset.on = String(on);
        const sr = cell.querySelector('[data-sr]');
        if (sr) sr.textContent = `${spoken(cellType)}: ${on ? 'compatible' : 'no compatible'}`;
      });
    });

    if (resTag) {
      if (info.isUniversalDonor) {
        resTag.innerHTML = `<span class="inline-flex items-center gap-1.5 rounded-lg bg-ok-soft px-3 py-1.5 text-sm font-bold text-ok">${iconSvg('check-circle', 'size-4')} Donante universal</span>`;
      } else if (info.isUniversalReceiver) {
        resTag.innerHTML = `<span class="inline-flex items-center gap-1.5 rounded-lg bg-sunken px-3 py-1.5 text-sm font-bold text-ink">${iconSvg('check-circle', 'size-4')} Receptor universal</span>`;
      } else {
        resTag.innerHTML = '';
      }
    }

    if (resMessage) {
      const give = info.giveTo.length === 8 ? 'a los 8 grupos' : `a ${joinTypes(info.giveTo)}`;
      const receive = info.receiveFrom.length === 8 ? 'de los 8 grupos' : `de ${joinTypes(info.receiveFrom)}`;
      let msg = `El tipo <strong class="text-ink">${pretty(type)}</strong> puede donar ${give} y recibir ${receive}.`;
      if (info.isUniversalDonor) msg += ' Sus glóbulos rojos sirven para cualquier paciente.';
      if (info.isUniversalReceiver) msg += ' Puede recibir glóbulos rojos de cualquier grupo.';
      resMessage.innerHTML = msg;
    }
  }

  document.querySelectorAll<HTMLInputElement>('input[name="matrix-blood-type"]').forEach((input) => {
    input.addEventListener('change', () => {
      if (input.checked) update(input.value);
    });
  });
</script>
