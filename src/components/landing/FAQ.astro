---
// FAQ.astro - Preguntas Frecuentes de la plataforma BLUD (Tema Claro)
---

<section id="faq" class="relative py-20 sm:py-28 bg-white overflow-hidden border-t border-slate-100 select-none">

  <!-- Patrón de Puntos de Fondo sutil -->
  <div 
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(#e5e7eb_1.5px,transparent_1.5px)] [background-size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-70"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-5xl px-4 md:px-8 relative z-10">
    
    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-blud-flag-red bg-blud-flag-red/10 px-3.5 py-1.5 rounded-full border border-blud-flag-red/20 inline-block mb-3">
        Resuelve tus dudas
      </span>
      <h2 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Preguntas <span class="text-blud-flag-red">Frecuentes</span>
      </h2>
      <p class="mt-3 text-base sm:text-lg text-slate-600 leading-relaxed">
        Todo lo que necesitas saber sobre el funcionamiento de BLUD, la gestión de donaciones y la red de centros hospitalarios.
      </p>
    </div>

    <!-- Buscador de FAQs -->
    <div class="max-w-xl mx-auto mb-10 relative">
      <div class="relative flex items-center">
        <input
          type="text"
          id="faq-search-input"
          placeholder="¿Qué estás buscando? (ej. donar, requisitos, hospitales)..."
          class="w-full pl-12 pr-4 py-3.5 bg-slate-50 border-2 border-slate-200/80 rounded-2xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blud-flag-red focus:bg-white focus:ring-4 focus:ring-blud-flag-red/10 shadow-xs transition-all"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute left-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <!-- Filtros de Categoría -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 mb-10" id="faq-categories">
      <button data-category="all" class="faq-category-btn active px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-blud-flag-red text-white shadow-md shadow-blud-flag-red/20">
        Todas
      </button>
      <button data-category="donantes" class="faq-category-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 border border-slate-200/80 transition-all">
        Donantes
      </button>
      <button data-category="centros" class="faq-category-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 border border-slate-200/80 transition-all">
        Centros de Salud
      </button>
      <button data-category="seguridad" class="faq-category-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 border border-slate-200/80 transition-all">
        Seguridad y Privacidad
      </button>
    </div>

    <!-- Lista de Preguntas Accordion -->
    <div class="space-y-4 max-w-3xl mx-auto" id="faq-list">
      
      <!-- FAQ Item 1 -->
      <div class="faq-item rounded-2xl border-2 border-slate-200/80 bg-slate-50/60 overflow-hidden transition-all duration-300 shadow-xs" data-category="donantes">
        <button class="faq-trigger w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-slate-800 hover:text-blud-flag-red transition-colors">
          <span class="text-sm sm:text-base">¿Cuáles son los requisitos básicos para ser donante en BLUD?</span>
          <span class="faq-icon text-slate-400 text-xl transition-transform duration-300 font-extrabold shrink-0">+</span>
        </button>
        <div class="faq-content hidden px-6 pb-5 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 pt-4">
          Para registrarte como donante activo debes ser mayor de 18 años (o contar con autorización legal), pesar más de 50 kg, contar con un documento de identidad válido y no haber sufrido enfermedades de transmisión sanguínea. La plataforma evaluará tu compatibilidad al momento de conectar con un centro.
        </div>
      </div>

      <!-- FAQ Item 2 -->
      <div class="faq-item rounded-2xl border-2 border-slate-200/80 bg-slate-50/60 overflow-hidden transition-all duration-300 shadow-xs" data-category="donantes">
        <button class="faq-trigger w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-slate-800 hover:text-blud-flag-red transition-colors">
          <span class="text-sm sm:text-base">¿Cómo me notifica la plataforma si hay una emergencia con mi tipo de sangre?</span>
          <span class="faq-icon text-slate-400 text-xl transition-transform duration-300 font-extrabold shrink-0">+</span>
        </button>
        <div class="faq-content hidden px-6 pb-5 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 pt-4">
          BLUD prioriza alertas geolocalizadas. Si un banco de sangre o centro de salud cercano a tu ubicación emite una solicitud urgente matching con tu tipo de sangre, recibirás una notificación directa a tu teléfono y correo con los detalles del centro.
        </div>
      </div>

      <!-- FAQ Item 3 -->
      <div class="faq-item rounded-2xl border-2 border-slate-200/80 bg-slate-50/60 overflow-hidden transition-all duration-300 shadow-xs" data-category="centros">
        <button class="faq-trigger w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-slate-800 hover:text-blud-flag-red transition-colors">
          <span class="text-sm sm:text-base">¿Cómo se integra un hospital o banco de sangre a la red BLUD?</span>
          <span class="faq-icon text-slate-400 text-xl transition-transform duration-300 font-extrabold shrink-0">+</span>
        </button>
        <div class="faq-content hidden px-6 pb-5 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 pt-4">
          Los centros médicos públicos o privados deben solicitar una verificación institucional. Una vez validada su credencial por el equipo de BLUD, reciben acceso a la API del ecosistema para gestionar su inventario de hemoderivados en tiempo real y emitir solicitudes.
        </div>
      </div>

      <!-- FAQ Item 4 -->
      <div class="faq-item rounded-2xl border-2 border-slate-200/80 bg-slate-50/60 overflow-hidden transition-all duration-300 shadow-xs" data-category="seguridad">
        <button class="faq-trigger w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-slate-800 hover:text-blud-flag-red transition-colors">
          <span class="text-sm sm:text-base">¿Mis datos de salud e información personal están protegidos?</span>
          <span class="faq-icon text-slate-400 text-xl transition-transform duration-300 font-extrabold shrink-0">+</span>
        </button>
        <div class="faq-content hidden px-6 pb-5 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 pt-4">
          Totalmente. En BLUD utilizamos protocolos de encriptación end-to-end para proteger tus datos personales y médicos. Ningún dato sensible es compartido públicamente; solo los centros verificados con los que decidas colaborar tienen acceso a tu contacto directo para agendar la donación.
        </div>
      </div>

      <!-- FAQ Item 5 -->
      <div class="faq-item rounded-2xl border-2 border-slate-200/80 bg-slate-50/60 overflow-hidden transition-all duration-300 shadow-xs" data-category="donantes">
        <button class="faq-trigger w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-slate-800 hover:text-blud-flag-red transition-colors">
          <span class="text-sm sm:text-base">¿Cada cuánto tiempo puedo volver a realizar una donación?</span>
          <span class="faq-icon text-slate-400 text-xl transition-transform duration-300 font-extrabold shrink-0">+</span>
        </button>
        <div class="faq-content hidden px-6 pb-5 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 pt-4">
          Por normativa médica general, los hombres pueden donar cada 3 meses y las mujeres cada 4 meses. La aplicación de BLUD calculará automáticamente tu temporizador de recuperación y mantendrá tu perfil pausado para evitar llamados hasta que estés médicamente apto nuevamente.
        </div>
      </div>

      <!-- FAQ Item 6 -->
      <div class="faq-item rounded-2xl border-2 border-slate-200/80 bg-slate-50/60 overflow-hidden transition-all duration-300 shadow-xs" data-category="centros">
        <button class="faq-trigger w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-slate-800 hover:text-blud-flag-red transition-colors">
          <span class="text-sm sm:text-base">¿BLUD reemplaza las pruebas de compatibilidad en el hospital?</span>
          <span class="faq-icon text-slate-400 text-xl transition-transform duration-300 font-extrabold shrink-0">+</span>
        </button>
        <div class="faq-content hidden px-6 pb-5 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 pt-4">
          No. BLUD optimiza la logística, comunicación y agiliza la localización de voluntariado y hemoderivados mediante algoritmos de decisión multicriterio. Todas las pruebas de tamizaje y cruzado de sangre siguen ejecutándose bajo la estricta supervisión del personal médico en el laboratorio hospitalario.
        </div>
      </div>

    </div>

    <!-- Estado Vacío para Búsquedas -->
    <div id="faq-empty" class="hidden text-center py-12 text-slate-500">
      <p class="text-sm font-medium">No encontramos preguntas que coincidan con tu búsqueda.</p>
    </div>

    <!-- Banner Soporte -->
    <div class="mt-16 text-center rounded-3xl border-2 border-slate-200/80 bg-slate-50 p-6 sm:p-8 max-w-2xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
      <div class="text-left">
        <h4 class="text-sm sm:text-base font-extrabold text-slate-900">¿Tienes otra pregunta?</h4>
        <p class="text-xs sm:text-sm text-slate-500 mt-0.5">Nuestro equipo de soporte está listo para asistirte.</p>
      </div>
      <a 
        href="#contacto" 
        class="px-5 py-3 rounded-xl bg-slate-900 hover:bg-blud-flag-red text-white font-extrabold text-xs transition-colors shrink-0 shadow-md"
      >
        Contactar Soporte
      </a>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll('.faq-trigger');
    const items = document.querySelectorAll<HTMLElement>('.faq-item');
    const categoryBtns = document.querySelectorAll<HTMLButtonElement>('.faq-category-btn');
    const searchInput = document.getElementById('faq-search-input') as HTMLInputElement;
    const emptyState = document.getElementById('faq-empty');

    // Accordion Toggle
    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('.faq-item') as HTMLElement;
        const content = item.querySelector('.faq-content') as HTMLElement;
        const icon = item.querySelector('.faq-icon') as HTMLElement;

        const isOpen = !content.classList.contains('hidden');

        // Cerrar los demás acordeones
        items.forEach(otherItem => {
          if (otherItem !== item) {
            const otherContent = otherItem.querySelector('.faq-content');
            const otherIcon = otherItem.querySelector('.faq-icon');
            if (otherContent) otherContent.classList.add('hidden');
            if (otherIcon) {
              otherIcon.textContent = '+';
              otherIcon.classList.remove('rotate-45', 'text-blud-flag-red');
              otherIcon.classList.add('text-slate-400');
            }
            otherItem.classList.remove('border-blud-flag-red/50', 'bg-white', 'shadow-md');
            otherItem.classList.add('border-slate-200/80', 'bg-slate-50/60');
          }
        });

        // Alternar el actual
        if (isOpen) {
          content.classList.add('hidden');
          icon.textContent = '+';
          icon.classList.remove('rotate-45', 'text-blud-flag-red');
          icon.classList.add('text-slate-400');
          item.classList.remove('border-blud-flag-red/50', 'bg-white', 'shadow-md');
          item.classList.add('border-slate-200/80', 'bg-slate-50/60');
        } else {
          content.classList.remove('hidden');
          icon.textContent = '×';
          icon.classList.add('rotate-45', 'text-blud-flag-red');
          icon.classList.remove('text-slate-400');
          item.classList.add('border-blud-flag-red/50', 'bg-white', 'shadow-md');
          item.classList.remove('border-slate-200/80', 'bg-slate-50/60');
        }
      });
    });

    // Filtrado de Categorías
    let currentCategory = 'all';

    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach(b => {
          b.classList.remove('active', 'bg-blud-flag-red', 'text-white', 'shadow-md', 'shadow-blud-flag-red/20');
          b.classList.add('bg-slate-100', 'text-slate-600', 'border', 'border-slate-200/80');
        });

        btn.classList.add('active', 'bg-blud-flag-red', 'text-white', 'shadow-md', 'shadow-blud-flag-red/20');
        btn.classList.remove('bg-slate-100', 'text-slate-600', 'border', 'border-slate-200/80');

        currentCategory = btn.getAttribute('data-category') || 'all';
        filterFaqs();
      });
    });

    // Filtro por Buscador
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        filterFaqs();
      });
    }

    function filterFaqs() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let visibleCount = 0;

      items.forEach(item => {
        const itemCategory = item.getAttribute('data-category');
        const text = item.textContent?.toLowerCase() || '';

        const matchesCategory = currentCategory === 'all' || itemCategory === currentCategory;
        const matchesQuery = text.includes(query);

        if (matchesCategory && matchesQuery) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }
  });
</script>
