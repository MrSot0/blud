---
import DropField from '../DropField.astro';
// FAQ.astro - Preguntas frecuentes de la plataforma BLUD
import Icon from '../Icon.astro';

const categories = [
  { id: 'all', label: 'Todas' },
  { id: 'donantes', label: 'Donantes' },
  { id: 'centros', label: 'Centros de salud' },
  { id: 'seguridad', label: 'Seguridad y privacidad' },
];

const faqs = [
  {
    category: 'donantes',
    q: '¿Cuáles son los requisitos básicos para ser donante en BLUD?',
    a: 'Para registrarte como donante activo debes ser mayor de 18 años (o contar con autorización legal), pesar más de 50 kg, tener un documento de identidad válido y no haber sufrido enfermedades de transmisión sanguínea. La plataforma evaluará tu compatibilidad al momento de conectarte con un centro.',
  },
  {
    category: 'donantes',
    q: '¿Cómo me avisa la plataforma si hay una emergencia con mi tipo de sangre?',
    a: 'BLUD prioriza alertas geolocalizadas. Si un banco de sangre o centro de salud cercano emite una solicitud urgente que coincide con tu tipo de sangre, recibirás una notificación en tu teléfono y en tu correo con los datos del centro.',
  },
  {
    category: 'centros',
    q: '¿Cómo se integra un hospital o banco de sangre a la red BLUD?',
    a: 'Los centros médicos públicos o privados deben solicitar una verificación institucional. Una vez validada su credencial por el equipo de BLUD, reciben acceso a la API del ecosistema para gestionar su inventario de hemoderivados en tiempo real y emitir solicitudes.',
  },
  {
    category: 'seguridad',
    q: '¿Mis datos de salud e información personal están protegidos?',
    a: 'Sí. Usamos cifrado de extremo a extremo para proteger tus datos personales y médicos. Ningún dato sensible se comparte públicamente: solo los centros verificados con los que decidas colaborar ven tu contacto para agendar la donación.',
  },
  {
    category: 'donantes',
    q: '¿Cada cuánto tiempo puedo volver a donar?',
    a: 'Por normativa médica general, los hombres pueden donar cada 3 meses y las mujeres cada 4 meses. BLUD calcula tu tiempo de recuperación y pausa tu perfil para no enviarte llamados hasta que vuelvas a estar apto.',
  },
  {
    category: 'centros',
    q: '¿BLUD reemplaza las pruebas de compatibilidad del hospital?',
    a: 'No. BLUD agiliza la logística, la comunicación y la búsqueda de donantes y hemoderivados. Todas las pruebas de tamizaje y cruzado de sangre se siguen haciendo bajo supervisión del personal médico en el laboratorio del hospital.',
  },
];
---

<section id="faq" class="relative isolate border-t border-line py-24 lg:py-32 dot-pattern-section">
  <DropField seed={6} />
  
  <div class="container-blud relative z-10">
    <!-- Encabezado con búsqueda -->
    <div class="flex flex-col items-center gap-8" data-reveal>
      <div class="section-head">
        <h2 class="section-title">Preguntas <span class="text-accent">frecuentes</span></h2>
        <p class="section-lead">
          Cómo funciona BLUD, qué necesitas para donar y cómo trabajamos con los centros de salud.
        </p>
      </div>

      <div class="w-full max-w-xl text-left">
        <label for="faq-search-input" class="sr-only">Buscar en preguntas frecuentes</label>
        <div class="relative">
          <Icon name="magnifying-glass" class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-ink-3" />
          <input
            type="search"
            id="faq-search-input"
            placeholder="Ej. requisitos, hospitales, datos"
            autocomplete="off"
            class="field pl-12"
          />
        </div>

        <div class="mt-3 flex flex-wrap justify-center gap-2" role="group" aria-label="Filtrar por categoría">
          {categories.map((cat) => (
            <button
              type="button"
              data-category={cat.id}
              aria-pressed={cat.id === 'all' ? 'true' : 'false'}
              class="faq-chip rounded-control border px-3.5 py-2 text-sm font-medium transition-colors duration-200"
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Lista -->
    <div class="mt-14" data-reveal style="--reveal-delay:1">
      <div id="faq-list" class="border-t border-line-strong">
        {faqs.map((item) => (
          <details name="faq" class="faq-item group border-b border-line-strong" data-category={item.category}>
            <summary class="grid cursor-pointer list-none grid-cols-[1fr_auto] items-start gap-6 py-6 text-left lg:grid-cols-12 lg:py-7 [&::-webkit-details-marker]:hidden">
              <span class="text-lg font-semibold leading-snug tracking-[-0.01em] text-ink transition-colors group-hover:text-accent-ink sm:text-xl lg:col-span-8 lg:text-[1.375rem]">
                {item.q}
              </span>
              <span class="mt-0.5 grid size-9 shrink-0 place-items-center justify-self-end rounded-full border border-line-strong text-ink-2 transition-[transform,background-color,border-color,color] duration-300 ease-out group-open:rotate-45 group-open:border-accent group-open:bg-accent group-open:text-white lg:col-span-4">
                <Icon name="plus" class="size-4" />
              </span>
            </summary>
            <div class="pb-8 pr-14">
              <p class="max-w-[68ch] text-[1.0625rem] leading-relaxed text-ink-2">{item.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div id="faq-empty" class="hidden border-b border-line-strong py-12 text-center">
        <p class="font-semibold text-ink">No encontramos preguntas con esos términos</p>
        <p class="mt-1 text-sm text-ink-3">Prueba con otra palabra o escríbenos directamente.</p>
        <button type="button" id="faq-clear" class="btn btn-secondary btn-sm mt-4">Limpiar filtros</button>
      </div>

      <div class="mt-10 flex flex-col items-start justify-between gap-5 rounded-panel bg-surface p-6 sm:flex-row sm:items-center sm:p-7 shadow-sm">
        <div>
          <h3 class="font-semibold text-ink">¿Tienes otra pregunta?</h3>
          <p class="mt-1 text-sm text-ink-2">Nuestro equipo de soporte responde en horario laboral.</p>
        </div>
        <a href="mailto:soporte@blud.app" class="btn btn-secondary shrink-0">
          <Icon name="envelope-simple" class="size-4" />
          Escribir a soporte
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-chip[aria-pressed="false"] {
    background: var(--surface);
    border-color: var(--line-strong);
    color: var(--ink-2);
  }
  .faq-chip[aria-pressed="false"]:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }
  .faq-chip[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--canvas);
  }

  /* Apertura animada donde el navegador lo soporta */
  @supports (interpolate-size: allow-keywords) {
    .faq-item {
      interpolate-size: allow-keywords;
    }
    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 320ms var(--ease-out),
        content-visibility 320ms allow-discrete;
    }
    .faq-item[open]::details-content {
      block-size: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content { transition: none; }
  }

  /* Patrón de puntos optimizado para verse perfectamente */
  .dot-pattern-section {
    position: relative;
    background-color: var(--sunken, #f7f9fa);
  }

  .dot-pattern-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: radial-gradient(color-mix(in srgb, var(--accent) 35%, #000000 15%) 1.5px, transparent 1.5px);
    background-size: 24px 24px;
    background-position: center;
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
  const chips = document.querySelectorAll<HTMLButtonElement>('.faq-chip');
  const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
  const emptyState = document.getElementById('faq-empty');
  const clearBtn = document.getElementById('faq-clear');

  let currentCategory = 'all';

  function filterFaqs() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    let visible = 0;

    items.forEach((item) => {
      const matchesCategory = currentCategory === 'all' || item.dataset.category === currentCategory;
      const matchesQuery = (item.textContent || '').toLowerCase().includes(query);
      const show = matchesCategory && matchesQuery;
      item.classList.toggle('hidden', !show);
      if (!show) item.open = false;
      if (show) visible++;
    });

    emptyState?.classList.toggle('hidden', visible > 0);
  }

  function setCategory(id: string) {
    currentCategory = id;
    chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.category === id)));
    filterFaqs();
  }

  chips.forEach((chip) => chip.addEventListener('click', () => setCategory(chip.dataset.category || 'all')));
  searchInput?.addEventListener('input', filterFaqs);
  clearBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    setCategory('all');
    searchInput?.focus();
  });
</script>