---
// UrgentRequests.astro
interface RequestItem {
  id: string;
  patientName: string;
  bloodType: string;
  hospital: string;
  location: string;
  unitsNeeded: number;
  unitsFulfilled: number;
  urgency: 'Alta' | 'Crítica' | 'Moderada';
  timeAgo: string;
}

const urgentRequests: RequestItem[] = [
  {
    id: "REQ-01",
    patientName: "Paciente A. Mendoza",
    bloodType: "O-",
    hospital: "Hospital Universitario",
    location: "Maracaibo, Zulia",
    unitsNeeded: 3,
    unitsFulfilled: 1,
    urgency: "Crítica",
    timeAgo: "Hace 15 min"
  },
  {
    id: "REQ-02",
    patientName: "Paciente R. Torres",
    bloodType: "A+",
    hospital: "Clínica San Rafael",
    location: "Maracaibo, Zulia",
    unitsNeeded: 2,
    unitsFulfilled: 0,
    urgency: "Alta",
    timeAgo: "Hace 40 min"
  },
  {
    id: "REQ-03",
    patientName: "Paciente B. Colina",
    bloodType: "AB-",
    hospital: "Centro Médico Docente",
    location: "San Francisco, Zulia",
    unitsNeeded: 4,
    unitsFulfilled: 2,
    urgency: "Crítica",
    timeAgo: "Hace 1 hora"
  }
];
---

<section id="urgencias" class="relative py-20 bg-blud-pulse border-t border-white/5">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-blud-brick-ember/40 bg-blud-brick-ember/10 px-3 py-1 text-xs text-blud-brick-ember mb-3">
          <span class="h-2 w-2 rounded-full bg-blud-brick-ember animate-ping"></span>
          Solicitudes Activas
        </div>
        <h2 class="font-sans text-3xl md:text-4xl font-extrabold text-white tracking-tight">
          Solicitudes <span class="text-blud-flag-red">Urgentes</span>
        </h2>
        <p class="mt-2 text-sm md:text-base text-blud-alabaster/80 max-w-xl">
          Pacientes y centros de salud que requieren donantes de manera prioritaria en este momento.
        </p>
      </div>

      <a href="#donar" class="inline-flex items-center gap-2 text-sm font-semibold text-blud-dark-teal hover:text-white transition-colors duration-200">
        Ver todas las solicitudes
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Grid de Tarjetas de Urgencia -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {urgentRequests.map((req) => (
        <article class="relative flex flex-col justify-between rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xs transition-all duration-300 hover:border-blud-brick-ember/40 hover:bg-white/[0.07] hover:-translate-y-1">
          
          <div>
            <!-- Header de la tarjeta -->
            <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
              <span class="font-mono text-xs text-blud-alabaster/60">{req.id} • {req.timeAgo}</span>
              <span class={`px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                req.urgency === 'Crítica' 
                  ? 'bg-blud-brick-ember/20 text-blud-brick-ember border border-blud-brick-ember/30' 
                  : 'bg-amber-500/20 text-amber-400 border border-amber-500/30'
              }`}>
                Nivel {req.urgency}
              </span>
            </div>

            <!-- Información del Paciente y Tipo de Sangre -->
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h3 class="font-sans text-lg font-bold text-white">{req.patientName}</h3>
                <p class="text-xs text-blud-alabaster/70 flex items-center gap-1.5 mt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blud-dark-teal shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                  {req.hospital}
                </p>
                <p class="text-xs text-blud-alabaster/50 ml-5">{req.location}</p>
              </div>

              <!-- Badge con el Tipo de Sangre -->
              <div class="flex flex-col items-center justify-center h-14 w-14 rounded-2xl bg-blud-brick-ember/20 border border-blud-brick-ember/40 text-white font-extrabold text-xl shadow-inner shrink-0">
                {req.bloodType}
              </div>
            </div>

            <!-- Barra de Progreso de Unidades -->
            <div class="mt-4 mb-6">
              <div class="flex justify-between text-xs font-semibold mb-1.5">
                <span class="text-blud-alabaster/70">Unidades requeridas</span>
                <span class="text-white">{req.unitsFulfilled} de {req.unitsNeeded} completadas</span>
              </div>
              <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden">
                <div 
                  class="h-full bg-blud-brick-ember rounded-full transition-all duration-500" 
                  style={`width: ${(req.unitsFulfilled / req.unitsNeeded) * 100}%`}
                ></div>
              </div>
            </div>
          </div>

          <!-- Botón de Respuesta -->
          <a 
            href={`#responder-${req.id}`}
            class="w-full inline-flex items-center justify-center rounded-xl bg-white/10 hover:bg-blud-brick-ember py-3 font-sans text-sm font-semibold text-white transition-all duration-200 border border-white/10 hover:border-blud-brick-ember shadow-md"
          >
            Quiero Donar a este Paciente
          </a>

        </article>
      ))}
    </div>

  </div>
</section>