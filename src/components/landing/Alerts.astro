---
// Alerts.astro - Solicitudes urgentes de sangre.
// Vista pública: solo tipo de sangre, centro y urgencia. Los nombres de pacientes,
// las unidades y el inventario son datos internos que solo gestionan los administradores.
// Datos de ejemplo hasta conectar la API de solicitudes.
import Icon from '../Icon.astro';

interface RequestItem {
  id: string;
  bloodType: string;
  hospital: string;
  location: string;
  urgency: 'Crítica' | 'Alta' | 'Moderada';
  timeAgo: string;
}

const urgentRequests: RequestItem[] = [
  {
    id: "REQ-01",
    bloodType: "O-",
    hospital: "Hospital Universitario",
    location: "Maracaibo, Zulia",
    urgency: "Crítica",
    timeAgo: "Hace 15 min",
  },
  {
    id: "REQ-02",
    bloodType: "A+",
    hospital: "Clínica San Rafael",
    location: "Maracaibo, Zulia",
    urgency: "Alta",
    timeAgo: "Hace 40 min",
  },
  {
    id: "REQ-03",
    bloodType: "AB-",
    hospital: "Centro Médico Docente",
    location: "San Francisco, Zulia",
    urgency: "Crítica",
    timeAgo: "Hace 1 hora",
  },
];

// Quién puede responder a cada solicitud (compatibilidad de glóbulos rojos).
const donorsFor: Record<string, string[]> = {
  "O-": ["O-"],
  "O+": ["O+", "O-"],
  "A-": ["A-", "O-"],
  "A+": ["A+", "A-", "O+", "O-"],
  "B-": ["B-", "O-"],
  "B+": ["B+", "B-", "O+", "O-"],
  "AB-": ["AB-", "A-", "B-", "O-"],
  "AB+": ["AB+", "AB-", "A+", "A-", "B+", "B-", "O+", "O-"],
};

const pretty = (t: string) => t.replace('-', '−');
const spoken = (t: string) => t.replace('-', ' negativo').replace('+', ' positivo');
---

<section id="urgencias" class="border-y border-line bg-sunken py-24 lg:py-28">
  <div class="container-blud">
    <div class="max-w-3xl" data-reveal>
      <h2 class="section-title">Solicitudes urgentes</h2>
      <p class="section-lead">
        Centros de salud que necesitan donantes ahora mismo. Si tu tipo de sangre coincide, puedes
        responder en un par de pasos.
      </p>
    </div>

    <div class="panel mt-12 overflow-hidden" data-reveal>
      <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-4 sm:px-7">
        <p class="inline-flex items-center gap-2.5 text-sm font-semibold text-ink">
          <span class="live-dot text-accent" aria-hidden="true"></span>
          {urgentRequests.length} solicitudes activas
        </p>
        <p class="hidden font-mono text-xs text-ink-3 sm:block">Maracaibo y San Francisco</p>
      </div>

      <ul class="divide-y divide-line">
        {urgentRequests.map((req) => (
            <li class="grid grid-cols-[auto_1fr] items-center gap-x-5 gap-y-5 px-5 py-6 transition-colors hover:bg-canvas/60 sm:px-7 lg:grid-cols-[4rem_minmax(0,1.1fr)_minmax(0,1fr)_9.5rem_auto] lg:gap-x-8">
              <span
                class="grid size-16 place-items-center rounded-control bg-accent text-2xl font-extrabold tracking-[-0.04em] text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.2)]"
                aria-label={`Tipo ${spoken(req.bloodType)}`}
              >
                {pretty(req.bloodType)}
              </span>

              <div class="min-w-0">
                <h3 class="flex items-center gap-2 text-lg font-bold tracking-[-0.02em] text-ink">
                  <Icon name="hospital" class="size-5 shrink-0 text-ink-3" />
                  <span class="lg:truncate">{req.hospital}</span>
                </h3>
                <p class="mt-1 text-sm text-ink-3">{req.location}</p>
              </div>

              <div class="col-span-2 lg:col-span-1">
                <p class="text-xs font-medium text-ink-3">Pueden responder donantes</p>
                <ul class="mt-1.5 flex flex-wrap gap-1" aria-label="Tipos de sangre que pueden responder">
                  {donorsFor[req.bloodType].map((type) => (
                    <li class="rounded-md border border-line px-1.5 py-0.5 font-mono text-xs font-semibold text-ink-2" aria-label={spoken(type)}>
                      {pretty(type)}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="col-span-2 flex items-center gap-3 lg:col-span-1 lg:flex-col lg:items-start lg:gap-1.5">
                <span
                  class:list={[
                    'inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-bold',
                    req.urgency === 'Crítica' ? 'bg-accent-soft text-accent-ink' : 'bg-warn-soft text-warn',
                  ]}
                >
                  <Icon name="siren" class="size-3.5" />
                  Urgencia {req.urgency.toLowerCase()}
                </span>
                <span class="inline-flex items-center gap-1.5 text-xs text-ink-3">
                  <Icon name="clock" class="size-3.5" />
                  {req.timeAgo}
                </span>
              </div>

              <a
                href="/register"
                class="btn btn-secondary col-span-2 w-full lg:col-span-1 lg:w-auto"
                aria-label={`Responder a la solicitud de sangre ${spoken(req.bloodType)} en ${req.hospital}`}
              >
                Responder
                <Icon name="arrow-right" class="size-4" />
              </a>
            </li>
        ))}
      </ul>
    </div>

    <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-2" data-reveal>
      ¿Ya eres donante?
      <a href="/login" class="link-arrow">
        Ver todas las solicitudes de tu zona
        <Icon name="arrow-right" class="size-4" />
      </a>
    </p>
  </div>
</section>
