---
// Map.astro - Vista previa de los centros en la portada: franja de mapa estática
// con una tarjeta encima. Todo lleva a /centros, donde vive el mapa interactivo.
// Leaflet se carga solo cuando la franja está por entrar en pantalla.
import Icon from '../Icon.astro';
import { centers } from '../../data/centers';
import '../../styles/map.css';

const cities = new Set(centers.map((c) => c.city)).size;
---

<section id="centros" data-centers={JSON.stringify(centers)}>
  <div class="container-blud">
    <div class="centers-preview group relative isolate overflow-hidden rounded-panel border border-line bg-sunken" data-reveal>
      <!-- Mapa de fondo, solo decorativo: sin zoom ni arrastre -->
      <div class="relative h-56 sm:absolute sm:inset-0 sm:h-auto" aria-hidden="true">
        <div id="blud-map" class="blud-map pointer-events-none absolute inset-0"></div>
        <div id="map-skeleton" class="skeleton absolute inset-0"></div>
      </div>

      <!-- Toda la franja lleva a /centros; el botón de la tarjeta es el enlace accesible -->
      <a href="/centros" class="absolute inset-0 z-[450]" tabindex="-1" aria-hidden="true"></a>

      <!-- Tarjeta -->
      <div class="pointer-events-none relative z-[500] p-4 sm:flex sm:min-h-[22rem] sm:items-center sm:p-8 lg:min-h-[24rem] lg:p-10">
        <div class="preview-card panel p-6 sm:max-w-sm sm:p-7">
          <h2 class="text-2xl font-bold leading-tight tracking-[-0.03em] text-ink sm:text-[1.75rem]">
            {centers.length} centros de donación
          </h2>
          <p class="mt-2 leading-relaxed text-ink-2">
            Bancos de sangre, hospitales y clínicas en {cities === 2 ? 'Maracaibo y San Francisco' : 'la región'}.
            Mira cuáles están abiertos, cómo llegar y agenda tu cita.
          </p>
          <p class="mt-4 flex items-center gap-2 text-sm font-medium text-ok" data-open-count hidden>
            <span class="live-dot" aria-hidden="true"></span>
            <span></span>
          </p>
          <a href="/centros" class="btn btn-primary pointer-events-auto mt-6 w-full sm:w-auto">
            Ver mapa completo
            <Icon name="arrow-right" class="preview-arrow size-5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .centers-preview {
    transition: border-color 200ms ease;
  }
  .preview-card {
    transition: transform 300ms var(--ease-out), box-shadow 300ms ease;
  }
  .preview-card :global(.preview-arrow) {
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) {
    .centers-preview:hover {
      border-color: var(--line-strong);
    }
    .centers-preview:hover .preview-card {
      transform: translateY(-3px);
    }
    .centers-preview:hover .preview-card :global(.preview-arrow) {
      transform: translateX(3px);
    }
  }
  /* Los controles de Leaflet no hacen falta en una vista previa. */
  .centers-preview :global(.leaflet-control-container .leaflet-top) {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .centers-preview:hover .preview-card { transform: none; }
  }
</style>

<script>
  import { centerIcon, createMap, loadLeaflet, openStatus, whenNearViewport } from '../../lib/map';
  import type { HealthCenter } from '../../data/centers';

  const section = document.getElementById('centros');
  const centers: HealthCenter[] = JSON.parse(section?.dataset.centers || '[]');
  const mapEl = document.getElementById('blud-map');
  const skeleton = document.getElementById('map-skeleton');
  const openCount = section?.querySelector<HTMLElement>('[data-open-count]');

  // Cuántos centros están abiertos según la hora local del visitante.
  if (openCount) {
    const open = centers.filter((c) => openStatus(c).open).length;
    openCount.querySelector('span:last-child')!.textContent =
      open === 1 ? '1 abierto ahora' : `${open} abiertos ahora`;
    openCount.hidden = open === 0;
  }

  if (mapEl) {
    whenNearViewport(mapEl, () =>
      loadLeaflet()
        .then((L) => {
          const map = createMap(L, mapEl, { zoom: 12 });
          [map.dragging, map.touchZoom, map.doubleClickZoom, map.scrollWheelZoom, map.boxZoom, map.keyboard].forEach(
            (handler) => handler?.disable()
          );
          map.off('focus click');
          centers.forEach((c) => L.marker(c.coords, { icon: centerIcon(L), keyboard: false, interactive: false }).addTo(map));

          // En pantallas anchas la tarjeta tapa la izquierda: los pines se centran a la derecha.
          const wide = window.matchMedia('(min-width: 640px)').matches;
          map.fitBounds(L.latLngBounds(centers.map((c) => c.coords)), {
            paddingTopLeft: [wide ? Math.min(mapEl.clientWidth * 0.45, 460) : 24, 32],
            paddingBottomRight: [32, 32],
            maxZoom: 14,
            animate: false,
          });
          skeleton?.remove();
        })
        .catch(() => skeleton?.classList.remove('skeleton'))
    );
  }
</script>
