---
// CustomCursor.astro
// variant="arrow" → cursor clásico rojo con borde blanco (por defecto)
// variant="drop"  → gota de sangre
interface Props {
  variant?: 'arrow' | 'drop';
  size?: number;
}

const { variant = 'arrow', size = 26 } = Astro.props;

// Punto exacto que "hace clic" (la punta), en coordenadas del viewBox 24x24
const hot = variant === 'drop' ? { x: 12, y: 2.5 } : { x: 5.5, y: 3.2 };
const k = size / 24;
const hx = +(hot.x * k).toFixed(2);
const hy = +(hot.y * k).toFixed(2);
---

<div id="custom-cursor" class="blud-cursor" popover="manual" aria-hidden="true" data-on="false" data-hover="false" data-down="false">
  <svg
    class="blud-cursor-svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    style={`left:${-hx}px;top:${-hy}px;transform-origin:${hx}px ${hy}px`}
    focusable="false"
  >
    {variant === 'drop' ? (
      <>
        <path d="M12 2.5S5.5 10 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10 12 2.5 12 2.5z" />
        <path d="M9 14.2a3.2 3.2 0 0 0 2.2 2.9" fill="none" stroke="#fff" stroke-opacity="0.65" stroke-width="1.4" stroke-linecap="round" />
      </>
    ) : (
      <path d="M5.5 3.2v16.2l4.1-3.8 2.8 6.2 2.6-1.2-2.8-6 5.6-.2z" />
    )}
  </svg>
</div>

<style is:global>
  /* El cursor nativo solo se oculta cuando el script confirma que el custom está activo.
     Así, si el JS falla, nunca te quedas sin cursor. */
  html.has-blud-cursor,
  html.has-blud-cursor * {
    cursor: none !important;
  }

  @media (pointer: coarse) {
    .blud-cursor {
      display: none !important;
    }
  }

  .blud-cursor {
    /* Reset de los estilos por defecto de [popover] */
    position: fixed;
    inset: auto;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    pointer-events: none;

    z-index: 2147483647;
    opacity: 0;
    will-change: transform;
    transition: opacity 180ms ease;
    --cur-fill: var(--color-blud-flag-red, var(--accent, #e53e3e));
  }

  .blud-cursor[data-on="true"] {
    opacity: 1;
  }

  .blud-cursor-svg {
    position: absolute;
    overflow: visible;
    fill: var(--cur-fill);
    stroke: #fff; /* borde blanco: se ve sobre cualquier fondo, incluso rojo */
    stroke-width: 1.6;
    stroke-linejoin: round;
    paint-order: stroke fill;
    filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.35));
    transition:
      transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1),
      fill 160ms ease;
  }

  /* Sobre elementos clicables: crece suavemente y se oscurece un poco */
  .blud-cursor[data-hover="true"] {
    --cur-fill: var(--color-blud-oxblood, var(--accent-strong, #b91c1c));
  }
  .blud-cursor[data-hover="true"] .blud-cursor-svg {
    transform: scale(1.14);
  }

  /* Al hacer clic */
  .blud-cursor[data-down="true"] .blud-cursor-svg {
    transform: scale(0.88);
  }

  @media (prefers-reduced-motion: reduce) {
    .blud-cursor,
    .blud-cursor-svg {
      transition: none;
    }
  }
</style>

<script>
  type Pos = { x: number; y: number };
  const w = window as unknown as { __bludCursorCtl?: AbortController; __bludCursorPos?: Pos };

  const HOVERABLE =
    'a[href], button, summary, select, label, input, textarea, [role="button"], [data-cursor-hover], .cursor-pointer, .type-tile, .dropdown-option, .matrix-btn';

  function initCustomCursor() {
    // Evita listeners duplicados (carga inicial + astro:page-load)
    w.__bludCursorCtl?.abort();

    const root = document.documentElement;
    const el = document.getElementById('custom-cursor');
    root.classList.remove('has-blud-cursor');
    if (!el || !window.matchMedia('(pointer: fine)').matches) return;

    const ctl = new AbortController();
    w.__bludCursorCtl = ctl;
    const { signal } = ctl;

    // --- Capa superior: los <dialog> modales quedan por encima de cualquier z-index,
    //     así que el cursor se "re-promueve" cada vez que se abre uno.
    const pop = el as HTMLElement & { showPopover?: () => void; hidePopover?: () => void };
    const promote = () => {
      if (typeof pop.showPopover !== 'function') return;
      try { pop.hidePopover?.(); } catch {}
      try { pop.showPopover(); } catch {}
    };
    promote();

    const mo = new MutationObserver((muts) => {
      for (const m of muts) {
        if (m.target instanceof HTMLDialogElement && m.target.open) {
          promote();
          break;
        }
      }
    });
    mo.observe(document.body, { subtree: true, attributes: true, attributeFilter: ['open'] });

    document.addEventListener(
      'toggle',
      (e) => {
        if (e.target !== el && (e as Event & { newState?: string }).newState === 'open') promote();
      },
      { capture: true, signal }
    );

    // --- Posición (sin retraso: el cursor siempre está exactamente donde apunta el mouse)
    let x = w.__bludCursorPos?.x ?? -100;
    let y = w.__bludCursorPos?.y ?? -100;
    let raf = 0;

    const paint = () => {
      raf = 0;
      el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    };

    if (w.__bludCursorPos) {
      paint();
      el.dataset.on = 'true';
    }

    document.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType === 'touch') {
          el.dataset.on = 'false';
          return;
        }
        x = e.clientX;
        y = e.clientY;
        w.__bludCursorPos = { x, y };
        if (!raf) raf = requestAnimationFrame(paint);
        if (el.dataset.on !== 'true') el.dataset.on = 'true';
      },
      { passive: true, signal }
    );

    // --- Estado hover: se recalcula en cada cambio de elemento (sin "quitar" clases a mano,
    //     así no puede quedar pegado ni desincronizarse)
    document.addEventListener(
      'pointerover',
      (e) => {
        const hit = (e.target as Element | null)?.closest?.(HOVERABLE);
        const on = !!hit && !hit.matches(':disabled, [aria-disabled="true"]');
        el.dataset.hover = String(on);
      },
      { signal }
    );

    // --- Clic
    const down = (v: boolean) => () => (el.dataset.down = String(v));
    document.addEventListener('pointerdown', down(true), { signal });
    document.addEventListener('pointerup', down(false), { signal });
    document.addEventListener('pointercancel', down(false), { signal });
    document.addEventListener('dragend', down(false), { signal });
    window.addEventListener('blur', down(false), { signal });

    // --- Salir / entrar a la ventana
    root.addEventListener('mouseleave', () => (el.dataset.on = 'false'), { signal });
    root.addEventListener('mouseenter', () => {
      if (w.__bludCursorPos) el.dataset.on = 'true';
    }, { signal });

    // Todo listo: ahora sí se oculta el cursor nativo
    root.classList.add('has-blud-cursor');

    signal.addEventListener('abort', () => {
      mo.disconnect();
      if (raf) cancelAnimationFrame(raf);
      root.classList.remove('has-blud-cursor');
    });
  }

  initCustomCursor();
  document.addEventListener('astro:page-load', initCustomCursor);
</script>