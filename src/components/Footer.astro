---
// Footer.astro - Pie de página de BLUD
// `compact`: una sola línea, para páginas de pantalla completa como /centros.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { infoTopics, infoHref } from '../data/info';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: "/#urgencias", label: "Solicitudes urgentes" },
  { href: "/#compatibilidad", label: "Compatibilidad" },
  { href: "/elegibilidad", label: "Test de elegibilidad" },
  { href: "/centros", label: "Mapa de centros" },
  { href: "/#faq", label: "Preguntas frecuentes" },
];

const infoLinks = infoTopics.map((t) => ({ href: infoHref(t.slug), label: t.title }));

const legalLinks = [
  { href: "/privacidad", label: "Privacidad" },
  { href: "/terminos", label: "Términos" },
  { href: "/privacidad#datos-de-salud", label: "Datos médicos" },
];
---

{compact ? (
  <footer class="footer-compact bg-night text-white">
    <div class="container-blud flex flex-wrap items-center gap-x-6 gap-y-1.5 pb-20 pt-3 text-xs text-white/55 sm:pb-3 sm:pr-24 lg:h-full lg:flex-nowrap lg:py-0">
      <a href="/" class="text-sm font-extrabold tracking-[-0.03em] text-white" aria-label="BLUD, ir al inicio">
        BLUD<span class="text-[#F2605A]">.</span>
      </a>
      <p>© {currentYear} BLUD</p>
      <nav aria-label="Enlaces legales">
        <ul class="flex gap-4">
          {legalLinks.slice(0, 2).map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-white">{link.label}</a></li>
          ))}
          <li><a href="mailto:soporte@blud.app" class="transition-colors hover:text-white">Soporte</a></li>
        </ul>
      </nav>
      <p class="flex items-center gap-1.5 lg:ml-auto">
        <Icon name="first-aid-kit" class="size-4 shrink-0 text-[#F2605A]" />
        Emergencia médica:{' '}
        <a href="tel:911" class="font-semibold text-white underline underline-offset-2">911</a>
      </p>
    </div>
  </footer>
) : (
  <footer class="relative isolate overflow-hidden bg-night text-white">
    <div class="grain absolute inset-0 -z-10" aria-hidden="true"></div>

    <div class="container-blud grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-6">
      <div class="sm:col-span-2 lg:col-span-3">
        <Logo tone="light" />
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-white/60">
          Conectamos donantes voluntarios con pacientes y bancos de sangre en tiempo real.
        </p>
      </div>

      <nav class="lg:col-span-2" aria-label="Enlaces del sitio">
        <h2 class="text-sm font-semibold text-white">Plataforma</h2>
        <ul class="mt-2.5 flex flex-col gap-1.5 text-sm text-white/60">
          {quickLinks.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-white">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="lg:col-span-3" aria-label="Infórmate">
        <h2 class="text-sm font-semibold text-white">Infórmate</h2>
        <ul class="mt-2.5 flex flex-col gap-1.5 text-sm text-white/60">
          {infoLinks.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-white">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label="Enlaces legales">
        <h2 class="text-sm font-semibold text-white">Legal</h2>
        <ul class="mt-2.5 flex flex-col gap-1.5 text-sm text-white/60">
          {legalLinks.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-white">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div id="contacto" class="lg:col-span-2">
        <h2 class="text-sm font-semibold text-white">Contacto</h2>
        <a
          href="mailto:soporte@blud.app"
          class="mt-2.5 inline-flex items-center gap-2 text-sm text-white/80 transition-colors hover:text-white"
        >
          <Icon name="envelope-simple" class="size-4 text-white/50" />
          soporte@blud.app
        </a>
        <p class="mt-1.5 text-sm leading-relaxed text-white/60">
          ¿Eres un centro de salud? Escríbenos para integrarte a la red.
        </p>
      </div>
    </div>

    <div class="border-t border-white/10">
      <div class="container-blud flex flex-col gap-2 pb-24 pt-4 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between sm:py-4 sm:pr-24">
        <p>© {currentYear} BLUD. Todos los derechos reservados.</p>
        <p class="flex items-start gap-1.5">
          <Icon name="first-aid-kit" class="size-4 shrink-0 text-[#F2605A]" />
          <span>
            Emergencia médica: acude al centro más cercano o llama al{' '}
            <a href="tel:911" class="font-semibold text-white underline underline-offset-2">911</a>
          </span>
        </p>
      </div>
    </div>
  </footer>
)}

<style>
  /* Altura fija en escritorio: /centros la descuenta para ocupar justo la ventana. */
  @media (min-width: 1024px) {
    .footer-compact { height: var(--footer-compact-h, 3.25rem); }
  }
</style>
