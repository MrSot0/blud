---
// Estructura compartida de las páginas de acceso: formulario a la izquierda,
// panel de marca con foto a la derecha (solo en pantallas grandes).
import Icon from '../Icon.astro';

interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;

const photo = "https://images.unsplash.com/photo-1615461066841-6116e61058f4";
const src = (w: number) => `${photo}?q=70&w=${w}&auto=format&fit=crop`;

const benefits = [
  { icon: 'bell-ringing', text: 'Te avisamos solo cuando tu tipo de sangre hace falta cerca de ti.' },
  { icon: 'map-pin', text: 'Centros verificados en Maracaibo y San Francisco.' },
  { icon: 'shield-check', text: 'Tus datos médicos solo los ven los centros que elijas.' },
] as const;
---

<section class="grid min-h-[calc(100dvh-var(--header-h))] lg:grid-cols-2">
  <div class="flex items-center justify-center px-4 py-14 sm:px-8 lg:py-20">
    <div class="w-full min-w-0 max-w-md">
      <h1 class="text-[2.25rem] font-bold leading-[1.05] tracking-[-0.04em] text-ink sm:text-[2.75rem]">{title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-ink-2">{subtitle}</p>
      <div class="mt-10">
        <slot />
      </div>
    </div>
  </div>

  <aside class="relative isolate hidden overflow-hidden bg-blud-shadow-grey text-white lg:flex lg:flex-col lg:justify-end lg:p-14 xl:p-16">
    <img
      src={src(1200)}
      srcset={`${src(800)} 800w, ${src(1200)} 1200w`}
      sizes="50vw"
      alt=""
      loading="lazy"
      decoding="async"
      class="absolute inset-0 -z-10 size-full object-cover object-[65%_center]"
    />
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(26_32_44/0.35)_0%,rgb(26_32_44/0.75)_45%,#1A202C_100%)]" aria-hidden="true"></div>
    <div class="grain absolute inset-0 -z-10" aria-hidden="true"></div>

    <p class="max-w-md text-3xl font-bold leading-[1.12] tracking-[-0.035em]">
      Una donación puede ayudar hasta a tres personas.
    </p>
    <ul class="mt-8 flex max-w-md flex-col gap-4">
      {benefits.map((b) => (
        <li class="flex gap-3 text-white/80">
          <Icon name={b.icon} class="mt-0.5 size-5 shrink-0 text-[#F2605A]" />
          <span class="leading-relaxed">{b.text}</span>
        </li>
      ))}
    </ul>
  </aside>
</section>