---
import Icon from '../Icon.astro';

interface Props {
  id: string;
  name: string;
  autocomplete: 'current-password' | 'new-password';
  placeholder?: string;
  describedby?: string;
}

const { id, name, autocomplete, placeholder, describedby } = Astro.props;
---

<div class="relative">
  <input
    type="password"
    id={id}
    name={name}
    autocomplete={autocomplete}
    placeholder={placeholder}
    aria-describedby={describedby}
    class="field pr-12"
  />
  <button
    type="button"
    data-toggle-password={id}
    aria-label="Mostrar contraseña"
    aria-pressed="false"
    class="absolute right-1.5 top-1/2 grid size-10 -translate-y-1/2 place-items-center rounded-lg text-ink-3 transition-colors hover:bg-sunken hover:text-ink"
  >
    <span class="eye-open"><Icon name="eye" class="size-5" /></span>
    <span class="eye-closed hidden"><Icon name="eye-slash" class="size-5" /></span>
  </button>
</div>
