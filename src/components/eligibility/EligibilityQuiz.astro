---
// Test de elegibilidad: una pregunta a la vez, con temas, progreso y regreso.
import Icon from '../Icon.astro';
import { categories, questions } from '../../data/eligibility';

const countByCategory = Object.fromEntries(
  categories.map((c) => [c.id, questions.filter((q) => q.category === c.id).length])
);
---

<section class="stripe-quiz-section relative isolate py-12 lg:py-20">
  <div class="container-blud relative z-10">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12 items-start">
      
      <!-- Sidebar / Temas del test -->
      <aside class="hidden lg:col-span-4 lg:block">
        <div class="lg:sticky lg:top-28 panel p-6 backdrop-blur-md bg-surface/90 border-line-strong">
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-line">
            <h2 class="text-xs font-bold uppercase tracking-wider text-ink-3">Categorías evaluadas</h2>
            <span class="inline-flex items-center gap-1 rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-semibold text-accent-ink">
              {questions.length} preguntas
            </span>
          </div>
          
          <ol class="flex flex-col gap-2" id="quiz-topics">
            {categories.map((cat, i) => (
              <li
                data-topic={cat.id}
                data-state={i === 0 ? 'current' : 'todo'}
                class="topic group flex items-center gap-3.5 rounded-control p-3 text-sm transition-all duration-200"
              >
                <span class="topic-mark grid size-7 shrink-0 place-items-center rounded-full border text-xs font-bold tabular transition-transform duration-200 group-hover:scale-105">
                  <span class="topic-num">{i + 1}</span>
                  <span class="topic-check hidden"><Icon name="check" class="size-3.5 stroke-[3]" /></span>
                </span>
                <span class="topic-label flex-1 font-medium transition-colors duration-200">{cat.label}</span>
                <span class="topic-count text-xs font-semibold text-ink-3 tabular px-2 py-0.5 rounded-md bg-sunken">{countByCategory[cat.id]}</span>
              </li>
            ))}
          </ol>
        </div>
      </aside>

      <!-- Panel Principal del Quiz -->
      <div class="lg:col-span-8">
        <div class="panel scroll-mt-24 overflow-hidden shadow-xl border-line-strong bg-surface" id="quiz" data-questions={JSON.stringify(questions)} data-categories={JSON.stringify(categories)}>
          
          <!-- Encabezado de Progreso -->
          <div id="quiz-progress" class="border-b border-line bg-sunken/40 px-6 py-5 sm:px-9">
            <div class="flex items-center justify-between text-sm">
              <div class="flex items-center gap-2">
                <span class="size-2 rounded-full bg-accent animate-pulse"></span>
                <p id="quiz-step-label" class="font-bold text-ink" aria-live="polite">
                  Pregunta 1 de {questions.length}
                </p>
              </div>
              
              <button
                type="button"
                id="quiz-back"
                class="inline-flex items-center gap-1.5 rounded-control border border-line bg-surface px-3 py-1.5 text-xs font-semibold text-ink-2 transition-all hover:border-line-strong hover:bg-sunken hover:text-ink disabled:pointer-events-none disabled:opacity-30 shadow-xs"
                disabled
              >
                <Icon name="arrow-left" class="size-3.5" />
                Anterior
              </button>
            </div>

            <!-- Barra de progreso -->
            <div class="mt-4 h-2 overflow-hidden rounded-full bg-line" aria-hidden="true">
              <div id="quiz-bar" class="quiz-bar h-full origin-left rounded-full bg-gradient-to-r from-accent to-accent-strong shadow-xs" style="transform: scaleX(0)"></div>
            </div>
          </div>

          <!-- Cuerpo de la pregunta -->
          <div id="quiz-body" class="px-6 py-8 sm:px-10 sm:py-10">
            <noscript>
              <div class="rounded-control bg-warn-soft p-4 text-warn font-medium text-sm">
                Activa JavaScript en tu navegador para realizar el test interactivo de elegibilidad.
              </div>
            </noscript>
          </div>

          <!-- Pantalla de Resultados -->
          <div id="quiz-result" class="hidden px-6 py-8 sm:px-10 sm:py-10"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Fondo con patrón de líneas diagonales (stripes) */
  .stripe-quiz-section {
    position: relative;
    background-color: var(--canvas);
  }

  .stripe-quiz-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--accent) 7%, transparent),
      color-mix(in srgb, var(--accent) 7%, transparent) 2px,
      transparent 2px,
      transparent 18px
    );
  }

  /* Animación barra de progreso */
  .quiz-bar {
    transition: transform 420ms var(--ease-out);
  }

  /* Estilos interactivos de la lista de temas (Sidebar) */
  .topic { 
    color: var(--ink-3); 
    background-color: transparent;
    border: 1px solid transparent;
  }
  .topic .topic-mark { 
    border-color: var(--line-strong); 
    background-color: var(--sunken);
    color: var(--ink-2);
  }
  
  /* Estado Activo / En curso */
  .topic[data-state="current"] { 
    background: var(--surface); 
    color: var(--ink); 
    font-weight: 600; 
    border-color: var(--line-strong);
    box-shadow: 0 4px 12px -2px color-mix(in srgb, var(--shadow-tint) / 0.08); 
  }
  .topic[data-state="current"] .topic-mark { 
    border-color: var(--accent); 
    background-color: var(--accent-soft);
    color: var(--accent-ink); 
  }
  .topic[data-state="current"] .topic-count {
    background-color: var(--accent-soft);
    color: var(--accent-ink);
  }

  /* Estado Completado */
  .topic[data-state="done"] { 
    color: var(--ink-2); 
  }
  .topic[data-state="done"] .topic-mark { 
    background: var(--accent); 
    border-color: var(--accent); 
    color: #ffffff; 
  }
  .topic[data-state="done"] .topic-num { display: none; }
  .topic[data-state="done"] .topic-check { display: grid; }

  /* Animaciones de cambio de pregunta */
  :global(.quiz-enter) { animation: quiz-enter 320ms var(--ease-out) both; }
  :global(.quiz-enter-back) { animation: quiz-enter-back 320ms var(--ease-out) both; }

  @keyframes quiz-enter {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes quiz-enter-back {
    from { opacity: 0; transform: translateX(-20px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.quiz-enter), :global(.quiz-enter-back) { animation: none; }
    .quiz-bar { transition: none; }
  }
</style>

<script>
  import { iconSvg } from '../../lib/icons';
  import type { CategoryId, Option, Question } from '../../data/eligibility';

  const quiz = document.getElementById('quiz');
  const questions: Question[] = JSON.parse(quiz?.dataset.questions || '[]');
  const categories: { id: CategoryId; label: string }[] = JSON.parse(quiz?.dataset.categories || '[]');

  const body = document.getElementById('quiz-body');
  const result = document.getElementById('quiz-result');
  const progress = document.getElementById('quiz-progress');
  const stepLabel = document.getElementById('quiz-step-label');
  const bar = document.getElementById('quiz-bar');
  const backBtn = document.getElementById('quiz-back') as HTMLButtonElement | null;
  const topics = document.querySelectorAll<HTMLElement>('[data-topic]');

  let step = 0;
  const answers: (number | undefined)[] = [];

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  const categoryLabel = (id: CategoryId) => categories.find((c) => c.id === id)?.label ?? '';

  function updateTopics(finished = false) {
    const order = categories.map((c) => c.id);
    const currentIndex = finished ? order.length : order.indexOf(questions[step].category);
    topics.forEach((topic) => {
      const i = order.indexOf(topic.dataset.topic as CategoryId);
      topic.dataset.state = i < currentIndex ? 'done' : i === currentIndex ? 'current' : 'todo';
    });
  }

  function updateProgress() {
    if (stepLabel) stepLabel.textContent = `Pregunta ${step + 1} de ${questions.length}`;
    if (backBtn) backBtn.disabled = step === 0;
    if (bar) bar.style.transform = `scaleX(${(step + 1) / questions.length})`;
    updateTopics();
  }

  function keepQuizInView() {
    if (!quiz) return;
    if (quiz.getBoundingClientRect().top < 64) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      quiz.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }
  }

  function renderQuestion(direction: 'forward' | 'back' = 'forward', moveFocus = false) {
    if (!body) return;
    const q = questions[step];
    updateProgress();

    body.innerHTML = `
      <div class="${direction === 'back' ? 'quiz-enter-back' : 'quiz-enter'}">
        <div class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 text-xs font-bold text-accent-ink">
          <span>${escapeHtml(categoryLabel(q.category))}</span>
        </div>

        <h3 id="quiz-question" tabindex="-1" class="mt-4 text-2xl font-bold leading-snug tracking-tight text-ink focus:outline-none sm:text-3xl">
          ${escapeHtml(q.title)}
        </h3>
        
        <p class="mt-2.5 max-w-[62ch] text-base leading-relaxed text-ink-2">${escapeHtml(q.description)}</p>
        
        <div class="mt-8 grid gap-3.5" role="group" aria-labelledby="quiz-question">
          ${q.options
            .map((opt, idx) => {
              const selected = answers[step] === idx;
              return `
                <button
                  type="button"
                  data-option="${idx}"
                  aria-pressed="${selected}"
                  class="group relative flex w-full items-center gap-4 rounded-control border p-4 sm:p-5 text-left transition-all duration-200 active:scale-[0.995] ${
                    selected
                      ? 'border-accent bg-accent-soft/60 shadow-sm ring-1 ring-accent'
                      : 'border-line-strong bg-surface hover:border-ink-3 hover:bg-sunken/40 hover:shadow-sm'
                  }"
                >
                  <span class="grid size-5 shrink-0 place-items-center rounded-full border-2 transition-all duration-200 ${
                    selected ? 'border-accent bg-accent scale-110' : 'border-line-strong group-hover:border-ink-3'
                  }">
                    <span class="size-2 rounded-full ${selected ? 'bg-white' : 'bg-transparent'}"></span>
                  </span>
                  <span class="font-semibold text-base leading-snug text-ink flex-1">${escapeHtml(opt.label)}</span>${iconSvg('arrow-right', 'size-4 opacity-0 -translate-x-2 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0 text-ink-3')}
                </button>`;
            })
            .join('')}
        </div>
      </div>
    `;

    body.querySelectorAll<HTMLButtonElement>('[data-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        answers[step] = Number(btn.dataset.option);
        if (step < questions.length - 1) {
          step++;
          renderQuestion('forward', true);
        } else {
          showResult();
        }
      });
    });

    if (moveFocus) {
      body.querySelector<HTMLElement>('#quiz-question')?.focus({ preventScroll: true });
      keepQuizInView();
    }
  }

  const listItem = (title: string, text: string, badge?: string, tone: 'warn' | 'ok' = 'warn') => `
    <li class="py-4 first:pt-0 last:pb-0">
      <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
        <h4 class="font-bold text-ink text-base">${escapeHtml(title)}</h4>
        ${
          badge
            ? `<span class="inline-flex max-w-full items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold ${
                tone === 'warn' ? 'bg-warn-soft text-warn' : 'bg-ok-soft text-ok'
              }">${iconSvg('clock', 'size-3.5 shrink-0')}<span>${escapeHtml(badge)}</span></span>`
            : ''
        }
      </div>
      <p class="mt-1.5 max-w-[65ch] text-sm leading-relaxed text-ink-2">${escapeHtml(text)}</p>
    </li>`;

  function showResult() {
    if (!body || !result || !progress) return;

    const chosen = questions.map((q, i) => ({ q, opt: q.options[answers[i] ?? 0] as Option }));
    const reasons = chosen.filter(({ opt }) => !opt.eligible);
    const notes = chosen.filter(({ opt }) => opt.eligible && opt.note);
    const eligible = reasons.length === 0;

    body.classList.add('hidden');
    progress.classList.add('hidden');
    result.classList.remove('hidden');
    updateTopics(true);

    const reasonsHtml = reasons
      .map(({ opt }) => listItem(opt.reasonTitle || 'Motivo de espera', opt.medicalReason || '', opt.timeframe))
      .join('');
    const notesHtml = notes.map(({ q, opt }) => listItem(q.title, opt.note || '')).join('');

    const tips = [
      'Duerme bien la noche anterior (mínimo 6 horas).',
      'Come algo ligero y sin grasa antes de acudir.',
      'Mantente bien hidratado, bebe suficiente agua.',
      'Lleva tu documento de identidad vigente.',
    ];

    result.innerHTML = `
      <div class="quiz-enter">
        <div class="flex items-center gap-4">
          <span class="grid size-14 place-items-center rounded-panel ${eligible ? 'bg-ok-soft text-ok' : 'bg-warn-soft text-warn'} shadow-xs">
            ${iconSvg(eligible ? 'check-circle' : 'warning-circle', 'size-8')}
          </span>
          <div>
            <span class="text-xs font-bold tracking-wider uppercase text-ink-3">Evaluación preliminar</span>
            <h3 id="quiz-result-title" tabindex="-1" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink focus:outline-none">
              ${eligible ? '¡Puedes ser candidato a donar!' : 'Por ahora no es recomendable donar'}
            </h3>
          </div>
        </div>

        <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-ink-2">
          ${
            eligible
              ? 'Tus respuestas cumplen los criterios básicos de elegibilidad. El siguiente paso es agendar tu cita o acudir a un centro autorizado donde el personal médico realizará la verificación final.'
              : `Según tus respuestas, hemos detectado ${reasons.length === 1 ? 'un motivo' : `${reasons.length} motivos`} por los que debes diferir tu donación temporalmente:`
          }
        </p>

        ${eligible ? '' : `<div class="mt-6 rounded-control border border-line bg-sunken/30 p-5"><ul class="divide-y divide-line">${reasonsHtml}</ul></div>`}

        ${
          notes.length
            ? `<div class="mt-6 rounded-control border border-line bg-sunken/30 p-5">
                 <h4 class="text-xs font-bold uppercase tracking-wider text-ink-3 mb-3">Notas para comentar con el personal médico</h4>
                 <ul class="divide-y divide-line">${notesHtml}</ul>
               </div>`
            : ''
        }

        ${
          eligible
            ? `<div class="mt-6 rounded-control border border-line-strong bg-sunken/40 p-6">
                 <h4 class="text-sm font-bold text-ink">Recomendaciones para tu donación</h4>
                 <ul class="mt-3 grid gap-3 text-sm text-ink-2 sm:grid-cols-2">
                   ${tips.map((t) => `<li class="flex items-start gap-2.5">${iconSvg('check-circle', 'mt-0.5 size-4 shrink-0 text-ok')}<span>${t}</span></li>`).join('')}
                 </ul>
               </div>`
            : ''
        }

        <div class="mt-6 flex items-start gap-3 rounded-control bg-sunken/50 p-4 text-xs leading-relaxed text-ink-3">
          ${iconSvg('info', 'mt-0.5 size-4 shrink-0 text-ink-2')}
          <span>Recuerda que este test es puramente orientativo. La aptitud definitiva la determina el profesional médico en la entrevista previa del banco de sangre.</span>
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          ${
            eligible
              ? `<a href="/register" class="btn btn-primary">Quiero ser donante ${iconSvg('arrow-right', 'size-4')}</a>
                 <a href="/centros" class="btn btn-secondary">Ver centros cercanos</a>`
              : `<a href="/#faq" class="btn btn-secondary">Leer preguntas frecuentes</a>`
          }
          <button type="button" id="quiz-restart" class="btn border border-line hover:bg-sunken text-ink-2 hover:text-ink">
            ${iconSvg('arrow-clockwise', 'size-4')} Reiniciar test
          </button>
        </div>
      </div>
    `;

    result.querySelector<HTMLElement>('#quiz-result-title')?.focus({ preventScroll: true });
    keepQuizInView();
    result.querySelector('#quiz-restart')?.addEventListener('click', restart);
  }

  function restart() {
    step = 0;
    answers.length = 0;
    result?.classList.add('hidden');
    progress?.classList.remove('hidden');
    body?.classList.remove('hidden');
    renderQuestion('back', true);
  }

  backBtn?.addEventListener('click', () => {
    if (step === 0) return;
    step--;
    renderQuestion('back', true);
  });

  if (questions.length) renderQuestion();
</script>