---
// src/components/donante/Navbar.astro
import Logo from './../Logo.astro';
import Icon from './../Icon.astro';
import Sidebar from './Sidebar.astro';


const normalize = (p: string) => p.replace(/\/$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full border-b border-line bg-surface/85 backdrop-blur-lg supports-[not(backdrop-filter:blur(0))]:bg-surface"
>
  <div class="container-blud flex h-(--header-h) items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <!-- Botón de Hamburguesa -->
      <button
        type="button"
        id="desktop-sidebar-btn"
        class="grid size-10 place-items-center rounded-control text-ink transition-colors hover:bg-sunken active:scale-95 cursor-pointer"
        aria-label="Alternar menú lateral"
        aria-controls="sidebar-drawer"
        aria-expanded="false"
        title="Menú Principal"
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      </button>

      <a href="/donante/perfil" aria-label="BLUD, ir al inicio">
        <Logo size="lg" />
      </a>
    </div>

    <div class="flex items-center gap-1.5">
      <!-- Menú Dropdown Perfil -->
      <div class="relative mr-1 hidden lg:block" id="account-dropdown-wrapper" data-auth-in data-account-menu>
        <button
          type="button"
          id="account-trigger"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="account-panel"
          class="flex items-center gap-2 rounded-full py-1 pl-1 pr-3 text-ink transition-colors hover:bg-sunken cursor-pointer"
        >
          <span class="grid size-9 place-items-center rounded-full bg-accent text-[0.875rem] font-bold text-white" data-user-initials></span>
          <span class="max-w-[9rem] truncate text-base font-medium" data-user-first></span>
          <Icon name="caret-down" class="account-caret size-3.5 text-ink-3 transition-transform duration-200" />
          <span class="sr-only">Abrir menú de la cuenta</span>
        </button>

        <div
          id="account-panel"
          hidden
          class="absolute right-0 top-full z-20 pt-2"
        >
          <div class="panel w-72 rounded-panel border border-line bg-surface p-2 shadow-xl">
            <div class="flex items-center gap-3 p-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-accent font-bold text-white" data-user-initials></span>
              <div class="min-w-0">
                <p class="truncate font-semibold text-ink" data-user-name></p>
                <p class="truncate text-sm text-ink-3" data-user-email></p>
              </div>
            </div>

            <button
              type="button"
              data-logout
              class="flex w-full items-center gap-2 rounded-control border-t border-line px-3 py-2.5 text-left text-sm font-semibold text-accent-ink transition-colors hover:bg-sunken cursor-pointer"
            >
              Cerrar sesión
            </button>
          </div>
        </div>
      </div>

      <!-- Toggle Modo Oscuro -->
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle relative grid size-11 place-items-center rounded-control text-ink-2 transition-colors duration-200 hover:bg-sunken hover:text-ink active:scale-95"
        aria-label="Cambiar a modo oscuro"
        title="Cambiar a modo oscuro"
      >
        <span class="theme-icon theme-icon-sun" aria-hidden="true"><Icon name="sun" class="size-[1.3rem]" /></span>
        <span class="theme-icon theme-icon-moon" aria-hidden="true"><Icon name="moon" class="size-[1.2rem]" /></span>
      </button>
    </div>
  </div>
</header>

<Sidebar />

<script is:inline>
  (function () {
    var s = null;
    try { s = JSON.parse(localStorage.getItem('blud-session') || sessionStorage.getItem('blud-session') || 'null'); } catch (e) {}
    if (!s || !s.name) return;
    var parts = s.name.split(/\s+/).filter(Boolean);
    var ini = parts.slice(0, 2).map(function (p) { return p.charAt(0).toUpperCase(); }).join('');
    var set = function (sel, v) { document.querySelectorAll(sel).forEach(function (el) { el.textContent = v; }); };
    set('[data-user-initials]', ini);
    set('[data-user-first]', parts[0] || '');
    set('[data-user-name]', s.name);
    set('[data-user-email]', s.email || '');
  })();
</script>

<style>
  #account-trigger[aria-expanded="true"] .account-caret {
    transform: rotate(180deg);
  }
  .menu-icon { position: relative; width: 22px; height: 14px; }
  .menu-icon > span {
    position: absolute; left: 0; right: 0; height: 2px;
    border-radius: 2px; background: currentColor;
  }
  .menu-icon > span:first-child { top: 2px; }
  .menu-icon > span:last-child { top: 10px; }

  .theme-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition:
      transform 520ms var(--ease-out),
      opacity 240ms ease;
  }
  .theme-icon-sun { transform: rotate(0) scale(1); opacity: 1; }
  .theme-icon-moon { transform: rotate(-100deg) scale(0.4); opacity: 0; }
  :global(:root[data-theme="dark"]) .theme-icon-sun { transform: rotate(100deg) scale(0.4); opacity: 0; }
  :global(:root[data-theme="dark"]) .theme-icon-moon { transform: rotate(0) scale(1); opacity: 1; }

  @media (hover: hover) {
    .theme-toggle:hover .theme-icon-sun :global(svg) { animation: sun-spin 1.2s var(--ease-out); }
    .theme-toggle:hover .theme-icon-moon :global(svg) { animation: moon-tilt 900ms var(--ease-out); }
  }
  @keyframes sun-spin {
    from { transform: rotate(0); }
    to { transform: rotate(90deg); }
  }
  @keyframes moon-tilt {
    0%, 100% { transform: rotate(0); }
    40% { transform: rotate(-18deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-icon { transition: opacity 150ms ease; transform: none !important; }
  }
</style>

<script>
  import { getSession, initials, logout } from '../../lib/auth';

  const root = document.documentElement;

  // ----- Estado de Autenticación -----
  const fill = (selector: string, value: string) =>
    document.querySelectorAll(selector).forEach((el) => (el.textContent = value));

  function renderAuth() {
    const user = getSession();
    if (!user) {
      delete root.dataset.auth;
      return;
    }
    root.dataset.auth = 'in';
    fill('[data-user-initials]', initials(user.name));
    fill('[data-user-first]', user.name.split(/\s+/)[0] ?? '');
    fill('[data-user-name]', user.name);
    fill('[data-user-email]', user.email || '');
  }

  // Cierre de Sesión
  document.querySelectorAll('[data-logout]').forEach((btn) =>
    btn.addEventListener('click', () => {
      logout();
      window.location.href = '/login';
    })
  );

  renderAuth();
  window.addEventListener('blud:auth', renderAuth);
  window.addEventListener('storage', (e) => {
    if (e.key === null || e.key.startsWith('blud-')) renderAuth();
  });

  // ----- Tema Claro / Oscuro -----
  const themeBtn = document.getElementById('theme-toggle');

  const currentTheme = () => (root.dataset.theme === 'dark' ? 'dark' : 'light');

  const syncThemeLabel = () => {
    const label = currentTheme() === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';
    themeBtn?.setAttribute('aria-label', label);
    themeBtn?.setAttribute('title', label);
  };

  const applyTheme = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('blud-theme', theme);
    } catch {}
    syncThemeLabel();
  };

  themeBtn?.addEventListener('click', (event) => {
    const button = event.currentTarget as HTMLElement;
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };

    if (!doc.startViewTransition || reduce) {
      applyTheme(next);
      return;
    }

    const rect = button.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.style.setProperty('--vt-x', `${x}px`);
    root.style.setProperty('--vt-y', `${y}px`);
    root.style.setProperty('--vt-r', `${r}px`);
    root.classList.add('theme-vt');

    doc.startViewTransition(() => applyTheme(next)).finished.finally(() => {
      root.classList.remove('theme-vt');
    });
  });

  syncThemeLabel();
  new MutationObserver(syncThemeLabel).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

  // ----- Desplegable de Cuenta -----
  function initNavbar() {
    const w = window as unknown as { __bludNavbarCtl?: AbortController };

    w.__bludNavbarCtl?.abort();
    const ctl = new AbortController();
    w.__bludNavbarCtl = ctl;
    const { signal } = ctl;

    const accountTrigger = document.getElementById('account-trigger');
    const accountPanel = document.getElementById('account-panel');
    if (!accountTrigger || !accountPanel) return;

    const isOpen = () => accountTrigger.getAttribute('aria-expanded') === 'true';

    function setAccountOpen(next: boolean, restoreFocus = false) {
      if (!accountTrigger || !accountPanel) return;
      accountTrigger.setAttribute('aria-expanded', String(next));
      accountPanel.hidden = !next;
      if (!next && restoreFocus) accountTrigger.focus({ preventScroll: true });
    }

    accountTrigger.addEventListener('click', () => setAccountOpen(!isOpen()), { signal });

    document.addEventListener(
      'click',
      (e) => {
        if (!isOpen()) return;
        const target = e.target as Node;
        if (accountPanel.contains(target) || accountTrigger.contains(target)) return;
        setAccountOpen(false);
      },
      { capture: true, signal }
    );

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && isOpen()) setAccountOpen(false, true);
      },
      { signal }
    );

    document.addEventListener('astro:before-swap', () => setAccountOpen(false), { signal });
  }

  initNavbar();
  document.addEventListener('astro:page-load', () => {
    initNavbar();
    renderAuth();
  });
</script>