---
// BackButton.astro
import Icon from './Icon.astro';

interface Props {
  href?: string;
  label?: string;
  class?: string;
}

const { href = '/', label = 'Volver al inicio', class: className = '' } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-xs font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:border-white/30 active:scale-95 shadow-xs ${className}`}
>
  <Icon name="arrow-left" class="size-3.5" />
  <span>{label}</span>
</a>