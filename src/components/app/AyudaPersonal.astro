---
// src/components/app/AyudaPersonal.astro
// Ayuda para el personal: guía corta del rol y «Reportar un problema» a soporte, con el seguimiento de cada reporte.
// Ver lib/ayuda.
import { ASUNTOS_PERSONAL, GUIA } from '../../lib/ayuda';
import type { RolPersonal } from '../../lib/ayuda';

interface Props { role: RolPersonal }
const { role } = Astro.props;
const guia = GUIA[role];
---

<div class="container-blud py-8 space-y-8" data-ayuda data-rol={role}>
  <div class="page-head">
    <div class="min-w-0">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Ayuda</h1>
      <p class="text-ink-2 text-sm sm:text-base mt-1">Respuestas a las dudas frecuentes de tu rol y un canal directo con soporte técnico.</p>
    </div>
    <div class="page-head-acciones">
      <a href="#reportar" class="btn btn-primary btn-sm">Reportar un problema</a>
    </div>
  </div>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)]">
    <section class="panel p-5 sm:p-8 space-y-2" aria-labelledby="h-guia">
      <h2 id="h-guia" class="text-lg font-bold text-ink border-b border-line pb-3">Preguntas frecuentes</h2>
      <div class="divide-y divide-line">
        {guia.map((g) => (
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold text-ink [&::-webkit-details-marker]:hidden">
              {g.p}
              <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-ink-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="pb-4 text-sm leading-relaxed text-ink-2">{g.r}</p>
            {g.enlace && <p class="pb-4 -mt-2"><a href={g.enlace.href} class="link-arrow text-sm">{g.enlace.texto}</a></p>}
          </details>
        ))}
      </div>
    </section>

    <section id="reportar" class="panel p-5 sm:p-8 space-y-5 scroll-mt-24" aria-labelledby="h-reportar">
      <div class="border-b border-line pb-3">
        <h2 id="h-reportar" class="text-lg font-bold text-ink">Reportar un problema</h2>
        <p class="mt-1 text-sm text-ink-3">Lo recibe soporte técnico. Te responde aquí mismo.</p>
      </div>
      <form class="space-y-4" data-ayuda-form novalidate>
        <div>
          <label for="ay-asunto" class="block text-xs font-bold uppercase text-ink-2 mb-1">De qué se trata</label>
          <select id="ay-asunto" class="field" required>
            <option value="">Elegir</option>
            {ASUNTOS_PERSONAL.map((a) => <option value={a}>{a}</option>)}
          </select>
        </div>
        <div>
          <label for="ay-pantalla" class="block text-xs font-bold uppercase text-ink-2 mb-1">Pantalla donde ocurrió <span class="font-normal normal-case text-ink-3">(opcional)</span></label>
          <input id="ay-pantalla" class="field" placeholder="Ej. Despachos" />
        </div>
        <div>
          <label for="ay-texto" class="block text-xs font-bold uppercase text-ink-2 mb-1">Qué pasó</label>
          <textarea id="ay-texto" rows="5" class="field" required placeholder="Qué intentabas hacer, qué esperabas y qué ocurrió. Si salió un mensaje, cópialo."></textarea>
        </div>
        <p class="hidden rounded-control bg-accent-soft px-3 py-2 text-sm font-medium text-accent-ink" role="alert" data-ayuda-error></p>
        <button type="submit" class="btn btn-primary w-full">Enviar a soporte</button>
      </form>
    </section>
  </div>

  <section class="panel p-5 sm:p-8 space-y-4" aria-labelledby="h-mis">
    <h2 id="h-mis" class="text-lg font-bold text-ink border-b border-line pb-3">Mis reportes <span class="text-ink-3 text-sm font-semibold">(<span data-ayuda-n>0</span>)</span></h2>
    <ul class="divide-y divide-line" data-ayuda-lista></ul>
    <p class="hidden py-6 text-center text-sm text-ink-3" data-ayuda-vacio>Todavía no has reportado ningún problema.</p>
  </section>
</div>

<dialog class="m-auto w-[min(40rem,calc(100vw-2rem))] rounded-panel bg-transparent p-0 backdrop:bg-black/60" data-ayuda-dialogo aria-labelledby="ay-d-titulo">
  <div class="panel flex max-h-[85dvh] flex-col">
    <div class="flex items-start justify-between gap-4 border-b border-line p-5">
      <div class="min-w-0">
        <p class="font-mono text-xs font-bold text-ink-3" data-ayuda-d-codigo></p>
        <h2 id="ay-d-titulo" class="text-lg font-bold text-ink" data-ayuda-d-asunto></h2>
        <p class="mt-1" data-ayuda-d-estado></p>
      </div>
      <button type="button" class="grid size-9 shrink-0 place-items-center rounded-full text-ink-3 hover:bg-sunken" data-ayuda-cerrar aria-label="Cerrar">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <ol class="flex-1 space-y-3 overflow-y-auto p-5" data-ayuda-hilo></ol>
    <form class="flex gap-2 border-t border-line p-4" data-ayuda-responder>
      <label for="ay-resp" class="sr-only">Responder</label>
      <input id="ay-resp" class="field flex-1" placeholder="Escribe una respuesta" autocomplete="off" />
      <button type="submit" class="btn btn-primary shrink-0">Enviar</button>
    </form>
  </div>
</dialog>

<script>
  import { misReportes, reportarProblema, responderReporte } from '../../lib/ayuda';
  import { onDb } from '../../lib/db';
  import { ESTADO_LABEL, fmtFechaHora } from '../../lib/soporte';
  import { esc, toast } from '../../lib/ui';
  import type { Ticket } from '../../lib/db';

  const TONO: Record<Ticket['estado'], string> = {
    abierto: 'bg-warn-soft text-warn',
    en_proceso: 'bg-accent-soft text-accent-ink',
    resuelto: 'bg-ok-soft text-ok',
  };
  const chip = (t: Ticket) => `<span class="rounded-full px-2.5 py-0.5 text-xs font-bold ${TONO[t.estado]}">${ESTADO_LABEL[t.estado]}</span>`;

  function init() {
    const raiz = document.querySelector<HTMLElement>('[data-ayuda]');
    if (!raiz || raiz.dataset.ready) return;
    raiz.dataset.ready = '1';
    const q = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
    const dlg = q<HTMLDialogElement>('[data-ayuda-dialogo]');
    let abierto: string | null = null;

    const pintarLista = () => {
      const lista = misReportes();
      q('[data-ayuda-n]').textContent = String(lista.length);
      q('[data-ayuda-vacio]').classList.toggle('hidden', lista.length > 0);
      q('[data-ayuda-lista]').innerHTML = lista.map((t) => {
        const ult = t.mensajes.at(-1);
        const respuesta = ult?.autor === 'soporte';
        return `<li><button type="button" data-ayuda-abrir="${esc(t.id)}" class="flex w-full flex-col gap-1 rounded-control py-4 text-left hover:bg-sunken sm:flex-row sm:items-center sm:gap-4 sm:px-2">
          <div class="min-w-0 flex-1">
            <p class="flex flex-wrap items-center gap-2"><span class="font-mono text-xs font-bold text-ink-3">${esc(t.codigo)}</span><span class="font-semibold text-ink">${esc(t.asunto)}</span>
              ${respuesta && t.estado !== 'resuelto' ? '<span class="rounded-full bg-ok-soft px-2 py-0.5 text-[0.6875rem] font-bold text-ok">Soporte respondió</span>' : ''}</p>
            <p class="truncate text-sm text-ink-2">${esc(ult?.texto ?? '')}</p>
          </div>
          <div class="flex items-center gap-3 sm:shrink-0">${chip(t)}<span class="text-xs text-ink-3 tabular">${esc(fmtFechaHora(t.actualizado))}</span></div>
        </button></li>`;
      }).join('');
    };

    const pintarDetalle = () => {
      const t = abierto ? misReportes().find((x) => x.id === abierto) : undefined;
      if (!t) return;
      q('[data-ayuda-d-codigo]').textContent = t.codigo;
      q('[data-ayuda-d-asunto]').textContent = t.asunto;
      q('[data-ayuda-d-estado]').innerHTML = `${chip(t)} <span class="ml-2 text-xs text-ink-3">${t.asignadoA ? 'Lo atiende ' + esc(t.asignadoA.nombre) : 'Sin asignar todavía'}</span>`;
      q('[data-ayuda-hilo]').innerHTML = t.mensajes.map((m) => {
        const mio = m.autor !== 'soporte';
        return `<li class="flex ${mio ? 'justify-end' : 'justify-start'}"><div class="max-w-[85%] rounded-2xl px-4 py-3 text-sm ${mio ? 'bg-accent-soft' : 'bg-sunken'} text-ink">
          <p class="mb-1 text-xs font-bold ${mio ? 'text-accent-ink' : 'text-ink-2'}">${mio ? 'Tú' : esc(m.nombre) + ' · Soporte'} <span class="font-normal text-ink-3">· ${esc(fmtFechaHora(m.fecha))}</span></p>
          <p class="whitespace-pre-wrap">${esc(m.texto)}</p></div></li>`;
      }).join('');
      const hilo = q('[data-ayuda-hilo]');
      hilo.scrollTop = hilo.scrollHeight;
    };

    q('[data-ayuda-form]').addEventListener('submit', (e) => {
      e.preventDefault();
      const err = q('[data-ayuda-error]');
      const r = reportarProblema({
        asunto: q<HTMLSelectElement>('#ay-asunto').value,
        pantalla: q<HTMLInputElement>('#ay-pantalla').value,
        mensaje: q<HTMLTextAreaElement>('#ay-texto').value,
      });
      err.classList.toggle('hidden', r.ok);
      if (!r.ok) { err.textContent = r.motivo; return; }
      (e.target as HTMLFormElement).reset();
      toast(`Reporte ${r.data.codigo} enviado a soporte.`);
      pintarLista();
    });

    q('[data-ayuda-lista]').addEventListener('click', (e) => {
      const id = (e.target as HTMLElement).closest<HTMLElement>('[data-ayuda-abrir]')?.dataset.ayudaAbrir;
      if (!id) return;
      abierto = id;
      pintarDetalle();
      dlg.showModal();
    });
    q('[data-ayuda-cerrar]').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => { abierto = null; });
    q('[data-ayuda-responder]').addEventListener('submit', (e) => {
      e.preventDefault();
      const input = q<HTMLInputElement>('#ay-resp');
      if (!abierto) return;
      const r = responderReporte(abierto, input.value);
      if (!r.ok) return toast(r.motivo);
      input.value = '';
      pintarDetalle();
    });

    pintarLista();
    onDb(() => { pintarLista(); if (abierto) pintarDetalle(); });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
