---
// src/components/app/FichaDonante.astro
// Carnet del donante tal como lo ve el personal al verificarlo (/verificar y Operador → Donantes).
// Foto, nombre y tipo de sangre centrados arriba; datos debajo. Lo rellena pintarFicha() de lib/ficha.
// El slot recibe las acciones (verificar, registrar donación…).
interface Props {
  id?: string;
  class?: string;
}
const { id, class: cls = '' } = Astro.props;
---

<article id={id} class:list={['ficha', cls]} data-ficha hidden>
  <header class="ficha-top">
    <span class="ficha-blob ficha-blob-a" aria-hidden="true"></span>
    <span class="ficha-blob ficha-blob-b" aria-hidden="true"></span>

    <div class="ficha-marca">
      <span class="flex items-center gap-2">
        <span class="grid size-8 place-items-center rounded-full bg-white/20" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
        </span>
        <span class="leading-tight">
          <span class="block text-sm font-extrabold tracking-tight">BLUD</span>
          <span class="block text-[0.625rem] font-semibold uppercase tracking-widest text-white/75">Carnet de donante</span>
        </span>
      </span>
      <span class="ficha-estado" data-ff-estado>Sin verificar</span>
    </div>

    <div class="ficha-centro">
      <span class="ficha-foto">
        <span data-ff="iniciales">?</span>
        <img data-ff-foto alt="Foto del donante" hidden />
      </span>
      <p class="ficha-sinfoto" data-ff-sinfoto hidden>Sin foto en el carnet</p>
      <p class="ficha-nombre" data-ff="nombre">—</p>
      <p class="ficha-id" data-ff="id">—</p>
      <div class="ficha-sangre">
        <span class="ficha-sangre-label">Tipo de sangre</span>
        <span class="ficha-sangre-valor" data-ff="sangre">—</span>
      </div>
    </div>
  </header>

  <dl class="ficha-datos">
    <div><dt>Cédula</dt><dd class="font-mono" data-ff="cedula">—</dd></div>
    <div><dt>Teléfono</dt><dd data-ff="telefono">—</dd></div>
    <div data-ff-privado><dt>Fecha de nacimiento</dt><dd data-ff="nacimiento">—</dd></div>
    <div data-ff-privado><dt>Sexo</dt><dd data-ff="sexo">—</dd></div>
    <div data-ff-privado><dt>Correo</dt><dd class="truncate" data-ff="email">—</dd></div>
    <div data-ff-privado><dt>Donante desde</dt><dd data-ff="registrado">—</dd></div>
    <div data-ff-privado><dt>Donaciones</dt><dd data-ff="donaciones">—</dd></div>
    <div data-ff-privado><dt>Última donación</dt><dd data-ff="ultima">—</dd></div>
    <div class="ficha-ancho" data-ff-privado><dt>Próxima cita</dt><dd data-ff="cita">—</dd></div>
  </dl>

  <div class="ficha-acciones empty:hidden"><slot /></div>
</article>

<style is:global>
  .ficha {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    background: var(--surface);
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / 0.35);
  }
  .ficha[hidden] { display: none; }

  .ficha-top {
    position: relative;
    overflow: hidden;
    padding: 1.25rem 1.25rem 1.75rem;
    color: #fff;
    background: linear-gradient(160deg, var(--color-blud-flag-red) 0%, var(--color-blud-flag-red) 40%, var(--color-blud-oxblood) 100%);
  }
  .ficha-blob { position: absolute; border-radius: 9999px; background: rgb(255 255 255 / 0.1); pointer-events: none; }
  .ficha-blob-a { width: 16rem; height: 16rem; top: -7rem; right: -5rem; }
  .ficha-blob-b { width: 10rem; height: 10rem; bottom: -4rem; left: -3rem; }

  .ficha-marca { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .ficha-estado {
    display: inline-flex; align-items: center; gap: 0.25rem;
    padding: 0.25rem 0.7rem; border-radius: 9999px;
    font-size: 0.75rem; font-weight: 700;
    background: rgb(255 255 255 / 0.2); color: #fff;
  }
  .ficha-estado[data-ok='true'] { background: #fff; color: var(--ok); }

  .ficha-centro { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; margin-top: 1.25rem; }
  .ficha-foto {
    position: relative; display: grid; place-items: center; overflow: hidden;
    width: 8.5rem; height: 8.5rem; border-radius: 9999px;
    background: #fff; color: var(--color-blud-flag-red);
    font-size: 2.5rem; font-weight: 800;
    box-shadow: 0 0 0 5px rgb(255 255 255 / 0.3), 0 16px 32px -12px rgb(0 0 0 / 0.45);
  }
  .ficha-foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ficha-sinfoto { margin-top: 0.6rem; font-size: 0.75rem; font-weight: 600; color: rgb(255 255 255 / 0.8); }
  .ficha-nombre { margin-top: 0.9rem; font-size: 1.5rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.01em; }
  .ficha-id { margin-top: 0.25rem; font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.8125rem; letter-spacing: 0.08em; color: rgb(255 255 255 / 0.85); }
  .ficha-sangre {
    display: inline-flex; flex-direction: column; align-items: center;
    margin-top: 1rem; padding: 0.5rem 1.5rem 0.6rem; border-radius: 1rem;
    background: #fff; color: var(--color-blud-flag-red);
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.45);
  }
  .ficha-sangre-label { font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-3); }
  .ficha-sangre-valor { font-size: 2.25rem; font-weight: 900; line-height: 1; }

  .ficha-datos { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--line); }
  .ficha-datos > div[hidden] { display: none; }
  .ficha-datos > div { background: var(--surface); padding: 0.85rem 1.25rem; min-width: 0; }
  .ficha-datos dt { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); }
  .ficha-datos dd { margin-top: 0.2rem; font-weight: 600; color: var(--ink); overflow-wrap: anywhere; }
  .ficha-acciones { display: grid; gap: 0.75rem; padding: 1.25rem; border-top: 1px solid var(--line); }

  @media (min-width: 640px) {
    .ficha-top { padding: 1.5rem 2rem 2rem; }
    .ficha-datos { grid-template-columns: 1fr 1fr; }
    .ficha-datos > div { padding-inline: 2rem; }
    .ficha-ancho { grid-column: 1 / -1; }
    .ficha-acciones { padding: 1.5rem 2rem; }
  }
</style>
