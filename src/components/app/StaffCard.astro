---
// src/components/app/StaffCard.astro
// Perfil del personal a pantalla completa (ecard). Reutilizable para operador, laboratorio y director.
// Uso: colócalo FUERA de .container-blud para que la foto ocupe todo el ancho:
//   <StaffCard role="operador" />
import type { Role } from '../../lib/auth';

interface Props {
  role: Role;
  editable?: boolean;
}
const { role, editable = true } = Astro.props;

const tiles = [
  { k: 'cedula', label: 'Cédula', icon: 'M3 5h18v14H3zM7 10h4M7 14h3M15 10h2M15 14h2' },
  { k: 'mpps', label: 'MPPS', icon: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4' },
  { k: 'sangre', label: 'Tipo de sangre', icon: 'M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z', blood: true },
  { k: 'area', label: 'Área de trabajo', icon: 'M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6' },
  { k: 'sede', label: 'Sede', icon: 'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z' },
  { k: 'telefono', label: 'Teléfono', icon: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z' },
  { k: 'email', label: 'Correo', icon: 'M3 6h18v12H3zM3 7l9 7 9-7', wide: true },
];
---

<section class="staff" data-staff data-role={role} aria-label="Perfil del personal">
  <div class="staff-hero">
    <img class="staff-photo" alt="" hidden />
    <div class="staff-ph" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
    </div>
    <div class="staff-shade" aria-hidden="true"></div>

    {editable && (
      <button type="button" class="staff-edit" data-s-open>
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
        Editar perfil
      </button>
    )}

    <div class="staff-id container-blud">
      <div class="staff-id-in rise" style="--d:80ms">
        <span class="staff-chip" data-s="rol"></span>
        <h1 class="staff-name" data-s="nombre">—</h1>
        <p class="staff-cargo" data-s="cargo">—</p>
      </div>
    </div>
  </div>

  <div class="staff-sheet">
    <div class="container-blud">
     <div class="staff-av-row">
      <div class="staff-av rise" style="--d:40ms">
        <img alt="" hidden />
        <span class="staff-av-ini" data-s="iniciales" aria-hidden="true"></span>
        {editable && (
          <button type="button" class="staff-av-cam" data-s-open aria-label="Cambiar foto de perfil">
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L8 6H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-3z"/><circle cx="12" cy="13" r="3.5"/></svg>
          </button>
        )}
      </div>
     </div>
    </div>
    <div class="container-blud">
      <ul class="staff-grid">
        {tiles.map((t, i) => (
          <li class:list={['tile rise', t.blood && 'tile-blood', t.wide && 'tile-wide']} style={`--d:${160 + i * 55}ms`}>
            <span class="tile-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon} /></svg>
            </span>
            <span class="min-w-0">
              <span class="tile-label">{t.label}</span>
              <span class="tile-val tabular" data-s={t.k}>—</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {editable && (
    <dialog class="staff-dlg" data-s-dlg aria-labelledby="staff-dlg-t">
      <form method="dialog" class="staff-form" data-s-form novalidate>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 id="staff-dlg-t" class="text-lg font-extrabold text-ink">Editar perfil</h2>
            <p class="text-sm text-ink-3">Cargo, MPPS y sede los asigna la dirección. Nombre y contraseña, en Configuración.</p>
          </div>
          <button type="button" class="staff-x" data-s-close aria-label="Cerrar">✕</button>
        </div>

        <fieldset class="staff-fs">
          <legend class="staff-lg">Foto de perfil</legend>
          <div class="flex items-center gap-4">
            <div class="staff-prev-av" data-s-prev-av>
              <img alt="" hidden />
              <span class="staff-prev-empty">Sin foto</span>
            </div>
            <div class="flex flex-wrap gap-2">
              <label class="btn btn-secondary cursor-pointer">
                Subir foto
                <input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-s-file-av />
              </label>
              <button type="button" class="btn btn-secondary" data-s-quitar-av>Quitar</button>
            </div>
          </div>
        </fieldset>

        <fieldset class="staff-fs">
          <legend class="staff-lg">Portada</legend>
          <div class="staff-prev" data-s-prev>
            <img alt="" hidden />
            <span class="staff-prev-empty">Sin portada</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <label class="btn btn-secondary cursor-pointer">
              Subir portada
              <input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" data-s-file />
            </label>
            <button type="button" class="btn btn-secondary" data-s-quitar>Quitar</button>
          </div>
          <div>
            <label for="s-y" class="block text-xs font-bold uppercase text-ink-2 mb-1">Encuadre vertical de la portada</label>
            <input id="s-y" type="range" min="0" max="100" step="1" class="w-full accent-[var(--accent)]" data-s-y />
          </div>
        </fieldset>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="s-ced" class="block text-xs font-bold uppercase text-ink-2 mb-1">Cédula</label>
            <input id="s-ced" class="field" inputmode="numeric" placeholder="V-12345678" data-s-ced />
          </div>
          <div>
            <label for="s-san" class="block text-xs font-bold uppercase text-ink-2 mb-1">Tipo de sangre</label>
            <select id="s-san" class="field" data-s-san>
              <option value="">Sin registrar</option>
              {['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'].map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>
        </div>
        <div>
          <label for="s-tel" class="block text-xs font-bold uppercase text-ink-2 mb-1">Teléfono</label>
          <input id="s-tel" class="field" type="tel" placeholder="+58 414 1234567" data-s-tel />
        </div>

        <p class="hidden rounded-control bg-accent-soft px-3 py-2 text-sm font-medium text-accent-ink" role="alert" data-s-err></p>
        <div class="flex justify-end gap-2">
          <button type="button" class="btn btn-secondary" data-s-close>Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </dialog>
  )}
</section>

<style is:global>
  .staff { --sheet-r: 2.75rem; --av: 7rem; position: relative; width: 100%; }
  @media (min-width: 640px) { .staff { --av: 9.5rem; } }

  .staff-hero { position: relative; height: clamp(24rem, 56vh, 38rem); overflow: hidden; background: #1c1517; color: #fff; }
  .staff-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% var(--fy, 30%); }
  .staff-ph {
    position: absolute; inset: 0; display: grid; place-items: center;
    background: radial-gradient(120% 90% at 20% 10%, var(--color-blud-flag-red, #CA2B2B), var(--color-blud-oxblood, #A30008) 60%, #3a0508);
  }
  .staff-ph svg { position: absolute; right: 8%; top: 8%; width: clamp(9rem, 28vw, 22rem); color: rgb(255 255 255 / 0.12); }
  .staff-shade { position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / 0.78) 0%, rgb(0 0 0 / 0.35) 38%, transparent 70%); }

  .staff-edit {
    position: absolute; top: 1rem; right: 1rem; z-index: 2; display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.55rem 0.95rem; border-radius: 9999px; font-size: 0.8125rem; font-weight: 700; color: #fff;
    background: rgb(0 0 0 / 0.35); border: 1px solid rgb(255 255 255 / 0.35); backdrop-filter: blur(8px);
    transition: background 150ms, transform 150ms;
  }
  .staff-edit:hover { background: rgb(0 0 0 / 0.55); transform: translateY(-1px); }

  .staff-id {
    position: absolute; left: 0; right: 0; bottom: calc(var(--sheet-r) + var(--av) / 2 + 0.9rem); z-index: 1;
    text-align: center;
  }
  @media (min-width: 640px) {
    .staff-id { bottom: calc(var(--sheet-r) + 1.25rem); text-align: left; }
    .staff-id-in { padding-left: calc(var(--av) + 1.5rem); }
  }
  .staff-chip {
    display: inline-block; padding: 0.25rem 0.7rem; border-radius: 9999px; font-size: 0.6875rem; font-weight: 800;
    letter-spacing: 0.12em; text-transform: uppercase; background: rgb(255 255 255 / 0.18); backdrop-filter: blur(6px);
  }
  .staff-name { margin-top: 0.6rem; font-size: clamp(2rem, 6vw, 4rem); line-height: 1.02; font-weight: 800; letter-spacing: -0.03em; text-shadow: 0 2px 18px rgb(0 0 0 / 0.4); }
  .staff-cargo { margin-top: 0.35rem; font-size: clamp(0.8rem, 1.6vw, 1rem); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #7de3d4; }

  .staff-sheet {
    position: relative; margin-top: calc(var(--sheet-r) * -1); background: var(--canvas, var(--surface));
    border-radius: 50% 50% 0 0 / var(--sheet-r) var(--sheet-r) 0 0; padding: calc(var(--av) / 2 + 1.75rem) 0 2.5rem;
  }
  .staff-av-row { position: relative; height: 0; z-index: 2; }
  .staff-av {
    position: absolute; top: calc(var(--av) * -1 - 1.75rem); left: 50%; translate: -50% 0;
    width: var(--av); height: var(--av); border-radius: 9999px; display: grid; place-items: center;
    background: linear-gradient(135deg, var(--color-blud-flag-red, #CA2B2B), var(--color-blud-oxblood, #A30008)); color: #fff;
    border: 6px solid var(--canvas, var(--surface)); box-shadow: 0 16px 34px -14px rgb(0 0 0 / 0.5);
  }
  @media (min-width: 640px) { .staff-av { left: 0; translate: none; } }
  .staff-av img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: inherit; object-fit: cover; }
  .staff-av-ini { font-size: calc(var(--av) * 0.36); font-weight: 800; letter-spacing: -0.02em; }
  .staff-av-cam {
    position: absolute; right: 0.1rem; bottom: 0.1rem; display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    border-radius: 9999px; background: var(--surface); color: var(--ink); border: 1px solid var(--line);
    box-shadow: 0 4px 12px -4px rgb(0 0 0 / 0.4); transition: transform 150ms;
  }
  .staff-av-cam:hover { transform: scale(1.08); }
  .staff-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  @media (min-width: 1024px) { .staff-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; } .tile-wide { grid-column: span 2; } }
  @media (max-width: 1023px) { .tile-wide { grid-column: span 2; } }

  .tile { display: flex; align-items: center; gap: 0.75rem; padding: 0.95rem 1rem; border: 1px solid var(--line); border-radius: 1.25rem; background: var(--surface); }
  .tile-ico { display: grid; place-items: center; flex-shrink: 0; width: 2.5rem; height: 2.5rem; border-radius: 0.85rem; background: var(--sunken); color: var(--ink-2); }
  .tile-label { display: block; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .tile-val { display: block; font-size: 0.95rem; font-weight: 700; color: var(--ink); overflow-wrap: break-word; }
  .tile-val.empty { font-weight: 500; color: var(--ink-3); }
  .tile-blood { background: var(--accent-soft); border-color: transparent; }
  .tile-blood .tile-ico { background: var(--accent); color: #fff; }
  .tile-blood .tile-val { font-size: 1.35rem; font-weight: 800; color: var(--accent-ink); }

  .staff .rise { opacity: 0; transform: translateY(14px); }
  .staff[data-ready="true"] .rise { animation: staff-rise 600ms var(--ease-out, ease-out) forwards; animation-delay: var(--d, 0ms); }
  @keyframes staff-rise { to { opacity: 1; transform: none; } }

  .staff-dlg { width: min(100% - 2rem, 34rem); max-height: 90dvh; overflow-y: auto; padding: 0; border: 1px solid var(--line); border-radius: 1.5rem; background: var(--surface); color: var(--ink); margin: auto; }
  .staff-dlg::backdrop { background: rgb(0 0 0 / 0.5); backdrop-filter: blur(6px); }
  .staff-form { display: grid; gap: 1.1rem; padding: 1.5rem; }
  .staff-x { width: 2.25rem; height: 2.25rem; border-radius: 9999px; background: var(--sunken); color: var(--ink-2); }
  .staff-fs { display: grid; gap: 0.75rem; border: 1px solid var(--line); border-radius: 1rem; padding: 0.9rem 1rem 1rem; }
  .staff-lg { padding: 0 0.4rem; font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .staff-prev-av { position: relative; flex-shrink: 0; width: 5.5rem; height: 5.5rem; border-radius: 9999px; overflow: hidden; background: var(--sunken); display: grid; place-items: center; }
  .staff-prev-av img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .staff-prev { position: relative; height: 7rem; border-radius: 1rem; overflow: hidden; background: var(--sunken); display: grid; place-items: center; }
  .staff-prev img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% var(--fy, 30%); }
  .staff-prev-empty { font-size: 0.8125rem; font-weight: 600; color: var(--ink-3); }

  @media (prefers-reduced-motion: reduce) {
    .staff .rise { opacity: 1; transform: none; animation: none !important; }
    .staff-edit { transition: none; }
  }
</style>

<script>
  import { cargarPerfil, guardarPerfil, iniciales, procesarAvatar, procesarFoto, toast } from '../../lib/personal';
  import type { Role } from '../../lib/personal';

  const ROL: Record<string, string> = { operador: 'Operador', laboratorio: 'Laboratorio', director: 'Dirección' };

  function init() {
    document.querySelectorAll<HTMLElement>('[data-staff]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const role = root.dataset.role as Role;
      const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
      const set = (k: string, v: string) => {
        const el = root.querySelector<HTMLElement>(`[data-s="${k}"]`);
        if (!el) return;
        el.textContent = v || 'Sin registrar';
        el.classList.toggle('empty', !v);
      };

      const hero = q<HTMLImageElement>('.staff-photo');
      const ph = q('.staff-ph');
      const av = q<HTMLImageElement>('.staff-av img');
      const avIni = q('.staff-av-ini');

      function render() {
        const p = cargarPerfil(role);
        set('nombre', p.nombre); set('cargo', p.cargo); set('cedula', p.cedula); set('mpps', p.mpps);
        set('sangre', p.sangre); set('area', p.area); set('sede', p.sede); set('telefono', p.telefono); set('email', p.email);
        q('[data-s="rol"]').textContent = ROL[role] ?? role;
        q('[data-s="iniciales"]').textContent = iniciales(p.nombre);
        root.style.setProperty('--fy', p.fotoY + '%');
        if (p.portada) { hero.src = p.portada; hero.hidden = false; ph.hidden = true; }
        else { hero.hidden = true; hero.removeAttribute('src'); ph.hidden = false; }
        if (p.foto) { av.src = p.foto; av.hidden = false; avIni.hidden = true; }
        else { av.hidden = true; av.removeAttribute('src'); avIni.hidden = false; }
        return p;
      }
      render();
      root.dataset.ready = 'true';
      window.addEventListener('blud:staff', render);

      const dlg = root.querySelector<HTMLDialogElement>('[data-s-dlg]');
      if (!dlg) return;
      const form = q<HTMLFormElement>('[data-s-form]');
      const prevImg = q<HTMLImageElement>('[data-s-prev] img');
      const prevEmpty = q('.staff-prev-empty');
      const err = q('[data-s-err]');
      const y = q<HTMLInputElement>('[data-s-y]');
      const avImg = q<HTMLImageElement>('[data-s-prev-av] img');
      const avEmpty = q('[data-s-prev-av] .staff-prev-empty');
      let foto = '';
      let portada = '';

      const paintPrev = () => {
        prevImg.hidden = !portada; prevEmpty.hidden = !!portada;
        if (portada) prevImg.src = portada;
        avImg.hidden = !foto; avEmpty.hidden = !!foto;
        if (foto) avImg.src = foto;
        q('[data-s-prev]').style.setProperty('--fy', y.value + '%');
      };

      root.querySelectorAll('[data-s-open]').forEach((b) => b.addEventListener('click', () => {
        const p = cargarPerfil(role);
        foto = p.foto; portada = p.portada; y.value = String(p.fotoY);
        q<HTMLInputElement>('[data-s-ced]').value = p.cedula;
        q<HTMLSelectElement>('[data-s-san]').value = p.sangre;
        q<HTMLInputElement>('[data-s-tel]').value = p.telefono;
        err.classList.add('hidden');
        paintPrev();
        dlg.showModal();
      }));
      root.querySelectorAll('[data-s-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

      y.addEventListener('input', paintPrev);
      q('[data-s-quitar]').addEventListener('click', () => { portada = ''; paintPrev(); });
      q('[data-s-quitar-av]').addEventListener('click', () => { foto = ''; paintPrev(); });
      const onFile = (sel: string, proc: (f: File) => Promise<string>, set: (v: string) => void) =>
        q<HTMLInputElement>(sel).addEventListener('change', async (e) => {
          const input = e.target as HTMLInputElement;
          const f = input.files?.[0];
          if (!f) return;
          try { set(await proc(f)); err.classList.add('hidden'); paintPrev(); }
          catch (ex) { err.textContent = (ex as Error).message; err.classList.remove('hidden'); }
          input.value = '';
        });
      onFile('[data-s-file-av]', (f) => procesarAvatar(f), (v) => (foto = v));
      onFile('[data-s-file]', (f) => procesarFoto(f), (v) => (portada = v));

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const r = guardarPerfil({
          foto, portada, fotoY: Number(y.value),
          cedula: q<HTMLInputElement>('[data-s-ced]').value,
          sangre: q<HTMLSelectElement>('[data-s-san]').value,
          telefono: q<HTMLInputElement>('[data-s-tel]').value,
        }, role);
        if (!r.ok) { err.textContent = r.motivo; err.classList.remove('hidden'); return; }
        dlg.close();
        toast('¡Perfil actualizado!');
      });
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>