---
// src/components/app/PaginasCursor.astro
// Navegación «anterior / siguiente» para listas paginadas por cursor (bitácora, cuentas, incidencias).
// Solo marcado: cada página maneja los botones con [data-pag-ant], [data-pag-sig] y el texto con [data-pag-estado].
interface Props {
  /** Nombre accesible de la navegación, p. ej. «Páginas de cuentas». */
  etiqueta: string;
  anterior?: string;
  siguiente?: string;
}
const { etiqueta, anterior = 'Anterior', siguiente = 'Siguiente' } = Astro.props;
const nombre = (base: string, texto: string, defecto: string) => (texto === defecto ? base : `${base} (${texto.toLowerCase()})`);
---

<nav class="flex items-center justify-between gap-3 border-t border-line pt-4" aria-label={etiqueta}>
  <button type="button" class="btn btn-secondary btn-sm" data-pag-ant disabled aria-label={nombre('Página anterior', anterior, 'Anterior')}>
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    <span class="hidden sm:inline">{anterior}</span>
  </button>
  <p class="min-w-0 text-center text-xs text-ink-3 tabular" data-pag-estado aria-live="polite"></p>
  <button type="button" class="btn btn-secondary btn-sm" data-pag-sig disabled aria-label={nombre('Página siguiente', siguiente, 'Siguiente')}>
    <span class="hidden sm:inline">{siguiente}</span>
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
  </button>
</nav>
