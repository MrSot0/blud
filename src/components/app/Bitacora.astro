---
// src/components/app/Bitacora.astro
// Bitácora de auditoría paginada (dirección: su sede; soporte: toda la red). Ver lib/bitacora.
import Filtros from './Filtros.astro';
import PaginasCursor from './PaginasCursor.astro';
import { MODULO } from '../../lib/bitacora';

const modulos = Object.entries(MODULO).sort((a, b) => a[1].localeCompare(b[1]));

interface Props { alcance: 'sede' | 'red' }
const { alcance } = Astro.props;
---

<div class="container-blud py-6 sm:py-8 space-y-6 sm:space-y-8" data-bitacora>
  <div class="page-head">
    <div class="min-w-0">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Bitácora</h1>
      <p class="text-ink-2 text-sm sm:text-base mt-1">
        {alcance === 'sede'
          ? 'Quién hizo qué y cuándo en tu sede: despachos, reservas, rechazos, notificaciones y hemovigilancia.'
          : 'Registro de auditoría de toda la red, para revisar incidencias y reclamos con datos.'}
      </p>
    </div>
    <div class="page-head-acciones">
      <button type="button" class="btn btn-secondary" data-bit-csv>Exportar esta página</button>
    </div>
  </div>

  <section class="panel p-4 sm:p-6 space-y-4">
    <Filtros>
      <input type="search" class="field filtro-ancho" placeholder="Persona, operación o n.º de registro (3 letras o más)" aria-label="Buscar en la bitácora" data-bit-q />
      <select class="field" aria-label="Módulo" data-bit-tabla><option value="">Todos los módulos</option>{modulos.map(([k, v]) => <option value={k}>{v}</option>)}</select>
      <input type="date" class="field" aria-label="Desde" data-bit-desde data-no-cuenta />
      <input type="date" class="field" aria-label="Hasta" data-bit-hasta data-no-cuenta />
    </Filtros>

    <p class="hidden rounded-control bg-warn-soft px-4 py-3 text-sm font-medium text-warn" role="status" data-bit-aviso></p>

    <div class="tabla-apilable" role="region" aria-label="Entradas de la bitácora" tabindex="0">
      <table class="w-full min-w-[44rem] text-left text-sm">
        <thead class="border-b border-line bg-sunken text-xs uppercase text-ink-3">
          <tr>
            <th class="p-3 font-bold">Fecha y hora</th>
            <th class="p-3 font-bold">Operación</th>
            <th class="p-3 font-bold">Módulo</th>
            <th class="p-3 font-bold">Persona</th>
            {alcance === 'red' && <th class="p-3 font-bold">Sede</th>}
            <th class="p-3 font-bold">Detalle</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line" data-bit-filas></tbody>
      </table>
    </div>
    <p class="hidden py-8 text-center text-sm text-ink-3" data-bit-vacio>No hay entradas que coincidan con los filtros.</p>
    <PaginasCursor etiqueta="Páginas de la bitácora" anterior="Más recientes" siguiente="Más antiguas" />
  </section>
</div>

<script>
  import { BitacoraNoDisponible, MIN_BUSQUEDA, POR_PAGINA, moduloDe, operacionDe, paginaBitacora, resumenDetalle, tonoOperacion } from '../../lib/bitacora';
  import type { EntradaBitacora, FiltrosBitacora } from '../../lib/bitacora';
  import { downloadFile, esc, hoyISO, sumarDias, toCSV, toast } from '../../lib/ui';

  const fmt = (iso: string) => {
    const d = new Date(iso.length === 10 ? iso + 'T00:00:00' : iso);
    if (isNaN(d.getTime())) return iso;
    const f = d.toLocaleDateString('es-VE', { day: 'numeric', month: 'short', year: 'numeric' });
    return iso.length === 10 ? f : `${f} · ${d.toLocaleTimeString('es-VE', { hour: '2-digit', minute: '2-digit', hour12: false })}`;
  };

  function init() {
    const raiz = document.querySelector<HTMLElement>('[data-bitacora]');
    if (!raiz || raiz.dataset.ready) return;
    raiz.dataset.ready = '1';
    const q = <T extends HTMLElement = HTMLElement>(s: string) => raiz.querySelector<T>(s)!;
    const conSede = raiz.querySelectorAll('thead th').length === 6;
    // Por defecto, los últimos 30 días: la consulta inicial es pequeña.
    q<HTMLInputElement>('[data-bit-hasta]').value = hoyISO();
    q<HTMLInputElement>('[data-bit-desde]').value = sumarDias(hoyISO(), -30);

    /** Cursores de cada página visitada: cursores[i] abre la página i (null = la primera). */
    let cursores: (string | null)[] = [null];
    let pagina = 0;
    let siguiente: string | null = null;
    let items: EntradaBitacora[] = [];
    let peticion = 0;

    const filtros = (): FiltrosBitacora => ({
      q: q<HTMLInputElement>('[data-bit-q]').value,
      tabla: q<HTMLSelectElement>('[data-bit-tabla]').value,
      desde: q<HTMLInputElement>('[data-bit-desde]').value,
      hasta: q<HTMLInputElement>('[data-bit-hasta]').value,
    });

    const fila = (e: EntradaBitacora) => `<tr class="align-top">
      <td class="p-3 celda-titulo celda-corta whitespace-nowrap tabular" data-label="Fecha">${esc(fmt(String(e.fecha)))}</td>
      <td class="p-3 celda-estado" data-label="Operación"><span class="inline-flex items-center gap-2 font-semibold text-ink"><span class="size-2 shrink-0 rounded-full ${tonoOperacion(e.operacion)}" aria-hidden="true"></span>${esc(operacionDe(e.operacion))}</span></td>
      <td class="p-3 text-ink-2" data-label="Módulo">${esc(moduloDe(e.tabla))}${e.registro != null ? ` <span class="text-ink-3 tabular">#${esc(e.registro)}</span>` : ''}</td>
      <td class="p-3" data-label="Persona"><span class="block text-ink">${esc(e.usuario || 'Sistema')}</span>${e.correo ? `<span class="block text-xs text-ink-3">${esc(e.correo)}</span>` : ''}</td>
      ${conSede ? `<td class="p-3 text-ink-2" data-label="Sede">${esc(e.sede ?? '—')}</td>` : ''}
      <td class="p-3 celda-ancha text-xs text-ink-2" data-label="Detalle">${esc(resumenDetalle(e.detalle)) || '—'}</td>
    </tr>`;

    const botones = (cargando: boolean) => {
      q<HTMLButtonElement>('[data-pag-ant]').disabled = cargando || pagina === 0;
      q<HTMLButtonElement>('[data-pag-sig]').disabled = cargando || !siguiente;
    };

    const pintar = () => {
      q('[data-bit-filas]').innerHTML = items.map(fila).join('');
      q('[data-bit-vacio]').classList.toggle('hidden', items.length > 0);
      const desde = pagina * POR_PAGINA + 1;
      q('[data-pag-estado]').textContent = items.length
        ? `Página ${pagina + 1} · entradas ${desde}–${desde + items.length - 1}${siguiente ? '' : ' (últimas)'}`
        : '';
      botones(false);
    };

    /** Carga la página n con los filtros actuales. Solo se pinta la respuesta de la última petición. */
    const ir = async (n: number) => {
      const yo = ++peticion;
      botones(true);
      q('[data-bit-filas]').setAttribute('aria-busy', 'true');
      try {
        const r = await paginaBitacora(filtros(), cursores[n] ?? null);
        if (yo !== peticion) return;
        pagina = n;
        items = r.items;
        siguiente = r.siguiente;
        cursores = cursores.slice(0, n + 1);
        if (siguiente) cursores[n + 1] = siguiente;
        q('[data-bit-aviso]').classList.add('hidden');
        pintar();
        if (n > 0) raiz.querySelector('.tabla-apilable')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
      } catch (e) {
        if (yo !== peticion) return;
        const aviso = q('[data-bit-aviso]');
        aviso.textContent = e instanceof BitacoraNoDisponible
          ? 'La bitácora todavía no está habilitada en el servidor. Los registros se siguen guardando y aparecerán aquí cuando se active.'
          : (e as Error).message;
        aviso.classList.remove('hidden');
        items = [];
        siguiente = null;
        pintar();
        q('[data-bit-vacio]').classList.add('hidden');
      } finally {
        q('[data-bit-filas]').removeAttribute('aria-busy');
      }
    };
    /** Con filtros nuevos se vuelve a la primera página. */
    const reiniciar = () => { cursores = [null]; ir(0); };

    let t: number | undefined;
    let ultimaBusqueda = '';
    q('[data-bit-q]').addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        const v = q<HTMLInputElement>('[data-bit-q]').value.trim();
        const efectiva = v.length >= MIN_BUSQUEDA ? v : '';
        if (efectiva === ultimaBusqueda) return; // 1 o 2 letras no disparan consultas
        ultimaBusqueda = efectiva;
        reiniciar();
      }, 400);
    });
    ['[data-bit-tabla]', '[data-bit-desde]', '[data-bit-hasta]'].forEach((s) => q(s).addEventListener('change', reiniciar));
    q('[data-pag-ant]').addEventListener('click', () => ir(pagina - 1));
    q('[data-pag-sig]').addEventListener('click', () => ir(pagina + 1));
    q('[data-bit-csv]').addEventListener('click', () => {
      if (!items.length) return toast('No hay entradas para exportar.');
      const rows = items.map((e) => ({
        Fecha: e.fecha, Operacion: operacionDe(e.operacion), Codigo: e.operacion, Modulo: moduloDe(e.tabla), Registro: e.registro ?? '',
        Persona: e.usuario ?? '', Correo: e.correo ?? '', Sede: e.sede ?? '', Detalle: resumenDetalle(e.detalle),
      }));
      downloadFile(`blud-bitacora-pagina-${pagina + 1}-${hoyISO()}.csv`, toCSV(rows), 'text/csv');
    });
    ir(0);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
