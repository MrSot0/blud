---
// Marca BLUD: gota en cuadro rojo + logotipo. Única fuente del logo
// para Navbar, Footer y páginas de acceso.
interface Props {
  href?: string;
  tone?: 'ink' | 'light';
  class?: string;
}

const { href = '/', tone = 'ink', class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={['group inline-flex items-center gap-2.5 rounded-control', className]}
  aria-label="BLUD, ir al inicio"
>
  <span class="grid size-9 place-items-center rounded-[10px] bg-accent text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.2)] transition-transform duration-300 ease-(--ease-out) group-hover:-rotate-6">
    <svg xmlns="http://www.w3.org/2000/svg" class="size-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
    </svg>
  </span>
  <span
    class:list={[
      'text-[1.375rem] font-extrabold tracking-[-0.04em] leading-none',
      tone === 'light' ? 'text-white' : 'text-ink',
    ]}
  >
    BLUD<span class="text-accent">.</span>
  </span>
</a>
