---
// Marca BLUD: gota en cuadro rojo + logotipo. Única fuente del logo
// para Navbar, Footer y páginas de acceso.
interface Props {
  href?: string;
  tone?: 'ink' | 'light';
  size?: 'md' | 'lg';
  class?: string;
}

const { href = '/', tone = 'ink', size = 'md', class: className = '' } = Astro.props;
const large = size === 'lg';
---

<a
  href={href}
  class:list={['group inline-flex items-center gap-2.5 rounded-control', className]}
  aria-label="BLUD, ir al inicio"
>
  <span
    class:list={[
      'grid place-items-center rounded-[10px] shadow-[inset_0_1px_0_rgb(255_255_255/0.2)] transition-transform duration-300 ease-(--ease-out) group-hover:-rotate-6',
      tone === 'light' ? 'bg-white text-accent' : 'bg-accent text-white',
      large ? 'size-10' : 'size-9',
    ]}
  >
    <svg xmlns="http://www.w3.org/2000/svg" class:list={['fill-current', large ? 'size-[1.375rem]' : 'size-5']} viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
    </svg>
  </span>
  <span
    class:list={[
      'font-extrabold tracking-[-0.04em] leading-none',
      large ? 'text-[1.5rem]' : 'text-[1.375rem]',
      tone === 'light' ? 'text-white' : 'text-ink',
    ]}
  >
    BLUD<span class={tone === 'light' ? 'text-white/70' : 'text-accent'}>.</span>
  </span>
</a>