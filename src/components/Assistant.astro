---
// Assistant.astro - Botón flotante de Bluddie, el asistente de IA de BLUD.
// Habla con /api/chat (Gemini en el servidor). La conversación se guarda solo en esta pestaña.
import Icon from './Icon.astro';

const examples = [
  '¿Puedo donar si me hice un tatuaje?',
  '¿Qué centro está abierto cerca de mí?',
  '¿Qué debo comer antes de donar?',
];
---

<div class="assistant" data-assistant>
  <div
    id="assistant-panel"
    class="assistant-panel panel fixed bottom-[calc(max(1rem,env(safe-area-inset-bottom))+4.75rem)] right-4 z-30 flex h-[min(36rem,calc(100dvh-10rem))] w-[min(23rem,calc(100vw-2rem))] flex-col overflow-hidden sm:bottom-[6.5rem] sm:right-6"
    role="dialog"
    aria-modal="false"
    aria-labelledby="assistant-title"
    data-open="false"
    inert
  >
    <header class="flex items-center gap-3 border-b border-line px-4 py-3.5">
      <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent-soft">
        <svg class="size-7" viewBox="0 0 48 48" aria-hidden="true">
          <use href="#bluddie" />
        </svg>
      </span>
      <div class="min-w-0 flex-1">
        <p id="assistant-title" class="font-bold leading-tight text-ink">Bluddie</p>
        <p class="flex items-center gap-1.5 text-xs text-ink-3">
          <span class="size-1.5 rounded-full bg-ok" aria-hidden="true"></span>
          Asistente de BLUD con IA
        </p>
      </div>
      <button
        type="button"
        data-assistant-reset
        class="grid size-9 shrink-0 place-items-center rounded-control text-ink-2 transition-colors hover:bg-sunken hover:text-ink"
        aria-label="Empezar una conversación nueva"
        title="Conversación nueva"
      >
        <Icon name="arrow-clockwise" class="size-[1.125rem]" />
      </button>
      <button
        type="button"
        data-assistant-close
        class="-mr-1.5 grid size-9 shrink-0 place-items-center rounded-control text-ink-2 transition-colors hover:bg-sunken hover:text-ink"
        aria-label="Cerrar asistente"
      >
        <Icon name="x" class="size-5" />
      </button>
    </header>

    <div id="assistant-scroll" class="flex-1 overflow-y-auto overscroll-contain bg-canvas px-4 py-5">
      <ol id="assistant-messages" class="flex flex-col gap-3" aria-live="polite">
        <li class="msg msg-model">
          ¡Hola! Soy Bluddie. Puedo ayudarte con requisitos para donar, cómo prepararte y los centros de la red.
        </li>
      </ol>

      <div id="assistant-examples" class="mt-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-3">Prueba a preguntarme</p>
        <ul class="mt-2 grid gap-1.5">
          {examples.map((example) => (
            <li>
              <button
                type="button"
                data-example
                class="w-full rounded-control border border-line-strong bg-surface px-3 py-2 text-left text-sm text-ink-2 transition-colors hover:border-ink-3 hover:text-ink"
              >
                {example}
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <form id="assistant-form" class="border-t border-line p-3" novalidate>
      <div class="flex items-center gap-2">
        <label for="assistant-input" class="sr-only">Mensaje para Bluddie</label>
        <input
          id="assistant-input"
          type="text"
          maxlength="800"
          autocomplete="off"
          placeholder="Escribe tu pregunta…"
          class="field min-h-11 flex-1 text-base sm:text-sm"
        />
        <button type="submit" disabled class="btn btn-primary size-11 shrink-0 px-0" aria-label="Enviar">
          <Icon name="arrow-right" class="size-5" />
        </button>
      </div>
      <p class="mt-2 text-center text-[0.6875rem] leading-snug text-ink-3">
        Bluddie puede equivocarse y no reemplaza al personal médico. Emergencias: 911.
      </p>
    </form>
  </div>

  <button
    type="button"
    id="assistant-trigger"
    class="assistant-trigger fixed bottom-[max(1rem,env(safe-area-inset-bottom))] right-4 z-30 grid size-[3.75rem] place-items-center rounded-full border border-line bg-surface sm:bottom-6 sm:right-6"
    aria-expanded="false"
    aria-controls="assistant-panel"
    aria-label="Abrir el asistente de BLUD"
  >
    <svg class="bluddie size-10" viewBox="0 0 48 48" aria-hidden="true"><use href="#bluddie" /></svg>
  </button>

  <!-- Bluddie: gota de sangre con carita. Se reutiliza con <use href="#bluddie">. -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="bluddie-shade" cx="35%" cy="35%" r="75%">
        <stop offset="0" stop-color="#E5484D" />
        <stop offset="1" stop-color="#B42121" />
      </radialGradient>
    </defs>
    <symbol id="bluddie" viewBox="0 0 48 48">
      <path d="M24 3.5c-1.2 1.6-14 17-14 27.2A14 14 0 0 0 24 44.7a14 14 0 0 0 14-14C38 20.5 25.2 5.1 24 3.5Z" fill="url(#bluddie-shade)" />
      <ellipse cx="17.6" cy="20" rx="2.4" ry="4.2" transform="rotate(28 17.6 20)" fill="#fff" opacity="0.35" />
      <g class="bluddie-eyes" fill="#1A202C">
        <ellipse cx="19" cy="29.5" rx="2" ry="2.7" />
        <ellipse cx="29" cy="29.5" rx="2" ry="2.7" />
      </g>
      <circle cx="15.6" cy="34" r="2" fill="#FF9A9A" opacity="0.55" />
      <circle cx="32.4" cy="34" r="2" fill="#FF9A9A" opacity="0.55" />
      <path d="M20.5 35.2c1.9 2.2 5.1 2.2 7 0" fill="none" stroke="#1A202C" stroke-width="1.9" stroke-linecap="round" />
    </symbol>
  </svg>
</div>

<style>
  .assistant-trigger {
    box-shadow:
      0 1px 2px hsl(var(--shadow-tint) / 0.08),
      0 14px 30px -12px hsl(var(--shadow-tint) / 0.45);
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms ease;
  }
  .assistant-trigger:active {
    transform: scale(0.94);
  }
  @media (hover: hover) {
    .assistant-trigger:hover {
      transform: translateY(-2px);
    }
    .assistant-trigger:hover .bluddie {
      animation: bluddie-wiggle 700ms var(--ease-out);
    }
  }
  .bluddie {
    transform-origin: 50% 90%;
  }
  @keyframes bluddie-wiggle {
    0%, 100% { transform: rotate(0); }
    30% { transform: rotate(-9deg); }
    60% { transform: rotate(6deg); }
  }

  /* Parpadeo ocasional (se aplica a todas las copias del símbolo). */
  .bluddie-eyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: bluddie-blink 5s infinite;
  }
  @keyframes bluddie-blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }

  .assistant-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(10px) scale(0.96);
    transform-origin: bottom right;
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 0s linear 150ms;
  }
  .assistant-panel[data-open="true"] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 200ms ease,
      transform 260ms var(--ease-out);
  }

  /* Burbujas del chat (también las que crea el script). */
  .assistant :global(.msg) {
    max-width: 85%;
    padding: 0.625rem 0.875rem;
    border-radius: 16px;
    font-size: 0.875rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    animation: msg-in 260ms var(--ease-out) both;
  }
  .assistant :global(.msg-model) {
    align-self: flex-start;
    border: 1px solid var(--line);
    border-bottom-left-radius: 6px;
    background: var(--surface);
    color: var(--ink);
  }
  .assistant :global(.msg-user) {
    align-self: flex-end;
    border-bottom-right-radius: 6px;
    background: var(--accent);
    color: #fff;
  }
  .assistant :global(.msg-error) {
    align-self: flex-start;
    border-bottom-left-radius: 6px;
    background: var(--warn-soft);
    color: var(--warn);
  }
  @keyframes msg-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  .assistant :global(.typing) {
    display: inline-flex;
    gap: 4px;
    padding-block: 0.25rem;
  }
  .assistant :global(.typing span) {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--ink-3);
    animation: typing 1.1s ease-in-out infinite;
  }
  .assistant :global(.typing span:nth-child(2)) { animation-delay: 150ms; }
  .assistant :global(.typing span:nth-child(3)) { animation-delay: 300ms; }
  @keyframes typing {
    0%, 60%, 100% { opacity: 0.35; transform: none; }
    30% { opacity: 1; transform: translateY(-3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bluddie-eyes { animation: none; }
    .assistant-panel,
    .assistant-panel[data-open="true"] { transform: none; }
  }
</style>

<script>
  type ChatMessage = { role: 'user' | 'model'; text: string };

  const STORAGE_KEY = 'blud-chat';

  const trigger = document.getElementById('assistant-trigger');
  const panel = document.getElementById('assistant-panel');
  const root = document.querySelector<HTMLElement>('[data-assistant]');
  const list = document.getElementById('assistant-messages');
  const scroller = document.getElementById('assistant-scroll');
  const examples = document.getElementById('assistant-examples');
  const form = document.getElementById('assistant-form') as HTMLFormElement | null;
  const input = document.getElementById('assistant-input') as HTMLInputElement | null;

  if (trigger && panel && root && list && scroller && examples && form && input) {
    const sendBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const greeting = list.firstElementChild!.cloneNode(true);
    let history: ChatMessage[] = [];
    let sending = false;

    try {
      history = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '[]');
    } catch {}

    const save = () => {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(history.slice(-30)));
      } catch {}
    };

    const scrollToEnd = () => scroller.scrollTo({ top: scroller.scrollHeight });

    function bubble(kind: 'user' | 'model' | 'error', text: string) {
      const li = document.createElement('li');
      li.className = `msg msg-${kind}`;
      li.textContent = text;
      list!.appendChild(li);
      scrollToEnd();
      return li;
    }

    function render() {
      list!.replaceChildren(greeting.cloneNode(true));
      history.forEach((m) => bubble(m.role, m.text));
      examples!.hidden = history.length > 0;
    }

    const updateSendState = () => {
      sendBtn.disabled = sending || !input.value.trim();
    };

    async function send(text: string) {
      const question = text.trim();
      if (!question || sending) return;

      sending = true;
      history.push({ role: 'user', text: question });
      save();
      examples!.hidden = true;
      bubble('user', question);
      input!.value = '';
      updateSendState();

      const typing = bubble('model', '');
      typing.innerHTML = '<span class="typing" aria-label="Bluddie está escribiendo"><span></span><span></span><span></span></span>';

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });
        const data = await res.json().catch(() => ({}));
        typing.remove();
        if (!res.ok || !data.reply) throw new Error(data.error || 'No pude responder ahora. Inténtalo de nuevo.');
        history.push({ role: 'model', text: data.reply });
        save();
        bubble('model', data.reply);
      } catch (error) {
        typing.remove();
        // La pregunta sin respuesta sale del historial para no confundir al modelo.
        history.pop();
        save();
        bubble('error', error instanceof Error && error.message !== 'Failed to fetch' ? error.message : 'Sin conexión. Revisa tu internet e inténtalo de nuevo.');
      } finally {
        sending = false;
        updateSendState();
      }
    }

    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      trigger.setAttribute('aria-label', open ? 'Cerrar el asistente de BLUD' : 'Abrir el asistente de BLUD');
      panel.dataset.open = String(open);
      panel.inert = !open;
      if (open) {
        scrollToEnd();
        // En pantallas táctiles no abre el teclado de golpe.
        if (window.matchMedia('(pointer: fine)').matches) input.focus();
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      send(input.value);
    });
    input.addEventListener('input', updateSendState);
    examples.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((btn) =>
      btn.addEventListener('click', () => send(btn.textContent ?? ''))
    );
    panel.querySelector('[data-assistant-reset]')?.addEventListener('click', () => {
      history = [];
      save();
      render();
      input.focus();
    });

    trigger.addEventListener('click', () => setOpen(!isOpen()));
    panel.querySelector('[data-assistant-close]')?.addEventListener('click', () => {
      setOpen(false);
      trigger.focus();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        trigger.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !root.contains(e.target as Node)) setOpen(false);
    });

    render();
  }
</script>
