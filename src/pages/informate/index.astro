---
// Infórmate: sección de artículos. Portada tipo revista con filtros por categoría,
// portadas animadas, brillo que sigue al puntero y entrada escalonada.
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import DropField from '../../components/DropField.astro';
import { infoTopics, infoHref } from '../../data/info';
import type { IconName } from '../../lib/icons';

const topic = (slug: string) => infoTopics.find((t) => t.slug === slug)!;

// Orden de lectura sugerido. El primero es el destacado.
const articulos = [
  { ...topic('viaje-de-tu-sangre'), cat: 'Proceso', cover: 'viaje', destacado: true },
  { ...topic('tipos-de-donacion'), cat: 'Donar', cover: 'tipos', destacado: false },
  { ...topic('primera-donacion'), cat: 'Donar', cover: 'primera', destacado: false },
  { ...topic('sangre-artificial'), cat: 'Ciencia', cover: 'artificial', destacado: false },
  { ...topic('beneficios'), cat: 'Salud', cover: 'beneficios', destacado: false },
];

const categorias = ['Todos', ...new Set(articulos.map((a) => a.cat))];
const cuenta = (c: string) => (c === 'Todos' ? articulos.length : articulos.filter((a) => a.cat === c).length);

const components = [
  { name: 'Sangre total', color: '#B3121B', w: '100%' },
  { name: 'Glóbulos rojos', color: '#7A0610', w: '72%' },
  { name: 'Plasma', color: '#E0A63A', w: '58%' },
  { name: 'Plaquetas', color: '#E9CF7A', w: '40%' },
];
const palabras = ['Infórmate', 'para', 'donar', 'mejor'];
---

<Layout
  title="BLUD | Infórmate"
  description="Artículos sobre la donación de sangre: tipos de donación, tu primera vez, el viaje de tu sangre, la sangre artificial y los beneficios de donar."
>
  <header class="relative isolate overflow-hidden border-b border-line bg-sunken">
    <DropField seed={7} />
    <div class="container-blud relative z-10 grid gap-8 py-14 lg:grid-cols-12 lg:items-end lg:py-20">
      <div class="lg:col-span-8">
        <p class="hub-in inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-sm font-medium text-ink-2" style="--i:0">
          <Icon name="book-open-text" class="size-4 text-accent" />
          Artículos
        </p>
        <h1 class="mt-5 text-[clamp(2.75rem,1.6rem+4.4vw,5rem)] font-extrabold leading-[0.95] tracking-[-0.05em] text-ink" aria-label="Infórmate para donar mejor">
          {palabras.map((p, i) => (
            <><span class={`hub-word ${i === 0 ? 'text-accent' : ''}`} style={`--i:${i + 1}`} aria-hidden="true">{p}</span>{' '}</>
          ))}
        </h1>
        <p class="hub-in mt-5 max-w-[38rem] text-lg leading-relaxed text-ink-2 sm:text-xl" style="--i:5">
          Todo lo que conviene saber antes, durante y después de donar, explicado sin tecnicismos.
        </p>
      </div>
      <p class="hub-in flex items-center gap-2 text-sm text-ink-3 lg:col-span-4 lg:justify-end" style="--i:6">
        {articulos.length} artículos · unos 3 minutos de lectura cada uno
      </p>
    </div>
  </header>

  <section class="py-12 lg:py-16" id="articulos">
    <div class="container-blud">
      <!-- Filtros -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar artículos por categoría" id="filtros">
          {categorias.map((c, i) => (
            <button type="button" class="chip-filtro" data-cat={c} aria-pressed={i === 0 ? 'true' : 'false'}>
              {c}
              <span class="chip-n">{cuenta(c)}</span>
            </button>
          ))}
        </div>
        <p class="text-sm text-ink-3" id="estado-filtro" role="status" aria-live="polite">Mostrando los {articulos.length} artículos</p>
      </div>

      <ul id="arts" class="mt-8 grid list-none gap-5 p-0 md:grid-cols-2 lg:grid-cols-6" data-filtrado="false">
        {articulos.map((a, i) => (
          <li class="art" data-reveal style={`--reveal-delay:${i}`} data-cat={a.cat} data-feat={a.destacado ? '' : undefined}>
            <article class="art-card group" style={`--i:${i}`}>
              <div class="art-cover" aria-hidden="true" data-cover={a.cover}>
                {a.cover === 'viaje' && (
                  <div class="cov cov-viaje">
                    <div class="grain absolute inset-0"></div>
                    <div class="absolute inset-0 bg-[radial-gradient(60%_60%_at_70%_30%,rgb(202_43_43/0.32),transparent_70%)]"></div>
                    <div class="route-mini relative mx-auto aspect-[5/2] w-full max-w-md">
                      <svg viewBox="0 0 400 160" class="absolute inset-0 size-full">
                        <path id="hub-route" d="M 30 120 C 90 120, 90 40, 150 40 S 210 120, 270 120 S 330 40, 370 40" fill="none" stroke="rgb(255 255 255 / 0.2)" stroke-width="2" stroke-dasharray="2 7" stroke-linecap="round" />
                        <circle r="7" fill="#F2605A">
                          <animateMotion dur="5s" repeatCount="indefinite" calcMode="spline" keyPoints="0;1" keyTimes="0;1" keySplines="0.45 0 0.2 1">
                            <mpath href="#hub-route" />
                          </animateMotion>
                        </circle>
                      </svg>
                      {([['drop', 7.5, 75], ['microscope', 37.5, 25], ['snowflake', 67.5, 75], ['hospital', 92.5, 25]] as [IconName, number, number][]).map(([icon, x, y], k) => (
                        <span class="cov-nodo absolute grid size-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-white/15 bg-night-2 text-white/80" style={`left:${x}%; top:${y}%; --k:${k}`}>
                          <Icon name={icon} class="size-5" />
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {a.cover === 'tipos' && (
                  <div class="cov cov-tipos">
                    <ul class="grid w-full gap-2.5">
                      {components.map((c, k) => (
                        <li class="flex items-center gap-3">
                          <span class="cov-barra h-2.5 rounded-full" style={`--w:${c.w}; background:${c.color}; --k:${k}`}></span>
                          <span class="shrink-0 text-xs text-ink-3">{c.name}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {a.cover === 'primera' && (
                  <div class="cov cov-primera">
                    <div class="flex w-full max-w-sm items-end gap-4">
                      <p class="text-6xl font-extrabold leading-none tracking-[-0.06em] text-accent-ink">1 h</p>
                      <div class="mb-1.5 flex flex-1 gap-1">
                        {[10, 15, 10, 15].map((m, k) => (
                          <span class="cov-seg h-2 rounded-full bg-accent" style={`flex:${m}; --k:${k}`}></span>
                        ))}
                      </div>
                      <Icon name="check-circle" class="cov-ok mb-0 size-7 text-accent" />
                    </div>
                  </div>
                )}

                {a.cover === 'artificial' && (
                  <div class="cov cov-artificial">
                    <span class="absolute left-5 top-5 inline-flex w-fit items-center gap-1.5 rounded-md bg-white/10 px-2 py-1 text-xs font-semibold text-[#E6CCF5]">
                      <Icon name="flask" class="size-3.5" />
                      En ensayo clínico
                    </span>
                    <div class="relative size-36" aria-hidden="true">
                      <span class="cov-ves absolute right-4 top-4 size-24 rounded-full border-[5px] border-dotted border-[#D7B3EE]/60 bg-[radial-gradient(circle_at_40%_35%,#9B5CC0,#4A1F66)]"></span>
                      <span class="cov-ves absolute bottom-1 left-2 size-10 rounded-full border-[3px] border-dotted border-[#D7B3EE]/50 bg-[#6D3590]" style="--d:-2s"></span>
                      <span class="cov-ves absolute right-0 top-0 size-6 rounded-full border-2 border-dotted border-[#D7B3EE]/50 bg-[#6D3590]" style="--d:-4s"></span>
                    </div>
                  </div>
                )}

                {a.cover === 'beneficios' && (
                  <div class="cov cov-beneficios">
                    <div class="flex items-center gap-4 text-ink">
                      <span class="cov-gota grid size-14 place-items-center rounded-full bg-accent text-white">
                        <Icon name="drop-fill" class="size-6" />
                      </span>
                      <Icon name="arrow-right" class="size-5 text-ink-3" />
                      <div class="flex -space-x-2">
                        {[0, 1, 2].map((k) => (
                          <span class="cov-corazon grid size-11 place-items-center rounded-full border-2 border-surface bg-sunken text-accent" style={`--k:${k}`}>
                            <Icon name="heart" class="size-5" />
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>
                )}
              </div>

              <div class="art-body">
                <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold uppercase tracking-[0.08em] text-ink-3">
                  <span class="rounded-md bg-accent-soft px-2 py-0.5 text-accent-ink">{a.cat}</span>
                  {a.destacado && <span class="text-accent-ink">Destacado</span>}
                  <span class="font-medium normal-case tracking-normal">≈ 3 min</span>
                </p>
                <h2 class="mt-3 text-2xl font-bold leading-tight tracking-[-0.03em] text-ink lg:text-[1.65rem]">
                  <a href={infoHref(a.slug)} class="art-link">{a.title}</a>
                </h2>
                <p class="mt-2 leading-relaxed text-ink-2">{a.short}</p>
                <span class="art-cta mt-5 inline-flex items-center gap-2 font-semibold text-accent-ink" aria-hidden="true">
                  Leer artículo
                  <Icon name="arrow-right" class="size-4" />
                </span>
              </div>
            </article>
          </li>
        ))}
      </ul>

      <p id="vacio" class="mt-8 hidden text-ink-2">No hay artículos en esta categoría todavía.</p>

      <p class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-6 text-ink-2">
        ¿Buscas algo concreto?
        <a href="/#faq" class="link-arrow">Preguntas frecuentes <Icon name="arrow-right" class="size-4" /></a>
        <a href="/elegibilidad" class="link-arrow">Test de elegibilidad <Icon name="arrow-right" class="size-4" /></a>
        <a href="/proceso" class="link-arrow">El viaje de una bolsa, paso a paso <Icon name="arrow-right" class="size-4" /></a>
      </p>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Cabecera ---------- */
  .hub-in { animation: hub-in 800ms var(--ease-out) both; animation-delay: calc(80ms + var(--i) * 90ms); }
  .hub-word { display: inline-block; animation: hub-word 800ms var(--ease-out) both; animation-delay: calc(120ms + var(--i) * 100ms); }
  @keyframes hub-in { from { opacity: 0; transform: translateY(14px); } }
  @keyframes hub-word { from { opacity: 0; transform: translateY(0.5em) rotate(3deg); filter: blur(6px); } }

  /* ---------- Filtros ---------- */
  .chip-filtro {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.9rem; border-radius: 999px; border: 1px solid var(--line);
    background: var(--surface); color: var(--ink-2); font-size: 0.9375rem; font-weight: 600;
    transition: transform 200ms var(--ease-out), background 200ms, color 200ms, border-color 200ms, box-shadow 200ms;
  }
  .chip-filtro:hover { border-color: var(--line-strong); color: var(--ink); transform: translateY(-1px); }
  .chip-filtro:active { transform: scale(0.96); }
  .chip-filtro[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: #fff; box-shadow: 0 10px 22px -12px var(--accent); }
  .chip-n { display: inline-grid; place-items: center; min-width: 1.35rem; height: 1.35rem; padding: 0 0.3rem; border-radius: 999px; background: var(--sunken); color: var(--ink-3); font-size: 0.75rem; transition: background 200ms, color 200ms; }
  .chip-filtro[aria-pressed='true'] .chip-n { background: rgb(255 255 255 / 0.22); color: #fff; }

  /* ---------- Rejilla: destacado a todo lo ancho solo sin filtro ---------- */
  .art { grid-column: span 1 / span 1; }
  @media (min-width: 768px) and (max-width: 1023px) { .art[data-feat] { grid-column: span 2 / span 2; } }
  @media (min-width: 1024px) {
    .art { grid-column: span 2 / span 2; }
    #arts[data-filtrado='false'] .art[data-feat] { grid-column: span 4 / span 4; }
  }
  .art[hidden] { display: none; }

  /* ---------- Tarjeta ---------- */
  .art-card {
    position: relative; isolation: isolate; display: flex; flex-direction: column; height: 100%;
    overflow: hidden; border-radius: var(--radius-panel, 1.5rem); border: 1px solid var(--line); background: var(--surface);
    transition: transform 350ms var(--ease-out), box-shadow 350ms ease, border-color 200ms ease, opacity 220ms ease;
  }
  .art-card::after {
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0; transition: opacity 300ms ease;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 0%), rgb(202 43 43 / 0.11), transparent 70%);
  }
  @media (hover: hover) {
    .art-card:hover { transform: translateY(-5px); border-color: var(--line-strong); box-shadow: 0 26px 48px -30px hsl(var(--shadow-tint) / 0.55); }
    .art-card:hover::after { opacity: 1; }
  }
  .art-card:active { transform: scale(0.99); }
  .art-card:has(.art-link:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .art-card.sale { opacity: 0; transform: scale(0.94) translateY(8px); }
  .art-card.entra { animation: art-entra 520ms var(--ease-out) both; animation-delay: calc(var(--i) * 70ms); }
  @keyframes art-entra { from { opacity: 0; transform: translateY(18px) scale(0.97); } }

  .art-link { color: inherit; text-decoration: none; }
  .art-link::after { content: ''; position: absolute; inset: 0; z-index: 3; }

  .art-cover { position: relative; flex: none; height: 13.5rem; overflow: hidden; }
  .cov { position: absolute; inset: 0; display: grid; place-items: center; padding: 1.5rem; transition: transform 600ms var(--ease-out); }
  .art-card:hover .cov { transform: scale(1.045); }
  .cov-viaje { background: var(--night); }
  .cov-tipos { background: linear-gradient(135deg, var(--sunken), var(--surface)); }
  .cov-primera { background: var(--accent-soft); }
  .cov-artificial { background: #2A1438; }
  .cov-beneficios { background: linear-gradient(135deg, var(--surface), var(--sunken)); }

  .art-body { position: relative; display: flex; flex: 1; flex-direction: column; padding: 1.5rem 1.5rem 1.75rem; }
  .art-cta { margin-top: auto; padding-top: 1.25rem; }
  .art-cta :global(svg) { transition: transform 250ms var(--ease-out); }
  .art-card:hover .art-cta :global(svg) { transform: translateX(5px); }

  @media (min-width: 1024px) {
    #arts[data-filtrado='false'] .art[data-feat] .art-card { flex-direction: row; }
    #arts[data-filtrado='false'] .art[data-feat] .art-cover { flex: 3 1 0; height: auto; min-height: 24rem; }
    #arts[data-filtrado='false'] .art[data-feat] .art-body { flex: 2 1 0; justify-content: center; padding: 2.5rem; }
    #arts[data-filtrado='false'] .art[data-feat] h2 { font-size: 2.25rem; }
  }

  /* ---------- Portadas animadas ---------- */
  .cov-nodo { animation: nodo 4s ease-in-out infinite; animation-delay: calc(var(--k) * 0.5s); }
  @keyframes nodo { 0%, 100% { box-shadow: 0 0 0 0 rgb(242 96 90 / 0); } 50% { box-shadow: 0 0 0 7px rgb(242 96 90 / 0.18); } }

  .cov-barra { width: calc(var(--w) * 0.7); transform-origin: left; animation: barra 3.8s ease-in-out infinite alternate; animation-delay: calc(var(--k) * 0.4s); }
  @keyframes barra { from { transform: scaleX(0.25); } to { transform: scaleX(1); } }

  .cov-seg { opacity: 0.25; animation: seg 5.6s ease-in-out infinite; animation-delay: calc(var(--k) * 0.6s); }
  @keyframes seg { 0%, 8% { opacity: 0.25; transform: scaleY(1); } 22%, 70% { opacity: 1; transform: scaleY(1.5); } 90%, 100% { opacity: 0.25; transform: scaleY(1); } }
  .cov-ok { animation: ok 5.6s ease-in-out infinite; }
  @keyframes ok { 0%, 55% { opacity: 0; transform: scale(0.3) rotate(-30deg); } 70%, 90% { opacity: 1; transform: none; } 100% { opacity: 0; } }

  .cov-ves { animation: flota-ves 7s ease-in-out infinite; animation-delay: var(--d, 0s); }
  @keyframes flota-ves { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-7px, 9px); } }

  .cov-gota { animation: gota 3.2s ease-in-out infinite; }
  @keyframes gota { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  .cov-corazon { animation: late 3.2s ease-in-out infinite; animation-delay: calc(var(--k) * 0.25s + 0.4s); }
  @keyframes late { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.22); } 30% { transform: scale(1); } }

  @media (prefers-reduced-motion: reduce) {
    .hub-in, .hub-word, .art-card.entra { animation: none; }
    .cov, .cov-nodo, .cov-barra, .cov-seg, .cov-ok, .cov-ves, .cov-gota, .cov-corazon { animation: none; transition: none; }
    .cov-ok { opacity: 1; }
    .cov-seg { opacity: 1; }
  }
</style>

<script>
  const lista = document.getElementById('arts') as HTMLElement;
  const items = [...lista.querySelectorAll<HTMLElement>('.art')];
  const botones = [...document.querySelectorAll<HTMLButtonElement>('.chip-filtro')];
  const estado = document.getElementById('estado-filtro')!;
  const vacio = document.getElementById('vacio')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const total = items.length;

  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('.route-mini svg').forEach((svg) => svg.pauseAnimations());
  }

  // Brillo que sigue al puntero.
  items.forEach((li) => {
    const card = li.querySelector<HTMLElement>('.art-card')!;
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  // Filtro por categoría: salen las que no coinciden y las demás vuelven a entrar escalonadas.
  let activa = 'Todos';
  const aplicar = (cat: string) => {
    if (cat === activa) return;
    activa = cat;
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
    const ver = items.filter((li) => cat === 'Todos' || li.dataset.cat === cat);

    const mostrar = () => {
      items.forEach((li) => { li.hidden = !ver.includes(li); });
      lista.dataset.filtrado = String(cat !== 'Todos');
      ver.forEach((li, i) => {
        const card = li.querySelector<HTMLElement>('.art-card')!;
        card.classList.remove('sale', 'entra');
        if (reduce) return;
        card.style.setProperty('--i', String(i));
        void card.offsetWidth;
        card.classList.add('entra');
      });
      vacio.classList.toggle('hidden', ver.length > 0);
      estado.textContent = cat === 'Todos' ? `Mostrando los ${total} artículos` : `Mostrando ${ver.length} de ${total}: ${cat}`;
    };

    if (reduce) return mostrar();
    items.forEach((li) => { if (!li.hidden) li.querySelector('.art-card')!.classList.add('sale'); });
    setTimeout(mostrar, 220);
  };
  botones.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.cat!)));
</script>
