---
// src/pages/operador/entregas.astro
import LayoutOperador from '../../layouts/LayoutOperador.astro';
import SeguridadTransfusional from '../../components/app/SeguridadTransfusional.astro';
import { BLOOD_TYPES, COMPONENTES } from '../../lib/db';
---

<LayoutOperador title="BLUD | Entregas">
  <div class="container-blud py-8 space-y-8">
    <div class="flex flex-col gap-4 pb-6 border-b border-line">
      <div class="min-w-0">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Despachos</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Despacha las solicitudes de tu hospital con la compatibilidad lista y los pedidos que otro centro le hizo al tuyo. El stock se descuenta solo.</p>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div id="vistas" class="flex flex-wrap gap-2" role="group" aria-label="Mostrar sección">
          <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="pedidos" aria-pressed="false">
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 11h-6"/></svg>
            Por despachar <span class="rounded-full bg-sunken px-2 py-0.5 text-xs font-bold text-ink-2 tabular" data-cuenta="pedidos">0</span>
          </button>
          <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="salida" aria-pressed="false">
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m12 8-4 4 4 4"/><path d="M16 12H8"/></svg>
            Salida directa
          </button>
          <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="historial" aria-pressed="false">
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/></svg>
            Historial de despachos <span class="rounded-full bg-sunken px-2 py-0.5 text-xs font-bold text-ink-2 tabular" data-cuenta="historial">0</span>
          </button>
        </div>
        <a href="/operador/prescribir" class="btn btn-secondary btn-sm self-start sm:self-auto">Cargar orden médica</a>
      </div>
    </div>

    <SeguridadTransfusional role="operador" />

    <!-- Vista: Solicitudes aprobadas por despachar -->
    <div data-frame="pedidos" class="space-y-8">
      <section class="panel p-6 sm:p-8 space-y-4 w-full" aria-labelledby="h-ped">
        <h2 id="h-ped" class="text-lg font-bold text-ink border-b border-line pb-3">Solicitudes de tu hospital <span class="text-ink-3 text-sm font-semibold">(<span id="n-ped">0</span>)</span></h2>
        <p class="text-xs text-ink-3">Tienen unidades reservadas. Se despachan cuando el laboratorio deja lista la compatibilidad.</p>
        <ul id="pedidos" class="grid gap-3 md:grid-cols-2"></ul>
        <p id="sin-pedidos" class="hidden py-4 text-center text-sm text-ink-3">No hay solicitudes con unidades reservadas.</p>
      </section>

      <section class="panel p-6 sm:p-8 space-y-4 w-full" aria-labelledby="h-centros" id="sec-centros" hidden>
        <div class="border-b border-line pb-3">
          <h2 id="h-centros" class="text-lg font-bold text-ink">Pedidos entre centros <span class="text-ink-3 text-sm font-semibold">(<span id="n-centros">0</span>)</span></h2>
          <p class="mt-1 text-sm text-ink-3">Aprobados por tu dirección para enviar a otro centro, y los que vienen en camino hacia el tuyo.</p>
        </div>
        <ul id="centros" class="grid gap-3 md:grid-cols-2"></ul>
        <p id="sin-centros" class="hidden py-4 text-center text-sm text-ink-3">No hay pedidos entre centros por despachar ni por recibir.</p>
      </section>

      <section class="panel p-6 sm:p-8 space-y-4 w-full" aria-labelledby="h-espera">
        <div class="border-b border-line pb-3">
          <h2 id="h-espera" class="text-lg font-bold text-ink">En espera de stock</h2>
          <p class="mt-1 text-sm text-ink-3">Tu sede no tenía unidades compatibles al registrarlas. Reintenta la reserva cuando entre stock; la dirección puede pedirlas a otro centro.</p>
        </div>
        <ul id="espera" class="divide-y divide-line"></ul>
      </section>
    </div>

    <!-- Vista: Salida directa -->
    <div data-frame="salida" class="hidden">
      <section class="panel p-6 sm:p-8 space-y-6 w-full">
        <h2 class="text-lg font-bold text-ink border-b border-line pb-3">Salida directa</h2>
        <form id="form" class="space-y-4" novalidate>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="paciente" class="block text-xs font-bold uppercase text-ink-2 mb-1">Paciente / receptor</label>
              <input type="text" id="paciente" class="field" placeholder="Ej. Roberto Gómez" required />
            </div>
            <div>
              <label for="pcedula" class="block text-xs font-bold uppercase text-ink-2 mb-1">Cédula del receptor</label>
              <input type="text" id="pcedula" class="field" placeholder="V-12345678" required />
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
            <div>
              <label for="tipo" class="block text-xs font-bold uppercase text-ink-2 mb-1">Tipo de sangre</label>
              <select id="tipo" class="field" required>
                <option value="">Seleccionar</option>
                {BLOOD_TYPES.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
            <div>
              <label for="comp" class="block text-xs font-bold uppercase text-ink-2 mb-1">Hemocomponente</label>
              <select id="comp" class="field" required>
                {COMPONENTES.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>
            <div>
              <label for="unidades" class="block text-xs font-bold uppercase text-ink-2 mb-1">Unidades</label>
              <input type="number" id="unidades" min="1" max="10" value="1" class="field" required />
            </div>
          </div>
          <p id="stock-hint" class="hidden rounded-control px-3 py-2 text-xs font-semibold"></p>
          <div>
            <label for="destino" class="block text-xs font-bold uppercase text-ink-2 mb-1">Hospital / clínica destino</label>
            <input type="text" id="destino" class="field" placeholder="Ej. Hospital Coromoto" required />
          </div>
          <p id="error" class="hidden rounded-control bg-accent-soft px-3 py-2 text-sm font-medium text-accent-ink" role="alert"></p>
          <button type="submit" class="btn btn-primary w-full sm:w-auto sm:px-10 min-h-12">Confirmar y despachar</button>
        </form>
      </section>
    </div>

    <!-- Vista: Historial de despachos -->
    <div data-frame="historial" class="hidden">
      <section class="panel p-6 sm:p-8 space-y-4 w-full">
        <h2 class="text-lg font-bold text-ink border-b border-line pb-3">Historial de despachos <span class="text-ink-3 text-sm font-semibold">(<span id="n-historial">0</span>)</span></h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-line text-ink-3 uppercase text-[0.7rem]">
              <tr><th class="py-2">Receptor</th><th class="py-2">Componente</th><th class="py-2">Cant.</th><th class="py-2">Destino</th><th class="py-2">Fecha</th></tr>
            </thead>
            <tbody id="tabla" class="divide-y divide-line"></tbody>
          </table>
        </div>
        <p id="vacia" class="hidden py-6 text-center text-sm text-ink-3">Aún no hay despachos registrados.</p>
      </section>
    </div>
  </div>

  <!-- RF-DS2 a DS5: verificación del despacho local, traslado entre centros y recepción con inspección -->
  <dialog id="dlg-salida" class="blud-dialog" aria-labelledby="ds-titulo">
    <form id="form-salida" class="blud-dialog-marco" novalidate>
      <header class="flex items-start justify-between gap-4 border-b border-line p-5">
        <div class="min-w-0">
          <h2 id="ds-titulo" class="text-lg font-bold text-ink"></h2>
          <p id="ds-sub" class="text-sm text-ink-2"></p>
        </div>
        <button type="button" class="grid size-9 shrink-0 place-items-center rounded-full text-ink-3 hover:bg-sunken" data-ds-cerrar aria-label="Cerrar">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </header>
      <div class="blud-dialog-cuerpo space-y-4">
        <fieldset data-ds-modo="local" class="space-y-3">
          <legend class="etiqueta-campo">Verificación antes de entregar</legend>
          <label class="flex items-start gap-3 rounded-control border border-line p-3 text-sm"><input type="checkbox" id="ds-brazalete" class="mt-0.5 size-4 shrink-0 accent-[var(--accent)]" /><span><span class="block font-semibold text-ink">Brazalete del paciente</span><span class="block text-xs text-ink-3">Nombre y cédula coinciden con la solicitud</span></span></label>
          <label class="flex items-start gap-3 rounded-control border border-line p-3 text-sm"><input type="checkbox" id="ds-din" class="mt-0.5 size-4 shrink-0 accent-[var(--accent)]" /><span><span class="block font-semibold text-ink">DIN de cada bolsa</span><span class="block text-xs text-ink-3">Coincide con las unidades reservadas</span></span></label>
          <label class="flex items-start gap-3 rounded-control border border-line p-3 text-sm"><input type="checkbox" id="ds-etiqueta" class="mt-0.5 size-4 shrink-0 accent-[var(--accent)]" /><span><span class="block font-semibold text-ink">Etiqueta de compatibilidad pegada</span><span class="block text-xs text-ink-3">Una en cada bolsa, con el grupo y la prueba cruzada</span></span></label>
          <div><label for="ds-recibe" class="etiqueta-campo">Quién recibe en el servicio</label><input id="ds-recibe" class="field" placeholder="Nombre y cargo" autocomplete="off" /></div>
        </fieldset>
        <fieldset data-ds-modo="despachar" class="form-grid">
          <legend class="etiqueta-campo col-full">Datos del traslado</legend>
          <div><label for="ds-transporte" class="etiqueta-campo">Transporte</label><input id="ds-transporte" class="field" placeholder="Ej. Ambulancia A-12" /></div>
          <div><label for="ds-chofer" class="etiqueta-campo">Chofer</label><input id="ds-chofer" class="field" placeholder="Nombre y cédula" /></div>
          <div><label for="ds-contenedor" class="etiqueta-campo">Contenedor isotérmico</label><input id="ds-contenedor" class="field" placeholder="Código del contenedor" /></div>
          <div><label for="ds-logger" class="etiqueta-campo">Data logger <span class="font-normal normal-case text-ink-3">(opcional)</span></label><input id="ds-logger" class="field" placeholder="Serial" /></div>
          <div class="col-full"><label for="ds-temp-salida" class="etiqueta-campo">Temperatura de salida (°C)</label><input id="ds-temp-salida" type="number" step="0.1" inputmode="decimal" class="field" /></div>
        </fieldset>
        <fieldset data-ds-modo="recibir" class="space-y-3">
          <legend class="etiqueta-campo">Recepción</legend>
          <p class="text-sm text-ink-2" data-ds-traslado></p>
          <div><label for="ds-temp-llegada" class="etiqueta-campo">Temperatura de llegada (°C)</label><input id="ds-temp-llegada" type="number" step="0.1" inputmode="decimal" class="field" /></div>
          <p class="text-sm text-ink-2">Inspección visual: marca lo que encuentres en alguna bolsa.</p>
          <div class="grid grid-cols-2 gap-2" data-ds-defectos></div>
          <div><label for="ds-obs" class="etiqueta-campo">Observaciones</label><textarea id="ds-obs" rows="2" class="field" placeholder="Obligatorias si marcaste algún hallazgo"></textarea></div>
          <p class="text-xs text-ink-3">Si hay hallazgos, las bolsas entran a tu sede en cuarentena hasta que el laboratorio las revise.</p>
        </fieldset>
        <p id="ds-error" class="hidden rounded-control bg-accent-soft px-3 py-2 text-sm font-medium text-accent-ink" role="alert"></p>
      </div>
      <footer class="grid grid-cols-2 gap-2 border-t border-line p-4 sm:flex sm:justify-end">
        <button type="button" class="btn btn-secondary" data-ds-cerrar>Cancelar</button>
        <button type="submit" class="btn btn-primary" id="ds-ok"></button>
      </footer>
    </form>
  </dialog>
</LayoutOperador>

<script>
  import { ESTADO_PEDIDO, PRIORIDAD_LABEL, anularPedido, codigoPedido, esc, fmtFecha, getEntregasOp, getPedidos, getPedidosPendientes, onDb, registrarEntrega, reintentarReserva, stockDe, toast, sumarDiasOp } from '../../lib/operador';
  import { DEFECTOS, bandejaCentros, despacharPedidoCentro, recibirPedidoCentro, ESTADO_PEDIDO_CENTRO, TONO_PEDIDO_CENTRO } from '../../lib/centros';
  import type { Defecto } from '../../lib/centros';
  import { verificarDespacho } from '../../lib/transfusion';
  import type { BandejaCentros } from '../../lib/centros';
  import type { Hemocomponente } from '../../lib/operador';
  import { usaSupabase } from '../../lib/supabase';
  import { listarTransfusiones } from '../../lib/transfusion';
  import type { Transfusion } from '../../lib/transfusion';
  import { unidadesEtiquetables } from '../../lib/etiquetas-pdf';

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const val = (id: string) => ($(`#${id}`) as HTMLInputElement).value;
  /** Solicitud aprobada → qué le falta para despachar ('' si está lista). Solo con base real. */
  const compat = new Map<string, string>();
  /** Solicitud aprobada → datos de compatibilidad completos (para imprimir las etiquetas). */
  const transfusiones = new Map<string, Transfusion>();

  function init() {
    const form = $<HTMLFormElement>('#form');
    if (form.dataset.ready) return;
    form.dataset.ready = '1';

    // Compatibilidad (tipaje y pruebas cruzadas del laboratorio) de cada solicitud aprobada.
    const cargarCompat = async () => {
      if (!usaSupabase()) return;
      try {
        const lista = await listarTransfusiones();
        compat.clear();
        transfusiones.clear();
        lista.filter((t) => t.estado === 'aprobado').forEach((t) => { compat.set(t.id, t.faltaParaDespachar ?? ''); transfusiones.set(t.id, t); });
        render();
      } catch {}
    };

    // Aviso de stock en vivo para la salida directa
    const hint = $('#stock-hint');
    const updateHint = () => {
      const tipo = val('tipo');
      if (!tipo) return hint.classList.add('hidden');
      const disp = stockDe(tipo, val('comp'));
      const need = Number(val('unidades')) || 1;
      hint.classList.remove('hidden');
      hint.textContent = `Stock disponible: ${disp} u.${disp < need ? ' (insuficiente)' : ''}`;
      hint.className = `rounded-control px-3 py-2 text-xs font-semibold ${disp >= need ? 'bg-ok-soft text-ok' : 'bg-warn-soft text-warn'}`;
    };
    ['tipo', 'comp', 'unidades'].forEach((id) => $(`#${id}`).addEventListener('input', updateHint));

    const confirmar = (aviso?: string) => !aviso || confirm(`${aviso}\n\n¿Despachar de todas formas?`);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const datos = {
        pacienteNombre: val('paciente'),
        pacienteCedula: val('pcedula'),
        tipoSangre: val('tipo'),
        tipoHemocomponente: val('comp') as Hemocomponente,
        unidades: Number(val('unidades')),
        hospitalDestino: val('destino'),
      };
      const disp = stockDe(datos.tipoSangre, datos.tipoHemocomponente);
      if (datos.tipoSangre && disp < datos.unidades && !confirmar(`El stock registrado de ${datos.tipoSangre} ${datos.tipoHemocomponente} es de ${disp} u.`)) return;
      const r = registrarEntrega(datos);
      const err = $('#error');
      if (!r.ok) {
        err.textContent = r.motivo;
        err.classList.remove('hidden');
        return;
      }
      err.classList.add('hidden');
      toast('Despacho registrado.');
      form.reset();
      hint.classList.add('hidden');
    });

    // Despachar un pedido pendiente con un clic
    $('#pedidos').addEventListener('click', async (e) => {
      const et = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-etiquetas]');
      if (et) {
        const t = transfusiones.get(et.dataset.etiquetas!);
        if (!t) return;
        et.disabled = true;
        try { await (await import('../../lib/etiquetas-pdf')).pdfEtiquetasCompatibilidad(t); }
        catch (ex) { toast((ex as Error).message); } finally { et.disabled = false; }
        return;
      }
      const id = (e.target as HTMLElement).closest<HTMLElement>('[data-despachar]')?.dataset.despachar;
      const p = id ? getPedidosPendientes().find((x) => x.id === id) : undefined;
      if (!p) return;
      // Sin tipaje y pruebas cruzadas compatibles no se despacha (la base también lo exige).
      const falta = compat.get(p.id);
      if (falta) return toast(falta);
      const disp = stockDe(p.tipoSangre, p.tipoHemocomponente);
      if (disp < p.unidades && !confirmar(`El stock registrado de ${p.tipoSangre} ${p.tipoHemocomponente} es de ${disp} u. y el pedido pide ${p.unidades}.`)) return;
      abrirSalida({ modo: 'local', id: p.id, titulo: 'Entregar al servicio', sub: `${p.pacienteNombre} · ${p.pacienteCedula} · ${p.unidades} u. ${p.tipoSangre} ${p.tipoHemocomponente}` });
    });

    // ---------- RF-DS2 a DS5: diálogo de salida y recepción
    type Modo = 'local' | 'despachar' | 'recibir';
    const dlgSalida = $<HTMLDialogElement>('#dlg-salida');
    let salidaActual: { modo: Modo; id: string } | null = null;
    $('[data-ds-defectos]').innerHTML = DEFECTOS.map((d) => `<label class="flex items-center gap-2 rounded-control border border-line p-2.5 text-sm"><input type="checkbox" data-defecto="${d.id}" class="size-4 accent-[var(--accent)]" />${d.label}</label>`).join('');
    function abrirSalida(o: { modo: Modo; id: string; titulo: string; sub: string; traslado?: string }) {
      salidaActual = { modo: o.modo, id: o.id };
      $<HTMLFormElement>('#form-salida').reset();
      $('#ds-error').classList.add('hidden');
      $('#ds-titulo').textContent = o.titulo;
      $('#ds-sub').textContent = o.sub;
      dlgSalida.querySelectorAll<HTMLElement>('[data-ds-modo]').forEach((f) => f.classList.toggle('hidden', f.dataset.dsModo !== o.modo));
      $('[data-ds-traslado]').textContent = o.traslado ?? '';
      $('#ds-ok').textContent = o.modo === 'local' ? 'Verificado: despachar' : o.modo === 'despachar' ? 'Despachar al centro' : 'Confirmar recepción';
      dlgSalida.showModal();
    }
    dlgSalida.querySelectorAll('[data-ds-cerrar]').forEach((b) => b.addEventListener('click', () => dlgSalida.close()));
    const num = (id: string) => parseFloat(($(`#${id}`) as HTMLInputElement).value.replace(',', '.'));
    $('#form-salida').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!salidaActual) return;
      const btn = $<HTMLButtonElement>('#ds-ok');
      btn.disabled = true;
      try {
        if (salidaActual.modo === 'local') {
          const p = getPedidosPendientes().find((x) => x.id === salidaActual!.id);
          if (!p) throw new Error('La solicitud ya no está por despachar.');
          await verificarDespacho(p.id, {
            brazalete: $<HTMLInputElement>('#ds-brazalete').checked, din: $<HTMLInputElement>('#ds-din').checked,
            etiqueta: $<HTMLInputElement>('#ds-etiqueta').checked, recibe: val('ds-recibe'),
          });
          const r = registrarEntrega({ ...p, pedidoId: p.id });
          if (!r.ok) throw new Error(r.motivo);
          toast(`Pedido de ${p.pacienteNombre} despachado.`);
        } else if (salidaActual.modo === 'despachar') {
          await despacharPedidoCentro(salidaActual.id, {
            transporte: val('ds-transporte'), chofer: val('ds-chofer'), contenedor: val('ds-contenedor'),
            datalogger: val('ds-logger') || undefined, tempSalida: num('ds-temp-salida'),
          });
          toast('Pedido despachado: va en camino al centro solicitante.');
          await cargarCentros();
        } else {
          const inspeccion = Object.fromEntries(DEFECTOS.map((d) => [d.id, dlgSalida.querySelector<HTMLInputElement>(`[data-defecto="${d.id}"]`)!.checked])) as Record<Defecto, boolean>;
          const r = await recibirPedidoCentro(salidaActual.id, { tempLlegada: num('ds-temp-llegada'), inspeccion, observaciones: val('ds-obs') });
          toast(!r.conforme ? 'Recibido con hallazgos: las bolsas quedaron en cuarentena para el laboratorio.'
            : r.reservaLocal ? 'Recibido: las unidades entraron a tu stock y quedaron reservadas para la solicitud.' : 'Recibido: las unidades entraron al stock de tu sede.');
          await cargarCentros();
        }
        dlgSalida.close();
      } catch (ex) {
        $('#ds-error').textContent = (ex as Error).message;
        $('#ds-error').classList.remove('hidden');
      } finally { btn.disabled = false; }
    });

    $('#espera').addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const re = t.closest<HTMLElement>('[data-reintentar]')?.dataset.reintentar;
      const an = t.closest<HTMLElement>('[data-anular]')?.dataset.anular;
      if (re) {
        const r = reintentarReserva(re);
        toast(r.ok ? 'Reintentando la reserva con el stock de tu sede…' : r.motivo);
      } else if (an) {
        const motivo = prompt('Motivo de la anulación:') ?? '';
        if (!motivo.trim()) return;
        const r = anularPedido(an, motivo);
        toast(r.ok ? 'Solicitud anulada.' : r.motivo);
      }
    });

    // Pedidos entre centros: despachar (somos el proveedor) o recibir (somos el solicitante).
    let centros: BandejaCentros | null = null;
    const renderCentros = () => {
      if (!centros) return;
      const salir = centros.recibidos.filter((p) => p.estado === 'aprobada');
      const llegar = centros.enviados.filter((p) => p.estado === 'despachada');
      const lista = [...salir.map((p) => ({ p, salida: true })), ...llegar.map((p) => ({ p, salida: false }))];
      $('#sec-centros').hidden = false;
      $('#n-centros').textContent = String(lista.length);
      $('#sin-centros').classList.toggle('hidden', lista.length > 0);
      $('#centros').innerHTML = lista.map(({ p, salida }) => `<li class="rounded-control border border-line p-4 space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0"><p class="font-mono text-[0.6875rem] font-bold text-ink-3">${esc(p.id)} · ${esc(PRIORIDAD_LABEL[p.prioridad])}</p>
              <p class="font-bold text-ink">${p.unidades} u. ${esc(p.tipoSangre)} · ${esc(p.componente)}</p>
              <p class="text-xs text-ink-3">${salida ? `Para ${esc(p.solicitante.nombre)}` : `Desde ${esc(p.proveedora.nombre)}`}</p></div>
            <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-bold ${TONO_PEDIDO_CENTRO[p.estado]}">${esc(ESTADO_PEDIDO_CENTRO[p.estado])}</span>
          </div>
          ${p.bolsas?.length ? `<p class="text-xs text-ink-2">Bolsas: ${p.bolsas.map((b) => `<span class="font-mono">${esc(b.codigo)}</span>`).join(', ')}</p>` : ''}
          <button type="button" class="btn btn-primary w-full" data-centro="${esc(p.id)}" data-accion="${salida ? 'despachar' : 'recibir'}">${salida ? 'Despachar al centro' : 'Confirmar recepción'}</button>
        </li>`).join('');
    };
    const cargarCentros = async () => {
      if (!usaSupabase()) return;
      try { centros = await bandejaCentros(); renderCentros(); } catch {}
    };
    $('#centros').addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-centro]');
      if (!b || !centros) return;
      const p = [...centros.recibidos, ...centros.enviados].find((x) => x.id === b.dataset.centro);
      if (!p) return;
      const sub = `${p.id} · ${p.unidades} u. ${p.tipoSangre} ${p.componente} · ${b.dataset.accion === 'despachar' ? 'hacia ' + p.solicitante.nombre : 'desde ' + p.proveedora.nombre}`;
      const t = p.traslado;
      abrirSalida(b.dataset.accion === 'despachar'
        ? { modo: 'despachar', id: p.id, titulo: 'Despachar al centro', sub }
        : { modo: 'recibir', id: p.id, titulo: 'Recibir el pedido', sub,
            traslado: t ? `Salió ${t.horaSalida ? new Date(t.horaSalida).toLocaleString('es-VE', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false }) : ''} en ${t.transporte} (chofer ${t.chofer}), contenedor ${t.contenedor}${t.datalogger ? `, logger ${t.datalogger}` : ''}, a ${t.tempSalida} °C.` : '' });
    });

    const render = () => {
      const pend = getPedidosPendientes();
      $('#n-ped').textContent = String(pend.length);
      $('[data-cuenta="pedidos"]').textContent = String(pend.length);
      $('#sin-pedidos').classList.toggle('hidden', pend.length > 0);
      $('#pedidos').innerHTML = pend.map((p) => {
        const disp = stockDe(p.tipoSangre, p.tipoHemocomponente);
        const ok = disp >= p.unidades;
        const falta = compat.get(p.id);
        const compatChip = !usaSupabase() ? '' : compat.has(p.id)
          ? `<p class="rounded-control px-3 py-2 text-xs font-semibold ${falta ? 'bg-warn-soft text-warn' : 'bg-ok-soft text-ok'}">${falta ? esc(falta) : 'Compatibilidad lista: tipaje y pruebas cruzadas conformes.'}</p>`
          : '<p class="rounded-control bg-sunken px-3 py-2 text-xs text-ink-3">Consultando la compatibilidad…</p>';
        return `<li class="rounded-control border border-line p-4 space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0"><p class="font-mono text-[0.6875rem] font-bold text-ink-3">${esc(codigoPedido(p.id))} · ${esc(PRIORIDAD_LABEL[p.prioridad ?? 'normal'])}</p>
            <p class="truncate font-bold text-ink">${esc(p.pacienteNombre)}</p>
            <p class="text-xs text-ink-3">${esc(p.pacienteCedula)} · ${esc(fmtFecha(p.fecha, { day: 'numeric', month: 'short' }))}</p></div>
            <span class="blood-chip">${esc(p.tipoSangre)}</span>
          </div>
          <p class="text-sm text-ink-2">${p.unidades} u. de ${esc(p.tipoHemocomponente)} → ${esc(p.hospitalDestino)}</p>
          ${compatChip}
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-full px-2 py-0.5 text-xs font-bold ${ok ? 'bg-ok-soft text-ok' : 'bg-warn-soft text-warn'}">${ok ? `Hay stock (${disp} u.)` : `Stock ${disp} u.`}</span>
            <span class="flex gap-2">
              ${transfusiones.get(p.id) && unidadesEtiquetables(transfusiones.get(p.id)!).length ? `<button type="button" class="btn btn-secondary btn-sm" data-etiquetas="${esc(p.id)}">Etiquetas</button>` : ''}
              <button type="button" class="btn btn-primary btn-sm" data-despachar="${esc(p.id)}" ${usaSupabase() && (falta || !compat.has(p.id)) ? 'disabled' : ''}>Despachar</button>
            </span>
          </div></li>`;
      }).join('');

      // En espera de stock (sin unidades reservadas) y anuladas recientes (7 días).
      const limite = sumarDiasOp(-7);
      const espera = getPedidos().filter((p) => p.estado === 'pendiente' || (p.estado === 'rechazado' && (p.fechaRevision ?? p.fecha) >= limite));
      $('#espera').innerHTML = espera.length
        ? espera.map((p) => `<li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0"><p class="truncate font-semibold text-ink">${esc(codigoPedido(p.id))} · ${p.unidades} u. ${esc(p.tipoSangre)} ${esc(p.tipoHemocomponente)}</p>
            <p class="truncate text-xs text-ink-3">${esc(p.pacienteNombre)} · ${esc(PRIORIDAD_LABEL[p.prioridad ?? 'normal'])} · stock en tu sede: ${stockDe(p.tipoSangre, p.tipoHemocomponente)} u.${p.motivoRechazo ? ' · Motivo: ' + esc(p.motivoRechazo) : ''}</p></div>
            ${p.estado === 'pendiente'
              ? `<div class="grid grid-cols-2 gap-2 sm:flex sm:shrink-0"><button type="button" class="btn btn-secondary btn-sm" data-anular="${esc(p.id)}">Anular</button>
                 <button type="button" class="btn btn-primary btn-sm" data-reintentar="${esc(p.id)}">Reintentar reserva</button></div>`
              : `<span class="shrink-0 self-start rounded-full bg-accent-soft px-2 py-0.5 text-xs font-bold text-accent-ink">${esc(ESTADO_PEDIDO[p.estado])}</span>`}</li>`).join('')
        : '<li class="py-4 text-center text-sm text-ink-3">No hay solicitudes en espera de stock.</li>';

      const lista = getEntregasOp();
      $('#n-historial').textContent = String(lista.length);
      $('[data-cuenta="historial"]').textContent = String(lista.length);
      $('#vacia').classList.toggle('hidden', lista.length > 0);
      $('#tabla').innerHTML = lista.map((e) => `<tr>
        <td class="py-3 font-semibold text-ink">${esc(e.pacienteNombre)}<br><span class="text-xs font-normal text-ink-3">${esc(e.pacienteCedula)}</span></td>
        <td class="py-3"><span class="blood-chip">${esc(e.tipoSangre)}</span><span class="mt-0.5 block text-xs text-ink-2">${esc(e.tipoHemocomponente)}</span></td>
        <td class="py-3 font-mono font-bold">${e.unidades} u.</td>
        <td class="py-3 text-xs text-ink-2">${esc(e.hospitalDestino)}</td>
        <td class="py-3 text-xs text-ink-3">${esc(fmtFecha(e.fecha, { day: 'numeric', month: 'short', year: 'numeric' }))}</td></tr>`).join('');
      updateHint();
    };

    // Lógica de pestañas
    type Vista = 'pedidos' | 'salida' | 'historial';
    const frames = [...document.querySelectorAll<HTMLElement>('[data-frame]')];
    const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-vista]')];
    let vista: Vista = 'pedidos';

    const setVista = (v: Vista) => {
      vista = v;
      frames.forEach((f) => f.classList.toggle('hidden', f.dataset.frame !== v));
      botones.forEach((b) => {
        const on = b.dataset.vista === v;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('btn-primary', on);
        b.classList.toggle('btn-secondary', !on);
      });
      if (v === 'salida') $('#paciente').focus({ preventScroll: true });
    };

    botones.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.vista as Vista;
      setVista(v === 'pedidos' && vista === 'pedidos' ? 'pedidos' : v);
    }));
    
    document.addEventListener('keydown', (e) => { 
      if (e.key === 'Escape' && vista !== 'pedidos' && !document.querySelector('dialog[open]')) setVista('pedidos'); 
    });
    
    setVista('pedidos');

    render();
    onDb(() => { render(); cargarCompat(); cargarCentros(); });
    cargarCompat();
    cargarCentros();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>