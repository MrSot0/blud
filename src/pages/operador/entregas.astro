---
// src/pages/operador/entregas.astro
import LayoutOperador from '../../layouts/LayoutOperador.astro';

const bloodTypes = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
const componentes = ['Sangre Total', 'Concentrado Globular', 'Plaquetas', 'Plasma Fresco Congelado', 'Crioprecipitado'];
---

<LayoutOperador title="BLUD | Despacho de Hemocomponentes">
  <div class="container-blud py-8 space-y-8">
    <div class="pb-6 border-b border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Despacho de Hemocomponentes</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Registra la entrega de bolsas/unidades procesadas a centros de salud o pacientes.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">
      
      <!-- Formulario de Entrega -->
      <section class="lg:col-span-2 panel p-6 space-y-4">
        <h2 class="text-lg font-bold text-ink">Registrar Salida</h2>
        <form id="form-entrega" class="space-y-3">
          <div>
            <label for="pacienteNombre" class="block text-xs font-bold uppercase text-ink-2 mb-1">Nombre Paciente / Receptor</label>
            <input type="text" id="pacienteNombre" class="field" placeholder="Ej. Roberto Gómez" required />
          </div>
          <div>
            <label for="pacienteCedula" class="block text-xs font-bold uppercase text-ink-2 mb-1">Cédula del Receptor</label>
            <input type="text" id="pacienteCedula" class="field" placeholder="V-12345678" required />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="tipoSangre" class="block text-xs font-bold uppercase text-ink-2 mb-1">Tipo de Sangre</label>
              <select id="tipoSangre" class="field" required>
                <option value="">Seleccionar</option>
                {bloodTypes.map(t => <option value={t}>{t}</option>)}
              </select>
            </div>
            <div>
              <label for="unidades" class="block text-xs font-bold uppercase text-ink-2 mb-1">Unidades</label>
              <input type="number" id="unidades" min="1" max="10" value="1" class="field" required />
            </div>
          </div>
          <div>
            <label for="tipoHemocomponente" class="block text-xs font-bold uppercase text-ink-2 mb-1">Hemocomponente</label>
            <select id="tipoHemocomponente" class="field" required>
              {componentes.map(c => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div>
            <label for="hospitalDestino" class="block text-xs font-bold uppercase text-ink-2 mb-1">Hospital / Clínica Destino</label>
            <input type="text" id="hospitalDestino" class="field" placeholder="Ej. Hospital Coromoto" required />
          </div>
          <button type="submit" class="btn btn-primary w-full">Confirmar y Despachar</button>
        </form>
      </section>

      <!-- Historial de Entregas -->
      <section class="lg:col-span-3 panel p-6 space-y-4">
        <h2 class="text-lg font-bold text-ink border-b border-line pb-3">Historial de Despachos</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-line text-ink-3 uppercase text-[0.7rem]">
              <tr>
                <th class="py-2">Receptor / Cédula</th>
                <th class="py-2">Componente</th>
                <th class="py-2">Cant.</th>
                <th class="py-2">Destino</th>
                <th class="py-2">Fecha</th>
              </tr>
            </thead>
            <tbody id="tabla-entregas" class="divide-y divide-line">
              <!-- Renderizado dinámico -->
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </div>
</LayoutOperador>

<script>
  import { getEntregasOp, saveEntregaOp, uid, toast } from '../../lib/operador';

  function renderTabla() {
    const lista = getEntregasOp();
    const tbody = document.getElementById('tabla-entregas');
    if (!tbody) return;

    tbody.innerHTML = lista.map(e => `
      <tr>
        <td class="py-3 font-semibold text-ink">${e.pacienteNombre}<br><span class="text-xs text-ink-3 font-normal">${e.pacienteCedula}</span></td>
        <td class="py-3"><span class="blood-chip">${e.tipoSangre}</span> <span class="text-xs text-ink-2 block mt-0.5">${e.tipoHemocomponente}</span></td>
        <td class="py-3 font-mono font-bold">${e.unidades} u.</td>
        <td class="py-3 text-ink-2 text-xs">${e.hospitalDestino}</td>
        <td class="py-3 text-ink-3 text-xs">${e.fecha}</td>
      </tr>
    `).join('');
  }

  function init() {
    renderTabla();
    const form = document.getElementById('form-entrega') as HTMLFormElement;

    form?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      saveEntregaOp({
        id: uid(),
        pacienteNombre: (document.getElementById('pacienteNombre') as HTMLInputElement).value,
        pacienteCedula: (document.getElementById('pacienteCedula') as HTMLInputElement).value,
        tipoSangre: (document.getElementById('tipoSangre') as HTMLSelectElement).value,
        tipoHemocomponente: (document.getElementById('tipoHemocomponente') as HTMLSelectElement).value as any,
        unidades: Number((document.getElementById('unidades') as HTMLInputElement).value),
        hospitalDestino: (document.getElementById('hospitalDestino') as HTMLInputElement).value,
        fecha: new Date().toISOString().slice(0, 10),
        operadorId: 'op-actual'
      });

      toast('¡Despacho registrado correctamente! 🩸');
      form.reset();
      renderTabla();
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>