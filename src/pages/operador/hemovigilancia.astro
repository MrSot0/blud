---
// src/pages/operador/hemovigilancia.astro
// RF-H1, H2, H4: registro de cada unidad despachada en cabecera de cama. Ver lib/hemovigilancia.
import LayoutOperador from '../../layouts/LayoutOperador.astro';
import { IMPUTABILIDAD, SEVERIDADES } from '../../lib/hemovigilancia';

const momentos = [
  { id: 'antes', label: 'Antes de iniciar' },
  { id: 'durante', label: 'A los 15 minutos' },
  { id: 'despues', label: 'Al terminar' },
];
const signos = [
  { id: 'pa', label: 'PA', ph: '120/80', modo: 'text' },
  { id: 'fc', label: 'FC', ph: 'lpm', modo: 'numeric' },
  { id: 'temp', label: 'Temp. °C', ph: '36.5', modo: 'decimal' },
  { id: 'fr', label: 'FR', ph: 'rpm', modo: 'numeric' },
  { id: 'spo2', label: 'SpO2 %', ph: '98', modo: 'numeric' },
];
const verificaciones = [
  { id: 'identidad', label: 'Identidad del paciente', hint: 'Nombre y cédula contra brazalete y solicitud' },
  { id: 'grupo', label: 'Grupo ABO/Rh compatible', hint: 'Grupo del paciente contra la etiqueta de la unidad' },
  { id: 'etiqueta', label: 'Etiqueta de la bolsa', hint: 'DIN, componente, integridad y vencimiento' },
  { id: 'consentimiento', label: 'Consentimiento informado', hint: 'Firmado y en la historia' },
];
---

<LayoutOperador title="BLUD | Hemovigilancia" description="Registro de cada transfusión: doble verificación, signos vitales y reacciones adversas.">
  <div class="container-blud py-6 sm:py-8 space-y-6 sm:space-y-8" data-hv>
    <div class="page-head">
      <div class="min-w-0">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Hemovigilancia</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Registra cada unidad que despachaste: doble verificación en cabecera, signos vitales y cómo terminó la transfusión.</p>
      </div>
    </div>

    <p id="hv-aviso" class="hidden rounded-control bg-warn-soft px-4 py-3 text-sm font-medium text-warn" role="status"></p>

    <div class="chips-scroll" role="tablist" aria-label="Registros">
      <button type="button" role="tab" class="pildora" data-tab="pendientes" aria-selected="true">Por registrar <span data-n="pendientes">0</span></button>
      <button type="button" role="tab" class="pildora" data-tab="en_curso" aria-selected="false">En curso <span data-n="en_curso">0</span></button>
      <button type="button" role="tab" class="pildora" data-tab="cerrado" aria-selected="false">Cerrados <span data-n="cerrado">0</span></button>
    </div>

    <section class="panel p-4 sm:p-6" data-frame="pendientes" aria-labelledby="h-pend">
      <h2 id="h-pend" class="sr-only">Unidades por registrar</h2>
      <p class="mb-4 text-sm text-ink-3">Unidades despachadas en los últimos 30 días que todavía no tienen registro.</p>
      <ul id="lista-pend" class="grid gap-3 md:grid-cols-2"></ul>
      <p id="vacio-pend" class="hidden py-8 text-center text-sm text-ink-3">No hay unidades despachadas pendientes de registro.</p>
    </section>

    <section class="panel p-4 sm:p-6 hidden" data-frame="registros" aria-labelledby="h-reg">
      <h2 id="h-reg" class="sr-only">Registros</h2>
      <div class="tabla-apilable" role="region" aria-label="Registros de hemovigilancia" tabindex="0">
        <table class="w-full min-w-[42rem] text-left text-sm">
          <thead class="border-b border-line bg-sunken text-xs uppercase text-ink-3">
            <tr><th class="p-3 font-bold">Folio</th><th class="p-3 font-bold">Paciente</th><th class="p-3 font-bold">Unidad</th><th class="p-3 font-bold">Resultado</th><th class="p-3 font-bold">Registrado</th><th class="p-3"></th></tr>
          </thead>
          <tbody id="filas" class="divide-y divide-line"></tbody>
        </table>
      </div>
      <p id="vacio-reg" class="hidden py-8 text-center text-sm text-ink-3"></p>
    </section>
  </div>

  <!-- Formulario de registro -->
  <dialog id="dlg" class="blud-dialog blud-dialog-ancho" data-hv-dlg aria-labelledby="dlg-titulo">
    <form id="form" class="blud-dialog-marco" novalidate>
      <header class="flex items-start justify-between gap-4 border-b border-line p-5">
        <div class="min-w-0">
          <p class="font-mono text-xs font-bold text-ink-3" id="dlg-folio"></p>
          <h2 id="dlg-titulo" class="text-lg font-bold text-ink">Registro de transfusión</h2>
          <p class="mt-0.5 text-sm text-ink-2" id="dlg-sub"></p>
        </div>
        <button type="button" class="grid size-9 shrink-0 place-items-center rounded-full text-ink-3 hover:bg-sunken" data-cerrar aria-label="Cerrar">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </header>

      <div class="blud-dialog-cuerpo space-y-6" id="dlg-cuerpo">
        <fieldset class="space-y-3">
          <legend class="w-full border-b border-line pb-1.5 text-xs font-bold uppercase tracking-wider text-ink-2">1. Doble verificación en cabecera</legend>
          <div class="grid gap-2 sm:grid-cols-2">
            {verificaciones.map((v) => (
              <label class="hv-check">
                <input type="checkbox" name={`ver-${v.id}`} class="mt-0.5 size-4 shrink-0 accent-[var(--accent)]" />
                <span><span class="block text-sm font-semibold text-ink">{v.label}</span><span class="block text-xs text-ink-3">{v.hint}</span></span>
              </label>
            ))}
          </div>
          <div class="form-grid">
            <div class="col-full">
              <label for="segundo" class="etiqueta-campo">Segundo verificador</label>
              <input id="segundo" class="field" placeholder="Nombre de quien verificó contigo" autocomplete="off" />
            </div>
            <div>
              <label for="ubicacion" class="etiqueta-campo">Ubicación del paciente</label>
              <input id="ubicacion" class="field" placeholder="Servicio y cama" />
            </div>
            <div>
              <label for="medico" class="etiqueta-campo">Médico responsable</label>
              <input id="medico" class="field" placeholder="Dr(a). Nombre Apellido" />
            </div>
          </div>
        </fieldset>

        <fieldset class="space-y-3">
          <legend class="w-full border-b border-line pb-1.5 text-xs font-bold uppercase tracking-wider text-ink-2">2. Infusión</legend>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            <div class="col-span-2 sm:col-span-1">
              <label for="inicio" class="etiqueta-campo">Inicio</label>
              <input id="inicio" type="datetime-local" class="field" />
            </div>
            <div>
              <label for="fin" class="etiqueta-campo">Fin</label>
              <input id="fin" type="datetime-local" class="field" />
            </div>
            <div>
              <label for="volumen" class="etiqueta-campo">Volumen (ml)</label>
              <input id="volumen" type="number" min="0" max="2000" inputmode="numeric" class="field" placeholder="280" />
            </div>
          </div>
        </fieldset>

        <fieldset class="space-y-3">
          <legend class="w-full border-b border-line pb-1.5 text-xs font-bold uppercase tracking-wider text-ink-2">3. Signos vitales</legend>
          <div class="grid gap-3 lg:grid-cols-3">
            {momentos.map((m) => (
              <div class="rounded-control border border-line p-3">
                <p class="etiqueta-campo mb-2">{m.label}</p>
                <div class="grid grid-cols-3 gap-2 lg:grid-cols-2">
                  {signos.map((s) => (
                    <label class="block">
                      <span class="block text-[0.6875rem] font-semibold text-ink-3">{s.label}</span>
                      <input class="field !min-h-10 !px-2.5 text-sm" name={`sg-${m.id}-${s.id}`} placeholder={s.ph} inputmode={s.modo as 'text'} autocomplete="off" />
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </fieldset>

        <fieldset class="space-y-3">
          <legend class="w-full border-b border-line pb-1.5 text-xs font-bold uppercase tracking-wider text-ink-2">4. Cómo terminó</legend>
          <div class="grid gap-2 sm:grid-cols-3" role="radiogroup" aria-label="Resultado de la transfusión">
            <label class="opcion-tarjeta"><input type="radio" name="tipo" value="sin_reaccion" class="sr-only" /><span class="font-semibold text-ink">Sin reacción</span><span class="text-xs text-ink-3">Terminó sin eventos</span></label>
            <label class="opcion-tarjeta"><input type="radio" name="tipo" value="reaccion" class="sr-only" /><span class="font-semibold text-ink">Reacción adversa</span><span class="text-xs text-ink-3">Signos o síntomas en el paciente</span></label>
            <label class="opcion-tarjeta"><input type="radio" name="tipo" value="incidente" class="sr-only" /><span class="font-semibold text-ink">Incidente</span><span class="text-xs text-ink-3">Error o problema con la unidad</span></label>
          </div>
          <p class="text-xs text-ink-3">Si la transfusión sigue, déjalo sin marcar y guarda en curso.</p>

          <div id="bloque-evento" class="hidden space-y-3 rounded-control border border-line bg-sunken/40 p-4">
            <p class="rounded-control bg-accent-soft px-3 py-2 text-xs font-semibold text-accent-ink">Ante una reacción: detén la infusión, mantén la vía con solución salina, avisa al médico y conserva la bolsa y el equipo para el laboratorio.</p>
            <div class="form-grid">
              <div class="col-full">
                <label for="categoria" class="etiqueta-campo">Categoría</label>
                <select id="categoria" class="field"></select>
              </div>
              <div>
                <label for="severidad" class="etiqueta-campo">Severidad</label>
                <select id="severidad" class="field"><option value="">Elegir</option>{SEVERIDADES.map((s) => <option value={s}>{s}</option>)}</select>
              </div>
              <div>
                <label for="imputabilidad" class="etiqueta-campo">Imputabilidad</label>
                <select id="imputabilidad" class="field">{IMPUTABILIDAD.map((s) => <option value={s}>{s}</option>)}</select>
              </div>
              <div class="col-full">
                <label for="sintomas" class="etiqueta-campo">Signos y síntomas</label>
                <textarea id="sintomas" rows="2" class="field" placeholder="Qué presentó el paciente y a los cuántos minutos"></textarea>
              </div>
              <div class="col-full">
                <label for="acciones" class="etiqueta-campo">Acciones tomadas</label>
                <textarea id="acciones" rows="3" class="field" placeholder="Suspensión de la infusión, medicamentos indicados, muestras enviadas al laboratorio"></textarea>
              </div>
            </div>
          </div>
        </fieldset>

        <p id="error" class="hidden rounded-control bg-accent-soft px-3 py-2 text-sm font-medium text-accent-ink" role="alert"></p>
      </div>

      <div id="dlg-lectura" class="blud-dialog-cuerpo hidden space-y-6"></div>

      <footer class="grid grid-cols-2 gap-2 border-t border-line p-4 sm:flex sm:justify-end">
        <button type="button" class="btn btn-secondary hidden sm:inline-flex" data-cerrar>Cancelar</button>
        <button type="button" class="btn btn-primary col-span-2 hidden" id="btn-pdf">Descargar PDF</button>
        <button type="submit" class="btn btn-secondary" id="btn-curso" value="curso">Guardar en curso</button>
        <button type="submit" class="btn btn-primary" id="btn-cerrar" value="cerrar">Cerrar registro</button>
      </footer>
    </form>
  </dialog>
</LayoutOperador>

<style is:global>
  /* Casilla de la doble verificación: se pinta en verde al marcarla. */
  [data-hv-dlg] .hv-check { display: flex; gap: .75rem; align-items: flex-start; padding: .75rem; border: 1px solid var(--line); border-radius: var(--radius-control); cursor: pointer; }
  [data-hv-dlg] .hv-check:has(input:checked) { border-color: var(--ok); background: var(--ok-soft); }
  /* La columna de estado sobra en escritorio (cada pestaña ya filtra por estado): solo se ve en las tarjetas. */
  @container (width >= 40rem) { [data-hv] .tabla-apilable td.celda-estado { display: none; } }
  [data-hv] .tabla-apilable thead th:nth-child(1) { width: 1%; }
</style>

<script>
  import {
    CATEGORIAS_INCIDENTE, CATEGORIAS_REACCION, HVNoDisponible, fmtFechaHora, guardarHV, listarHV, seedHVDemo,
  } from '../../lib/hemovigilancia';
  import type { DatosHV, PendienteHV, RegistroHV, Signos, TipoEvento } from '../../lib/hemovigilancia';
  import { chipEstadoHV, chipEvento, detalleHTML } from '../../lib/hemovigilancia-vista';
  import { onDb } from '../../lib/db';
  import { esc, toast } from '../../lib/ui';

  type Tab = 'pendientes' | 'en_curso' | 'cerrado';
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  /** ISO → valor de <input type="datetime-local"> en hora local. */
  const aLocal = (iso?: string) => {
    if (!iso) return '';
    const d = new Date(iso);
    return isNaN(d.getTime()) ? '' : new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
  };
  const aISO = (v: string) => (v ? new Date(v).toISOString() : undefined);

  function init() {
    const raiz = document.querySelector<HTMLElement>('[data-hv]');
    if (!raiz || raiz.dataset.ready) return;
    raiz.dataset.ready = '1';
    seedHVDemo();

    let tab: Tab = 'pendientes';
    let registros: RegistroHV[] = [];
    let pendientes: PendienteHV[] = [];
    /** Lo que se está registrando: una unidad nueva o un registro existente. */
    let actual: { pend?: PendienteHV; reg?: RegistroHV } = {};
    const dlg = $<HTMLDialogElement>('#dlg');
    const form = $<HTMLFormElement>('#form');

    // ---------- Listas
    const paciente = (p?: { nombre: string; cedula: string }) => p ? `${esc(p.nombre)} <span class="text-ink-3">· ${esc(p.cedula)}</span>` : '—';

    function pintar() {
      const enCurso = registros.filter((r) => r.estado === 'en_curso');
      const cerrados = registros.filter((r) => r.estado === 'cerrado');
      $('[data-n="pendientes"]').textContent = String(pendientes.length);
      $('[data-n="en_curso"]').textContent = String(enCurso.length);
      $('[data-n="cerrado"]').textContent = String(cerrados.length);

      $('#lista-pend').innerHTML = pendientes.map((p, i) => `<li class="flex flex-col gap-3 rounded-control border border-line p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0"><p class="font-semibold text-ink">${paciente(p.paciente)}</p>
            <p class="text-sm text-ink-2">${esc(p.componente ?? '')} · ${esc(p.tipoSangre ?? '')}</p></div>
          <span class="shrink-0 rounded-full bg-sunken px-2.5 py-0.5 font-mono text-xs font-bold text-ink-2">${esc(p.unidadCodigo ?? String(p.unidadId))}</span>
        </div>
        <p class="text-xs text-ink-3">${esc(p.solicitudId)} · despachada ${esc(fmtFechaHora(p.despachado))}${p.cruzada ? ` · cruzada ${esc(p.cruzada.toLowerCase())}` : ''}${p.paciente?.servicio ? ` · ${esc(p.paciente.servicio)}` : ''}</p>
        <button type="button" class="btn btn-primary btn-sm self-start" data-iniciar="${i}">Iniciar registro</button>
      </li>`).join('');
      $('#vacio-pend').classList.toggle('hidden', pendientes.length > 0);

      const lista = tab === 'en_curso' ? enCurso : cerrados;
      $('#filas').innerHTML = lista.map((r) => `<tr>
        <td class="p-3 celda-titulo celda-corta font-mono text-xs font-bold" data-label="Folio">${esc(r.id)}</td>
        <td class="p-3 celda-estado" data-label="Estado">${chipEstadoHV(r)}</td>
        <td class="p-3" data-label="Paciente">${paciente(r.paciente)}</td>
        <td class="p-3" data-label="Unidad"><span class="block">${esc(r.componente ?? '')} · ${esc(r.tipoSangre ?? '')}</span><span class="font-mono text-xs text-ink-3">${esc(r.unidadCodigo ?? '')}</span></td>
        <td class="p-3" data-label="Resultado">${chipEvento(r)}</td>
        <td class="p-3 text-xs text-ink-2 tabular" data-label="Registrado">${esc(fmtFechaHora(r.registrado))}</td>
        <td class="p-3 celda-acciones text-right"><button type="button" class="btn btn-secondary btn-sm" data-abrir="${esc(r.id)}">${r.estado === 'cerrado' ? 'Ver' : 'Completar'}</button></td>
      </tr>`).join('');
      const vacio = $('#vacio-reg');
      vacio.textContent = tab === 'en_curso' ? 'No hay transfusiones en curso.' : 'Todavía no hay registros cerrados.';
      vacio.classList.toggle('hidden', lista.length > 0);

      raiz.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)));
      raiz.querySelector('[data-frame="pendientes"]')!.classList.toggle('hidden', tab !== 'pendientes');
      raiz.querySelector('[data-frame="registros"]')!.classList.toggle('hidden', tab === 'pendientes');
    }

    async function cargar() {
      try {
        const r = await listarHV();
        registros = r.registros;
        pendientes = r.pendientes;
        $('#hv-aviso').classList.add('hidden');
      } catch (e) {
        const aviso = $('#hv-aviso');
        aviso.textContent = e instanceof HVNoDisponible
          ? 'El registro de hemovigilancia todavía no está habilitado en el servidor. Mientras tanto, usa la hoja en papel de tu servicio.'
          : (e as Error).message;
        aviso.classList.remove('hidden');
      }
      pintar();
    }

    raiz.querySelectorAll<HTMLElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => { tab = b.dataset.tab as Tab; pintar(); }));

    // ---------- Formulario
    const campo = <T extends HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement = HTMLInputElement>(id: string) => $<T>(`#${id}`);
    const tipo = () => (form.querySelector<HTMLInputElement>('input[name="tipo"]:checked')?.value || undefined) as TipoEvento | undefined;

    function opcionesCategoria(t?: TipoEvento, valor?: string) {
      const lista = t === 'incidente' ? CATEGORIAS_INCIDENTE : CATEGORIAS_REACCION;
      const sel = campo<HTMLSelectElement>('categoria');
      sel.innerHTML = `<option value="">Elegir</option>` + lista.map((c) => `<option>${esc(c)}</option>`).join('');
      if (valor) sel.value = valor;
    }
    function pintarEvento() {
      const t = tipo();
      const conEvento = t === 'reaccion' || t === 'incidente';
      $('#bloque-evento').classList.toggle('hidden', !conEvento);
      if (conEvento) {
        const prev = campo<HTMLSelectElement>('categoria').value;
        opcionesCategoria(t, prev);
      }
    }
    form.querySelectorAll('input[name="tipo"]').forEach((r) => r.addEventListener('change', pintarEvento));

    function abrir(pend?: PendienteHV, reg?: RegistroHV) {
      actual = { pend, reg };
      form.reset();
      $('#error').classList.add('hidden');
      const base = reg ?? pend!;
      $('#dlg-folio').textContent = reg ? reg.id : 'Registro nuevo';
      $('#dlg-sub').innerHTML = `${paciente(base.paciente)} · ${esc(base.componente ?? '')} ${esc(base.tipoSangre ?? '')} · unidad <span class="font-mono">${esc(base.unidadCodigo ?? String(base.unidadId))}</span>`;
      const soloLectura = reg?.estado === 'cerrado';
      $('#dlg-cuerpo').classList.toggle('hidden', soloLectura);
      $('#dlg-lectura').classList.toggle('hidden', !soloLectura);
      $('#btn-curso').classList.toggle('hidden', soloLectura);
      $('#btn-cerrar').classList.toggle('hidden', soloLectura);
      $('#btn-pdf').classList.toggle('hidden', !soloLectura);
      if (soloLectura) $('#dlg-lectura').innerHTML = detalleHTML(reg!);

      if (reg && !soloLectura) {
        const v = reg.verificacion;
        (['identidad', 'grupo', 'etiqueta', 'consentimiento'] as const).forEach((k) => {
          form.querySelector<HTMLInputElement>(`[name="ver-${k}"]`)!.checked = !!v[k];
        });
        campo('segundo').value = v.segundoVerificador ?? '';
        campo('ubicacion').value = reg.ubicacion ?? '';
        campo('medico').value = reg.medico ?? '';
        campo('inicio').value = aLocal(reg.inicio);
        campo('fin').value = aLocal(reg.fin);
        campo('volumen').value = reg.volumenMl ? String(reg.volumenMl) : '';
        (['antes', 'durante', 'despues'] as const).forEach((m) => {
          (['pa', 'fc', 'temp', 'fr', 'spo2'] as const).forEach((s) => {
            form.querySelector<HTMLInputElement>(`[name="sg-${m}-${s}"]`)!.value = reg.signos[m]?.[s] ?? '';
          });
        });
        if (reg.tipoEvento) form.querySelector<HTMLInputElement>(`input[name="tipo"][value="${reg.tipoEvento}"]`)!.checked = true;
        opcionesCategoria(reg.tipoEvento, reg.categoria);
        campo<HTMLSelectElement>('severidad').value = reg.severidad ?? '';
        campo<HTMLSelectElement>('imputabilidad').value = reg.imputabilidad ?? 'Por evaluar';
        campo<HTMLTextAreaElement>('sintomas').value = reg.sintomas ?? '';
        campo<HTMLTextAreaElement>('acciones').value = reg.acciones ?? '';
      } else if (!reg) {
        campo('inicio').value = aLocal(new Date().toISOString());
        campo('ubicacion').value = pend?.paciente?.servicio ?? '';
        opcionesCategoria('reaccion');
      }
      pintarEvento();
      dlg.showModal();
    }

    function datos(cerrar: boolean): DatosHV {
      const sg = (m: string): Signos => {
        const o: Signos = {};
        (['pa', 'fc', 'temp', 'fr', 'spo2'] as const).forEach((s) => {
          const v = form.querySelector<HTMLInputElement>(`[name="sg-${m}-${s}"]`)!.value.trim();
          if (v) o[s] = v;
        });
        return o;
      };
      const chk = (k: string) => form.querySelector<HTMLInputElement>(`[name="ver-${k}"]`)!.checked;
      const t = tipo();
      const conEvento = t === 'reaccion' || t === 'incidente';
      const base = actual.reg ?? actual.pend!;
      const vol = campo('volumen').value;
      return {
        id: actual.reg?.id,
        solicitudId: base.solicitudId,
        unidadId: base.unidadId,
        verificacion: { identidad: chk('identidad'), grupo: chk('grupo'), etiqueta: chk('etiqueta'), consentimiento: chk('consentimiento'), segundoVerificador: campo('segundo').value.trim() },
        signos: { antes: sg('antes'), durante: sg('durante'), despues: sg('despues') },
        inicio: aISO(campo('inicio').value),
        fin: aISO(campo('fin').value),
        volumenMl: vol ? Number(vol) : '',
        ubicacion: campo('ubicacion').value,
        medico: campo('medico').value,
        tipoEvento: t,
        categoria: conEvento ? campo<HTMLSelectElement>('categoria').value : undefined,
        severidad: conEvento ? campo<HTMLSelectElement>('severidad').value : undefined,
        imputabilidad: conEvento ? campo<HTMLSelectElement>('imputabilidad').value : undefined,
        sintomas: conEvento ? campo<HTMLTextAreaElement>('sintomas').value : undefined,
        acciones: conEvento ? campo<HTMLTextAreaElement>('acciones').value : undefined,
        cerrar,
      };
    }

    let guardando = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (guardando) return;
      const cerrar = (e as SubmitEvent).submitter?.id === 'btn-cerrar';
      const d = datos(cerrar);
      if (cerrar && !d.fin) d.fin = new Date().toISOString();
      const err = $('#error');
      guardando = true;
      form.querySelectorAll<HTMLButtonElement>('footer button').forEach((b) => (b.disabled = true));
      try {
        const r = await guardarHV(d);
        dlg.close();
        toast(cerrar ? `Registro ${r.id} cerrado.` : `Registro ${r.id} guardado en curso.`);
        tab = cerrar ? 'cerrado' : 'en_curso';
        await cargar();
      } catch (ex) {
        err.textContent = (ex as Error).message;
        err.classList.remove('hidden');
        err.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      } finally {
        guardando = false;
        form.querySelectorAll<HTMLButtonElement>('footer button').forEach((b) => (b.disabled = false));
      }
    });

    $('#btn-pdf').addEventListener('click', async () => {
      if (!actual.reg) return;
      const { pdfHemovigilancia } = await import('../../lib/reportes-pdf');
      await pdfHemovigilancia(actual.reg);
    });
    dlg.querySelectorAll('[data-cerrar]').forEach((b) => b.addEventListener('click', () => dlg.close()));

    raiz.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      const i = el.closest<HTMLElement>('[data-iniciar]')?.dataset.iniciar;
      if (i !== undefined) return abrir(pendientes[Number(i)]);
      const id = el.closest<HTMLElement>('[data-abrir]')?.dataset.abrir;
      const reg = id ? registros.find((r) => r.id === id) : undefined;
      if (reg) abrir(undefined, reg);
    });

    let t: number | undefined;
    onDb(() => { clearTimeout(t); t = window.setTimeout(cargar, 400); });
    cargar();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
