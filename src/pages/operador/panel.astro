---
// src/pages/operador/panel.astro
import LayoutOperador from '../../layouts/LayoutOperador.astro';
import { BLOOD_TYPES } from '../../lib/db';
---

<LayoutOperador title="BLUD | Panel de operación">
  <div class="container-blud py-8 space-y-8">

    <div class="pb-6 border-b border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Panel de operación</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1" id="centro-txt">Resumen de tu centro.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/operador/donaciones" class="btn btn-primary">Registrar donación</a>
        <a href="/operador/donantes" class="btn btn-secondary">Verificar donantes</a>
      </div>
    </div>

    <!-- KPIs -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/operador/donantes" class="panel p-5 transition-transform hover:-translate-y-0.5">
        <p class="text-xs font-bold uppercase text-ink-3">Por verificar</p>
        <p class="mt-1 text-3xl font-extrabold text-ink tabular" data-kpi="porVerificar">0</p>
        <p class="text-xs text-ink-3">pre-registrados en la app</p>
      </a>
      <a href="/operador/historial" class="panel p-5 transition-transform hover:-translate-y-0.5">
        <p class="text-xs font-bold uppercase text-ink-3">Donaciones hoy</p>
        <p class="mt-1 text-3xl font-extrabold text-ink tabular" data-kpi="donacionesHoy">0</p>
        <p class="text-xs text-ink-3"><span data-kpi="donacionesMes">0</span> en el mes</p>
      </a>
      <div class="panel p-5">
        <p class="text-xs font-bold uppercase text-ink-3">Stock total</p>
        <p class="mt-1 text-3xl font-extrabold text-ink tabular" data-kpi="stockTotal">0</p>
        <p class="text-xs text-ink-3">unidades disponibles</p>
      </div>
      <a href="/operador/entregas" class="panel p-5 transition-transform hover:-translate-y-0.5">
        <p class="text-xs font-bold uppercase text-ink-3">Pedidos pendientes</p>
        <p class="mt-1 text-3xl font-extrabold text-accent-ink tabular" data-kpi="pedidosPendientes">0</p>
        <p class="text-xs text-ink-3">por despachar</p>
      </a>
    </div>

    <!-- Stock por tipo -->
    <section class="panel p-6 sm:p-8 space-y-4" aria-labelledby="h-stock">
      <div class="flex items-center justify-between gap-3">
        <h2 id="h-stock" class="text-lg font-bold text-ink">Stock por tipo de sangre</h2>
        <button type="button" id="btn-demo" class="btn btn-secondary btn-sm">Cargar datos de ejemplo</button>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="stock">
        {BLOOD_TYPES.map((t) => (
          <div class="rounded-control bg-sunken p-4" data-tipo={t}>
            <div class="flex items-center justify-between">
              <span class="blood-chip">{t}</span>
              <span class="hidden text-[0.6875rem] font-bold uppercase text-warn" data-bajo>Bajo</span>
            </div>
            <p class="mt-2 text-2xl font-extrabold text-ink tabular"><span data-n>0</span> <span class="text-xs font-semibold text-ink-3">u.</span></p>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line"><span class="block h-full w-0 rounded-full bg-accent transition-[width] duration-500" data-bar></span></div>
          </div>
        ))}
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <section class="panel p-6 sm:p-8 space-y-4" aria-labelledby="h-ped">
        <div class="flex items-center justify-between border-b border-line pb-3">
          <h2 id="h-ped" class="text-lg font-bold text-ink">Pedidos pendientes</h2>
          <a href="/operador/entregas" class="link-arrow text-sm">Ver todos</a>
        </div>
        <ul id="lista-pedidos" class="divide-y divide-line"></ul>
      </section>

      <section class="panel p-6 sm:p-8 space-y-4" aria-labelledby="h-act">
        <div class="flex items-center justify-between border-b border-line pb-3">
          <h2 id="h-act" class="text-lg font-bold text-ink">Actividad reciente</h2>
          <a href="/operador/historial" class="link-arrow text-sm">Ver historial</a>
        </div>
        <ul id="lista-actividad" class="divide-y divide-line"></ul>
      </section>
    </div>
  </div>
</LayoutOperador>

<script>
  import { STOCK_BAJO, actividad, esc, fmtFecha, getPedidosPendientes, kpis, onDb, operadorActual, seedOperadorDemo, stockDe, stockPorTipo, toast } from '../../lib/operador';

  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;

  function render() {
    const k = kpis();
    (Object.keys(k) as (keyof typeof k)[]).forEach((key) =>
      document.querySelectorAll(`[data-kpi="${key}"]`).forEach((el) => (el.textContent = String(k[key])))
    );
    $('#centro-txt').textContent = `${operadorActual().centro} · resumen de hoy`;

    const stock = stockPorTipo();
    const max = Math.max(10, ...Object.values(stock));
    document.querySelectorAll<HTMLElement>('#stock [data-tipo]').forEach((card) => {
      const n = stock[card.dataset.tipo!] ?? 0;
      card.querySelector('[data-n]')!.textContent = String(n);
      (card.querySelector('[data-bar]') as HTMLElement).style.width = `${Math.round((n / max) * 100)}%`;
      card.querySelector('[data-bajo]')!.classList.toggle('hidden', n >= STOCK_BAJO);
    });

    const pend = getPedidosPendientes().slice(0, 5);
    $('#lista-pedidos').innerHTML = pend.length
      ? pend.map((p) => {
          const disp = stockDe(p.tipoSangre, p.tipoHemocomponente);
          return `<li class="flex items-center justify-between gap-3 py-3">
            <div class="min-w-0"><p class="truncate font-semibold text-ink">${esc(p.pacienteNombre)}</p>
            <p class="truncate text-xs text-ink-3">${p.unidades} u. ${esc(p.tipoSangre)} · ${esc(p.tipoHemocomponente)} → ${esc(p.hospitalDestino)}</p></div>
            <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-bold ${disp >= p.unidades ? 'bg-ok-soft text-ok' : 'bg-warn-soft text-warn'}">${disp >= p.unidades ? 'Hay stock' : `Stock ${disp}`}</span>
          </li>`;
        }).join('')
      : '<li class="py-6 text-center text-sm text-ink-3">No hay pedidos pendientes 🎉</li>';

    const act = actividad().slice(0, 5);
    $('#lista-actividad').innerHTML = act.length
      ? act.map((e) => `<li class="py-3"><p class="text-sm font-semibold text-ink">${esc(e.titulo)}</p>
          <p class="truncate text-xs text-ink-3">${esc(e.detalle)} · ${esc(fmtFecha(e.fecha, { day: 'numeric', month: 'short' }))}</p></li>`).join('')
      : '<li class="py-6 text-center text-sm text-ink-3">Todavía no hay actividad.</li>';
  }

  function init() {
    const root = document.getElementById('stock');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    if (new URLSearchParams(location.search).get('demo') === '1') {
      seedOperadorDemo();
      history.replaceState(null, '', location.pathname);
    }
    document.getElementById('btn-demo')?.addEventListener('click', () => {
      seedOperadorDemo();
      toast('Datos de ejemplo cargados.');
    });

    render();
    onDb(render);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
