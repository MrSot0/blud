---
// src/pages/operador/donantes.astro
import FichaDonante from '../../components/app/FichaDonante.astro';
import Paginador from '../../components/app/Paginador.astro';
import LayoutOperador from '../../layouts/LayoutOperador.astro';
import { BLOOD_TYPES } from '../../lib/db';
---

<LayoutOperador title="BLUD | Gestión de donantes">
  <div class="container-blud py-8 space-y-8">
    <div class="flex flex-col gap-4 pb-6 border-b border-line">
      <div class="min-w-0">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Gestión de donantes</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Escanea el QR del carnet o busca por cédula, ID o nombre. Todos los donantes se abren en la misma ficha del carnet.</p>
      </div>
      <div id="vistas" class="flex flex-wrap gap-2" role="group" aria-label="Mostrar sección">
        <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="verificar" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          Verificar <span class="rounded-full bg-sunken px-2 py-0.5 text-xs font-bold text-ink-2 tabular" data-cuenta="cola">0</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="registro" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
          Registro
        </button>
        <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="mios" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Mis donantes <span class="rounded-full bg-sunken px-2 py-0.5 text-xs font-bold text-ink-2 tabular" data-cuenta="mios">0</span>
        </button>
      </div>
    </div>

    <!-- Vista: Verificar (una sola caja: verificar arriba, por verificar abajo) -->
    <div data-frame="verificar">
      <div class="panel p-6 sm:p-8 space-y-6 w-full">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-ink">Buscar o verificar donante</h2>
          <form id="form-buscar" class="flex flex-col sm:flex-row sm:items-end gap-3" novalidate>
            <div class="flex-1 min-w-0">
              <label for="buscar" class="block text-xs font-bold uppercase text-ink-2 mb-1">Cédula, ID del carnet o nombre</label>
              <input type="search" id="buscar" class="field" placeholder="V-12345678 · BLD-000123 · Ana Pérez" autocomplete="off" />
            </div>
            <div class="grid grid-cols-2 gap-3 sm:flex">
              <button type="button" id="btn-escanear" class="btn btn-secondary min-h-12 inline-flex items-center justify-center gap-2 sm:px-6">
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><rect width="7" height="7" x="7" y="7" rx="1"/><path d="M17 12v5h-5"/></svg>
                Escanear QR
              </button>
              <button type="submit" class="btn btn-primary min-h-12 sm:px-10">Buscar</button>
            </div>
          </form>

          <div id="escaner" hidden class="mx-auto w-full max-w-md space-y-3">
            <div class="relative overflow-hidden rounded-card bg-black aspect-square">
              <video id="escaner-video" class="size-full object-cover" playsinline muted></video>
              <span class="pointer-events-none absolute inset-[18%] rounded-card border-4 border-white/80" aria-hidden="true"></span>
            </div>
            <p id="escaner-msg" class="text-center text-sm text-ink-2">Apunta la cámara al QR del carnet del donante.</p>
            <button type="button" id="escaner-cerrar" class="btn btn-secondary w-full">Cancelar</button>
          </div>

          <div id="coincidencias" hidden class="space-y-2">
            <p class="text-xs font-bold uppercase text-ink-3" id="coinc-titulo"></p>
            <ul id="coinc-lista" class="divide-y divide-line rounded-control border border-line"></ul>
          </div>

          <div id="resultado" class="hidden mx-auto w-full max-w-xl">
            <FichaDonante id="res-ficha">
              <div id="res-verificar" class="space-y-3">
                <label class="flex items-start gap-3 cursor-pointer">
                  <input type="checkbox" id="res-check" class="size-4 mt-0.5 rounded text-accent border-line-strong focus:ring-accent" />
                  <span class="text-sm text-ink-2">Comprobé la cédula física: la foto y los datos coinciden con esta persona.</span>
                </label>
                <button type="button" id="btn-verificar" class="btn btn-primary w-full" disabled>Verificar y aprobar</button>
              </div>
              <a id="res-donar" href="/operador/donaciones" class="hidden btn btn-primary w-full">Registrar donación</a>
              <a id="res-chat" href="/operador/mensajes" class="btn btn-secondary w-full">Escribir al donante</a>
            </FichaDonante>
          </div>
          <p id="res-vacio" class="hidden rounded-control bg-warn-soft px-3 py-2 text-sm font-medium text-warn"></p>
        </div>
        <div class="space-y-4 border-t border-line pt-6">
          <div class="flex items-center justify-between border-b border-line pb-3">
            <h2 class="text-lg font-bold text-ink">Por verificar <span class="text-ink-3 text-sm font-semibold">(<span id="n-cola">0</span>)</span></h2>
          </div>
          <ul id="cola" class="divide-y divide-line max-h-80 overflow-y-auto"></ul>
        </div>
      </div>
    </div>

    <!-- Vista: Registro (una sola caja: formulario arriba, últimos 5 abajo) -->
    <div data-frame="registro" class="hidden">
      <div class="panel p-6 sm:p-8 space-y-6 w-full">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-ink">Nuevo registro manual</h2>
          <form id="form-nuevo" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1.5fr_9rem_10rem_8rem_auto] gap-4 items-end" novalidate>
            <div>
              <label for="reg-cedula" class="block text-xs font-bold uppercase text-ink-2 mb-1">Cédula</label>
              <input type="text" id="reg-cedula" class="field" placeholder="V-12345678" required />
            </div>
            <div>
              <label for="reg-nombre" class="block text-xs font-bold uppercase text-ink-2 mb-1">Nombre completo</label>
              <input type="text" id="reg-nombre" class="field" placeholder="Nombres y apellidos" required />
            </div>
            <div>
              <label for="reg-sangre" class="block text-xs font-bold uppercase text-ink-2 mb-1">Tipo de sangre</label>
              <select id="reg-sangre" class="field" required>
                <option value="">Seleccionar</option>
                {BLOOD_TYPES.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
            <div>
              <label for="reg-nac" class="block text-xs font-bold uppercase text-ink-2 mb-1">Nacimiento</label>
              <input type="date" id="reg-nac" class="field" />
            </div>
            <div>
              <label for="reg-sexo" class="block text-xs font-bold uppercase text-ink-2 mb-1">Sexo</label>
              <select id="reg-sexo" class="field">
                <option value="">—</option>
                <option value="F">Femenino</option>
                <option value="M">Masculino</option>
              </select>
            </div>
            <p id="reg-error" class="hidden order-last sm:col-span-2 lg:col-span-6 rounded-control bg-accent-soft px-3 py-2 text-sm font-medium text-accent-ink" role="alert"></p>
            <button type="submit" class="btn btn-primary w-full sm:col-span-2 lg:col-span-1 lg:w-auto lg:px-8 min-h-12">Guardar donante</button>
          </form>
        </div>
        <div class="space-y-4 border-t border-line pt-6">
          <div class="flex items-center justify-between border-b border-line pb-3">
            <h2 class="text-lg font-bold text-ink">Últimos registrados</h2>
            <span class="text-xs font-semibold text-ink-3">Máx. 5</span>
          </div>
          <ul id="ultimos" class="divide-y divide-line"></ul>
        </div>
      </div>
    </div>

    <!-- Vista: Mis donantes (oculta hasta que se pide) -->
    <div data-frame="mios" class="hidden">
        <div class="panel p-6 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-line pb-4">
            <h2 class="text-lg font-bold text-ink">Mis donantes <span class="text-ink-3 text-sm font-semibold">(<span id="n-mios">0</span>)</span></h2>
            <div class="flex items-center gap-2">
              <input type="search" id="filtro" class="field sm:w-72" placeholder="Filtrar por nombre o cédula…" aria-label="Filtrar donantes" />
            </div>
          </div>
          <div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead class="border-b border-line text-ink-3 uppercase text-[0.7rem]">
                  <tr><th class="py-2">Donante</th><th class="py-2">Sangre</th><th class="py-2">Origen</th><th class="py-2">Fecha</th><th class="py-2"><span class="sr-only">Acciones</span></th></tr>
                </thead>
                <tbody id="tabla" class="divide-y divide-line"></tbody>
              </table>
            </div>
            <p id="tabla-vacia" class="hidden py-6 text-center text-sm text-ink-3">Aún no has verificado ni registrado donantes.</p>
            <Paginador id="pag-mios" />
          </div>
        </div>
    </div>
  </div>
</LayoutOperador>

<script>
  import { buscarDonante, esc, fmtFecha, getDonantesOp, getPorVerificar, onDb, operadorActual, registrarDonanteOp, toast, verificarDonanteOp } from '../../lib/operador';
  import type { RegistroDonante } from '../../lib/operador';
  import { fichaDeRegistro, obtenerFicha, pintarFicha } from '../../lib/ficha';
  import { usaSupabase } from '../../lib/supabase';
  import { Paginador, masAntigua, paginaRemota } from '../../lib/paginacion';
  import { cachear } from '../../lib/db';
  import { registro } from '../../lib/db';
  import type { Escaner } from '../../lib/escaner';

  const iniciales = (n: string) => n.split(/\s+/).slice(0, 2).map((p) => p[0]?.toUpperCase() ?? '').join('') || '?';
  /** Fila de donante con el mismo orden que el carnet: avatar, nombre, cédula e ID, tipo de sangre y «Ver ficha». */
  const fila = (d: RegistroDonante, detalle: string) => `<li class="flex items-center gap-3 py-3 px-1">
      <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent text-xs font-bold text-white" aria-hidden="true">${esc(iniciales(d.nombreCompleto))}</span>
      <div class="min-w-0 flex-1"><p class="truncate font-semibold text-ink">${esc(d.nombreCompleto)}</p>
        <p class="truncate text-xs text-ink-3">${esc(d.cedula)} · ${esc(d.id)}${detalle ? ' · ' + detalle : ''}</p></div>
      <span class="blood-chip shrink-0">${esc(d.sangre || '—')}</span>
      <button type="button" class="btn btn-secondary btn-sm shrink-0" data-revisar="${esc(d.id)}">${d.estado === 'verificado' ? 'Ver ficha' : 'Revisar'}</button></li>`;

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;

  function init() {
    const root = $('#form-buscar');
    if (root.dataset.ready) return;
    root.dataset.ready = '1';

    let actual: RegistroDonante | undefined;
    const citaUrl = new URLSearchParams(location.search).get('cita');
    let vistaGeneral = () => {};

    const mostrar = (d: RegistroDonante) => {
      if ($('#resultado').closest('[data-frame]')?.classList.contains('hidden')) vistaGeneral();
      actual = d;
      $('#res-vacio').classList.add('hidden');
      $('#resultado').classList.remove('hidden');
      const ver = d.estado === 'verificado';
      $('#res-verificar').classList.toggle('hidden', ver);
      $('#res-donar').classList.toggle('hidden', !ver);
      ($('#res-check') as HTMLInputElement).checked = false;
      ($('#btn-verificar') as HTMLButtonElement).disabled = true;

      // Primero lo que ya está en el registro; luego la ficha completa (foto, teléfono, citas) de la base.
      ($('#res-chat') as HTMLAnchorElement).href = `/operador/mensajes?donante=${encodeURIComponent(d.id)}`;
      ($('#res-donar') as HTMLAnchorElement).href = `/operador/donaciones?q=${encodeURIComponent(d.cedula || d.id)}${citaUrl ? `&cita=${encodeURIComponent(citaUrl)}` : ''}`;
      $('#coincidencias').hidden = true;
      const card = $('#res-ficha');
      pintarFicha(card, fichaDeRegistro(d));
      if (usaSupabase()) {
        obtenerFicha(d.id)
          .then((f) => {
            if (!f || actual?.id !== d.id) return;
            pintarFicha(card, { ...f, verificado: f.verificado || ver });
            if (f.contactoPendiente) ($('#res-chat') as HTMLAnchorElement).href += '&motivo=contacto_laboratorio';
          })
          .catch(() => {});
      }
      $('#resultado').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    const buscar = (q: string) => {
      const d = buscarDonante(q);
      if (d) return mostrar(d);
      actual = undefined;
      $('#resultado').classList.add('hidden');
      // Sin coincidencia exacta: por nombre o por parte de la cédula.
      const t = q.trim().toLowerCase();
      const dig = t.replace(/\D/g, '');
      const hallados = t.length >= 3
        ? registro.all().filter((r) => r.nombreCompleto.toLowerCase().includes(t) || (dig.length >= 4 && r.cedula.replace(/\D/g, '').includes(dig))).slice(0, 20)
        : [];
      if (hallados.length === 1) return mostrar(hallados[0]);
      const coinc = $('#coincidencias');
      coinc.hidden = !hallados.length;
      if (hallados.length) {
        $('#res-vacio').classList.add('hidden');
        $('#coinc-titulo').textContent = `${hallados.length} donantes coinciden con «${q.trim()}»`;
        $('#coinc-lista').innerHTML = hallados.map((r) => fila(r, r.estado === 'verificado' ? 'verificado' : 'sin verificar')).join('');
        return;
      }
      const msg = $('#res-vacio');
      const noEsta = () => {
        msg.textContent = 'No encontramos ese donante. Pídele que complete su perfil en la app o regístralo manualmente.';
        msg.classList.remove('hidden');
        ($('#reg-cedula') as HTMLInputElement).value = q.trim();
      };
      if (!usaSupabase() || t.length < 3) return noEsta();
      // La caché solo trae donantes con actividad reciente: el resto se busca en la base.
      msg.textContent = 'Buscando en todo el registro…';
      msg.classList.remove('hidden');
      const qRemoto = q.match(/BLD-[A-Z0-9]{4,}/i)?.[0] ?? q;
      paginaRemota<RegistroDonante>('donantes', { q: qRemoto, limite: 20 })
        .then((r) => {
          const lista = r?.items ?? [];
          cachear('blud-db-donantes', lista);
          if (lista.length === 1) { msg.classList.add('hidden'); return mostrar(lista[0]); }
          if (!lista.length) return noEsta();
          msg.classList.add('hidden');
          coinc.hidden = false;
          $('#coinc-titulo').textContent = `${r!.total} donantes coinciden con «${q.trim()}»${r!.total > lista.length ? ` (se muestran ${lista.length}; afina la búsqueda)` : ''}`;
          $('#coinc-lista').innerHTML = lista.map((x) => fila(x, x.estado === 'verificado' ? 'verificado' : 'sin verificar')).join('');
        })
        .catch(() => noEsta());
    };

    $('#form-buscar').addEventListener('submit', (e) => {
      e.preventDefault();
      const q = ($('#buscar') as HTMLInputElement).value;
      if (!q.trim()) return toast('Ingresa una cédula, un ID o el contenido del QR.');
      buscar(q);
    });

    // Llega desde /verificar (QR escaneado): busca de una vez.
    const pre = new URLSearchParams(location.search).get('q');
    if (pre) {
      ($('#buscar') as HTMLInputElement).value = pre;
      buscar(pre);
    }

    // Escáner del QR del carnet: el mismo enlace que abre /verificar.
    let escaner: Escaner | null = null;
    const cerrarEscaner = () => { escaner?.detener(); escaner = null; $('#escaner').hidden = true; };
    $('#btn-escanear').addEventListener('click', async () => {
      if (escaner) return cerrarEscaner();
      $('#escaner').hidden = false;
      $('#escaner-msg').textContent = 'Apunta la cámara al QR del carnet del donante.';
      const { escanearQR } = await import('../../lib/escaner');
      escaner = await escanearQR($<HTMLVideoElement>('#escaner-video'), (texto) => {
        cerrarEscaner();
        ($('#buscar') as HTMLInputElement).value = texto.match(/[?&]id=(BLD-[A-Z0-9]+)/i)?.[1]?.toUpperCase() ?? texto;
        buscar(texto);
      }, (motivo) => { $('#escaner-msg').textContent = motivo; });
    });
    $('#escaner-cerrar').addEventListener('click', cerrarEscaner);
    document.addEventListener('astro:before-swap', cerrarEscaner, { once: true });

    // «Ver ficha» / «Revisar» desde cualquier lista abre la misma ficha del carnet.
    const abrirDesdeLista = (e: Event) => {
      const id = (e.target as HTMLElement).closest<HTMLElement>('[data-revisar]')?.dataset.revisar;
      const d = id ? buscarDonante(id) : undefined;
      if (d) {
        mostrar(d);
        $('#resultado').scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    };
    ['#coinc-lista', '#ultimos', '#tabla'].forEach((sel) => $(sel).addEventListener('click', abrirDesdeLista));

    $('#res-check').addEventListener('change', (e) => {
      ($('#btn-verificar') as HTMLButtonElement).disabled = !(e.target as HTMLInputElement).checked;
    });

    $('#btn-verificar').addEventListener('click', () => {
      if (!actual) return;
      const r = verificarDonanteOp(actual.id);
      if (!r.ok) return toast(r.motivo);
      toast('Donante verificado. Ya puede donar.');
      mostrar(r.data);
    });

    $('#form-nuevo').addEventListener('submit', (e) => {
      e.preventDefault();
      const err = $('#reg-error');
      const r = registrarDonanteOp({
        cedula: ($('#reg-cedula') as HTMLInputElement).value,
        nombreCompleto: ($('#reg-nombre') as HTMLInputElement).value,
        sangre: ($('#reg-sangre') as HTMLSelectElement).value,
        nacimiento: ($('#reg-nac') as HTMLInputElement).value || undefined,
        sexo: (($('#reg-sexo') as HTMLSelectElement).value || undefined) as 'M' | 'F' | undefined,
      });
      if (!r.ok) {
        err.textContent = r.motivo;
        err.classList.remove('hidden');
        return;
      }
      err.classList.add('hidden');
      toast(r.aviso ?? 'Donante registrado.');
      ($('#form-nuevo') as HTMLFormElement).reset();
      mostrar(r.data);
    });

    // Tablas
    const renderCola = () => {
      const cola = getPorVerificar();
      $('#n-cola').textContent = String(cola.length);
      $('[data-cuenta="cola"]').textContent = String(cola.length);
      $('#cola').innerHTML = cola.length
        ? cola.map((d) => fila(d, `pre-registrado ${esc(fmtFecha(d.fechaRegistro, { day: 'numeric', month: 'short' }))}`)).join('')
        : '<li class="py-6 text-center text-sm text-ink-3">No hay donantes esperando verificación.</li>';
    };

    const pagMios = new Paginador<RegistroDonante>({
      lista: $('#tabla'), pie: $('#pag-mios'), nombre: 'donantes', clave: (d) => d.id,
      vacio: () => (getDonantesOp().length ? '<tr><td colspan="5" class="py-6 text-center text-sm text-ink-3">Ningún donante coincide con el filtro.</td></tr>' : ''),
      render: (vis) => vis.map((d) => `<tr>
        <td class="py-3"><span class="flex items-center gap-3"><span class="grid size-9 shrink-0 place-items-center rounded-full bg-accent text-xs font-bold text-white" aria-hidden="true">${esc(iniciales(d.nombreCompleto))}</span>
          <span class="min-w-0"><span class="block font-semibold text-ink">${esc(d.nombreCompleto)}</span><span class="block text-xs font-normal text-ink-3">${esc(d.cedula)} · ${esc(d.id)}</span></span></span></td>
        <td class="py-3"><span class="blood-chip">${esc(d.sangre || '—')}</span></td>
        <td class="py-3 text-xs text-ink-2">${d.origen === 'app' ? 'Verificado desde la app' : 'Registro manual'}</td>
        <td class="py-3 text-xs text-ink-3">${esc(fmtFecha(d.fechaVerificacion ?? d.fechaRegistro, { day: 'numeric', month: 'short', year: 'numeric' }))}</td>
        <td class="py-3 text-right"><button type="button" class="btn btn-secondary btn-sm" data-revisar="${esc(d.id)}">Ver ficha</button></td></tr>`).join(''),
      remoto: async (cursor) => {
        const r = await paginaRemota<RegistroDonante>('donantes', {
          q: ($('#filtro') as HTMLInputElement).value, cursor,
          filtros: { operadorId: operadorActual().id, antesDe: masAntigua(getDonantesOp(), (d) => d.fechaVerificacion ?? d.fechaRegistro) },
        });
        if (r) cachear('blud-db-donantes', r.items);
        return r;
      },
    });

    const renderTabla = () => {
      const f = ($('#filtro') as HTMLInputElement).value.trim().toLowerCase();
      const lista = getDonantesOp();
      const vis = lista.filter((d) => !f || d.nombreCompleto.toLowerCase().includes(f) || d.cedula.toLowerCase().includes(f));
      $('#n-mios').textContent = String(lista.length);
      $('[data-cuenta="mios"]').textContent = String(lista.length);
      $('#tabla-vacia').classList.toggle('hidden', lista.length > 0);
      pagMios.mostrar(vis, f);
    };

    $('#cola').addEventListener('click', (e) => {
      const id = (e.target as HTMLElement).closest<HTMLElement>('[data-revisar]')?.dataset.revisar;
      const d = id ? buscarDonante(id) : undefined;
      if (d) {
        mostrar(d);
        $('#resultado').scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
    $('#filtro').addEventListener('input', renderTabla);

    // Tres vistas: Verificar (verificar + por verificar), Registro (nuevo + últimos 5) y Mis donantes (oculta hasta pedirla).
    type Vista = 'verificar' | 'registro' | 'mios';
    const frames = [...document.querySelectorAll<HTMLElement>('[data-frame]')];
    const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-vista]')];
    let vista: Vista = 'verificar';

    const setVista = (v: Vista) => {
      vista = v;
      frames.forEach((f) => f.classList.toggle('hidden', f.dataset.frame !== v));
      botones.forEach((b) => {
        const on = b.dataset.vista === v;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('btn-primary', on);
        b.classList.toggle('btn-secondary', !on);
      });
      if (v === 'mios') $('#filtro').focus({ preventScroll: true });
      if (v === 'verificar') $('#buscar').focus({ preventScroll: true });
    };
    // Pulsar la vista activa de "Mis donantes" vuelve a Verificar; las otras dos son fijas
    botones.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.vista as Vista;
      setVista(v === 'mios' && vista === 'mios' ? 'verificar' : v);
    }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && vista === 'mios' && !document.querySelector('dialog[open]')) setVista('verificar'); });
    vistaGeneral = () => setVista('verificar');
    setVista('verificar');

    const renderUltimos = () => {
      const u = getDonantesOp()
        .map((d, i) => ({ d, i }))
        .sort((x, y) => (y.d.fechaVerificacion ?? y.d.fechaRegistro).localeCompare(x.d.fechaVerificacion ?? x.d.fechaRegistro) || y.i - x.i)
        .slice(0, 5)
        .map((x) => x.d);
      $('#ultimos').innerHTML = u.length
        ? u.map((d) => fila(d, `${d.origen === 'app' ? 'verificado desde la app' : 'registro manual'} · ${esc(fmtFecha(d.fechaVerificacion ?? d.fechaRegistro, { day: 'numeric', month: 'short' }))}`)).join('')
        : '<li class="py-6 text-center text-sm text-ink-3">Aún no has registrado donantes.</li>';
    };

    const render = () => { renderCola(); renderTabla(); renderUltimos(); };
    render();
    onDb(render);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>