---
// src/pages/operador/donantes.astro
import LayoutOperador from '../../layouts/LayoutOperador.astro';
import { BLOOD_TYPES } from '../../lib/db';
---

<LayoutOperador title="BLUD | Gestión de donantes">
  <div class="container-blud py-8 space-y-8">
    <div class="flex flex-col gap-4 pb-6 border-b border-line">
      <div class="min-w-0">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Gestión de donantes</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Verifica a los usuarios pre-registrados en la app o registra nuevos donantes del centro.</p>
      </div>
      <div id="vistas" class="flex flex-wrap gap-2" role="group" aria-label="Mostrar sección">
        <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="verificar" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          Verificar <span class="rounded-full bg-sunken px-2 py-0.5 text-xs font-bold text-ink-2 tabular" data-cuenta="cola">0</span>
        </button>
        <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="registro" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
          Registro
        </button>
        <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="mios" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Mis donantes <span class="rounded-full bg-sunken px-2 py-0.5 text-xs font-bold text-ink-2 tabular" data-cuenta="mios">0</span>
        </button>
      </div>
    </div>

    <!-- Vista: Verificar (una sola caja: verificar arriba, por verificar abajo) -->
    <div data-frame="verificar">
      <div class="panel p-6 sm:p-8 space-y-6 w-full">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-ink">Verificar donante</h2>
          <form id="form-buscar" class="flex flex-col sm:flex-row sm:items-end gap-3" novalidate>
            <div class="flex-1 min-w-0">
              <label for="buscar" class="block text-xs font-bold uppercase text-ink-2 mb-1">Cédula, ID del carnet o contenido del QR</label>
              <input type="text" id="buscar" class="field" placeholder="V-12345678 · BLD-A1B2C3" autocomplete="off" />
            </div>
            <button type="submit" class="btn btn-primary w-full sm:w-auto sm:px-10 min-h-12">Buscar</button>
          </form>

          <div id="resultado" class="hidden rounded-control border border-line bg-sunken p-4 space-y-3">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p id="res-nombre" class="font-bold text-ink"></p>
                <p id="res-cedula" class="text-xs text-ink-3"></p>
              </div>
              <span id="res-sangre" class="blood-chip"></span>
            </div>
            <p class="text-xs text-ink-2">Estado: <span id="res-estado" class="font-bold"></span></p>
            <div id="res-verificar" class="space-y-3">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" id="res-check" class="size-4 mt-0.5 rounded text-accent border-line-strong focus:ring-accent" />
                <span class="text-sm text-ink-2">Comprobé la cédula física y coincide con estos datos.</span>
              </label>
              <button type="button" id="btn-verificar" class="btn btn-primary w-full" disabled>Verificar y aprobar</button>
            </div>
            <a id="res-donar" href="/operador/donaciones" class="hidden btn btn-secondary w-full">Registrar donación</a>
          </div>
          <p id="res-vacio" class="hidden rounded-control bg-warn-soft px-3 py-2 text-sm font-medium text-warn"></p>
        </div>
        <div class="space-y-4 border-t border-line pt-6">
          <div class="flex items-center justify-between border-b border-line pb-3">
            <h2 class="text-lg font-bold text-ink">Por verificar <span class="text-ink-3 text-sm font-semibold">(<span id="n-cola">0</span>)</span></h2>
          </div>
          <ul id="cola" class="divide-y divide-line max-h-80 overflow-y-auto"></ul>
        </div>
      </div>
    </div>

    <!-- Vista: Registro (una sola caja: formulario arriba, últimos 5 abajo) -->
    <div data-frame="registro" class="hidden">
      <div class="panel p-6 sm:p-8 space-y-6 w-full">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-ink">Nuevo registro manual</h2>
          <form id="form-nuevo" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1.6fr_11rem_auto] gap-4 items-end" novalidate>
            <div>
              <label for="reg-cedula" class="block text-xs font-bold uppercase text-ink-2 mb-1">Cédula</label>
              <input type="text" id="reg-cedula" class="field" placeholder="V-12345678" required />
            </div>
            <div>
              <label for="reg-nombre" class="block text-xs font-bold uppercase text-ink-2 mb-1">Nombre completo</label>
              <input type="text" id="reg-nombre" class="field" placeholder="Nombres y apellidos" required />
            </div>
            <div>
              <label for="reg-sangre" class="block text-xs font-bold uppercase text-ink-2 mb-1">Tipo de sangre</label>
              <select id="reg-sangre" class="field" required>
                <option value="">Seleccionar</option>
                {BLOOD_TYPES.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
            <p id="reg-error" class="hidden order-last sm:col-span-2 lg:col-span-4 rounded-control bg-accent-soft px-3 py-2 text-sm font-medium text-accent-ink" role="alert"></p>
            <button type="submit" class="btn btn-primary w-full sm:col-span-2 lg:col-span-1 lg:w-auto lg:px-8 min-h-12">Guardar donante</button>
          </form>
        </div>
        <div class="space-y-4 border-t border-line pt-6">
          <div class="flex items-center justify-between border-b border-line pb-3">
            <h2 class="text-lg font-bold text-ink">Últimos registrados</h2>
            <span class="text-xs font-semibold text-ink-3">Máx. 5</span>
          </div>
          <ul id="ultimos" class="divide-y divide-line"></ul>
        </div>
      </div>
    </div>

    <!-- Vista: Mis donantes (oculta hasta que se pide) -->
    <div data-frame="mios" class="hidden">
        <div class="panel p-6 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-line pb-4">
            <h2 class="text-lg font-bold text-ink">Mis donantes <span class="text-ink-3 text-sm font-semibold">(<span id="n-mios">0</span>)</span></h2>
            <div class="flex items-center gap-2">
              <input type="search" id="filtro" class="field sm:w-72" placeholder="Filtrar por nombre o cédula…" aria-label="Filtrar donantes" />
            </div>
          </div>
          <div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead class="border-b border-line text-ink-3 uppercase text-[0.7rem]">
                  <tr><th class="py-2">Donante</th><th class="py-2">Sangre</th><th class="py-2">Origen</th><th class="py-2">Fecha</th></tr>
                </thead>
                <tbody id="tabla" class="divide-y divide-line"></tbody>
              </table>
            </div>
            <p id="tabla-vacia" class="hidden py-6 text-center text-sm text-ink-3">Aún no has verificado ni registrado donantes.</p>
          </div>
        </div>
    </div>
  </div>
</LayoutOperador>

<script>
  import { buscarDonante, esc, fmtFecha, getDonantesOp, getPorVerificar, onDb, registrarDonanteOp, toast, verificarDonanteOp } from '../../lib/operador';
  import type { RegistroDonante } from '../../lib/operador';

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;

  function init() {
    const root = $('#form-buscar');
    if (root.dataset.ready) return;
    root.dataset.ready = '1';

    let actual: RegistroDonante | undefined;
    let vistaGeneral = () => {};

    const mostrar = (d: RegistroDonante) => {
      if ($('#resultado').closest('[data-frame]')?.classList.contains('hidden')) vistaGeneral();
      actual = d;
      $('#res-vacio').classList.add('hidden');
      $('#resultado').classList.remove('hidden');
      $('#res-nombre').textContent = d.nombreCompleto;
      $('#res-cedula').textContent = `${d.cedula} · ${d.id}`;
      $('#res-sangre').textContent = d.sangre || '—';
      const ver = d.estado === 'verificado';
      const est = $('#res-estado');
      est.textContent = ver ? 'Verificado' : 'Pre-registrado en la app';
      est.className = `font-bold ${ver ? 'text-ok' : 'text-warn'}`;
      $('#res-verificar').classList.toggle('hidden', ver);
      $('#res-donar').classList.toggle('hidden', !ver);
      ($('#res-check') as HTMLInputElement).checked = false;
      ($('#btn-verificar') as HTMLButtonElement).disabled = true;
    };

    const buscar = (q: string) => {
      const d = buscarDonante(q);
      if (d) return mostrar(d);
      actual = undefined;
      $('#resultado').classList.add('hidden');
      const msg = $('#res-vacio');
      msg.textContent = 'No encontramos ese donante. Pídele que complete su perfil en la app o regístralo manualmente.';
      msg.classList.remove('hidden');
      ($('#reg-cedula') as HTMLInputElement).value = q.trim();
    };

    $('#form-buscar').addEventListener('submit', (e) => {
      e.preventDefault();
      const q = ($('#buscar') as HTMLInputElement).value;
      if (!q.trim()) return toast('Ingresa una cédula, un ID o el contenido del QR.');
      buscar(q);
    });

    $('#res-check').addEventListener('change', (e) => {
      ($('#btn-verificar') as HTMLButtonElement).disabled = !(e.target as HTMLInputElement).checked;
    });

    $('#btn-verificar').addEventListener('click', () => {
      if (!actual) return;
      const r = verificarDonanteOp(actual.id);
      if (!r.ok) return toast(r.motivo);
      toast('¡Donante verificado! Ya puede donar.');
      mostrar(r.data);
    });

    $('#form-nuevo').addEventListener('submit', (e) => {
      e.preventDefault();
      const err = $('#reg-error');
      const r = registrarDonanteOp({
        cedula: ($('#reg-cedula') as HTMLInputElement).value,
        nombreCompleto: ($('#reg-nombre') as HTMLInputElement).value,
        sangre: ($('#reg-sangre') as HTMLSelectElement).value,
      });
      if (!r.ok) {
        err.textContent = r.motivo;
        err.classList.remove('hidden');
        return;
      }
      err.classList.add('hidden');
      toast(r.aviso ?? '¡Donante registrado!');
      ($('#form-nuevo') as HTMLFormElement).reset();
      mostrar(r.data);
    });

    // Tablas
    const renderCola = () => {
      const cola = getPorVerificar();
      $('#n-cola').textContent = String(cola.length);
      $('[data-cuenta="cola"]').textContent = String(cola.length);
      $('#cola').innerHTML = cola.length
        ? cola.map((d) => `<li class="flex items-center justify-between gap-3 py-3">
            <div class="min-w-0"><p class="truncate font-semibold text-ink">${esc(d.nombreCompleto)}</p>
            <p class="text-xs text-ink-3">${esc(d.cedula)} · pre-registrado ${esc(fmtFecha(d.fechaRegistro, { day: 'numeric', month: 'short' }))}</p></div>
            <span class="blood-chip">${esc(d.sangre || '—')}</span>
            <button type="button" class="btn btn-secondary btn-sm" data-revisar="${esc(d.id)}">Revisar</button></li>`).join('')
        : '<li class="py-6 text-center text-sm text-ink-3">No hay donantes esperando verificación 🎉</li>';
    };

    const renderTabla = () => {
      const f = ($('#filtro') as HTMLInputElement).value.trim().toLowerCase();
      const lista = getDonantesOp();
      const vis = lista.filter((d) => !f || d.nombreCompleto.toLowerCase().includes(f) || d.cedula.toLowerCase().includes(f));
      $('#n-mios').textContent = String(lista.length);
      $('[data-cuenta="mios"]').textContent = String(lista.length);
      $('#tabla-vacia').classList.toggle('hidden', lista.length > 0);
      $('#tabla').innerHTML = vis.map((d) => `<tr>
        <td class="py-3 font-semibold text-ink">${esc(d.nombreCompleto)}<br><span class="text-xs font-normal text-ink-3">${esc(d.cedula)}</span></td>
        <td class="py-3"><span class="blood-chip">${esc(d.sangre || '—')}</span></td>
        <td class="py-3 text-xs text-ink-2">${d.origen === 'app' ? 'Verificado desde la app' : 'Registro manual'}</td>
        <td class="py-3 text-xs text-ink-3">${esc(fmtFecha(d.fechaVerificacion ?? d.fechaRegistro, { day: 'numeric', month: 'short', year: 'numeric' }))}</td></tr>`).join('');
    };

    $('#cola').addEventListener('click', (e) => {
      const id = (e.target as HTMLElement).closest<HTMLElement>('[data-revisar]')?.dataset.revisar;
      const d = id ? buscarDonante(id) : undefined;
      if (d) {
        mostrar(d);
        $('#resultado').scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
    $('#filtro').addEventListener('input', renderTabla);

    // Tres vistas: Verificar (verificar + por verificar), Registro (nuevo + últimos 5) y Mis donantes (oculta hasta pedirla).
    type Vista = 'verificar' | 'registro' | 'mios';
    const frames = [...document.querySelectorAll<HTMLElement>('[data-frame]')];
    const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-vista]')];
    let vista: Vista = 'verificar';

    const setVista = (v: Vista) => {
      vista = v;
      frames.forEach((f) => f.classList.toggle('hidden', f.dataset.frame !== v));
      botones.forEach((b) => {
        const on = b.dataset.vista === v;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('btn-primary', on);
        b.classList.toggle('btn-secondary', !on);
      });
      if (v === 'mios') $('#filtro').focus({ preventScroll: true });
      if (v === 'verificar') $('#buscar').focus({ preventScroll: true });
    };
    // Pulsar la vista activa de "Mis donantes" vuelve a Verificar; las otras dos son fijas
    botones.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.vista as Vista;
      setVista(v === 'mios' && vista === 'mios' ? 'verificar' : v);
    }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && vista === 'mios' && !document.querySelector('dialog[open]')) setVista('verificar'); });
    vistaGeneral = () => setVista('verificar');
    setVista('verificar');

    const renderUltimos = () => {
      const u = getDonantesOp()
        .map((d, i) => ({ d, i }))
        .sort((x, y) => (y.d.fechaVerificacion ?? y.d.fechaRegistro).localeCompare(x.d.fechaVerificacion ?? x.d.fechaRegistro) || y.i - x.i)
        .slice(0, 5)
        .map((x) => x.d);
      $('#ultimos').innerHTML = u.length
        ? u.map((d) => `<li class="flex items-center justify-between gap-3 py-3">
            <div class="min-w-0"><p class="truncate font-semibold text-ink">${esc(d.nombreCompleto)}</p>
            <p class="text-xs text-ink-3">${esc(d.cedula)} · ${d.origen === 'app' ? 'verificado desde la app' : 'registro manual'} · ${esc(fmtFecha(d.fechaVerificacion ?? d.fechaRegistro, { day: 'numeric', month: 'short' }))}</p></div>
            <span class="blood-chip">${esc(d.sangre || '—')}</span></li>`).join('')
        : '<li class="py-6 text-center text-sm text-ink-3">Aún no has registrado donantes.</li>';
    };

    const render = () => { renderCola(); renderTabla(); renderUltimos(); };
    render();
    onDb(render);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>