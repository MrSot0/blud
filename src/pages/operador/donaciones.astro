---
// src/pages/operador/donaciones.astro
import LayoutOperador from '../../layouts/LayoutOperador.astro';
import Paginador from '../../components/app/Paginador.astro';
import { BLOOD_TYPES, COMPONENTES } from '../../lib/db';
---

<LayoutOperador title="BLUD | Registro de donaciones">
  <div class="container-blud py-8 space-y-8">
    <div class="flex flex-col gap-4 pb-6 border-b border-line">
      <div class="min-w-0">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Registro de donaciones</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Registra la extracción por hemocomponente. Solo pueden donar personas ya verificadas.</p>
      </div>
      <div id="vistas" class="flex flex-wrap gap-2" role="group" aria-label="Mostrar sección">
        <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="registro" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
          Registrar donación
        </button>
        <button type="button" class="btn btn-secondary btn-sm inline-flex items-center gap-1.5" data-vista="historial" aria-pressed="false">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          Historial de extracciones <span class="rounded-full bg-sunken px-2 py-0.5 text-xs font-bold text-ink-2 tabular" data-cuenta="historial">0</span>
        </button>
      </div>
    </div>

    <!-- Vista: Registro (una sola caja: formulario arriba, últimas 5 abajo) -->
    <div data-frame="registro">
      <div class="panel p-6 sm:p-8 space-y-6 w-full">
        <div class="space-y-4">
          <h2 class="text-lg font-bold text-ink">Registrar nueva donación</h2>
          <div id="cita-banner" hidden class="flex flex-col gap-2 rounded-control bg-accent-soft px-4 py-3 text-sm text-accent-ink sm:flex-row sm:items-center sm:justify-between">
            <p><strong class="font-bold">Atendiendo una cita<span data-cita-hora></span>.</strong> Al guardar la evaluación o la donación, la cita se cierra sola.</p>
            <a href="/operador/citas" class="link-arrow shrink-0 font-semibold">Volver a la bandeja</a>
          </div>
          <form id="form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.4fr_9rem_9rem_1.2fr] gap-4 items-end" novalidate>
            <div class="sm:col-span-2 lg:col-span-1">
              <label for="cedula" class="block text-xs font-bold uppercase text-ink-2 mb-1">Cédula o ID del donante</label>
              <input type="text" id="cedula" class="field" placeholder="V-12345678" autocomplete="off" required />
            </div>
            <div>
              <label for="tipo" class="block text-xs font-bold uppercase text-ink-2 mb-1">Tipo de sangre</label>
              <select id="tipo" class="field" required>
                <option value="">Seleccionar</option>
                {BLOOD_TYPES.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
            <div>
              <label for="vol" class="block text-xs font-bold uppercase text-ink-2 mb-1">Volumen (ml)</label>
              <input type="number" id="vol" class="field" value="450" min="50" max="600" required />
            </div>
            <div class="sm:col-span-2 lg:col-span-1">
              <label for="comp" class="block text-xs font-bold uppercase text-ink-2 mb-1">Hemocomponente extraído</label>
              <select id="comp" class="field" required>
                {COMPONENTES.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>

            <!-- RF-O7: evaluación médica previa -->
            <fieldset class="sm:col-span-2 lg:col-span-4 rounded-control border border-line p-4 sm:p-5 space-y-4">
              <legend class="px-2 text-xs font-bold uppercase tracking-wider text-ink-2">Evaluación médica <span class="font-normal normal-case text-ink-3">· el banco decide si es apto</span></legend>
              <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Peso (kg) *</span>
                  <input id="ev-peso" inputmode="decimal" class="field" placeholder="70" autocomplete="off" /></label>
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Talla (cm)</span>
                  <input id="ev-talla" inputmode="decimal" class="field" placeholder="170" autocomplete="off" /></label>
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Presión *</span>
                  <input id="ev-presion" class="field" placeholder="120/80" autocomplete="off" /></label>
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Pulso (lpm)</span>
                  <input id="ev-fc" inputmode="numeric" class="field" placeholder="72" autocomplete="off" /></label>
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Temp. (°C) *</span>
                  <input id="ev-temp" inputmode="decimal" class="field" placeholder="36.5" autocomplete="off" /></label>
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Hb (g/dL) *</span>
                  <input id="ev-hb" inputmode="decimal" class="field" placeholder="14" autocomplete="off" /></label>
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Hcto (%)</span>
                  <input id="ev-hcto" inputmode="decimal" class="field" placeholder="42" autocomplete="off" /></label>
              </div>
              <p class="text-xs text-ink-3">Rangos: presión 90–180 / 60–100 mmHg · pulso 50–100 · temperatura ≤ 37,5 °C · peso ≥ 50 kg · Hb mujer ≥ 12,5, hombre ≥ 13,5 g/dL · Hcto ≥ 38 %.</p>
              <div class="grid grid-cols-1 sm:grid-cols-[14rem_1fr] gap-3 items-start">
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Dictamen *</span>
                  <select id="ev-dictamen" class="field">
                    <option value="apto">Apto para donar</option>
                    <option value="temporal">Rechazo temporal</option>
                    <option value="definitivo">Rechazo permanente</option>
                  </select></label>
                <label class="hidden block" id="ev-motivo-box"><span class="mb-1 block text-xs text-ink-3">Motivo del rechazo * <span class="text-ink-3">(solo lo ve el personal médico)</span></span>
                  <input id="ev-motivo" class="field" maxlength="200" placeholder="Ej.: medicamento en uso, antecedente clínico…" autocomplete="off" /></label>
              </div>
              <p id="ev-alerta" class="hidden rounded-control bg-warn-soft px-3 py-2 text-xs font-medium text-warn" role="status"></p>
            </fieldset>

            <!-- RF-O8: extracción -->
            <fieldset class="sm:col-span-2 lg:col-span-4 rounded-control border border-line p-4 sm:p-5 space-y-4" id="extraccion">
              <legend class="px-2 text-xs font-bold uppercase tracking-wider text-ink-2">Extracción</legend>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Tipo de donación *</span>
                  <select id="ex-tipo" class="field">
                    <option value="Voluntaria">Voluntaria</option>
                    <option value="Reposicion">De reposición</option>
                    <option value="Autologa">Autóloga</option>
                    <option value="Aferesis">Aféresis</option>
                  </select></label>
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Bolsa y anticoagulante *</span>
                  <select id="ex-bolsa" class="field">
                    <option value="Cuádruple CPD/SAG-M">Cuádruple CPD/SAG-M</option>
                    <option value="Triple CPD/SAG-M">Triple CPD/SAG-M</option>
                    <option value="Doble CPDA-1">Doble CPDA-1</option>
                    <option value="Simple CPDA-1">Simple CPDA-1</option>
                    <option value="Kit de aféresis ACD-A">Kit de aféresis ACD-A</option>
                  </select></label>
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Inicio *</span>
                  <input id="ex-inicio" type="time" class="field" /></label>
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Fin *</span>
                  <input id="ex-fin" type="time" class="field" /></label>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-[14rem_1fr] gap-3 items-start">
                <label class="block"><span class="mb-1 block text-xs text-ink-3">Reacciones durante la donación *</span>
                  <select id="ex-reaccion" class="field">
                    <option value="">Ninguna</option>
                    <option value="Mareo o lipotimia leve">Mareo o lipotimia leve</option>
                    <option value="Reacción vasovagal moderada">Reacción vasovagal moderada</option>
                    <option value="Reacción vasovagal grave">Reacción vasovagal grave</option>
                    <option value="Hematoma en el sitio de punción">Hematoma en el sitio de punción</option>
                    <option value="Punción arterial">Punción arterial</option>
                    <option value="otra">Otra</option>
                  </select></label>
                <label class="hidden block" id="ex-reaccion-box"><span class="mb-1 block text-xs text-ink-3">Describe la reacción y lo que se hizo *</span>
                  <input id="ex-reaccion-txt" class="field" maxlength="300" autocomplete="off" /></label>
              </div>
              <p class="text-xs text-ink-3">Responsable de la extracción: <strong class="text-ink" id="ex-responsable">tú</strong>. La bolsa queda en cuarentena hasta el análisis del laboratorio.</p>
            </fieldset>

            <div id="donante" class="hidden sm:col-span-2 lg:col-span-4 rounded-control border border-line bg-sunken p-3 text-sm space-y-1">
              <div class="flex items-center justify-between gap-3">
                <p class="font-bold text-ink" id="d-nombre"></p>
                <span class="rounded-full px-2 py-0.5 text-xs font-bold" id="d-estado"></span>
              </div>
              <p class="text-xs text-ink-3" id="d-extra"></p>
              <a href="/operador/donantes" id="d-link" class="hidden link-arrow text-xs">Ir a verificar</a>
            </div>
            <p id="error" class="hidden sm:col-span-2 lg:col-span-4 rounded-control bg-accent-soft px-3 py-2 text-sm font-medium text-accent-ink" role="alert"></p>
            <div class="sm:col-span-2 lg:col-span-4 flex justify-center">
              <button type="submit" class="btn btn-primary w-full sm:w-auto sm:px-12 min-h-12">Guardar donación</button>
            </div>
          </form>
        </div>

        <div class="space-y-4 border-t border-line pt-6">
          <div class="flex items-center justify-between border-b border-line pb-3">
            <h2 class="text-lg font-bold text-ink">Últimas extracciones</h2>
            <span class="text-xs font-semibold text-ink-3">Máx. 5</span>
          </div>
          <ul id="ultimas" class="divide-y divide-line"></ul>
        </div>
      </div>
    </div>

    <!-- Vista: Historial completo (oculta hasta que se pide) -->
    <div data-frame="historial" class="hidden">
      <div class="panel p-6 sm:p-8 space-y-4 w-full">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-line pb-4">
          <h2 class="text-lg font-bold text-ink">Historial de extracciones <span class="text-ink-3 text-sm font-semibold">(<span id="n">0</span>)</span></h2>
          <input type="search" id="filtro" class="field sm:w-72" placeholder="Filtrar por donante, cédula o tipo…" aria-label="Filtrar extracciones" />
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-line text-ink-3 uppercase text-[0.7rem]">
              <tr><th class="py-2">Donante</th><th class="py-2">Sangre</th><th class="py-2">Componente</th><th class="py-2">Vol.</th><th class="py-2">Fecha</th></tr>
            </thead>
            <tbody id="tabla" class="divide-y divide-line"></tbody>
          </table>
        </div>
        <p id="vacia" class="hidden py-6 text-center text-sm text-ink-3">Todavía no hay extracciones registradas.</p>
        <Paginador id="pag-historial" />
      </div>
    </div>
  </div>
</LayoutOperador>

<script>
  import { buscarDonante, esc, fmtFecha, getDonacionesOp, onDb, operadorActual, registrarDonacionOp, toast } from '../../lib/operador';
  import type { DonacionOp, Hemocomponente } from '../../lib/operador';
  import { Paginador, masAntigua, paginaRemota } from '../../lib/paginacion';
  import { cerrarCitaDemo } from '../../lib/citas';

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;

  function init() {
    const form = $<HTMLFormElement>('#form');
    if (form.dataset.ready) return;
    form.dataset.ready = '1';

    const cedula = $<HTMLInputElement>('#cedula');
    const tipo = $<HTMLSelectElement>('#tipo');

    // Vistas: Registro (formulario + últimas 5) e Historial (completo, oculto hasta pedirlo)
    type Vista = 'registro' | 'historial';
    const frames = [...document.querySelectorAll<HTMLElement>('[data-frame]')];
    const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-vista]')];
    let vista: Vista = 'registro';
    const setVista = (v: Vista) => {
      vista = v;
      frames.forEach((f) => f.classList.toggle('hidden', f.dataset.frame !== v));
      botones.forEach((b) => {
        const on = b.dataset.vista === v;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('btn-primary', on);
        b.classList.toggle('btn-secondary', !on);
      });
      if (v === 'historial') $('#filtro').focus({ preventScroll: true });
      else cedula.focus({ preventScroll: true });
    };
    // Pulsar "Historial" estando en él vuelve al registro
    botones.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.vista as Vista;
      setVista(v === 'historial' && vista === 'historial' ? 'registro' : v);
    }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && vista === 'historial' && !document.querySelector('dialog[open]')) setVista('registro'); });
    setVista('registro');

    // Al escribir la cédula/ID se busca el donante y se completa su tipo de sangre
    const lookup = () => {
      const box = $('#donante');
      const q = cedula.value.trim();
      if (q.length < 5) return box.classList.add('hidden');
      const d = buscarDonante(q);
      box.classList.remove('hidden');
      const estado = $('#d-estado');
      if (!d) {
        $('#d-nombre').textContent = 'Donante no encontrado';
        $('#d-extra').textContent = 'Regístralo primero en Gestión de donantes.';
        estado.textContent = 'Sin registro';
        estado.className = 'rounded-full px-2 py-0.5 text-xs font-bold bg-warn-soft text-warn';
        $('#d-link').classList.remove('hidden');
        return;
      }
      const ver = d.estado === 'verificado';
      $('#d-nombre').textContent = d.nombreCompleto;
      $('#d-extra').textContent = `${d.cedula} · tipo ${d.sangre || 'sin confirmar'}`;
      estado.textContent = ver ? 'Verificado' : 'Sin verificar';
      estado.className = `rounded-full px-2 py-0.5 text-xs font-bold ${ver ? 'bg-ok-soft text-ok' : 'bg-warn-soft text-warn'}`;
      $('#d-link').classList.toggle('hidden', ver);
      if (d.sangre) tipo.value = d.sangre;
    };
    cedula.addEventListener('input', lookup);

    // Llega desde la bandeja de citas (o la ficha del donante): cédula ya cargada.
    const params = new URLSearchParams(location.search);
    const citaId = params.get('cita');
    const pre = params.get('q');
    if (pre) {
      cedula.value = pre;
      lookup();
      onDb(() => { if (cedula.value === pre) lookup(); });
      requestAnimationFrame(() => $('#ev-peso').focus({ preventScroll: true }));
    }
    if (citaId) {
      $('#cita-banner').hidden = false;
      const hora = params.get('hora');
      if (hora) $('[data-cita-hora]').textContent = ` de las ${hora}`;
    }

    // ---- Evaluación (RF-O7): dictamen y alertas de rango en vivo
    const dictamen = $<HTMLSelectElement>('#ev-dictamen');
    const motivoBox = $('#ev-motivo-box');
    const extraccion = $('#extraccion');
    const pintarDictamen = () => {
      const rechazo = dictamen.value !== 'apto';
      motivoBox.classList.toggle('hidden', !rechazo);
      extraccion.classList.toggle('opacity-50', rechazo);
      extraccion.toggleAttribute('disabled', rechazo);
      form.querySelector<HTMLButtonElement>('button[type=submit]')!.textContent = rechazo ? 'Guardar evaluación (sin extracción)' : 'Guardar donación';
    };
    dictamen.addEventListener('change', pintarDictamen);
    const num = (id: string) => Number(($<HTMLInputElement>(id).value || '').replace(',', '.'));
    const alertas = () => {
      const a: string[] = [];
      const [sis, dia] = $<HTMLInputElement>('#ev-presion').value.split('/').map(Number);
      if (sis && (sis < 90 || sis > 180)) a.push('presión sistólica fuera de 90–180');
      if (dia && (dia < 60 || dia > 100)) a.push('presión diastólica fuera de 60–100');
      const fc = num('#ev-fc'); if (fc && (fc < 50 || fc > 100)) a.push('pulso fuera de 50–100');
      const t = num('#ev-temp'); if (t && t > 37.5) a.push('temperatura mayor de 37,5 °C');
      const peso = num('#ev-peso'); if (peso && peso < 50) a.push('peso menor de 50 kg');
      const hcto = num('#ev-hcto'); if (hcto && hcto < 38) a.push('hematocrito menor de 38 %');
      const hb = num('#ev-hb');
      const d = buscarDonante(cedula.value.trim());
      if (hb && hb < (d?.sexo === 'F' ? 12.5 : 13.5)) a.push(`hemoglobina menor de ${d?.sexo === 'F' ? '12,5' : '13,5'} g/dL`);
      const box = $('#ev-alerta');
      box.classList.toggle('hidden', !a.length);
      box.textContent = a.length ? `Fuera de rango: ${a.join(', ')}. Si se confirma, el dictamen debe ser de rechazo.` : '';
    };
    ['#ev-presion', '#ev-fc', '#ev-temp', '#ev-peso', '#ev-hb', '#ev-hcto'].forEach((id) => $(id).addEventListener('input', alertas));

    // ---- Extracción (RF-O8)
    const reaccion = $<HTMLSelectElement>('#ex-reaccion');
    reaccion.addEventListener('change', () => $('#ex-reaccion-box').classList.toggle('hidden', reaccion.value !== 'otra'));
    $('#ex-responsable').textContent = operadorActual().nombre || 'tú';
    const ahoraHM = () => new Date().toTimeString().slice(0, 5);
    $<HTMLInputElement>('#ex-inicio').value = ahoraHM();
    $('#comp').addEventListener('change', () => {
      if ($<HTMLSelectElement>('#comp').value === 'Plaquetas') {
        $<HTMLSelectElement>('#ex-tipo').value = 'Aferesis';
        $<HTMLSelectElement>('#ex-bolsa').value = 'Kit de aféresis ACD-A';
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const err = $('#error');
      const v = (id: string) => $<HTMLInputElement>(id).value.trim();
      const fallo = (m: string, foco?: string) => {
        err.textContent = m; err.classList.remove('hidden');
        if (foco) $(foco).focus();
      };
      const evaluacion = {
        peso: v('#ev-peso'), presion: v('#ev-presion'), hb: v('#ev-hb'), temperatura: v('#ev-temp'),
        fc: v('#ev-fc') || undefined, talla: v('#ev-talla') || undefined, hcto: v('#ev-hcto') || undefined,
        dictamen: dictamen.value as 'apto' | 'temporal' | 'definitivo', motivo: v('#ev-motivo') || undefined,
      };
      // La evaluación médica es obligatoria (RF-O7).
      if (!(evaluacion.peso && evaluacion.presion && evaluacion.hb && evaluacion.temperatura)) {
        return fallo('Registra el peso, la presión arterial, la temperatura y la hemoglobina del donante.', '#ev-peso');
      }
      if (!/^\d{2,3}\/\d{2,3}$/.test(evaluacion.presion)) return fallo('La presión debe escribirse así: 120/80.', '#ev-presion');
      if (evaluacion.dictamen !== 'apto' && !evaluacion.motivo) return fallo('Escribe el motivo del rechazo.', '#ev-motivo');
      // Extracción (RF-O8)
      const inicio = v('#ex-inicio');
      const fin = v('#ex-fin');
      const reacc = reaccion.value === 'otra' ? v('#ex-reaccion-txt') : reaccion.value;
      if (evaluacion.dictamen === 'apto') {
        if (!inicio || !fin) return fallo('Indica la hora de inicio y de fin de la extracción.', inicio ? '#ex-fin' : '#ex-inicio');
        if (fin <= inicio) return fallo('La hora de fin debe ser posterior a la de inicio.', '#ex-fin');
        if (reaccion.value === 'otra' && !reacc) return fallo('Describe la reacción.', '#ex-reaccion-txt');
      }
      const r = registrarDonacionOp({
        evaluacion,
        cedula: cedula.value,
        tipoSangre: tipo.value,
        tipoHemocomponente: $<HTMLSelectElement>('#comp').value as Hemocomponente,
        volumenMl: Number($<HTMLInputElement>('#vol').value),
        extraccion: {
          tipoDonacion: $<HTMLSelectElement>('#ex-tipo').value, bolsa: $<HTMLSelectElement>('#ex-bolsa').value,
          inicio, fin, reacciones: reacc || undefined,
        },
      });
      if (!r.ok) {
        err.textContent = r.motivo;
        err.classList.remove('hidden');
        return;
      }
      err.classList.add('hidden');
      toast(evaluacion.dictamen === 'apto' ? `Donación de ${r.data.donanteNombre} registrada. ${r.aviso ?? ''}`.trim() : `Evaluación guardada: ${r.data.donanteNombre} quedó diferido.`);
      if (citaId) {
        cerrarCitaDemo(citaId, evaluacion.dictamen === 'apto' ? 'Atendida' : 'No apto');
        const banner = $('#cita-banner');
        banner.querySelector('p')!.innerHTML = `<strong class="font-bold">Cita cerrada.</strong> ${evaluacion.dictamen === 'apto' ? 'La donación quedó registrada.' : 'La evaluación quedó registrada y el donante, diferido.'}`;
        banner.querySelector('a')!.className = 'btn btn-primary btn-sm shrink-0';
      }
      form.reset();
      $('#vol').setAttribute('value', '450');
      $('#donante').classList.add('hidden');
      $('#ev-alerta').classList.add('hidden');
      $<HTMLInputElement>('#ex-inicio').value = ahoraHM();
      pintarDictamen();
    });

    // Historial paginado: 20 por tanda; lo anterior al último año se pide a la base.
    const pag = new Paginador<DonacionOp>({
      lista: $('#tabla'), pie: $('#pag-historial'), nombre: 'extracciones', clave: (d) => d.id,
      vacio: () => (getDonacionesOp().length ? '<tr><td colspan="5" class="py-6 text-center text-sm text-ink-3">Ninguna extracción coincide con el filtro.</td></tr>' : ''),
      render: (vis) => vis.map((d) => `<tr>
        <td class="py-3 font-semibold text-ink">${esc(d.donanteNombre)}<br><span class="text-xs font-normal text-ink-3">${esc(d.donanteCedula)}</span></td>
        <td class="py-3"><span class="blood-chip">${esc(d.tipoSangre)}</span></td>
        <td class="py-3 text-ink-2">${esc(d.tipoHemocomponente)}</td>
        <td class="py-3 font-mono">${d.volumenMl} ml</td>
        <td class="py-3 text-xs text-ink-3">${esc(fmtFecha(d.fecha, { day: 'numeric', month: 'short', year: 'numeric' }))}</td></tr>`).join(''),
      remoto: (cursor) => paginaRemota<DonacionOp>('donaciones', {
        q: $<HTMLInputElement>('#filtro').value, cursor,
        filtros: { antesDe: masAntigua(getDonacionesOp(), (d) => d.fecha) },
      }),
    });

    const render = () => {
      const f = $<HTMLInputElement>('#filtro').value.trim().toLowerCase();
      const all = getDonacionesOp();
      const vis = all.filter((d) => !f || `${d.donanteNombre} ${d.donanteCedula} ${d.tipoSangre} ${d.tipoHemocomponente}`.toLowerCase().includes(f));
      $('#n').textContent = String(all.length);
      $('[data-cuenta="historial"]').textContent = String(all.length);
      $('#vacia').classList.toggle('hidden', all.length > 0);
      pag.mostrar(vis, f);

      // Últimas 5 (la más reciente arriba; a igual fecha, la última registrada)
      const ult = all
        .map((d, i) => ({ d, i }))
        .sort((x, y) => y.d.fecha.localeCompare(x.d.fecha) || y.i - x.i)
        .slice(0, 5)
        .map((x) => x.d);
      $('#ultimas').innerHTML = ult.length
        ? ult.map((d) => `<li class="flex items-center justify-between gap-3 py-3">
            <div class="min-w-0"><p class="truncate font-semibold text-ink">${esc(d.donanteNombre)}</p>
            <p class="text-xs text-ink-3">${esc(d.donanteCedula)} · ${esc(d.tipoHemocomponente)} · ${d.volumenMl} ml · ${esc(fmtFecha(d.fecha, { day: 'numeric', month: 'short' }))}</p>
            ${d.dinIsbt ? `<p class="font-mono text-[0.6875rem] text-ink-3">DIN ${esc(d.dinIsbt)}</p>` : ''}</div>
            <span class="blood-chip">${esc(d.tipoSangre)}</span></li>`).join('')
        : '<li class="py-6 text-center text-sm text-ink-3">Todavía no has registrado extracciones.</li>';
    };
    $('#filtro').addEventListener('input', render);
    render();
    onDb(render);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>