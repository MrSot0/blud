---
// login.astro - Inicio de sesión de BLUD
import Layout from '../layouts/Layout.astro';
import AuthShell from '../components/auth/AuthShell.astro';
import PasswordInput from '../components/auth/PasswordInput.astro';
import SubmitButton from '../components/auth/SubmitButton.astro';
import Icon from '../components/Icon.astro';
import { demoUsers } from '../lib/auth';

// Con base real las cuentas de prueba no se publican en la página: cualquiera podría entrar con ellas.
const baseReal = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
---

<Layout title="BLUD | Iniciar sesión">
  <AuthShell title="Bienvenido de nuevo" subtitle="Ingresa a tu cuenta para gestionar tus donaciones.">
    <div
      id="form-success"
      role="status"
      class="mb-6 hidden items-start gap-3 rounded-control bg-ok-soft px-4 py-3 text-sm font-medium text-ok"
    >
      <Icon name="check-circle" class="mt-0.5 size-5 shrink-0" />
      <span data-success-text>Sesión iniciada correctamente.</span>
    </div>

    <div
      id="form-error"
      role="alert"
      class="mb-6 hidden items-start gap-3 rounded-control bg-accent-soft px-4 py-3 text-sm font-medium text-accent-ink"
    >
      <Icon name="warning-circle" class="mt-0.5 size-5 shrink-0" />
      <span class="min-w-0 flex-1">
        <span data-error-text></span>
        <button type="button" id="reenviar" class="mt-2 hidden font-semibold underline cursor-pointer">Reenviar correo de confirmación</button>
      </span>
    </div>

    <form id="login-form" novalidate class="flex flex-col gap-6">
      <div>
        <label for="login-email" class="mb-2 block text-sm font-semibold text-ink">Correo electrónico</label>
        <input
          type="email"
          id="login-email"
          name="email"
          autocomplete="email"
          inputmode="email"
          placeholder="tucorreo@ejemplo.com"
          aria-describedby="login-email-error"
          class="field"
        />
        <p id="login-email-error" class="mt-2 hidden text-sm font-medium text-accent-ink"></p>
      </div>

      <div>
        <div class="mb-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
          <label for="login-password" class="block text-sm font-semibold text-ink">Contraseña</label>
          <a href="/recuperar" class="text-sm font-medium text-accent-ink underline-offset-4 hover:underline">
            ¿Olvidaste tu contraseña?
          </a>
        </div>
        <PasswordInput
          id="login-password"
          name="password"
          autocomplete="current-password"
          describedby="login-password-error"
        />
        <p id="login-password-error" class="mt-2 hidden text-sm font-medium text-accent-ink"></p>
      </div>

      <label class="flex cursor-pointer items-center gap-3 text-sm text-ink-2">
        <input type="checkbox" id="login-remember" name="remember" class="size-[1.125rem] accent-(--accent)" />
        Mantener sesión iniciada
      </label>

      <SubmitButton label="Iniciar sesión" loadingLabel="Iniciando sesión" />
    </form>

    <!-- RF-T6: segundo paso, si la cuenta tiene verificación en dos pasos -->
    <form id="codigo-form" novalidate class="hidden flex-col gap-6">
      <div class="flex items-start gap-4 rounded-control bg-sunken p-4">
        <span class="grid size-11 shrink-0 place-items-center rounded-full bg-accent-soft text-accent-ink" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
        </span>
        <div>
          <p class="font-semibold text-ink">Verificación en dos pasos</p>
          <p class="text-sm text-ink-3">Abre tu app de autenticación y escribe el código de 6 dígitos de BLUD.</p>
        </div>
      </div>
      <div>
        <label for="codigo" class="mb-2 block text-sm font-semibold text-ink">Código</label>
        <input id="codigo" name="codigo" class="field text-center font-mono text-2xl tracking-[0.5em]" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" placeholder="000000" />
        <p id="codigo-error" class="mt-2 hidden text-sm font-medium text-accent-ink" role="alert"></p>
      </div>
      <div class="flex flex-col-reverse sm:flex-row justify-center gap-3">
        <button type="button" class="btn btn-secondary sm:px-8" id="codigo-cancelar">Usar otra cuenta</button>
        <button type="submit" class="btn btn-primary sm:px-10" id="codigo-enviar">Verificar y entrar</button>
      </div>
    </form>

    <!-- Cuentas de prueba: existen en modo demo y en la base real (las crea supabase/seed.sql) -->
    <div class="mt-8 rounded-panel border border-dashed border-line-strong p-4 sm:p-5" data-demo-list>
      <p class="flex items-center gap-2 text-sm font-semibold text-ink">
        <Icon name="info" class="size-4 text-ink-3" />
        Cuentas de prueba
      </p>
      <p class="mt-1 text-sm text-ink-3">{baseReal ? 'Úsalas para probar cada rol: donante, operador, laboratorio, soporte y dirección.' : 'Úsalas para probar el acceso. Las cuentas nuevas se guardan en este navegador.'}</p>
      <ul class="mt-4 grid gap-2">
        {demoUsers.map((user) => (
          <li class="flex items-center gap-3 rounded-control bg-sunken px-3 py-2.5">
            <div class="min-w-0 flex-1 font-mono text-xs leading-relaxed text-ink-2">
              <p class="truncate"><span class="text-ink-3">correo</span> {user.email}</p>
              <p class="truncate"><span class="text-ink-3">clave&nbsp;</span> {user.password}</p>
            </div>
            <button
              type="button"
              class="btn btn-secondary btn-sm shrink-0 pointer-coarse:min-h-11"
              data-demo-email={user.email}
              data-demo-password={user.password}
            >
              Usar
              <span class="sr-only">la cuenta de {user.name}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-10 border-t border-line pt-6 text-ink-2">
      ¿No tienes cuenta?
      <a href="/register" class="link-arrow ml-1" data-keep-next>
        Quiero ser donante
        <Icon name="arrow-right" class="size-4" />
      </a>
    </p>
  </AuthShell>
</Layout>

<script>
  import {
    bindPasswordToggles,
    clearError,
    isShowingError,
    setError,
    validateEmailField,
    withSubmitting,
  } from '../lib/forms';
  import { cancelarSegundoPaso, completarConfirmacion, completarSegundoPaso, login, reenviarConfirmacion, safeNext, type Session } from '../lib/auth';
  import { homeFor } from '../lib/roles';

  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('form-success');
  const errorBanner = document.getElementById('form-error');

  if (form) {
    const emailInput = document.getElementById('login-email') as HTMLInputElement;
    const passwordInput = document.getElementById('login-password') as HTMLInputElement;
    const rememberInput = document.getElementById('login-remember') as HTMLInputElement;
    const emailError = document.getElementById('login-email-error') as HTMLElement;
    const passwordError = document.getElementById('login-password-error') as HTMLElement;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const next = safeNext(new URLSearchParams(location.search).get('next'));

    const validateEmail = () => validateEmailField(emailInput, emailError);

    function validatePassword(): boolean {
      const value = passwordInput.value;
      if (!value) {
        setError(passwordInput, passwordError, 'Ingresa tu contraseña.');
        return false;
      }
      if (value.length < 8) {
        setError(passwordInput, passwordError, 'La contraseña debe tener al menos 8 caracteres.');
        return false;
      }
      clearError(passwordInput, passwordError);
      return true;
    }

    const showFormError = (message: string | null) => {
      if (!errorBanner) return;
      errorBanner.querySelector('[data-error-text]')!.textContent = message ?? '';
      errorBanner.classList.toggle('hidden', !message);
      errorBanner.classList.toggle('flex', Boolean(message));
      reenviar?.classList.add('hidden');
    };
    const showSuccess = (message: string) => {
      const text = successBanner?.querySelector('[data-success-text]');
      if (text) text.textContent = message;
      successBanner?.classList.remove('hidden');
      successBanner?.classList.add('flex');
    };

    // Cuenta sin confirmar: ofrece reenviar el correo.
    const reenviar = document.getElementById('reenviar');
    reenviar?.addEventListener('click', async () => {
      if (!validateEmail()) return emailInput.focus();
      reenviar.setAttribute('disabled', '');
      const r = await reenviarConfirmacion(emailInput.value);
      reenviar.removeAttribute('disabled');
      if (!r.ok) return showFormError(r.error);
      showFormError(null);
      showSuccess(`Te enviamos un nuevo enlace a ${emailInput.value.trim()}. Revisa también la carpeta de spam.`);
    });

    // Vuelve del enlace del correo de confirmación (/login?confirmado=1): entra directo.
    const qs = new URLSearchParams(location.search);
    if (qs.get('motivo') === 'inactividad') {
      showSuccess('Cerramos tu sesión por inactividad para proteger tus datos. Vuelve a entrar para continuar.');
    }
    if (qs.has('confirmado') || qs.has('token_hash') || /error_description|access_token/.test(location.hash)) {
      completarConfirmacion().then((r) => {
        history.replaceState(null, '', '/login');
        if (!r) return showSuccess('Tu correo está confirmado. Ya puedes iniciar sesión.');
        if (!r.ok) return showFormError(r.error);
        showSuccess(`Correo confirmado. Bienvenido a BLUD, ${r.user.name.split(/\s+/)[0]}. Te llevamos a tu perfil…`);
        form?.classList.add('opacity-60', 'pointer-events-none');
        window.setTimeout(() => location.assign(homeFor(r.user.role)), 1400);
      });
    }

    emailInput.addEventListener('blur', () => { if (emailInput.value) validateEmail(); });
    emailInput.addEventListener('input', () => { if (isShowingError(emailError)) validateEmail(); showFormError(null); });
    passwordInput.addEventListener('input', () => { if (isShowingError(passwordError)) validatePassword(); showFormError(null); });

    // Rellena el formulario con una cuenta de prueba.
    document.querySelectorAll<HTMLButtonElement>('[data-demo-email]').forEach((btn) =>
      btn.addEventListener('click', () => {
        emailInput.value = btn.dataset.demoEmail ?? '';
        passwordInput.value = btn.dataset.demoPassword ?? '';
        clearError(emailInput, emailError);
        clearError(passwordInput, passwordError);
        showFormError(null);
        submit?.focus();
      })
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      showFormError(null);
      const emailOk = validateEmail();
      const passwordOk = validatePassword();

      if (!emailOk) return emailInput.focus();
      if (!passwordOk) return passwordInput.focus();
      if (!submit) return;

      withSubmitting(submit, async () => {
        const result = await login(emailInput.value, passwordInput.value, rememberInput.checked);
        if (!result.ok && result.segundoPaso) {
          submit.disabled = false;
          mostrarSegundoPaso();
          return;
        }
        if (!result.ok) {
          submit.disabled = false;
          showFormError(result.noConfirmado ? 'Aún no confirmas tu correo. Abre el enlace que te enviamos al registrarte.' : result.error);
          if (result.noConfirmado) reenviar?.classList.remove('hidden');
          passwordInput.select();
          return;
        }
        entrar(result.user);

      });
    });

    /** Vuelve a donde iba (?next=) o, si no, a la página de inicio de su rol. */
    function entrar(user: Session) {
      const pedido = new URLSearchParams(window.location.search).get('next');
      const targetUrl = pedido ? safeNext(pedido) : homeFor(user.role);
      const firstName = user.name.split(/\s+/)[0];
      const text = successBanner?.querySelector('[data-success-text]');
      if (text) text.textContent = `Hola, ${firstName}. Sesión iniciada. Te llevamos de vuelta…`;
      successBanner?.classList.remove('hidden');
      successBanner?.classList.add('flex');
      form!.classList.add('opacity-60', 'pointer-events-none');
      codigoForm.classList.add('opacity-60', 'pointer-events-none');
      window.setTimeout(() => location.assign(targetUrl), 1100);
    }

    // ---------- Segundo paso (RF-T6) ----------
    const codigoForm = document.getElementById('codigo-form') as HTMLFormElement;
    const codigo = document.getElementById('codigo') as HTMLInputElement;
    const codigoErr = document.getElementById('codigo-error') as HTMLElement;
    function mostrarSegundoPaso() {
      showFormError(null);
      form!.classList.add('hidden');
      form!.classList.remove('flex');
      document.querySelector<HTMLElement>('[data-demo-list]')?.classList.add('hidden');
      codigoForm.classList.remove('hidden');
      codigoForm.classList.add('flex');
      codigo.value = '';
      codigo.focus();
    }
    codigo.addEventListener('input', () => {
      codigo.value = codigo.value.replace(/\D/g, '').slice(0, 6);
      codigoErr.classList.add('hidden');
      if (codigo.value.length === 6) codigoForm.requestSubmit();
    });
    codigoForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('codigo-enviar') as HTMLButtonElement;
      btn.disabled = true;
      const r = await completarSegundoPaso(codigo.value);
      btn.disabled = false;
      if (r.ok) return entrar(r.user);
      codigoErr.textContent = r.error;
      codigoErr.classList.remove('hidden');
      codigo.select();
    });
    document.getElementById('codigo-cancelar')!.addEventListener('click', async () => {
      await cancelarSegundoPaso();
      codigoForm.classList.add('hidden');
      codigoForm.classList.remove('flex');
      form!.classList.remove('hidden');
      form!.classList.add('flex');
      passwordInput.value = '';
      document.querySelector<HTMLElement>('[data-demo-list]')?.classList.remove('hidden');
      emailInput.focus();
    });

    bindPasswordToggles(form);
  }

  // Conserva el destino (?next=) al cambiar entre inicio de sesión y registro.
  const nextParam = new URLSearchParams(location.search).get('next');
  if (nextParam) {
    document.querySelectorAll<HTMLAnchorElement>('[data-keep-next]').forEach((link) => {
      link.href = `${link.pathname}?next=${encodeURIComponent(nextParam)}`;
    });
  }
</script>
