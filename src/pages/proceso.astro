<style>
  .hero-grid { background-image: linear-gradient(rgba(30,36,48,.35) 1px, transparent 1px), linear-gradient(90deg, rgba(30,36,48,.35) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(60% 60% at 60% 40%, #000, transparent); }
  :global(.h-ola) { animation: ola 3s linear infinite; }
  :global(.h-burbuja) { animation: burbuja 4.2s ease-in infinite; }
  @keyframes burbuja { 0% { transform: translateY(0); opacity: 0; } 20% { opacity: .4; } 100% { transform: translateY(-150px); opacity: 0; } }
  .h-gota { border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; background: radial-gradient(circle at 35% 30%, #FF9A9E, #B3121A 70%); box-shadow: 0 10px 24px rgba(202, 43, 43, .22); animation: flota 5s ease-in-out infinite alternate; }
  @keyframes flota { to { transform: translateY(-18px) rotate(8deg); } }
  .hero-bolsa { translate: 0 calc(var(--sy, 0) * -70px); }
  /* Solo la bolsa se balancea: la cola queda quieta para empalmar con la etapa 1. */
  :global(.h-bolsa-g) { transform-origin: 210px 56px; animation: mece 6s ease-in-out infinite alternate; }
  .h-gota { translate: calc(var(--mx, 0) * var(--k, 8) * 3px) calc(var(--sy, 0) * var(--k, 8) * -9px); }

  /* La cola se dibuja al cargar y luego la sangre fluye por ella hasta el borde de la pantalla. */
  .hero.animar :global(.h-tubo) { stroke-dasharray: 1; stroke-dashoffset: 1; animation: dibuja 2.6s cubic-bezier(.3, .7, .2, 1) 0.4s forwards; }
  :global(.h-flujo) { animation: flujo 1.4s linear infinite; opacity: 0; }
  .hero.animar :global(.h-flujo) { animation: flujo 1.4s linear infinite, aparece 600ms ease 2.6s forwards; }
  :global(.h-gotita) { opacity: 0; }
  .hero.animar :global(.h-gotita) { animation: aparece 600ms ease 2.8s forwards; }
  @keyframes dibuja { to { stroke-dashoffset: 0; } }
  @keyframes flujo { to { stroke-dashoffset: -62; } }
  @keyframes aparece { to { opacity: 1; } }

  /* Título palabra por palabra */
  .pal { display: inline-block; }
  .hero.animar .pal { animation: pal 800ms var(--ease-out) both; animation-delay: calc(var(--w) * 90ms + 120ms); }
  @keyframes pal { from { opacity: 0; transform: translateY(0.55em) rotate(3deg); filter: blur(6px); } }
  @keyframes mece { from { transform: rotate(-0.9deg); } to { transform: rotate(0.9deg); } }
  /* La entrada solo se activa cuando ya hay cuadros dibujándose: si no, el texto se ve directo (nunca queda oculto). */
  .hero.animar .hero-in { animation: entra 900ms var(--ease-out) both; }
  .hero-in:nth-child(2) { animation-delay: 80ms; } .hero-in:nth-child(3) { animation-delay: 160ms; } .hero-in:nth-child(4) { animation-delay: 240ms; } .hero-in:nth-child(5) { animation-delay: 320ms; } .hero-in:nth-child(6) { animation-delay: 400ms; }
  @keyframes entra { from { opacity: 0; transform: translateY(18px); } }

  .escena { height: 300vh; }

  /* Entrada de cada etapa: la lámina sube y el texto llega de costado. Solo si hay JS y movimiento. */
  :global(html.proceso-anim) .escena-lamina { opacity: 0; transform: translateY(56px) scale(0.94) rotate(0.8deg); transition: opacity 800ms var(--ease-out), transform 1000ms var(--ease-out); }
  :global(html.proceso-anim) .escena.dentro .escena-lamina { opacity: 1; transform: none; }
  :global(html.proceso-anim) .escena-texto > * { opacity: 0; transform: translateX(-32px); transition: opacity 600ms var(--ease-out), transform 700ms var(--ease-out); }
  :global(html.proceso-anim) .escena.dentro .escena-texto > * { opacity: 1; transform: none; }
  :global(html.proceso-anim) .escena.dentro .escena-texto > :nth-child(2) { transition-delay: 90ms; }
  :global(html.proceso-anim) .escena.dentro .escena-texto > :nth-child(3) { transition-delay: 180ms; }
  :global(html.proceso-anim) .escena.dentro .escena-texto > :nth-child(4) { transition-delay: 270ms; }

  /* Cierre */
  :global(html.proceso-anim) .fin-in { opacity: 0; transform: translateY(26px); transition: opacity 700ms var(--ease-out), transform 800ms var(--ease-out); }
  :global(html.proceso-anim) .fin.dentro .fin-in { opacity: 1; transform: none; }
  :global(html.proceso-anim) .fin.dentro .fin-in:nth-child(2) { transition-delay: 120ms; }
  :global(html.proceso-anim) .fin.dentro .fin-in:nth-child(3) { transition-delay: 220ms; }
  :global(html.proceso-anim) .fin.dentro .fin-in:nth-child(4) { transition-delay: 320ms; }
  :global(html.proceso-anim) .fin.dentro .fin-in:nth-child(5) { transition-delay: 420ms; }
  .fin.dentro .fin-gota { animation: gota-salta 2.4s var(--ease-out) 0.6s infinite; }
  @keyframes gota-salta { 0%, 100% { translate: 0 0; } 18% { translate: 0 -14px; } 34% { translate: 0 0; } 44% { translate: 0 -5px; } 54% { translate: 0 0; } }

  /* ---------- Etiquetas del inicio ---------- */
  .tag-don { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.9rem 0.4rem 0.7rem; border-radius: 999px; background: #fff; border: 1px solid #EBD9D3; box-shadow: 0 10px 24px -14px rgba(160, 40, 40, 0.45); font: 600 0.72rem/1 var(--font-mono); letter-spacing: 0.16em; color: #6B4A4A; }
  .tag-don i { font-style: normal; color: #D9A9A6; }
  .tag-don b { color: #B3121A; font-weight: 800; padding: 0.2rem 0.45rem; border-radius: 6px; background: #FCE4E2; letter-spacing: 0.08em; }
  .tag-punto { position: relative; width: 9px; height: 9px; border-radius: 50%; background: #D9534F; }
  .tag-punto::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 2px solid #D9534F; opacity: 0; animation: tag-onda 2.2s ease-out infinite; }
  @keyframes tag-onda { 0% { transform: scale(0.4); opacity: 0.8; } 100% { transform: scale(1.5); opacity: 0; } }

  .etq { position: relative; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.85rem 0.3rem 0.3rem; border-radius: 999px; background: rgba(255, 255, 255, 0.85); border: 1px solid #EADFD8; color: #3A4252; font-size: 0.8125rem; font-weight: 600; box-shadow: 0 6px 16px -12px rgba(80, 40, 30, 0.5); transition: transform 250ms var(--ease-out), background 250ms, border-color 250ms, color 250ms, box-shadow 250ms; animation: etq-pulso 9s ease-in-out infinite; animation-delay: calc(var(--n) * 0.5s + 3s); }
  .etq-n { display: grid; place-items: center; min-width: 1.6rem; height: 1.6rem; border-radius: 999px; background: #FCE4E2; color: #B3121A; font: 700 0.6875rem/1 var(--font-mono); transition: background 250ms, color 250ms, transform 300ms var(--ease-out); }
  .etq:hover { transform: translateY(-3px); background: #CA2B2B; border-color: #CA2B2B; color: #fff; box-shadow: 0 14px 24px -12px rgba(202, 43, 43, 0.7); }
  .etq:hover .etq-n { background: #fff; color: #CA2B2B; transform: rotate(-8deg) scale(1.08); }
  .etq:active { transform: scale(0.96); }
  /* Un destello recorre las etapas, como la sangre que avanza. */
  @keyframes etq-pulso { 0%, 9%, 100% { border-color: #EADFD8; box-shadow: 0 6px 16px -12px rgba(80, 40, 30, 0.5); } 4% { border-color: #E8908C; box-shadow: 0 0 0 4px rgba(217, 83, 79, 0.16), 0 6px 16px -12px rgba(80, 40, 30, 0.5); } }
  .hero.animar .tag-don { animation: etq-in 800ms var(--ease-out) both; }
  .hero.animar .etq { animation: etq-in 700ms var(--ease-out) calc(1.1s + var(--n) * 70ms) both, etq-pulso 9s ease-in-out calc(var(--n) * 0.5s + 4s) infinite; }
  @keyframes etq-in { from { opacity: 0; transform: translateY(14px) scale(0.8) rotate(-4deg); } }

  /* ---------- La cola recorre todas las etapas ---------- */
  .fin-cola { position: absolute; left: 0; top: 0; width: 100%; height: 96px; overflow: visible; pointer-events: none; }
  .fin-flujo { animation: flujo 1.4s linear infinite; }
  .cola { position: absolute; inset: 0; z-index: 6; pointer-events: none; }
  .cola-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .cola-flujo { animation: flujo 1.4s linear infinite; }
  .cola-marca { position: absolute; left: 0; top: 0; width: 15px; height: 15px; margin: -7px 0 0 -7px; border-radius: 50%; background: #FF6B70; border: 2px solid #fff; box-shadow: 0 0 0 5px rgba(217, 83, 79, 0.22), 0 4px 10px rgba(122, 9, 16, 0.4); will-change: transform; }
  /* Carril libre a la derecha: las etapas reservan ese espacio para la cola y su lupa. */
  .escena-stage :global(.container-blud) { padding-inline: 6.6rem; padding-bottom: 5rem; }
  @media (max-width: 1023px) { .escena-stage :global(.container-blud) { padding-inline: 1.9rem; padding-bottom: 4.2rem; } .lupa { display: none; } }
  .lupa { position: absolute; left: 0; top: 0; display: flex; flex-direction: column; align-items: center; gap: 0.55rem; padding: 0.35rem 0.35rem 0.8rem; border-radius: 999px; background: rgba(255, 255, 255, 0.94); border: 1px solid #EADFD8; box-shadow: 0 14px 28px -14px rgba(122, 9, 16, 0.45); opacity: var(--lo, 1); scale: var(--ls, 1); transform-origin: 100% 100%; will-change: transform; }
  .lupa-cristal { position: relative; flex: none; width: 2.9rem; height: 2.9rem; overflow: hidden; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #D8323A, #8E0F16 70%); box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.7), inset 0 -6px 10px rgba(60, 0, 6, 0.35); }
  .lupa-cristal::after { content: ''; position: absolute; left: 18%; top: 12%; width: 38%; height: 20%; border-radius: 50%; background: rgba(255, 255, 255, 0.5); transform: rotate(-30deg); }
  /* Glóbulos vistos de cerca: se acercan al aparecer la lupa y siguen a la deriva. */
  .lupa-cristal i { position: absolute; width: 1.3rem; height: 0.85rem; border-radius: 50%; background: radial-gradient(circle at 50% 50%, #7A0910 28%, #E5484D 30%); box-shadow: inset 0 0 0 1px rgba(255, 190, 192, 0.5); scale: var(--lz, 1); animation: lupa-deriva 5s ease-in-out infinite alternate; }
  .lupa-cristal i:nth-child(1) { left: 6%; top: 18%; rotate: -20deg; }
  .lupa-cristal i:nth-child(2) { left: 48%; top: 46%; rotate: 25deg; animation-delay: -1.7s; animation-duration: 4s; }
  .lupa-cristal i:nth-child(3) { left: 14%; top: 66%; rotate: 8deg; animation-delay: -3s; animation-duration: 6s; }
  @keyframes lupa-deriva { from { translate: -5px 0; } to { translate: 7px 2px; } }
  .lupa-texto { display: flex; align-items: center; gap: 0.45rem; writing-mode: vertical-rl; rotate: 180deg; white-space: nowrap; line-height: 1; }
  .lupa-texto small { font-size: 0.65rem; letter-spacing: 0.14em; color: #B3121A; font-weight: 700; }
  .lupa-texto b { font-size: 0.95rem; font-weight: 800; letter-spacing: -0.02em; color: #1E2430; }

  :global(.q-copo) { animation: copo 4.5s ease-in-out infinite alternate; }
  @keyframes copo { to { transform: translate(6px, 14px); opacity: 0.15; } }
  .escena-stage { top: var(--header-h); height: calc(100dvh - var(--header-h)); }
  .escena-fondo { background: radial-gradient(55% 60% at 70% 45%, rgba(240, 128, 118, 0.14), transparent 70%); }
  .escena[data-escena='cita'] .escena-fondo { background: radial-gradient(55% 60% at 70% 45%, rgba(123, 97, 255, 0.16), transparent 70%); }
  .escena[data-escena='evaluacion'] .escena-fondo, .escena[data-escena='cuarentena'] .escena-fondo { background: radial-gradient(55% 60% at 70% 45%, rgba(59, 140, 255, 0.14), transparent 70%); }
  .escena[data-escena='serologia'] .escena-fondo { background: radial-gradient(55% 60% at 70% 45%, rgba(94, 240, 138, 0.1), transparent 70%); }
  .escena[data-escena='fraccionamiento'] .escena-fondo { background: radial-gradient(55% 60% at 70% 45%, rgba(43, 185, 160, 0.14), transparent 70%); }
  .ilustracion { width: 100%; max-height: calc(100dvh - var(--header-h) - 8rem); border-radius: 28px; box-shadow: 0 30px 60px -30px rgba(90, 60, 50, 0.28), 0 0 0 1px rgba(30, 36, 48, 0.07); }

  /* El texto saliente se va rápido y el entrante llega después: nunca se ven dos encimados. */
  .paso { position: absolute; inset: 0 0 auto 0; opacity: 0; transform: translateY(22px); filter: blur(3px); transition: opacity 140ms var(--ease-out), transform 140ms var(--ease-out), filter 140ms var(--ease-out); pointer-events: none; }
  .paso[data-pasado] { transform: translateY(-16px); }
  .paso[data-activo] { opacity: 1; transform: none; filter: none; transition-duration: 520ms; transition-delay: 120ms; }

  .scroll-cue { width: 22px; height: 34px; border: 2px solid rgba(30, 36, 48, 0.35); border-radius: 12px; position: relative; }
  .scroll-cue::after { content: ''; position: absolute; left: 50%; top: 6px; width: 4px; height: 7px; margin-left: -2px; border-radius: 2px; background: #1E2430; animation: cue 1.6s var(--ease-in-out) infinite; }
  @keyframes cue { 0% { transform: translateY(0); opacity: 1; } 100% { transform: translateY(12px); opacity: 0; } }

  :global(.e-ola) { animation: ola 2.4s linear infinite; }
  @keyframes ola { to { transform: translateX(60px); } }
  :global(.t-sirena-r) { animation: sirena 0.9s steps(1) infinite; }
  :global(.t-sirena-a) { animation: sirena 0.9s steps(1) infinite 0.45s; }
  @keyframes sirena { 0% { opacity: 1; } 50% { opacity: 0.15; } }
  :global(.t-star) { animation: titila 3s ease-in-out infinite alternate; }
  @keyframes titila { to { opacity: 0.2; } }

  @media (prefers-reduced-motion: reduce) {
    .escena { height: auto; }
    .escena-stage { position: relative; top: 0; height: auto; }
    .pasos { min-height: 0; }
    .paso { position: static; opacity: 1; transform: none; filter: none; margin-bottom: 1.25rem; }
    .cola-marca { display: none; }
    .hero-bolsa, .h-gota { translate: none; rotate: none; }
    :global(.e-ola), :global(.t-sirena-r), :global(.t-sirena-a), :global(.t-star), .scroll-cue::after,
    :global(.h-ola), :global(.h-burbuja), .h-gota, .hero-bolsa, .hero-in, .tag-punto::after, .etq, :global(.q-copo), :global(.h-flujo), :global(.pal) { animation: none; }
    :global(.h-gotita) { display: none; }
  }
</style>

<script>
  import { createTimeline, svg, utils } from 'animejs';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) requestAnimationFrame(() => document.querySelector('.hero')?.classList.add('animar'));
  if (!reduce) document.documentElement.classList.add('proceso-anim');
  const $ = (s: string, r: ParentNode = document) => r.querySelector(s) as Element;

  // Las ilustraciones viven en <template> para no repetir defs; se insertan en su escena.
  document.querySelectorAll<HTMLElement>('[data-svg]').forEach((slot) => {
    const tpl = document.getElementById(`svg-${slot.dataset.svg}`) as HTMLTemplateElement;
    slot.replaceChildren(tpl.content.cloneNode(true));
  });

  const contador = (el: Element, fmt: (v: number) => string) => {
    const o = { v: 0 };
    return { o, render: () => (el.textContent = fmt(o.v)) };
  };
  const mmss = (s: number) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

  // ---------------- Extracción
  function extraccion() {
    const ml = contador($('#e-ml'), (v) => `${String(Math.round(v)).padStart(3, '0')} ml`);
    const t = contador($('#e-tiempo'), (v) => mmss(v));
    const tl = createTimeline({ autoplay: false, defaults: { ease: 'inOutSine' } });
    tl.add('#e-torniquete', { scale: [0.6, 1], opacity: [0, 1], duration: 600, ease: 'outCubic' }, 0)
      .add('#e-aguja', { opacity: [0, 1], translateX: [40, 0], translateY: [40, 0], duration: 900, ease: 'outCubic' }, 500)
      .add(svg.createDrawable('#e-tubo'), { draw: ['0 0', '0 1'], duration: 1400 }, 1500)
      .add('.e-gota', { ...svg.createMotionPath('#e-tubo'), opacity: [0, 1, 0], duration: 1300, delay: (_: unknown, i: number) => i * 220, loop: 4, ease: 'linear' }, 2200)
      .add('#e-liquido', { translateY: [118, 16], duration: 5200, ease: 'outQuad' }, 2700)
      .add('#e-pelota', { scale: [1, 0.8, 1, 0.8, 1, 0.8, 1, 0.8, 1], duration: 5200, ease: 'inOutSine' }, 2700)
      .add('#e-bolsa', { rotate: [-2.5, 2.5, -2, 2, -1.5, 1.5, 0], duration: 5200, ease: 'inOutSine' }, 2700)
      .add(ml.o, { v: [0, 450], duration: 5200, ease: 'outQuad', onUpdate: ml.render }, 2700)
      .add(t.o, { v: [0, 600], duration: 5200, ease: 'linear', onUpdate: t.render }, 2700)
      .add(svg.createDrawable('#e-ecg'), { draw: ['0 0', '0 1', '1 1'], duration: 5200, ease: 'linear' }, 2700)
      .add('#e-aguja', { opacity: 0, translateX: 30, translateY: 30, duration: 700 }, 8100)
      .add('#e-torniquete', { opacity: 0, duration: 500 }, 8100)
      .add('#e-din', { opacity: [0, 1], scale: [0.92, 1], duration: 700, ease: 'outCubic' }, 8400);
    utils.set('#e-bolsa', { transformOrigin: '694px 398px' });
    utils.set('#e-din', { transformOrigin: '690px 512px' });
    utils.set('#e-torniquete', { transformOrigin: '541px 292px' });
    utils.set('#e-pelota', { transformOrigin: '300px 320px' });
    return tl;
  }

  // ---------------- Fraccionamiento
  function fraccionamiento() {
    const rpm = contador($('#f-rpm'), (v) => `${Math.round(v).toLocaleString('es-VE')} rpm`);
    const blur = $('#f-blur-amt');
    const vel = { v: 0 };
    const tl = createTimeline({ autoplay: false, defaults: { ease: 'inOutSine' } });
    tl.add('#f-tapa', { translateY: [0, -150], opacity: [1, 0.0], duration: 900, ease: 'outCubic' }, 0)
      .add('#f-bolsa-in', { translateY: [0, 210], scale: [1, 0.45], opacity: [1, 0], duration: 1300, ease: 'inOutQuad' }, 600)
      .add('#f-tapa', { translateY: [-150, 0], opacity: [0, 1], duration: 800, ease: 'outCubic' }, 1900)
      .add('#f-rotor', { rotate: [0, 2880], duration: 4200, ease: 'inOutQuad' }, 2700)
      .add(vel, { v: [0, 4000, 4000, 0], duration: 4200, ease: 'inOutQuad', onUpdate: () => {
        rpm.o.v = vel.v; rpm.render();
        blur.setAttribute('stdDeviation', (vel.v / 4000 * 6).toFixed(2));
      } }, 2700)
      .add('#f-led', { opacity: [0.2, 1, 1, 0.2], duration: 4200 }, 2700)
      .add('#f-maquina', { translateY: [0, 1.5, -1.5, 1, -1, 0], duration: 4200, ease: 'linear' }, 2700)
      .add('#f-maquina', { opacity: [1, 0], scale: [1, 0.94], duration: 700, ease: 'outCubic' }, 7000)
      .add('#f-sep', { opacity: [0, 1], scale: [0.94, 1], duration: 700, ease: 'outCubic' }, 7200)
      .add('#f-capas', { opacity: [0, 1], duration: 1400 }, 7700)
      .add('#f-etq', { opacity: [0, 1], translateX: [-10, 0], duration: 600, ease: 'outCubic' }, 9000)
      .add('#f-sep', { opacity: 0, scale: 0.94, duration: 600, ease: 'outCubic' }, 10000)
      .add('.f-prod', { opacity: [0, 1], translateY: [40, 0], scale: [0.94, 1], duration: 900, delay: (_: unknown, i: number) => i * 160, ease: 'outCubic' }, 10300);
    utils.set('#f-rotor', { transformOrigin: '0px 0px' });
    utils.set(['#f-maquina', '#f-sep'], { transformOrigin: '400px 300px' });
    return tl;
  }

  // ---------------- Transfusión
  function transfusion() {
    const tl = createTimeline({ autoplay: false, defaults: { ease: 'inOutSine' } });
    tl.add('#t-amb', { translateX: [-360, 250], duration: 4000, ease: 'outQuad' }, 0)
      .add('.t-rueda', { rotate: [0, 1440], duration: 4000, ease: 'outQuad' }, 0)
      .add('#t-lineas', { translateX: [0, -480], duration: 4000, ease: 'outQuad' }, 0)
      .add('#t-cerca', { translateX: [0, -160], duration: 4000, ease: 'outQuad' }, 0)
      .add('#t-lejos', { translateX: [0, -60], duration: 4000, ease: 'outQuad' }, 0)
      .add('#t-hospital', { translateX: [260, 0], duration: 4000, ease: 'outQuad' }, 0)
      .add('.t-paciente', { opacity: [0, 1], translateY: [24, 0], duration: 800, delay: (_: unknown, i: number) => i * 250, ease: 'outCubic' }, 4600)
      .add(svg.createDrawable('.t-ecg'), { draw: ['0 0', '0 1'], duration: 1600, delay: (_: unknown, i: number) => i * 250, ease: 'linear' }, 5100)
      .add('.t-corazon', { scale: [1, 1.3, 1, 1.2, 1], duration: 1400, delay: (_: unknown, i: number) => i * 250 }, 5300)
      .add('#t-vidas', { opacity: [0, 1], translateY: [12, 0], duration: 800, ease: 'outCubic' }, 7200);
    utils.set('.t-rueda', { transformOrigin: '0px 0px' });
    document.querySelectorAll<SVGElement>('.t-corazon').forEach((c) => utils.set(c, { transformOrigin: '0px 4px' }));
    return tl;
  }

  // ---------------- Cita
  function cita() {
    const dia = { v: 3 };
    const tl = createTimeline({ autoplay: false, defaults: { ease: 'inOutSine' } });
    tl.add('#c-telefono', { translateY: [60, 0], opacity: [0, 1], duration: 900, ease: 'outCubic' }, 0)
      .add('#c-mapa', { translateX: [60, 0], opacity: [0, 1], duration: 900, ease: 'outCubic' }, 300)
      .add(['#c-dia', '#c-dia-n'], { translateX: [0, 96], translateY: [0, 26], duration: 1200, ease: 'inOutCubic' }, 1000)
      .add(dia, { v: [3, 12], duration: 1200, ease: 'inOutCubic', onUpdate: () => ($('#c-dia-n').textContent = String(Math.round(dia.v))) }, 1000)
      .add('#c-slot', { translateX: [0, 56], duration: 800, ease: 'inOutCubic' }, 2500)
      .add('#c-boton', { scale: [1, 0.94, 1], duration: 500 }, 3500)
      .add('#c-ok', { opacity: [0, 1], duration: 500, ease: 'outCubic' }, 3900)
      .add(svg.createDrawable('#c-check'), { draw: ['0 0', '0 1'], duration: 600, ease: 'outCubic' }, 4200)
      .add(svg.createDrawable('#c-ruta'), { draw: ['0 0', '0 1'], duration: 1500, ease: 'inOutQuad' }, 4800)
      .add('#c-pin', { translateY: [-70, 0], opacity: [0, 1], duration: 700, ease: 'outBounce' }, 6100)
      .add('#c-eta', { opacity: [0, 1], translateY: [10, 0], duration: 500, ease: 'outCubic' }, 6600)
      .add('#c-noti', { translateY: [-30, 0], opacity: [0, 1], duration: 700, ease: 'outCubic' }, 7000);
    utils.set('#c-boton', { transformOrigin: '105px 338px' });
    return tl;
  }

  // ---------------- Evaluación
  function evaluacion() {
    const peso = contador($('#v-peso'), (v) => v.toFixed(1));
    const hb = contador($('#v-hb'), (v) => (v < 0.1 ? '--.-' : v.toFixed(1)));
    const temp = contador($('#v-temp'), (v) => (v < 30 ? '--.- °C' : `${v.toFixed(1)} °C`));
    const sis = { v: 0 };
    const enRango = (n: number, at: number) =>
      tl.add(`.v-estado-${n} .v-midiendo`, { opacity: [0.55, 0], duration: 200 }, at)
        .add(`.v-estado-${n} .v-enrango`, { opacity: [0, 1], scale: [0.9, 1], duration: 400, ease: 'outCubic' }, at);
    const tl = createTimeline({ autoplay: false, defaults: { ease: 'inOutSine' } });
    tl.add('.v-card', { opacity: [0, 1], translateY: [24, 0], duration: 700, delay: (_: unknown, i: number) => i * 90, ease: 'outCubic' }, 0)
      .add(peso.o, { v: [0, 72.4], duration: 1400, ease: 'outCubic', onUpdate: peso.render }, 600);
    enRango(1, 2000);
    tl.add('#v-aguja', { rotate: [-120, 40, -10], duration: 1600, ease: 'outCubic' }, 2200)
      .add(sis, { v: [0, 120], duration: 1600, ease: 'outCubic', onUpdate: () => ($('#v-presion').textContent = sis.v < 1 ? '---/--' : `${Math.round(sis.v)}/${Math.round(sis.v * 0.667)}`) }, 2200);
    enRango(2, 3800);
    tl.add('#v-gota', { scale: [0, 1], opacity: [0, 1], duration: 500, ease: 'outBack' }, 4000)
      .add('#v-gota', { translateX: [0, 130], translateY: [0, 10], opacity: [1, 0], duration: 700, ease: 'inQuad' }, 4600)
      .add(hb.o, { v: [0, 14.2], duration: 1200, ease: 'outCubic', onUpdate: hb.render }, 5000);
    enRango(3, 6200);
    tl.add('#v-mercurio', { scaleY: [0.1, 0.78], duration: 1400, ease: 'outCubic' }, 6400)
      .add(temp.o, { v: [30, 36.6], duration: 1400, ease: 'outCubic', onUpdate: temp.render }, 6400);
    enRango(4, 7800);
    tl.add('#v-sello', { opacity: [0, 1], scale: [1.5, 1], duration: 700, ease: 'outBack' }, 8300);
    utils.set('#v-aguja', { transformOrigin: '0px 0px' });
    utils.set('#v-mercurio', { transformOrigin: '15px 170px' });
    utils.set('#v-gota', { transformOrigin: '138px 62px' });
    utils.set('#v-sello', { transformOrigin: '400px 300px' });
    document.querySelectorAll('.v-enrango').forEach((el) => utils.set(el, { transformOrigin: 'center', transformBox: 'fill-box' }));
    return tl;
  }

  // ---------------- Cuarentena
  function cuarentena() {
    const n = contador($('#q-n'), (v) => String(Math.round(v)));
    const tl = createTimeline({ autoplay: false, defaults: { ease: 'inOutSine' } });
    tl.add('#q-bolsa', { translateX: [-420, 0], rotate: [-12, 0], duration: 1600, ease: 'outCubic' }, 0)
      .add('#q-tag', { opacity: [0, 1], rotate: [-30, 6, 0], duration: 900, ease: 'outCubic' }, 1500)
      .add(n.o, { v: [2, 3], duration: 400, onUpdate: n.render }, 2000)
      .add('#q-candado', { opacity: [0, 1], scale: [0.7, 1], duration: 500, ease: 'outBack' }, 2600)
      .add('#q-arco', { translateY: [-10, 0], duration: 400, ease: 'inQuad' }, 3200)
      .add('.q-tubo', { opacity: [0, 1], duration: 300, delay: (_: unknown, i: number) => i * 120 }, 4400)
      .add('.q-tubo', { translateX: [0, 250], translateY: [0, 104], rotate: [0, 18], duration: 1700, delay: (_: unknown, i: number) => i * 140, ease: 'inOutCubic' }, 4800)
      .add('#q-lab', { opacity: [0, 1], translateY: [10, 0], duration: 500, ease: 'outCubic' }, 6300)
      .add('.q-tubo', { opacity: 0, scale: 0.6, duration: 400, delay: (_: unknown, i: number) => i * 80, ease: 'inQuad' }, 6500);
    utils.set('#q-bolsa', { transformOrigin: '400px 293px' });
    utils.set('#q-tag', { transformOrigin: '436px 252px' });
    utils.set('#q-candado', { transformOrigin: '586px 286px' });
    return tl;
  }

  // ---------------- Serología
  function serologia() {
    const n = contador($('#s-n'), (v) => `${Math.round(v)}/7 pruebas`);
    const tl = createTimeline({ autoplay: false, defaults: { ease: 'inOutSine' } });
    tl.add('#s-laser', { translateX: [90, 700], duration: 5600, ease: 'linear' }, 0)
      .add('.s-chip', { opacity: [0, 1], scale: [0.85, 1], duration: 400, delay: (_: unknown, i: number) => i * 760, ease: 'outBack' }, 700)
      .add('#s-barra', { scaleX: [0, 1], duration: 5600, ease: 'linear' }, 0)
      .add(n.o, { v: [0, 7], duration: 5300, ease: 'linear', onUpdate: n.render }, 700)
      .add('#s-liberada', { opacity: [0, 1], translateY: [-16, 0], scale: [0.95, 1], duration: 800, ease: 'outBack' }, 6300);
    utils.set('#s-barra', { transformOrigin: '108px 463px' });
    utils.set('#s-liberada', { transformOrigin: '400px 70px' });
    document.querySelectorAll('.s-chip').forEach((el) => utils.set(el, { transformOrigin: 'center', transformBox: 'fill-box' }));
    return tl;
  }

  // ---------------- Inventario
  function inventario() {
    const total = contador($('#i-total'), (v) => String(Math.round(v)));
    const omas = contador($('#i-omas'), (v) => String(Math.round(v)));
    const tl = createTimeline({ autoplay: false, defaults: { ease: 'inOutSine' } });
    tl.add('.i-col', { scaleY: [0, 1], opacity: [0, 1], duration: 1200, delay: (_: unknown, i: number) => i * 110, ease: 'outCubic' }, 0)
      .add(total.o, { v: [0, 41], duration: 2000, ease: 'outCubic', onUpdate: total.render }, 0)
      .add('.i-nueva', { opacity: [0, 1], translateY: [-140, 0], duration: 1000, delay: (_: unknown, i: number) => i * 260, ease: 'outBounce' }, 2600)
      .add(total.o, { v: [41, 44], duration: 900, onUpdate: total.render }, 2800)
      .add(omas.o, { v: [10, 13], duration: 900, onUpdate: omas.render }, 2800)
      .add('.i-bajo', { opacity: [0, 1, 0.4, 1], scale: [0.8, 1], duration: 1200, ease: 'outCubic' }, 4400)
      .add('#i-fifo', { opacity: [0, 1], translateX: [40, 0], duration: 800, ease: 'outCubic' }, 5600)
      .add('#i-sale', { opacity: [0, 1], translateY: [8, 0], duration: 500, ease: 'outCubic' }, 6500);
    document.querySelectorAll('.i-col').forEach((el) => utils.set(el, { transformOrigin: 'bottom', transformBox: 'fill-box' }));
    document.querySelectorAll('.i-bajo').forEach((el) => utils.set(el, { transformOrigin: 'center', transformBox: 'fill-box' }));
    return tl;
  }

  // ---------------- Solicitud
  function solicitud() {
    const tl = createTimeline({ autoplay: false, defaults: { ease: 'inOutSine' } });
    tl.add('#r-orden', { translateY: [-80, 0], translateX: [-40, 0], rotate: [-10, 0], opacity: [0, 1], duration: 1100, ease: 'outCubic' }, 0)
      .add(svg.createDrawable('#r-firma'), { draw: ['0 0', '0 1'], duration: 1200, ease: 'inOutSine' }, 1000)
      .add('.r-ok', { opacity: [0, 1], scale: [0.9, 1], duration: 500, delay: (_: unknown, i: number) => i * 220, ease: 'outBack' }, 2600)
      .add('#r-sello', { opacity: [0, 1], scale: [1.8, 1], duration: 600, ease: 'outBack' }, 4300)
      .add('#r-unidad', { opacity: [0, 1], translateY: [30, 0], duration: 800, ease: 'outCubic' }, 5300);
    utils.set('#r-orden', { transformOrigin: '180px 300px' });
    utils.set('#r-sello', { transformOrigin: '676px 348px' });
    document.querySelectorAll('.r-ok').forEach((el) => utils.set(el, { transformOrigin: 'center', transformBox: 'fill-box' }));
    return tl;
  }

  // Hero: contadores, paralaje con el scroll y con el puntero.
  const hero = document.querySelector<HTMLElement>('.hero');
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-cuenta]').forEach((el, i) => {
      const fin = Number(el.dataset.cuenta);
      const t0 = performance.now() + 500 + i * 140;
      el.textContent = '0';
      const paso = (t: number) => {
        const k = utils.clamp((t - t0) / 1500, 0, 1);
        el.textContent = String(Math.round(fin * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    });
    if (hero) {
      let sy = 0, mx = 0, mxActual = 0;
      const calc = () => { sy = utils.clamp(scrollY / Math.max(hero.offsetHeight, 1), 0, 1); };
      addEventListener('scroll', calc, { passive: true });
      hero.addEventListener('pointermove', (ev) => {
        const r = hero.getBoundingClientRect();
        mx = (ev.clientX - r.left) / r.width - 0.5;
      });
      hero.addEventListener('pointerleave', () => { mx = 0; });
      calc();
      const loop = () => {
        mxActual += (mx - mxActual) * 0.08;
        hero.style.setProperty('--mx', mxActual.toFixed(4));
        hero.style.setProperty('--sy', sy.toFixed(4));
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }

  const crear: Record<string, () => ReturnType<typeof createTimeline>> = { cita, evaluacion, extraccion, cuarentena, serologia, fraccionamiento, inventario, solicitud, transfusion };
  const escenas = [...document.querySelectorAll<HTMLElement>('.escena')].map((el) => {
    const tl = crear[el.dataset.escena!]();
    const cola = el.querySelector<HTMLElement>('.cola')!;
    return { el, tl, pasos: [...el.querySelectorAll<HTMLElement>('.paso')], barra: el.querySelector<HTMLElement>('.progreso')!, m: 0, meta: 0, actual: 0, cola, ruta: cola.querySelector<SVGPathElement>('.cola-ruta')!, marca: cola.querySelector<HTMLElement>('.cola-marca')!, lupa: cola.querySelector<HTMLElement>('.lupa')!, largo: 1, ancho: 1280, alto: 700, tramo1: 600, derecha: true };
  });

  // Entrada de cada etapa y del cierre al llegar a la pantalla.
  const io = new IntersectionObserver(
    (entradas) => entradas.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('dentro'); io.unobserve(en.target); } }),
    { rootMargin: '0px 0px -30% 0px' }
  );
  document.querySelectorAll('.escena, .fin').forEach((el) => io.observe(el));

  // La cola ocupa todo el ancho; la gota y la lupa la recorren a medida que avanza la etapa.
  const tramo = (v: number, a: number, b: number) => utils.clamp((v - a) / (b - a), 0, 1);
  // Misma forma que en el servidor (zigzag): baja por un carril, cruza por la franja inferior y sale por el otro lado.
  const colaD = (i: number, W: number, H: number, xL: number, xR: number) => {
    const xs = i % 2 === 0 ? xR : xL, xe = i % 2 === 0 ? xL : xR, dir = Math.sign(xe - xs), yb = H - 40;
    const r = Math.round;
    return `M${r(xs)} -28 L${r(xs)} ${r(yb - 90)} C ${r(xs)} ${r(yb - 30)}, ${r(xs + dir * 50)} ${yb}, ${r(xs + dir * 110)} ${yb} L${r(xe - dir * 110)} ${yb} C ${r(xe - dir * 50)} ${yb}, ${r(xe)} ${r(yb + 30)}, ${r(xe)} ${r(yb + 90)} L${r(xe)} ${H + 28}`;
  };
  // Carriles de la cola: pegados a los bordes del contenido (no de la pantalla), así que en pantallas anchas la cola sigue al contenido.
  const carriles = () => {
    const c = document.querySelector<HTMLElement>('.escena-stage .container-blud')!.getBoundingClientRect();
    return { xL: Math.round(c.left + 16), xR: Math.round(c.right - 16) };
  };
  // La cola del inicio baja hasta el carril derecho, por donde entra la etapa 1.
  const colaInicio = () => {
    const r = document.getElementById('h-tubo-ruta') as unknown as SVGPathElement | null;
    const m = r?.getScreenCTM();
    if (!r || !m) return;
    const xu = new DOMPoint(carriles().xR, 0).matrixTransform(m.inverse()).x;
    const a = 210 + (xu - 210) * 0.3, b = 210 + (xu - 210) * 0.7;
    const d = `M210 470 C 210 545, ${a} 585, ${b} 615 S ${xu} 660, ${xu} 740 L ${xu} 1300`;
    document.querySelectorAll('.h-cola path').forEach((p) => p.setAttribute('d', d));
  };
  const trazar = (e: (typeof escenas)[number]) => {
    const W = Math.round(e.cola.clientWidth), H = Math.round(e.cola.clientHeight);
    const { xL, xR } = carriles();
    const d = colaD(Number(e.cola.dataset.i), W, H, xL, xR);
    e.cola.querySelector('svg')!.setAttribute('viewBox', `0 0 ${W} ${H}`);
    e.cola.querySelectorAll('.cola-p').forEach((p) => p.setAttribute('d', d));
    e.largo = e.ruta.getTotalLength();
    e.tramo1 = H - 40 - 62; // largo del primer tramo recto (baja por el carril)
    e.ancho = W;
    e.alto = H;
    e.derecha = Number(e.cola.dataset.i) % 2 === 0;
  };
  // Cierre: la cola llega por el carril izquierdo y se curva hasta la gota.
  const trazarFin = () => {
    const f = document.querySelector<SVGSVGElement>('.fin-cola');
    if (!f) return;
    const W = Math.round(document.documentElement.clientWidth);
    const x = carriles().xL;
    f.setAttribute('viewBox', `0 0 ${W} 96`);
    f.querySelectorAll('.fin-p').forEach((p) => p.setAttribute('d', `M${x} -6 C ${x} 50, ${Math.round(W / 2)} 30, ${Math.round(W / 2)} 100`));
  };
  const pintar = (e: (typeof escenas)[number]) => {
    const m = e.m;
    e.actual = m;
    e.tl.seek(m * e.tl.duration);
    e.barra.style.transform = `scaleX(${m})`;
    let activo = 0;
    e.pasos.forEach((p, i) => { if (Number(p.dataset.at) <= m + 0.001) activo = i; });
    e.pasos.forEach((p, i) => { p.toggleAttribute('data-activo', i === activo); p.toggleAttribute('data-pasado', i < activo); });
    // La gota baja por el carril durante casi toda la etapa y, al final, cruza por la franja inferior hacia el otro lado.
    const baja = tramo(m, 0, 0.8);
    const largoPos = m < 0.8 ? e.tramo1 * (0.03 + 0.97 * baja) : e.tramo1 + tramo(m, 0.8, 1) * (e.largo - e.tramo1 - 20);
    const pt = e.ruta.getPointAtLength(largoPos);
    e.marca.style.transform = `translate(${pt.x}px, ${pt.y}px)`;
    e.marca.style.opacity = String(tramo(m, 0.01, 0.05) * (1 - tramo(m, 0.97, 1)));
    // La lupa (vertical) va junto al tramo recto: a la izquierda del tubo si baja por la derecha y a la derecha si baja por la izquierda.
    const pw = e.lupa.offsetWidth, ph = e.lupa.offsetHeight;
    const arriba = utils.clamp(pt.y - ph - 12, 8, e.alto - ph - 8);
    e.lupa.style.transform = `translate(${e.derecha ? pt.x - 22 - pw : pt.x + 22}px, ${arriba}px)`;
    // La lupa hace un zoom suave al entrar y se despide al llegar al final de la etapa.
    const entra = tramo(m, 0, 0.07), sale = tramo(m, 0.7, 0.8);
    e.lupa.style.setProperty('--ls', String(0.55 + entra * 0.45 - sale * 0.1));
    e.lupa.style.setProperty('--lo', String(entra * (1 - sale)));
    e.lupa.style.setProperty('--lz', String(1.7 - entra * 0.7));
  };

  if (reduce) {
    // Sin movimiento: cada ilustración en su estado final y todos los textos visibles.
    escenas.forEach((e) => { trazar(e); e.m = 0; pintar(e); e.tl.seek(e.tl.duration); e.barra.style.transform = 'scaleX(1)'; });
  } else {
    const medir = () => {
      const vh = innerHeight;
      escenas.forEach((e) => {
        const r = e.el.getBoundingClientRect();
        e.meta = utils.clamp(-r.top / (r.height - vh), 0, 1);
      });
    };
    // Scroll con inercia: la animación persigue la posición del scroll en vez de saltar a ella.
    const frame = () => {
      escenas.forEach((e) => {
        const d = e.meta - e.m;
        if (Math.abs(d) < 0.0004) return;
        e.m += d * 0.12;
        pintar(e);
      });
      requestAnimationFrame(frame);
    };
    addEventListener('scroll', medir, { passive: true });
    addEventListener('resize', () => { medir(); escenas.forEach((e) => { trazar(e); pintar(e); }); colaInicio(); trazarFin(); });
    medir();
    escenas.forEach((e) => { trazar(e); e.m = e.meta; pintar(e); });
    colaInicio();
    trazarFin();
    requestAnimationFrame(frame);
  }
</script>
