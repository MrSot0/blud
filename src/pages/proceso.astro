---
// proceso.astro - El viaje de una bolsa de sangre (prototipo: extracción, fraccionamiento y transfusión).
// Cada escena queda fija mientras se hace scroll y el scroll avanza o retrocede su animación (Anime.js).
import Layout from '../layouts/Layout.astro';

// Cola de la bolsa: sale por abajo y recorre el hero hasta el borde de la pantalla.
const COLA = 'M210 470 C 210 545, 300 585, 380 615 S 440 660, 440 740 L 440 1300';
const tituloA = ['El', 'viaje', 'de', 'una'];
const tituloB = ['bolsa', 'de', 'sangre'];

const escenas = [
  {
    id: 'cita',
    num: '01',
    titulo: 'La cita',
    pasos: [
      { at: 0, t: 'Todo empieza con una decisión', d: 'Carlos abre BLUD y elige el centro más cercano de la red.' },
      { at: 0.2, t: 'Elige el día', d: 'El calendario solo ofrece fechas en las que ya puede donar: 90 días después de la última vez (120 si es mujer).' },
      { at: 0.42, t: 'Y la hora', d: 'Los horarios disponibles salen de la agenda real del centro.' },
      { at: 0.6, t: 'Cita confirmada', d: 'La cita queda guardada y el centro ya sabe que llega.' },
      { at: 0.78, t: 'El día antes, un recordatorio', d: 'Con la ruta al centro y lo que conviene hacer: comer bien, dormir y tomar agua.' },
    ],
  },
  {
    id: 'evaluacion',
    num: '02',
    titulo: 'Evaluación',
    pasos: [
      { at: 0, t: 'Antes de donar, cuidarte', d: 'Un profesional revisa que donar sea seguro para ti y para quien reciba tu sangre.' },
      { at: 0.08, t: 'Peso: 50 kg o más', d: 'Así se pueden extraer 450 ml sin riesgo.' },
      { at: 0.3, t: 'Presión arterial en rango', d: 'Entre 90/50 y 180/100.' },
      { at: 0.52, t: 'Hemoglobina suficiente', d: 'Al menos 13 g/dL en hombres y 12,5 en mujeres: una gota del dedo basta.' },
      { at: 0.72, t: 'Sin fiebre', d: 'Temperatura de 37,5 °C o menos.' },
      { at: 0.88, t: 'Apto para donar', d: 'Si algo no está en rango, no es un "no": el sistema indica desde cuándo podrá volver.' },
    ],
  },
  {
    id: 'extraccion',
    num: '03',
    titulo: 'Extracción',
    pasos: [
      { at: 0, t: 'Todo empieza con una persona', d: 'Carlos ya pasó la evaluación: peso, hemoglobina, presión y temperatura en rango.' },
      { at: 0.18, t: 'Una punción, nada más', d: 'Se coloca el torniquete y una aguja estéril de un solo uso en la vena del brazo.' },
      { at: 0.38, t: '450 ml en unos 10 minutos', d: 'La sangre baja por la vía hasta la bolsa, que se mece para mezclarla con el anticoagulante.' },
      { at: 0.82, t: 'La bolsa recibe su identidad', d: 'Se sella y se etiqueta con un código único (DIN). Desde aquí se puede rastrear hasta el paciente.' },
    ],
  },
  {
    id: 'cuarentena',
    num: '04',
    titulo: 'Cuarentena',
    pasos: [
      { at: 0, t: 'Bajo llave', d: 'La bolsa entra a una nevera de conservación a 4 °C.' },
      { at: 0.25, t: 'Todavía no cuenta', d: 'Queda marcada en cuarentena: el sistema no la ofrece a ningún hospital.' },
      { at: 0.5, t: 'Nada sale sin análisis', d: 'Ninguna unidad puede despacharse hasta tener todos sus resultados.' },
      { at: 0.7, t: 'Las muestras viajan al laboratorio', d: 'Tres tubos piloto, tomados en la extracción, van a serología con el mismo código de la bolsa.' },
    ],
  },
  {
    id: 'serologia',
    num: '05',
    titulo: 'Serología',
    pasos: [
      { at: 0, t: 'Siete pruebas, una por una', d: 'Se buscan infecciones que pueden transmitirse por la sangre.' },
      { at: 0.15, t: 'VIH y hepatitis B y C', d: 'Cuatro de los siete marcadores.' },
      { at: 0.5, t: 'Sífilis, Chagas y HTLV', d: 'Los otros tres, obligatorios en Venezuela.' },
      { at: 0.82, t: 'Todo negativo: liberada', d: 'La bolsa sale de cuarentena. Si una prueba fuera reactiva, se descarta y el laboratorio notifica el caso con total confidencialidad.' },
    ],
  },
  {
    id: 'fraccionamiento',
    num: '06',
    titulo: 'Fraccionamiento',
    pasos: [
      { at: 0, t: 'Una bolsa, tres medicinas', d: 'La sangre total se separa en sus componentes, porque cada paciente necesita algo distinto.' },
      { at: 0.2, t: 'A la centrífuga', d: 'La bolsa entra al rotor junto a otras y la tapa se cierra.' },
      { at: 0.35, t: '4.000 revoluciones por minuto', d: 'La fuerza ordena la sangre por densidad: lo más pesado se va al fondo.' },
      { at: 0.66, t: 'Tres capas', d: 'Abajo los glóbulos rojos, en medio una capa fina con las plaquetas y arriba el plasma.' },
      { at: 0.84, t: 'Cada una con su reloj', d: 'Glóbulos rojos 42 días, plasma congelado 365 días y plaquetas solo 7.' },
    ],
  },
  {
    id: 'inventario',
    num: '07',
    titulo: 'Inventario',
    pasos: [
      { at: 0, t: 'Stock en tiempo real', d: 'Cada unidad liberada aparece en el inventario de la red, por tipo de sangre.' },
      { at: 0.35, t: 'Llegan las nuevas', d: 'Los tres componentes de Carlos se suman al stock de O+.' },
      { at: 0.6, t: 'Alerta de stock bajo', d: 'Si un tipo baja de 3 unidades, la red lo sabe y puede convocar donantes de ese grupo.' },
      { at: 0.8, t: 'Primero lo que vence antes', d: 'Las plaquetas duran 7 días: el sistema despacha siempre la unidad más próxima a vencer.' },
    ],
  },
  {
    id: 'solicitud',
    num: '08',
    titulo: 'Solicitud',
    pasos: [
      { at: 0, t: 'Un médico la pide', d: 'Llega una orden de transfusión: Roberto Gómez, O+, 1 unidad de glóbulos rojos, urgente.' },
      { at: 0.3, t: '¿Qué sangre le sirve?', d: 'Un paciente O+ puede recibir glóbulos rojos O+ u O−. El sistema solo propone unidades compatibles.' },
      { at: 0.58, t: 'La dirección aprueba', d: 'Revisa la orden y el stock, y la aprueba.' },
      { at: 0.76, t: 'Unidad reservada', d: 'La bolsa de Carlos queda apartada para Roberto: ya nadie más puede tomarla.' },
    ],
  },
  {
    id: 'transfusion',
    num: '09',
    titulo: 'Transfusión',
    pasos: [
      { at: 0, t: 'Un hospital la necesita', d: 'La dirección aprobó la solicitud y la unidad compatible sale del banco de sangre.' },
      { at: 0.4, t: 'Llega a tiempo', d: 'La cadena de frío se mantiene durante todo el traslado.' },
      { at: 0.62, t: 'Tres personas distintas', d: 'Una paciente en cirugía, un niño con leucemia y alguien con quemaduras graves.' },
      { at: 0.86, t: '450 ml, hasta 3 vidas', d: 'Eso es lo que deja una sola donación de 10 minutos.' },
    ],
  },
];

// La cola es una sola línea continua en zigzag: baja por el lado derecho de la etapa, cruza por la franja inferior y sigue bajando por el
// izquierdo en la etapa siguiente (y al revés). Sale y entra en el mismo punto entre etapas, así que parece la misma línea.
const colaD = (i: number, W: number, H: number, xL = 16, xR = W - 16) => {
  const xs = i % 2 === 0 ? xR : xL, xe = i % 2 === 0 ? xL : xR, dir = Math.sign(xe - xs), yb = H - 40;
  const r = Math.round;
  return `M${r(xs)} -28 L${r(xs)} ${r(yb - 90)} C ${r(xs)} ${r(yb - 30)}, ${r(xs + dir * 50)} ${yb}, ${r(xs + dir * 110)} ${yb} L${r(xe - dir * 110)} ${yb} C ${r(xe - dir * 50)} ${yb}, ${r(xe)} ${r(yb + 30)}, ${r(xe)} ${r(yb + 90)} L${r(xe)} ${H + 28}`;
};
---

<Layout title="BLUD | El viaje de una bolsa" description="Sigue una bolsa de sangre desde la extracción hasta el paciente, paso a paso.">
  <section class="hero relative overflow-hidden bg-[#FBF7F3] text-[#1E2430]">
    <div class="absolute inset-0 bg-[radial-gradient(45%_60%_at_72%_45%,rgba(240,128,118,0.20),transparent_70%)]" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(30%_40%_at_10%_90%,rgba(43,185,160,0.10),transparent_70%)]" aria-hidden="true"></div>
    <div class="hero-grid absolute inset-0 opacity-[0.07]" aria-hidden="true"></div>
    <div class="container-blud relative grid min-h-[calc(100dvh-var(--header-h))] items-center gap-10 py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)]">
      <div>
        <p class="hero-in tag-don"><span class="tag-punto" aria-hidden="true"></span><span>DON-26000001</span><i aria-hidden="true">/</i><span>SANGRE TOTAL</span><i aria-hidden="true">/</i><b>O+</b></p>
        <h1 class="hero-in mt-5 max-w-3xl text-5xl font-bold leading-[1.02] tracking-tight sm:text-7xl" aria-label="El viaje de una bolsa de sangre">
          {tituloA.map((w, i) => (<><span class="pal" style={`--w:${i}`} aria-hidden="true">{w}</span>{' '}</>))}
          <span class="text-[#D9534F]">{tituloB.map((w, i) => (<><span class="pal" style={`--w:${i + tituloA.length}`} aria-hidden="true">{w}</span>{i < tituloB.length - 1 ? ' ' : ''}</>))}</span>
        </h1>
        <p class="hero-in mt-6 max-w-xl text-lg text-[#4A5363]">De un brazo a tres personas que la necesitan. Desliza y acompáñala por las 9 etapas que recorre en el banco de sangre.</p>
        <dl class="hero-in mt-10 grid max-w-lg grid-cols-3 gap-3">
          {[['450', 'ml por donación'], ['10', 'minutos en el sillón'], ['3', 'vidas que puede salvar']].map(([n, l]) => (
            <div class="rounded-2xl border border-[#ECE4DD] bg-white/80 shadow-[0_8px_24px_-12px_rgba(80,50,40,0.18)] p-4 backdrop-blur-sm">
              <dt class="sr-only">{l}</dt>
              <dd class="text-3xl font-bold tabular-nums" data-cuenta={n}>{n}</dd>
              <dd class="mt-1 text-xs leading-snug text-[#6B7383]">{l}</dd>
            </div>
          ))}
        </dl>
        <ol class="hero-in mt-10 flex max-w-2xl flex-wrap gap-2.5" aria-label="Etapas del recorrido">
          {escenas.map((e, i) => (
            <li style={`--n:${i}`}>
              <a href={`#etapa-${e.id}`} class="etq"><span class="etq-n">{e.num}</span>{e.titulo}</a>
            </li>
          ))}
        </ol>
        <p class="hero-in mt-12 flex items-center gap-3 text-sm text-[#6B7383]"><span class="scroll-cue" aria-hidden="true"></span>Desliza para empezar</p>
      </div>
      <div class="hero-bolsa relative mx-auto w-full max-w-[26rem]" aria-hidden="true">
        <svg viewBox="0 0 420 560" class="w-full overflow-visible drop-shadow-[0_40px_50px_rgba(120,40,40,0.22)]">
          <defs>
            <linearGradient id="h-blood" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F0565B"/><stop offset=".55" stop-color="#B3121A"/><stop offset="1" stop-color="#6E070D"/></linearGradient>
            <linearGradient id="h-gloss" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity=".6"/><stop offset=".3" stop-color="#fff" stop-opacity=".1"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
            <linearGradient id="h-film" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".16"/><stop offset="1" stop-color="#fff" stop-opacity=".04"/></linearGradient>
            <radialGradient id="h-glow"><stop offset="0" stop-color="#FF3B42" stop-opacity=".55"/><stop offset="1" stop-color="#FF3B42" stop-opacity="0"/></radialGradient>
            <clipPath id="h-clip"><path d="M92 132 Q92 104 120 104 H300 Q328 104 328 132 V448 Q328 500 276 500 H144 Q92 500 92 448 Z"/></clipPath>
          </defs>
          <ellipse cx="210" cy="320" rx="200" ry="220" fill="url(#h-glow)"/>
          <g class="h-cola" fill="none" stroke-linecap="round">
            <path class="h-tubo" pathLength="1" d={COLA} stroke="#7A0910" stroke-opacity=".28" stroke-width="13" transform="translate(0 6)"/>
            <path id="h-tubo-ruta" class="h-tubo" pathLength="1" d={COLA} stroke="#C81E26" stroke-width="10" opacity=".92"/>
            <path class="h-flujo" d={COLA} stroke="#FF9AA0" stroke-width="4" stroke-dasharray="16 46"/>
            <path class="h-tubo" pathLength="1" d={COLA} stroke="#fff" stroke-opacity=".3" stroke-width="3" transform="translate(-2 -3)"/>
          </g>
          {[0, 1, 2, 3, 4].map((i) => (
            <circle class="h-gotita" r="5.5" fill="#FF6B70" stroke="#fff" stroke-opacity=".55" stroke-width="1.5">
              <animateMotion dur="9s" begin={`${i * 1.8}s`} repeatCount="indefinite"><mpath href="#h-tubo-ruta"/></animateMotion>
            </circle>
          ))}
          <g class="h-bolsa-g">
          <rect x="170" y="56" width="26" height="56" rx="10" fill="#D7DDE5"/><rect x="224" y="56" width="26" height="56" rx="10" fill="#D7DDE5"/>
          <rect x="174" y="60" width="6" height="46" rx="3" fill="#fff" opacity=".7"/><rect x="228" y="60" width="6" height="46" rx="3" fill="#fff" opacity=".7"/>
          <path d="M92 132 Q92 104 120 104 H300 Q328 104 328 132 V448 Q328 500 276 500 H144 Q92 500 92 448 Z" fill="url(#h-film)" stroke="#fff" stroke-opacity=".45" stroke-width="2.5"/>
          <rect x="182" y="118" width="56" height="12" rx="6" fill="#0B0F15" opacity=".6"/>
          <g clip-path="url(#h-clip)">
            <rect x="80" y="190" width="260" height="330" fill="url(#h-blood)"/>
            <path class="h-ola" d="M-40 190 q 26 -12 52 0 t 52 0 t 52 0 t 52 0 t 52 0 t 52 0 t 52 0 t 52 0 t 52 0 V 214 H-40 Z" fill="#F0565B"/>
            {[[140, 420, 5], [250, 380, 3.5], [190, 460, 4], [280, 300, 3], [130, 330, 3], [230, 250, 2.5]].map(([x, y, r], i) => <circle class="h-burbuja" style={`animation-delay:${i * 0.7}s`} cx={x} cy={y} r={r} fill="#fff" opacity=".35"/>)}
          </g>
          <path d="M104 140 Q104 118 124 118 H146 V488 H140 Q104 488 104 452 Z" fill="url(#h-gloss)"/>
          <g>
            <rect x="156" y="300" width="150" height="150" rx="10" fill="#fff"/>
            <rect x="156" y="300" width="150" height="30" rx="10" fill="#CA2B2B"/><rect x="156" y="318" width="150" height="12" fill="#CA2B2B"/>
            <text x="170" y="320" font-size="13" font-weight="800" fill="#fff" letter-spacing="2">BLUD</text>
            <text x="292" y="320" text-anchor="end" font-size="11" fill="#fff" opacity=".85">Sangre total</text>
            <text x="170" y="372" font-size="40" font-weight="800" fill="#151A23">O+</text>
            <text x="292" y="352" text-anchor="end" font-size="11" fill="#616B7C">450 ml</text>
            <text x="292" y="368" text-anchor="end" font-size="11" fill="#616B7C">CPDA-1</text>
            <g fill="#151A23">{[0, 4, 6, 11, 13, 17, 22, 24, 28, 33, 35, 40, 43, 46, 51, 54, 59, 62, 66, 70, 73, 78, 82, 85, 90, 94, 97, 102, 106, 110, 114, 118].map((x, i) => <rect x={170 + x} y="390" width={i % 3 ? 2 : 3.5} height="32"/>)}</g>
            <text x="231" y="440" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="#151A23">DON-26000001</text>
          </g>
          </g>
        </svg>
        {[[8, 30, 10], [88, 18, 7], [92, 70, 8], [4, 76, 6]].map(([x, y, s], i) => (
          <span class="h-gota absolute" style={`left:${x}%;top:${y}%;width:${s * 2}px;height:${s * 2.6}px;animation-delay:${i * 0.9}s;--k:${s}`}></span>
        ))}
      </div>
    </div>
  </section>

  {escenas.map((e, zi) => (
    <section id={`etapa-${e.id}`} class="escena relative bg-[#FBF7F3] text-[#1E2430]" data-escena={e.id} aria-labelledby={`h-${e.id}`}>
      <div class="escena-stage sticky overflow-hidden">
        <div class="escena-fondo absolute inset-0" aria-hidden="true"></div>
        <div class="container-blud relative grid h-full items-center gap-6 py-6 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-12">
          <div class="escena-texto order-2 lg:order-1">
            <p class="font-mono text-xs tracking-[0.3em] text-[#6B7383]">ETAPA {e.num} / 09</p>
            <h2 id={`h-${e.id}`} class="mt-2 text-3xl font-bold sm:text-4xl">{e.titulo}</h2>
            <ol class="pasos relative mt-6 min-h-36">
              {e.pasos.map((p, i) => (
                <li class="paso" data-at={p.at} data-activo={i === 0 ? '' : undefined}>
                  <p class="text-lg font-semibold">{p.t}</p>
                  <p class="mt-2 text-[#4A5363]">{p.d}</p>
                </li>
              ))}
            </ol>
            <div class="mt-8 h-1 w-full max-w-60 overflow-hidden rounded-full bg-[#ECE6E0]" aria-hidden="true">
              <div class="progreso h-full origin-left rounded-full bg-[#E36F6B]"></div>
            </div>
          </div>
          <div class="escena-lamina order-1 lg:order-2" set:html={''} data-svg={e.id}></div>
        </div>

        <!-- La cola de la bolsa sigue por aquí: una gota viaja por ella y una lupa de sangre muestra la etapa. -->
        <div class="cola" aria-hidden="true" data-i={zi}>
          <svg class="cola-svg" viewBox="0 0 1280 700" preserveAspectRatio="none">
            <g fill="none" stroke-linecap="round">
              <path class="cola-p" d={colaD(zi, 1280, 700)} stroke="#7A0910" stroke-opacity=".28" stroke-width="13" transform="translate(0 6)"/>
              <path id={`cola-${e.id}`} class="cola-p cola-ruta" d={colaD(zi, 1280, 700)} stroke="#C81E26" stroke-width="10" opacity=".92"/>
              <path class="cola-p cola-flujo" d={colaD(zi, 1280, 700)} stroke="#FF9AA0" stroke-width="4" stroke-dasharray="16 46"/>
              <path class="cola-p" d={colaD(zi, 1280, 700)} stroke="#fff" stroke-opacity=".3" stroke-width="3" transform="translate(-2 -3)"/>
            </g>
          </svg>
          <span class="cola-marca"></span>
          <div class="lupa">
            <span class="lupa-cristal"><i></i><i></i><i></i></span>
            <span class="lupa-texto"><small class="font-mono">{e.num}</small><b>{e.titulo}</b></span>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="fin relative bg-[#FBF7F3] py-24 text-center text-[#1E2430]">
    <svg class="fin-cola" aria-hidden="true" viewBox="0 0 1280 96">
      <g fill="none" stroke-linecap="round">
        <path class="fin-p" stroke="#7A0910" stroke-opacity=".28" stroke-width="13" transform="translate(0 6)"/>
        <path class="fin-p" stroke="#C81E26" stroke-width="10" opacity=".92"/>
        <path class="fin-p fin-flujo" stroke="#FF9AA0" stroke-width="4" stroke-dasharray="16 46"/>
        <path class="fin-p" stroke="#fff" stroke-opacity=".3" stroke-width="3" transform="translate(-2 -3)"/>
      </g>
    </svg>
    <svg class="fin-in fin-gota mx-auto mb-6 size-14" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" fill="#CA2B2B"/><ellipse cx="9.6" cy="12.4" rx="1.1" ry="2" transform="rotate(28 9.6 12.4)" fill="#fff" opacity=".45"/></svg>
    <p class="fin-in font-mono text-xs tracking-[0.3em] text-[#6B7383]">FIN DEL VIAJE · DON-26000001</p>
    <p class="fin-in mx-auto mt-4 max-w-2xl text-3xl font-bold sm:text-4xl">La próxima bolsa puede ser la tuya.</p>
    <p class="fin-in mx-auto mt-4 max-w-xl text-[#4A5363]">10 minutos en un sillón. Hasta 3 personas que siguen adelante.</p>
    <div class="fin-in mt-8 flex flex-wrap justify-center gap-3">
      <a href="/centros" class="btn btn-primary">Encuentra dónde donar</a>
      <a href="/elegibilidad" class="btn border border-[#D9D2CB] text-[#1E2430] hover:bg-[#ECE6E0]">¿Puedo donar?</a>
    </div>
  </section>

  <!-- ============ Ilustraciones (se mueven al contenedor de cada escena) ============ -->
  <template id="svg-cita">
    <svg viewBox="0 0 800 600" class="ilustracion" role="img" aria-label="En el teléfono se elige día y hora, se confirma la cita y aparece la ruta al centro">
      <defs>
        <radialGradient id="c-bg" cx="40%" cy="35%" r="80%"><stop offset="0" stop-color="#EFE9F8"/><stop offset="1" stop-color="#FBF8F5"/></radialGradient>
        <linearGradient id="c-body" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3A4352"/><stop offset=".5" stop-color="#151B24"/><stop offset="1" stop-color="#2A313D"/></linearGradient>
        <linearGradient id="c-screen" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#18202C"/><stop offset="1" stop-color="#0D131B"/></linearGradient>
        <linearGradient id="c-map" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F4F7FB"/><stop offset="1" stop-color="#E6ECF3"/></linearGradient>
        <linearGradient id="c-btn" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#E5484D"/><stop offset="1" stop-color="#B42121"/></linearGradient>
        <clipPath id="c-clip"><rect x="10" y="10" width="190" height="410" rx="26"/></clipPath>
        <filter id="c-shadow" x="-30%" y="-30%" width="160%" height="170%"><feDropShadow dx="0" dy="16" stdDeviation="14" flood-color="#000" flood-opacity="0.22"/></filter>
        <filter id="c-soft" x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000" flood-opacity="0.16"/></filter>
        <filter id="c-glow" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="6" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <linearGradient id="c-blood" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F0565B"/><stop offset="1" stop-color="#7A0910"/></linearGradient>
