---
// src/pages/donante/centros.astro
import LayoutDonante from '../../layouts/LayoutDonante.astro';
import Icon from '../../components/Icon.astro';
import ScheduleDialog from '../../components/centers/ScheduleDialog.astro';
import { centerKinds, centers } from '../../data/centers';
import { getDonor } from '../../lib/donante';
import '../../styles/map.css';

const sorted = [...centers].sort((a, b) => a.name.localeCompare(b.name, 'es'));
const chipClass =
  'chip inline-flex h-9 shrink-0 cursor-pointer whitespace-nowrap items-center gap-1.5 rounded-full border border-line-strong bg-surface px-3.5 text-sm font-medium text-ink-2 transition-colors duration-150 hover:border-ink-3 hover:text-ink';
---

<LayoutDonante title="BLUD | Centros de donación">
  <section id="centros-app" class="centros-app" data-view="list" data-centers={JSON.stringify(centers)}>
    
    <!-- Panel de controles y filtros (Columna izquierda en escritorio) -->
    <div class="centros-head border-b border-line bg-surface px-4 pb-4 pt-6 sm:px-6 lg:border-r">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Centros cercanos</h1>
          <p class="mt-1 text-xs sm:text-sm text-ink-3">Encuentra dónde donar y cuáles centros necesitan tu tipo de sangre.</p>
        </div>
        <button type="button" id="locate-btn" class="btn btn-secondary btn-sm shrink-0 pointer-coarse:min-h-11">
          <span data-locate-icon><Icon name="map-pin" class="size-4" /></span>
          <span data-locate-spinner class="hidden"><Icon name="spinner-gap" class="spin size-4" /></span>
          Cerca de mí
        </button>
      </div>

      <!-- Buscador -->
      <label for="centros-search" class="sr-only">Buscar centro</label>
      <div class="relative mt-4">
        <Icon name="magnifying-glass" class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-ink-3" />
        <input
          type="search"
          id="centros-search"
          placeholder="Nombre, zona o tipo de centro…"
          autocomplete="off"
          class="field pl-12"
        />
      </div>

      <!-- Chips de filtro de tipo de centro y estado -->
      <div class="chip-row relative -mx-4 mt-3 flex gap-2 overflow-x-auto px-4 pb-1 sm:-mx-6 sm:px-6" role="group" aria-label="Filtrar centros">
        <label class="shrink-0">
          <input type="radio" name="kind" value="all" class="sr-only" checked />
          <span class={chipClass}>Todos</span>
        </label>
        
        <label class="shrink-0">
          <input type="checkbox" id="filter-need-mine" class="sr-only" />
          <span class={chipClass}>🩸 Necesitan mi tipo</span>
        </label>

        {centerKinds.map((kind) => (
          <label class="shrink-0">
            <input type="radio" name="kind" value={kind.id} class="sr-only" />
            <span class={chipClass}>{kind.label}</span>
          </label>
        ))}

        <label class="shrink-0">
          <input type="checkbox" name="open" id="open-now" class="sr-only" />
          <span class={chipClass}>
            <span class="size-2 rounded-full bg-ok" aria-hidden="true"></span>
            Abiertos ahora
          </span>
        </label>
      </div>

      <!-- Conteo y ordenamiento -->
      <div class="mt-4 flex items-center justify-between gap-3 text-sm">
        <p class="font-semibold text-ink" aria-live="polite">
          <span id="centros-count" class="tabular">{centers.length}</span>{' '}
          <span id="centros-count-label">centros</span>
        </p>
        <div class="segmented" role="group" aria-label="Ordenar">
          <button type="button" data-sort="name" aria-pressed="true">Nombre</button>
          <button type="button" data-sort="distance" aria-pressed="false">Distancia</button>
        </div>
      </div>
      <p id="locate-status" class="mt-3 hidden rounded-control px-3 py-2 text-xs" role="status"></p>
    </div>

    <!-- Alternador de vista Móvil (Lista / Mapa) -->
    <div class="view-switch sticky top-(--header-offset) z-20 transition-[top] duration-300 ease-(--ease-out) border-b border-line bg-surface/90 px-4 py-2.5 backdrop-blur-lg sm:px-6 lg:hidden">
      <div class="segmented segmented-full" role="group" aria-label="Vista">
        <button type="button" data-view-btn="list" aria-pressed="true">
          <Icon name="list" class="size-4" />
          Lista
        </button>
        <button type="button" data-view-btn="map" aria-pressed="false">
          <Icon name="map-trifold" class="size-4" />
          Mapa
        </button>
      </div>
    </div>

    <!-- Lista de tarjetas de centros -->
    <div class="list-pane px-4 py-4 sm:px-6 lg:min-h-0 lg:overflow-y-auto lg:overscroll-contain lg:border-r lg:border-line lg:bg-surface">
      <ul id="centros-list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        {sorted.map((c) => (
          <li
            data-center-item={c.id}
            data-kind={c.kind}
            data-name={c.name}
            data-needs={c.needs.join(',')}
            data-search={`${c.name} ${c.type} ${c.address} ${c.city}`.toLowerCase()}
          >
            <article class="centro panel p-5 flex flex-col gap-3.5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
              <div class="flex items-start gap-3.5">
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-accent-soft text-accent-ink">
                  <Icon name="first-aid-kit" class="size-5" />
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center justify-between gap-2">
                    <h2 class="font-bold text-ink leading-tight truncate">{c.name}</h2>
                    <span data-open-status class="inline-flex items-center gap-1.5 text-xs font-semibold shrink-0"></span>
                  </div>
                  <p class="text-xs text-ink-3 mt-0.5">{c.address}</p>
                  <p class="text-xs text-ink-2 mt-1" data-distance></p>
                </div>
              </div>

              {c.needs.length > 0 && (
                <div class="flex flex-wrap items-center gap-1.5 pt-1">
                  <span class="text-[0.75rem] font-semibold text-ink-3">Necesitan:</span>
                  {c.needs.map((t) => (
                    <span class="blood-chip" data-type={t}>{t}</span>
                  ))}
                </div>
              )}
              <p class="mine hidden text-xs font-bold text-accent-ink">¡Tu tipo de sangre hace falta aquí!</p>

              <div class="mt-auto flex flex-col sm:flex-row gap-2 pt-2 border-t border-line">
                <a
                  class="btn btn-secondary flex-1 text-xs h-9"
                  href={c.mapsUrl || `https://www.google.com/maps/search/?api=1&query=${c.coords[0]},${c.coords[1]}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >Cómo llegar</a>
                <button type="button" data-center-id={c.id} class="btn btn-primary flex-1 text-xs h-9">Ver en mapa</button>
                <a class="btn btn-primary flex-1 text-xs h-9" href={`/donante/donar?centro=${c.id}`}>Donar aquí</a>
              </div>
            </article>
          </li>
        ))}
      </ul>

      <div id="centros-empty" class="hidden py-12 text-center space-y-2">
        <p class="text-2xl">🔎</p>
        <p class="font-bold text-ink">No encontramos centros con esos filtros</p>
        <p class="text-sm text-ink-3">Prueba con otro nombre o ajusta los parámetros de búsqueda.</p>
        <button type="button" id="centros-clear" class="btn btn-secondary btn-sm mt-2">Quitar filtros</button>
      </div>
    </div>

    <!-- Panel interactivo del mapa -->
    <div class="map-pane relative isolate bg-sunken">
      <div id="centros-map" class="blud-map absolute inset-0" role="region" aria-label="Mapa de centros de donación"></div>
      
      <div id="centros-skeleton" class="skeleton absolute inset-0 grid place-items-center" aria-hidden="true">
        <span class="inline-flex items-center gap-2 rounded-control bg-surface px-4 py-2 text-sm font-medium text-ink-2 shadow-sm">
          <Icon name="map-trifold" class="size-4" />
          Cargando mapa
        </span>
      </div>

      <div id="centros-map-error" class="absolute inset-0 hidden place-items-center p-8 text-center">
        <div>
          <p class="font-semibold text-ink">No pudimos cargar el mapa interactivo</p>
          <p class="mt-1 text-sm text-ink-3">Usa el botón «Cómo llegar» de cada centro para ubicarlo en Google Maps.</p>
        </div>
      </div>

      <button
        type="button"
        id="fit-all"
        class="absolute right-3 top-3 z-[500] inline-flex h-9 items-center gap-2 rounded-control border border-line bg-surface px-3 text-xs font-semibold text-ink shadow-md hover:bg-sunken"
      >
        <Icon name="map-trifold" class="size-4 text-ink-3" />
        Ver todos
      </button>
    </div>
  </section>

  <ScheduleDialog />
</LayoutDonante>

<style>
  @media (min-width: 1024px) {
    .centros-app {
      display: grid;
      grid-template-columns: minmax(22rem, 27rem) 1fr;
      grid-template-rows: auto minmax(0, 1fr);
      grid-template-areas:
        "head map"
        "list map";
      height: calc(100dvh - var(--header-h));
    }
    .centros-head { grid-area: head; }
    .list-pane { grid-area: list; }
    .map-pane { grid-area: map; }
  }

  @media (max-width: 1023px) {
    .map-pane {
      height: calc(100dvh - var(--header-h) - 3.75rem);
      min-height: 22rem;
    }
    .centros-app[data-view="list"] .map-pane {
      position: absolute;
      left: -200vw;
      width: 100vw;
      visibility: hidden;
    }
    .centros-app[data-view="map"] .list-pane {
      display: none;
    }
  }

  .chip-row { scrollbar-width: none; }
  .chip-row::-webkit-scrollbar { display: none; }
  
  input:checked + :global(.chip) {
    border-color: var(--color-blud-flag-red, var(--ink));
    background: var(--color-blud-flag-red, var(--ink));
    color: #fff;
  }

  .segmented {
    display: inline-flex;
    padding: 3px;
    border-radius: var(--radius-control);
    background: var(--sunken);
    border: 1px solid var(--line);
  }
  .segmented-full { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
  .segmented button {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;
    min-height: 2rem; padding: 0 0.75rem; border-radius: 9px;
    font-size: 0.8125rem; font-weight: 600; color: var(--ink-3); transition: all 180ms ease;
  }
  .segmented button[aria-pressed="true"] {
    background: var(--surface); color: var(--ink);
    box-shadow: 0 1px 2px hsl(var(--shadow-tint) / 0.12), 0 0 0 1px var(--line);
  }

  .blood-chip { padding: 0.15rem 0.55rem; border-radius: 9999px; background: var(--accent-soft); color: var(--accent-ink); font-size: 0.75rem; font-weight: 800; }
  .blood-chip[data-mine="true"] { background: var(--color-blud-flag-red); color: #fff; animation: beat 1.6s ease-in-out infinite; }
  @keyframes beat { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.18); } 30% { transform: scale(1); } }

  :global([data-open-status])::before { content: ""; width: 0.5rem; height: 0.5rem; border-radius: 999px; background: var(--ink-3); }
  :global([data-open-status][data-open="true"]) { color: var(--ok); }
  :global([data-open-status][data-open="true"])::before { background: var(--ok); }
</style>

<script>
  import {
    centerIcon,
    createMap,
    distanceKm,
    formatKm,
    loadLeaflet,
    openStatus,
    popupHtml,
    popupOptions,
    userIcon,
  } from '../../lib/map';
  import { getDonor, toast } from '../../lib/donante';
  import type { HealthCenter } from '../../data/centers';

  const app = document.getElementById('centros-app') as HTMLElement;
  const centers: HealthCenter[] = JSON.parse(app.dataset.centers || '[]');
  const byId = new Map(centers.map((c) => [c.id, c]));

  const list = document.getElementById('centros-list') as HTMLUListElement;
  const items = Array.from(list.querySelectorAll<HTMLElement>('[data-center-item]'));
  const search = document.getElementById('centros-search') as HTMLInputElement;
  const openNow = document.getElementById('open-now') as HTMLInputElement;
  const filterNeedMine = document.getElementById('filter-need-mine') as HTMLInputElement;
  const countEl = document.getElementById('centros-count')!;
  const countLabel = document.getElementById('centros-count-label')!;
  const emptyState = document.getElementById('centros-empty')!;
  const locateBtn = document.getElementById('locate-btn') as HTMLButtonElement;
  const locateStatus = document.getElementById('locate-status')!;
  const sortButtons = document.querySelectorAll<HTMLButtonElement>('[data-sort]');
  const viewButtons = document.querySelectorAll<HTMLButtonElement>('[data-view-btn]');
  const mapEl = document.getElementById('centros-map') as HTMLElement;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const isDesktop = window.matchMedia('(min-width: 1024px)');

  const donor = getDonor();
  const sangre: string = donor.sangre ?? '';

  let map: any = null;
  let L: any = null;
  let userMarker: any = null;
  let userCoords: [number, number] | null = null;
  let sortMode: 'name' | 'distance' = 'name';
  const markers: Record<string, any> = {};

  // Marca los centros que necesitan el tipo de sangre del donante
  items.forEach((item) => {
    const needs = (item.dataset.needs ?? '').split(',').filter(Boolean);
    const mine = !!sangre && needs.includes(sangre);
    item.dataset.mine = String(mine);
    item.querySelector('.mine')?.classList.toggle('hidden', !mine);
    item.querySelectorAll<HTMLElement>('.blood-chip').forEach((b) => (b.dataset.mine = String(b.dataset.type === sangre)));
  });

  const openState: Record<string, boolean> = {};
  function refreshOpenStatus() {
    items.forEach((item) => {
      const center = byId.get(item.dataset.centerItem || '');
      const el = item.querySelector<HTMLElement>('[data-open-status]');
      if (!center || !el) return;
      const status = openStatus(center);
      openState[center.id] = status.open;
      el.textContent = status.label;
      el.dataset.open = String(status.open);
    });
  }

  const selectedKind = () => (document.querySelector<HTMLInputElement>('input[name="kind"]:checked')?.value ?? 'all');

  function visibleIds(): string[] {
    const query = search.value.toLowerCase().trim();
    const kind = selectedKind();
    const onlyMine = filterNeedMine.checked;

    return items
      .filter((item) => {
        const matchesText = (item.dataset.search || '').includes(query);
        const matchesKind = kind === 'all' || item.dataset.kind === kind;
        const matchesOpen = !openNow.checked || openState[item.dataset.centerItem || ''];
        const matchesMine = !onlyMine || item.dataset.mine === 'true';
        return matchesText && matchesKind && matchesOpen && matchesMine;
      })
      .map((item) => item.dataset.centerItem as string);
  }

  function applyFilters({ fit = true } = {}) {
    const ids = new Set(visibleIds());
    items.forEach((item) => {
      const id = item.dataset.centerItem as string;
      const show = ids.has(id);
      item.classList.toggle('hidden', !show);
      const marker = markers[id];
      if (marker && map) {
        if (show && !map.hasLayer(marker)) map.addLayer(marker);
        if (!show && map.hasLayer(marker)) map.removeLayer(marker);
      }
    });
    countEl.textContent = String(ids.size);
    countLabel.textContent = ids.size === 1 ? 'centro' : 'centros';
    emptyState.classList.toggle('hidden', ids.size > 0);
    if (fit) fitTo([...ids]);
  }

  function applySort() {
    const ordered = [...items].sort((a, b) => {
      if (sortMode === 'distance' && userCoords) {
        const ca = byId.get(a.dataset.centerItem || '')!;
        const cb = byId.get(b.dataset.centerItem || '')!;
        return distanceKm(userCoords, ca.coords) - distanceKm(userCoords, cb.coords);
      }
      return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'es');
    });
    ordered.forEach((item) => list.appendChild(item));
    sortButtons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.sort === sortMode)));
  }

  function setStatus(message: string, tone: 'ok' | 'warn' | null) {
    locateStatus.textContent = message;
    locateStatus.classList.toggle('hidden', !tone);
    locateStatus.classList.toggle('bg-ok-soft', tone === 'ok');
    locateStatus.classList.toggle('text-ok', tone === 'ok');
    locateStatus.classList.toggle('bg-warn-soft', tone === 'warn');
    locateStatus.classList.toggle('text-warn', tone === 'warn');
  }

  function setLocating(busy: boolean) {
    locateBtn.disabled = busy;
    locateBtn.querySelector('[data-locate-icon]')?.classList.toggle('hidden', busy);
    locateBtn.querySelector('[data-locate-spinner]')?.classList.toggle('hidden', !busy);
  }

  function locate() {
    if (!('geolocation' in navigator)) return toast('Tu navegador no permite obtener la ubicación.');
    setLocating(true);
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        setLocating(false);
        userCoords = [pos.coords.latitude, pos.coords.longitude];
        items.forEach((item) => {
          const center = byId.get(item.dataset.centerItem || '')!;
          const el = item.querySelector<HTMLElement>('[data-distance]');
          if (el) el.textContent = `📍 a ${formatKm(distanceKm(userCoords!, center.coords))}`;
        });
        sortMode = 'distance';
        applySort();
        const nearest = byId.get(list.querySelector<HTMLElement>('[data-center-item]:not(.hidden)')?.dataset.centerItem || '');
        setStatus(nearest ? `El más cercano es ${nearest.name}.` : 'Ubicación obtenida.', 'ok');
        if (map && L) {
          userMarker?.remove();
          userMarker = L.marker(userCoords, { icon: userIcon(L), title: 'Tu ubicación', keyboard: false, zIndexOffset: 1000 }).addTo(map);
          fitTo(visibleIds(), true);
        }
      },
      () => {
        setLocating(false);
        toast('No pudimos obtener tu ubicación.');
      },
      { enableHighAccuracy: false, timeout: 10000 }
    );
  }

  function setSelected(id: string | null) {
    items.forEach((item) => {
      item.querySelector('[data-center-id]')?.setAttribute('aria-pressed', String(item.dataset.centerItem === id));
    });
    Object.entries(markers).forEach(([markerId, marker]) => {
      marker.getElement()?.classList.toggle('is-selected', markerId === id);
    });
  }

  function fitTo(ids: string[], includeUser = false) {
    if (!map || !L) return;
    const points = ids.map((id) => byId.get(id)!.coords);
    if (includeUser && userCoords) points.push(userCoords);
    if (!points.length) return;
    if (points.length === 1) map.setView(points[0], 15, { animate: !reduceMotion.matches });
    else map.fitBounds(L.latLngBounds(points), { padding: [48, 48], maxZoom: 15, animate: !reduceMotion.matches });
  }

  function focusCenter(id: string) {
    const center = byId.get(id);
    setSelected(id);
    if (!center || !map || !markers[id]) return;
    map.flyTo(center.coords, 15, { duration: reduceMotion.matches ? 0 : 0.9 });
    markers[id].openPopup();
  }

  function initMap() {
    map = createMap(L, mapEl, { zoom: 12, attribution: 'bottomleft' });
    centers.forEach((center) => {
      const marker = L.marker(center.coords, { icon: centerIcon(L), title: center.name, alt: center.name }).addTo(map);
      
      const customPopup = `
        <div class="p-1 space-y-2">
          <p class="font-bold text-sm text-ink">${center.name}</p>
          <p class="text-xs text-ink-3">${center.address}</p>
          <a href="/donante/donar?centro=${center.id}" class="btn btn-primary btn-sm text-xs w-full">Donar aquí</a>
        </div>
      `;

      marker.bindPopup(customPopup, popupOptions);
      marker.on('click', () => {
        setSelected(center.id);
        if (isDesktop.matches) {
          list.querySelector(`[data-center-item="${center.id}"]`)?.scrollIntoView({
            behavior: reduceMotion.matches ? 'auto' : 'smooth',
            block: 'nearest',
          });
        }
      });
      markers[center.id] = marker;
    });
    map.on('popupclose', () => setSelected(null));
    document.getElementById('centros-skeleton')?.classList.add('hidden');
    applyFilters();
  }

  function setView(view: 'list' | 'map') {
    app.dataset.view = view;
    viewButtons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.viewBtn === view)));
    if (view === 'map') {
      requestAnimationFrame(() => map?.invalidateSize());
    }
  }

  search.addEventListener('input', () => applyFilters());
  document.querySelectorAll('input[name="kind"], #open-now').forEach((input) =>
    input.addEventListener('change', () => applyFilters())
  );

  filterNeedMine.addEventListener('change', () => {
    if (filterNeedMine.checked && !sangre) {
      filterNeedMine.checked = false;
      toast('Primero elige tu tipo de sangre en tu perfil 🩸');
      return;
    }
    applyFilters();
  });

  document.getElementById('centros-clear')?.addEventListener('click', () => {
    search.value = '';
    openNow.checked = false;
    filterNeedMine.checked = false;
    const all = document.querySelector<HTMLInputElement>('input[name="kind"][value="all"]');
    if (all) all.checked = true;
    applyFilters();
    search.focus();
  });

  sortButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      if (btn.dataset.sort === 'distance' && !userCoords) {
        sortMode = 'distance';
        locate();
        return;
      }
      sortMode = btn.dataset.sort as 'name' | 'distance';
      applySort();
    })
  );

  locateBtn.addEventListener('click', locate);
  document.getElementById('fit-all')?.addEventListener('click', () => fitTo(visibleIds(), true));
  viewButtons.forEach((btn) => btn.addEventListener('click', () => setView(btn.dataset.viewBtn as 'list' | 'map')));

  items.forEach((item) => {
    const id = item.dataset.centerItem as string;
    item.querySelector('[data-center-id]')?.addEventListener('click', () => {
      if (!isDesktop.matches) setView('map');
      requestAnimationFrame(() => focusCenter(id));
    });
    item.addEventListener('pointerenter', () => markers[id]?.getElement()?.classList.add('is-hovered'));
    item.addEventListener('pointerleave', () => markers[id]?.getElement()?.classList.remove('is-hovered'));
  });

  refreshOpenStatus();
  applyFilters({ fit: false });

  loadLeaflet()
    .then((leaflet) => {
      L = leaflet;
      initMap();
    })
    .catch(() => {
      document.getElementById('centros-skeleton')?.classList.add('hidden');
      const error = document.getElementById('centros-map-error');
      error?.classList.remove('hidden');
      error?.classList.add('grid');
    });
</script>