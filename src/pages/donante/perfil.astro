---
// src/pages/donante/perfil.astro
import LayoutDonante from '../../layouts/LayoutDonante.astro';
import DonorCard from '../../components/app/DonorCard.astro';
const bloodTypes = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
---

<LayoutDonante title="BLUD | Mi perfil de donante">
  <div class="container-blud py-8 space-y-8" data-profile>
    <div class="pb-6 border-b border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">
          ¡Hola, <span class="text-accent" data-d="firstname">donante</span>!
        </h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">
          Gestiona tu carnet digital, verifica tu identidad y mantén tus datos al día.
        </p>
      </div>
      <a href="/donante/donar" class="btn btn-primary self-start sm:self-auto">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
        Quiero donar sangre
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Índice lateral de opciones estilo Facebook -->
      <aside class="lg:col-span-4 panel p-4 space-y-1" role="tablist" aria-label="Opciones del perfil">
        <button type="button" class="w-full flex items-center gap-3 px-4 py-3 rounded-control font-semibold text-sm text-left transition-colors text-ink bg-sunken" data-vista="carnet" role="tab" aria-selected="true">
          <svg viewBox="0 0 24 24" class="size-5 text-ink-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
          <div>
            <p class="font-bold text-ink">Mi carnet digital</p>
            <p class="text-xs text-ink-3 font-normal">QR y estadísticas de donación</p>
          </div>
        </button>

        <button type="button" class="w-full flex items-center gap-3 px-4 py-3 rounded-control font-semibold text-sm text-left transition-colors text-ink-2 hover:bg-sunken" data-vista="datos" role="tab" aria-selected="false">
          <svg viewBox="0 0 24 24" class="size-5 text-ink-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <div>
            <p class="font-bold text-ink">Datos personales</p>
            <p class="text-xs text-ink-3 font-normal">Edita tu información y perfil</p>
          </div>
        </button>

        <button type="button" class="w-full flex items-center gap-3 px-4 py-3 rounded-control font-semibold text-sm text-left transition-colors text-ink-2 hover:bg-sunken" data-vista="kyc" role="tab" aria-selected="false">
          <svg viewBox="0 0 24 24" class="size-5 text-ink-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <div>
            <p class="font-bold text-ink">Verificación de identidad</p>
            <p class="text-xs text-ink-3 font-normal">Estado de tu cuenta KYC</p>
          </div>
        </button>
      </aside>

      <!-- Contenido de las secciones -->
      <div class="lg:col-span-8 space-y-6">
        <!-- Sección: Carnet Digital -->
        <div data-frame="carnet" class="space-y-6">
          <section id="req-panel" class="hidden panel p-6 sm:p-8 space-y-4 border-l-4 border-accent" aria-labelledby="h-req">
            <div class="flex items-start gap-4">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-accent-soft text-accent-ink" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              </span>
              <div class="min-w-0 flex-1">
                <h2 id="h-req" class="text-lg font-bold text-ink">Completa tu perfil para poder donar</h2>
                <p class="text-sm text-ink-3 mt-0.5">El banco de sangre necesita estos datos antes de tu primera cita.</p>
              </div>
            </div>
            <ul id="req-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></ul>
            <div class="flex justify-end">
              <button type="button" class="btn btn-primary" data-ir-datos>Completar mis datos</button>
            </div>
          </section>

          <section class="panel p-6 sm:p-8 space-y-5 w-full" aria-label="Carnet de donante">
            <div class="scene" id="carnet-scene">
              <div class="tilt" id="carnet-tilt">
                <div class="carnet" id="carnet" data-flipped="false">
                  <!-- Frente -->
                  <div class="face front" id="face-front">
                    <span class="blob blob-a" aria-hidden="true"></span>
                    <span class="blob blob-b" aria-hidden="true"></span>
                    <span class="shine" aria-hidden="true"></span>

                    <div class="relative flex items-start justify-between">
                      <div class="flex items-center gap-2">
                        <span class="grid size-8 place-items-center rounded-full bg-white/20">
                          <svg viewBox="0 0 24 24" class="size-4 text-white" fill="currentColor" aria-hidden="true"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
                        </span>
                        <div class="leading-tight">
                          <p class="text-sm font-extrabold tracking-tight">BLUD</p>
                          <p class="text-[0.625rem] font-semibold uppercase tracking-widest text-white/75">Carnet de donante</p>
                        </div>
                      </div>
                      <span class="kyc-chip" data-kyc-chip data-state="none">Sin verificar</span>
                    </div>

                    <div class="relative flex items-center gap-3 mt-5">
                      <span class="relative grid size-16 shrink-0 place-items-center overflow-hidden rounded-full bg-white text-lg font-extrabold text-blud-flag-red shadow-lg ring-4 ring-white/25">
                        <span data-d="initials">?</span>
                        <img data-foto alt="Foto del donante" class="absolute inset-0 size-full object-cover" hidden />
                      </span>
                      <div class="min-w-0">
                        <p class="truncate text-lg font-extrabold leading-tight" data-d="fullname">Donante BLUD</p>
                        <p class="text-xs font-medium text-white/80">ID <span class="font-mono tracking-wider" data-d="id">BLD-000000</span></p>
                      </div>
                    </div>

                    <div class="relative mt-auto flex items-end justify-between gap-3 pt-5">
                      <div class="flex items-end gap-4">
                        <div>
                          <p class="text-[0.625rem] font-semibold uppercase tracking-widest text-white/75">Sangre</p>
                          <p class="blood text-4xl font-black leading-none" data-d="sangre">—</p>
                        </div>
                        <div class="pb-0.5">
                          <p class="text-[0.625rem] font-semibold uppercase tracking-widest text-white/75">Cédula</p>
                          <p class="font-mono text-sm font-semibold" data-d="cedula-mask">—</p>
                          <p class="mt-1.5 text-[0.625rem] font-semibold uppercase tracking-widest text-white/75">Desde</p>
                          <p class="text-sm font-semibold" data-d="since">—</p>
                        </div>
                      </div>
                      <div class="qr-tile size-24 shrink-0" data-qr role="img" aria-label="Código QR del donante"></div>
                    </div>
                  </div>

                  <!-- Reverso -->
                  <div class="face back" id="face-back" aria-hidden="true">
                    <span class="blob blob-a" aria-hidden="true"></span>
                    <span class="shine" aria-hidden="true"></span>
                    <div class="relative flex flex-1 flex-col items-center justify-center text-center gap-3">
                      <div class="qr-tile size-40" data-qr role="img" aria-label="Código QR ampliado del donante"></div>
                      <p class="text-sm font-bold">Muestra este código en el centro</p>
                      <p class="text-xs text-white/80 max-w-[17rem]">Quien lo escanee verá tu foto, nombre, cédula, ID, teléfono y tipo de sangre. El personal de salud ve tu ficha completa.</p>
                      <p class="font-mono text-xs tracking-widest text-white/90" data-d="id">BLD-000000</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <button type="button" id="flip-btn" class="btn btn-secondary w-full" aria-pressed="false">
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
              <span id="flip-label">Ver el QR grande</span>
            </button>
          </section>

          <!-- Estadísticas -->
          <section class="panel p-6 sm:p-8 space-y-4 w-full">
            <h2 class="text-lg font-bold text-ink border-b border-line pb-3">Tus estadísticas</h2>
            <div class="grid grid-cols-2 gap-4 text-center">
              <div class="p-4 rounded-control bg-sunken">
                <span class="block text-3xl font-extrabold text-ink tabular" data-count="donaciones">0</span>
                <span class="text-xs font-semibold text-ink-3 uppercase">Donaciones</span>
              </div>
              <div class="p-4 rounded-control bg-sunken">
                <span class="block text-3xl font-extrabold text-ink tabular" data-count="vidas">0</span>
                <span class="text-xs font-semibold text-ink-3 uppercase">Vidas ayudadas*</span>
              </div>
            </div>
            <p class="text-xs text-ink-3 text-center">*Cada donación puede ayudar hasta a 3 personas.</p>
          </section>
        </div>

        <!-- Sección: Datos Personales -->
        <div data-frame="datos" class="hidden">
          <section class="panel p-6 sm:p-8 space-y-6 w-full">
            <div class="border-b border-line pb-4">
              <h2 class="text-lg font-bold text-ink">Mis datos</h2>
              <p class="text-xs sm:text-sm text-ink-3">Lo que cambies aquí se actualiza al instante en tu carnet.</p>
            </div>

            <form id="donor-form" class="space-y-4" novalidate>
              <p class="text-xs text-ink-3">Los campos con <span class="text-accent">*</span> son obligatorios para poder donar.</p>
              <div class="flex flex-col sm:flex-row sm:items-center gap-4 rounded-control bg-sunken p-4">
                <span class="relative grid size-20 shrink-0 place-items-center overflow-hidden rounded-full bg-accent-soft text-2xl font-extrabold text-accent-ink ring-4 ring-surface">
                  <span data-d="initials">?</span>
                  <img data-foto alt="Tu foto" class="absolute inset-0 size-full object-cover" hidden />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="font-bold text-ink">Foto del carnet <span class="text-accent">*</span></p>
                  <p class="text-xs text-ink-3 mt-0.5">De frente, con buena luz, sin lentes oscuros ni gorra. El personal la usa para confirmar que eres tú.</p>
                </div>
                <label for="foto-input" class="btn btn-secondary shrink-0 cursor-pointer self-start sm:self-auto" id="foto-btn" tabindex="0">
                  <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
                  <span id="foto-btn-txt">Subir foto</span>
                </label>
                <input type="file" id="foto-input" accept="image/jpeg,image/png,image/webp" class="sr-only" tabindex="-1" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="firstname" class="block text-xs font-bold uppercase tracking-wider text-ink-2">Nombres <span class="text-accent">*</span></label>
                  <input type="text" id="firstname" name="firstname" class="field" autocomplete="given-name" required />
                  <p class="hidden text-xs font-medium text-accent-ink" id="err-firstname" role="alert"></p>
                </div>
                <div class="space-y-1.5">
                  <label for="lastname" class="block text-xs font-bold uppercase tracking-wider text-ink-2">Apellidos <span class="text-accent">*</span></label>
                  <input type="text" id="lastname" name="lastname" class="field" autocomplete="family-name" required />
                  <p class="hidden text-xs font-medium text-accent-ink" id="err-lastname" role="alert"></p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="email" class="block text-xs font-bold uppercase tracking-wider text-ink-2">Correo electrónico</label>
                  <input type="email" id="email" name="email" class="field" autocomplete="email" required />
                  <p class="hidden text-xs font-medium text-accent-ink" id="err-email" role="alert"></p>
                  <p class="hidden text-xs text-ink-3" id="email-lock">Es el correo con el que inicias sesión.</p>
                </div>
                <div class="space-y-1.5">
                  <label for="telefono" class="block text-xs font-bold uppercase tracking-wider text-ink-2">Teléfono <span class="text-accent">*</span></label>
                  <input type="tel" id="telefono" name="telefono" class="field" autocomplete="tel" placeholder="+58 414 1234567" />
                  <p class="hidden text-xs font-medium text-accent-ink" id="err-telefono" role="alert"></p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="cedula" class="block text-xs font-bold uppercase tracking-wider text-ink-2">Cédula <span class="text-accent">*</span></label>
                  <div class="flex gap-2">
                    <select id="cedula-tipo" name="cedula-tipo" class="field w-24 shrink-0" aria-label="Tipo de cédula">
                      <option value="V">V-</option>
                      <option value="E">E-</option>
                    </select>
                    <input type="text" id="cedula" name="cedula" class="field min-w-0 flex-1" inputmode="numeric" pattern="[0-9]*" maxlength="9" placeholder="12345678" autocomplete="off" aria-describedby="cedula-ayuda" />
                  </div>
                  <p class="hidden text-xs font-medium text-accent-ink" id="err-cedula" role="alert"></p>
                  <p class="text-xs text-ink-3" id="cedula-ayuda">V: venezolano · E: extranjero residente.</p>
                  <p class="hidden text-xs text-ink-3" id="cedula-lock">Verificada: para cambiarla, contacta a soporte.</p>
                </div>
                <div class="space-y-1.5">
                  <label for="nacimiento" class="block text-xs font-bold uppercase tracking-wider text-ink-2">Fecha de nacimiento <span class="text-accent">*</span></label>
                  <input type="date" id="nacimiento" name="nacimiento" class="field" autocomplete="bday" />
                  <p class="hidden text-xs font-medium text-accent-ink" id="err-nacimiento" role="alert"></p>
                </div>
                <div class="space-y-1.5">
                  <label for="sexo" class="block text-xs font-bold uppercase tracking-wider text-ink-2">Sexo <span class="text-accent">*</span></label>
                  <select id="sexo" name="sexo" class="field">
                    <option value="">Selecciona…</option>
                    <option value="F">Femenino</option>
                    <option value="M">Masculino</option>
                  </select>
                  <p class="hidden text-xs font-medium text-accent-ink" id="err-sexo" role="alert"></p>
                  <p class="text-xs text-ink-3">Define el tiempo de espera entre donaciones (90 o 120 días).</p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="sangre" class="block text-xs font-bold uppercase tracking-wider text-ink-2">Tipo de sangre <span class="text-accent">*</span></label>
                  <select id="sangre" name="sangre" class="field">
                    <option value="">Selecciona…</option>
                    {bloodTypes.map((t) => <option value={t}>{t}</option>)}
                  </select>
                  <p class="hidden text-xs font-medium text-accent-ink" id="err-sangre" role="alert"></p>
                </div>
                <div class="space-y-1.5">
                  <label for="ciudad" class="block text-xs font-bold uppercase tracking-wider text-ink-2">Ciudad</label>
                  <input type="text" id="ciudad" name="ciudad" class="field" autocomplete="address-level2" placeholder="Maracaibo" />
                  <p class="hidden text-xs font-medium text-accent-ink" id="err-ciudad" role="alert"></p>
                </div>
              </div>

              <p class="hidden rounded-control bg-accent-soft px-3 py-2 text-sm font-medium text-accent-ink" id="form-error" role="alert"></p>

              <div class="flex justify-center pt-2">
                <button type="submit" class="btn btn-primary w-full sm:w-auto sm:px-12 min-h-12">Guardar cambios</button>
              </div>
            </form>
          </section>
        </div>

        <!-- Sección: Verificación de Identidad (KYC) -->
        <div data-frame="kyc" class="hidden">
          <section class="panel p-6 sm:p-8 space-y-4 w-full" id="kyc-panel" data-kyc="none">
            <h2 class="text-lg font-bold text-ink border-b border-line pb-3">Verificación de identidad</h2>
            <div class="flex flex-col sm:flex-row sm:items-center gap-5 pt-2">
              <span class="kyc-badge grid size-14 shrink-0 place-items-center rounded-full" data-kyc-icon data-state="none">
                <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4" data-check/></svg>
              </span>
              <div class="flex-1 min-w-0">
                <h3 class="text-lg font-bold text-ink" data-kyc-title>Verifica tu identidad</h3>
                <p class="text-sm text-ink-3 mt-0.5" data-kyc-text>
                  Así los centros saben que eres tú y tu carnet queda con el sello de verificado. Toma menos de 2 minutos.
                </p>
              </div>
              <button type="button" id="kyc-open" class="btn btn-primary shrink-0">Verificar ahora</button>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ Diálogo KYC ============ -->
  <dialog id="kyc-dialog" class="kyc-dialog" aria-labelledby="kyc-title">
    <form method="dialog" id="kyc-form" class="flex max-h-[90vh] flex-col" novalidate>
      <div class="flex items-center justify-between gap-4 border-b border-line px-6 py-4">
        <div>
          <h2 id="kyc-title" class="text-lg font-extrabold text-ink">Verificación de identidad</h2>
          <p class="text-xs text-ink-3">Paso <span id="kyc-step-n">1</span> de 3</p>
        </div>
        <button type="button" data-kyc-cancel class="grid size-8 place-items-center rounded-control text-ink-3 hover:bg-sunken hover:text-ink transition-colors cursor-pointer" aria-label="Cerrar">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="flex gap-2 px-6 pt-4" aria-hidden="true">
        <span class="dot" data-dot="1"></span><span class="dot" data-dot="2"></span><span class="dot" data-dot="3"></span>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto px-6 py-5">
        <!-- Paso 1 -->
        <div data-step="1" class="step space-y-4">
          <h3 class="font-bold text-ink">Foto de tu cédula</h3>
          <p class="text-sm text-ink-3">Busca buena luz y asegúrate de que se lean tus datos y se vea la foto.</p>
          <label class="drop" for="kyc-front">
            <img alt="Vista previa de tu cédula" class="drop-img" hidden data-preview="front" />
            <span class="drop-empty" data-empty="front">
              <svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="8" cy="12" r="2.5"/><path d="M14 10h5M14 14h4"/></svg>
              <span class="text-sm font-semibold">Toca para subir o tomar la foto</span>
            </span>
          </label>
          <input type="file" id="kyc-front" name="front" accept="image/*" capture="environment" class="sr-only" />
        </div>

        <!-- Paso 2 -->
        <div data-step="2" class="step space-y-4" hidden>
          <h3 class="font-bold text-ink">Un selfie rápido</h3>
          <p class="text-sm text-ink-3">Mira de frente a la cámara, sin lentes ni gorra. Es para comprobar que la cédula es tuya.</p>
          <label class="drop drop-round" for="kyc-selfie">
            <img alt="Vista previa de tu selfie" class="drop-img" hidden data-preview="selfie" />
            <span class="drop-empty" data-empty="selfie">
              <svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
              <span class="text-sm font-semibold">Toca para tomar tu selfie</span>
            </span>
          </label>
          <input type="file" id="kyc-selfie" name="selfie" accept="image/*" capture="user" class="sr-only" />
        </div>

        <!-- Paso 3 -->
        <div data-step="3" class="step space-y-4" hidden>
          <h3 class="font-bold text-ink">Todo listo para enviar</h3>
          <p class="text-sm text-ink-3">Revisaremos tus fotos y te avisaremos cuando tu carnet esté verificado.</p>
          <div class="grid grid-cols-2 gap-3">
            <img alt="Tu cédula" class="h-28 w-full rounded-control border border-line object-cover" data-summary="front" />
            <img alt="Tu selfie" class="h-28 w-full rounded-control border border-line object-cover" data-summary="selfie" />
          </div>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" id="kyc-consent" class="size-4 mt-1 rounded text-accent border-line-strong focus:ring-accent" />
            <span class="text-sm text-ink-2">Autorizo a BLUD a usar estas imágenes solo para verificar mi identidad.</span>
          </label>
        </div>
      </div>

      <div class="flex items-center justify-between gap-3 border-t border-line px-6 py-4">
        <button type="button" class="btn btn-secondary" id="kyc-back" hidden>Atrás</button>
        <button type="button" class="btn btn-primary ml-auto" id="kyc-next" disabled>Continuar</button>
      </div>
    </form>
  </dialog>

  <div id="toast" class="toast" role="status" aria-live="polite" data-show="false"></div>
</LayoutDonante>

<style>
  /* ---------- Carnet ---------- */
  .scene { perspective: 1100px; max-width: 28rem; margin-inline: auto; }
  .tilt {
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 180ms ease-out;
  }
  .carnet {
    display: grid;
    transform-style: preserve-3d;
    transition: transform 750ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .carnet[data-flipped="true"] { transform: rotateY(180deg); }

  .face {
    grid-area: 1 / 1;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 15.5rem;
    padding: 1.25rem;
    border-radius: 1.5rem;
    overflow: hidden;
    color: #fff;
    background: linear-gradient(135deg, var(--color-blud-flag-red) 0%, var(--color-blud-flag-red) 35%, var(--color-blud-oxblood) 100%);
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.25);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .back { transform: rotateY(180deg); background: linear-gradient(315deg, var(--color-blud-flag-red) 0%, var(--color-blud-oxblood) 100%); }

  .blob { position: absolute; border-radius: 9999px; background: rgb(255 255 255 / 0.1); pointer-events: none; }
  .blob-a { width: 14rem; height: 14rem; top: -5rem; right: -4rem; animation: float 9s ease-in-out infinite; }
  .blob-b { width: 9rem; height: 9rem; bottom: -3rem; left: -2rem; animation: float 11s ease-in-out infinite reverse; }
  @keyframes float { 50% { transform: translate(-10px, 12px) scale(1.06); } }

  .shine {
    position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 250ms;
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 0%), rgb(255 255 255 / 0.28), transparent 55%);
  }
  .scene:hover .shine { opacity: 1; }

  .blood { text-shadow: 0 2px 12px rgb(0 0 0 / 0.25); animation: beat 1.8s ease-in-out infinite; transform-origin: left center; }
  @keyframes beat {
    0%, 100% { transform: scale(1); }
    12% { transform: scale(1.12); }
    24% { transform: scale(1); }
    36% { transform: scale(1.07); }
    48% { transform: scale(1); }
  }

  .qr-tile { display: grid; place-items: center; padding: 0.4rem; border-radius: 0.75rem; background: #fff; box-shadow: 0 6px 16px -6px rgb(0 0 0 / 0.4); }
  .qr-tile :global(svg) { width: 100%; height: 100%; display: block; }

  /* Chip de verificación */
  .kyc-chip {
    display: inline-flex; align-items: center; gap: 0.25rem;
    padding: 0.2rem 0.6rem; border-radius: 9999px;
    font-size: 0.6875rem; font-weight: 700;
    background: rgb(255 255 255 / 0.2); color: #fff;
  }
  .kyc-chip[data-state="verified"] { background: #fff; color: #15803d; }
  .kyc-chip[data-state="review"] { background: #fef3c7; color: #92400e; }

  /* Insignia KYC del panel */
  .kyc-badge[data-state="none"] { background: var(--accent-soft); color: var(--accent-ink); }
  .kyc-badge[data-state="review"] { background: #fef3c7; color: #92400e; }
  .kyc-badge[data-state="verified"] { background: #dcfce7; color: #15803d; animation: pop 600ms var(--ease-out, ease-out); }
  .kyc-badge:not([data-state="verified"]) [data-check] { display: none; }
  @keyframes pop { 0% { transform: scale(0.6); } 60% { transform: scale(1.15); } 100% { transform: scale(1); } }

  /* ---------- Diálogo KYC ---------- */
  .kyc-dialog {
    width: min(32rem, calc(100vw - 2rem));
    padding: 0; margin: auto;
    border: 1px solid var(--line); border-radius: 1.5rem;
    background: var(--surface); color: var(--ink);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.45);
  }
  .kyc-dialog[open] { animation: dlg-in 320ms var(--ease-out, ease-out); }
  .kyc-dialog::backdrop { background: rgb(0 0 0 / 0.5); backdrop-filter: blur(4px); }
  @keyframes dlg-in { from { opacity: 0; transform: translateY(16px) scale(0.97); } }

  .dot { height: 0.375rem; flex: 1; border-radius: 9999px; background: var(--line); transition: background 300ms; }
  .dot[data-on="true"] { background: var(--color-blud-flag-red); }

  .step:not([hidden]) { animation: step-in 300ms var(--ease-out, ease-out); }
  @keyframes step-in { from { opacity: 0; transform: translateX(12px); } }

  .drop {
    position: relative; display: grid; place-items: center; overflow: hidden;
    min-height: 11rem; border: 2px dashed var(--line-strong, var(--line)); border-radius: 1rem;
    background: var(--sunken); color: var(--ink-3); cursor: pointer; transition: border-color 200ms, background 200ms;
  }
  .drop:hover, .drop:focus-within { border-color: var(--color-blud-flag-red); }
  .drop-round { width: 13rem; height: 13rem; margin-inline: auto; border-radius: 9999px; }
  .drop-empty { display: grid; justify-items: center; gap: 0.5rem; padding: 1rem; text-align: center; }
  .drop-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* ---------- Toast ---------- */
  .toast {
    position: fixed; left: 50%; bottom: 1.5rem; z-index: 80;
    transform: translate(-50%, 20px); opacity: 0; pointer-events: none;
    padding: 0.75rem 1.25rem; border-radius: 9999px;
    background: var(--ink); color: var(--surface);
    font-size: 0.875rem; font-weight: 600; box-shadow: 0 12px 30px -10px rgb(0 0 0 / 0.5);
    transition: transform 300ms var(--ease-out, ease-out), opacity 300ms;
  }
  .toast[data-show="true"] { transform: translate(-50%, 0); opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .blob, .blood, .kyc-badge, .kyc-dialog[open], .step:not([hidden]) { animation: none !important; }
    .tilt, .carnet { transition: none; }
  }
</style>

<script>
  import QRCode from 'qrcode';
  import {
    cargarFicha, edadDe, guardarPerfil, loadDonor, qrDe, requisitos, subirFoto, urlFoto, toast, type Donor, type Kyc,
  } from '../../lib/donante';
  import { usaSupabase } from '../../lib/supabase';
  import { clearError, emailPattern, setError } from '../../lib/forms';

  const q = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) =>
    root.querySelector<T>(sel);
  const qa = <T extends HTMLElement = HTMLElement>(sel: string, root: ParentNode = document) =>
    Array.from(root.querySelectorAll<T>(sel));

  const fullName = (d: Donor) => `${d.firstname} ${d.lastname}`.trim() || 'Donante BLUD';
  const initialsOf = (d: Donor) =>
    fullName(d).split(/\s+/).slice(0, 2).map((p) => p.charAt(0).toUpperCase()).join('') || '?';
  const maskCedula = (c: string) => (c ? '•••' + c.replace(/\D/g, '').slice(-3) : '—');
  const fmtSince = (iso: string) =>
    iso ? new Date(iso + 'T00:00:00').toLocaleDateString('es-VE', { month: 'short', year: 'numeric' }) : '—';

  const setText = (key: string, value: string) =>
    qa(`[data-d="${key}"]`).forEach((el) => (el.textContent = value));

  let qrToken = 0;
  let qrHecho = '';
  async function renderQR(d: Donor) {
    const payload = qrDe(d);
    if (payload === qrHecho) return;
    const token = ++qrToken;
    try {
      const svg = await QRCode.toString(payload, {
        type: 'svg',
        margin: 0,
        errorCorrectionLevel: 'M',
        color: { dark: '#1f0a0c', light: '#ffffff' },
      });
      if (token !== qrToken) return;
      qrHecho = payload;
      qa('[data-qr]').forEach((el) => (el.innerHTML = svg));
    } catch (err) {
      console.error('No se pudo generar el QR', err);
    }
  }

  let fotoHecha: string | undefined;
  async function renderFoto(d: Donor) {
    if (d.foto === fotoHecha) return;
    fotoHecha = d.foto;
    const url = await urlFoto(d.foto);
    qa<HTMLImageElement>('[data-foto]').forEach((img) => {
      if (url) img.src = url;
      img.hidden = !url;
    });
    const txt = q('#foto-btn-txt');
    if (txt) txt.textContent = url ? 'Cambiar foto' : 'Subir foto';
  }

  const KYC_COPY: Record<Kyc, { chip: string; title: string; text: string; cta: string }> = {
    none: {
      chip: 'Sin verificar',
      title: 'Verifica tu identidad',
      text: 'Así los centros saben que eres tú y tu carnet queda con el sello de verificado. Toma menos de 2 minutos.',
      cta: 'Verificar ahora',
    },
    review: {
      chip: 'En revisión',
      title: 'Estamos revisando tus fotos',
      text: 'Te avisaremos apenas termine la revisión. Mientras tanto puedes usar tu carnet con normalidad.',
      cta: '',
    },
    verified: {
      chip: '✓ Verificado',
      title: '¡Identidad verificada!',
      text: 'Tu carnet tiene el sello de verificado. Ya estás listo para donar.',
      cta: '',
    },
  };

  function renderKyc(d: Donor) {
    const copy = KYC_COPY[d.kyc];
    const chip = q('[data-kyc-chip]');
    if (chip) { chip.textContent = copy.chip; chip.dataset.state = d.kyc; }
    const icon = q('[data-kyc-icon]');
    if (icon) icon.dataset.state = d.kyc;
    const panel = q('#kyc-panel');
    if (panel) panel.dataset.kyc = d.kyc;
    const title = q('[data-kyc-title]'); if (title) title.textContent = copy.title;
    const text = q('[data-kyc-text]'); if (text) text.textContent = copy.text;
    const open = q<HTMLButtonElement>('#kyc-open');
    if (open) { open.hidden = !copy.cta; open.textContent = copy.cta; }

    const cedula = q<HTMLInputElement>('#cedula');
    const lock = q('#cedula-lock');
    const locked = d.kyc === 'verified';
    if (cedula) cedula.disabled = locked;
    const tipo = q<HTMLSelectElement>('#cedula-tipo');
    if (tipo) tipo.disabled = locked;
    lock?.classList.toggle('hidden', !locked);
  }

  function renderRequisitos(d: Donor) {
    const reqs = requisitos(d);
    const falta = reqs.some((r) => !r.ok);
    q('#req-panel')?.classList.toggle('hidden', !falta);
    const list = q('#req-list');
    if (!list) return;
    list.innerHTML = reqs
      .map((r) => `
        <li class="flex items-center gap-2.5 rounded-control px-3 py-2 text-sm ${r.ok ? 'bg-sunken text-ink-3' : 'bg-accent-soft font-semibold text-accent-ink'}">
          <span class="grid size-5 shrink-0 place-items-center rounded-full ${r.ok ? 'bg-ok text-white' : 'border-2 border-current'}" aria-hidden="true">${r.ok ? '<svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg>' : ''}</span>
          <span>${r.label}</span><span class="sr-only">${r.ok ? '(listo)' : '(pendiente)'}</span>
        </li>`)
      .join('');
  }

  function renderCard(d: Donor) {
    setText('firstname', d.firstname || 'donante');
    setText('fullname', fullName(d));
    setText('initials', initialsOf(d));
    setText('id', d.id);
    setText('sangre', d.sangre || '—');
    setText('cedula-mask', maskCedula(d.cedula));
    setText('since', fmtSince(d.since));
    renderQR(d);
    renderFoto(d);
    renderKyc(d);
    renderRequisitos(d);
  }

  function countUp(el: HTMLElement, to: number) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || to === 0) { el.textContent = String(to); return; }
    const start = performance.now();
    const dur = 900;
    const tick = (now: number) => {
      const t = Math.min((now - start) / dur, 1);
      el.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  function init() {
    const root = q<HTMLElement>('[data-profile]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    let donor = loadDonor();

    const form = q<HTMLFormElement>('#donor-form', root)!;
    const fields = ['firstname', 'lastname', 'email', 'telefono', 'cedula', 'nacimiento', 'sexo', 'sangre', 'ciudad'] as const;
    // La cédula se edita en dos partes: tipo (V/E) y número.
    const cedTipo = q<HTMLSelectElement>('#cedula-tipo', root)!;
    const cedNum = q<HTMLInputElement>('#cedula', root)!;
    const setCedula = (c: string) => {
      const m = String(c ?? '').toUpperCase().match(/^([VE])?-?(\d*)/);
      cedTipo.value = m?.[1] ?? 'V';
      cedNum.value = m?.[2] ?? '';
    };
    const getCedula = () => {
      const n = cedNum.value.replace(/\D/g, '');
      return n ? `${cedTipo.value}-${n}` : '';
    };
    cedNum.addEventListener('input', () => {
      const limpio = cedNum.value.replace(/\D/g, '').slice(0, 9);
      if (limpio !== cedNum.value) cedNum.value = limpio;
    });

    const fillForm = (d: Donor) => {
      fields.forEach((f) => {
        const input = form.elements.namedItem(f) as HTMLInputElement | null;
        if (input) input.value = String((d as unknown as Record<string, unknown>)[f] ?? '');
      });
      setCedula(d.cedula);
    };
    const renderStats = (d: Donor) => {
      countUp(q('[data-count="donaciones"]', root)!, d.donaciones);
      countUp(q('[data-count="vidas"]', root)!, d.donaciones * 3);
    };

    // Con base real el correo es el de inicio de sesión: no se cambia desde aquí.
    if (usaSupabase()) {
      const email = form.elements.namedItem('email') as HTMLInputElement;
      email.readOnly = true;
      email.classList.add('opacity-70');
      q('#email-lock', root)?.classList.remove('hidden');
    }

    fillForm(donor);
    renderCard(donor);
    renderStats(donor);

    // La base manda: al abrir el perfil se traen los datos guardados en ella.
    cargarFicha().then((d) => {
      const cambio = JSON.stringify(d) !== JSON.stringify(donor);
      donor = d;
      if (!cambio) return;
      fillForm(d);
      renderCard(d);
      renderStats(d);
    });

    form.addEventListener('input', () => {
      const draft = { ...donor } as Donor;
      fields.forEach((f) => {
        const input = form.elements.namedItem(f) as HTMLInputElement | null;
        if (input && !input.disabled) (draft as unknown as Record<string, string>)[f] = input.value.trim();
      });
      if (!cedNum.disabled) draft.cedula = getCedula();
      renderCard(draft);
    });

    const errorBox = q('#form-error', root)!;
    const fail = (msg: string, field?: string) => {
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
      if (field) (form.elements.namedItem(field) as HTMLElement | null)?.focus();
    };

    // ---------- Validación de cada campo ----------
    type Campo = 'firstname' | 'lastname' | 'email' | 'telefono' | 'cedula' | 'nacimiento' | 'sexo' | 'sangre' | 'ciudad';
    const val = (k: string) => String((form.elements.namedItem(k) as HTMLInputElement | null)?.value ?? '').trim();
    const NOMBRE = /^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ' .-]+$/;
    const REGLAS: Record<Campo, () => string> = {
      firstname: () => {
        const v = val('firstname');
        if (!v) return 'Escribe tus nombres.';
        if (v.length < 2 || !NOMBRE.test(v)) return 'Usa solo letras (mínimo 2).';
        return '';
      },
      lastname: () => {
        const v = val('lastname');
        if (!v) return 'Escribe tus apellidos.';
        if (v.length < 2 || !NOMBRE.test(v)) return 'Usa solo letras (mínimo 2).';
        return '';
      },
      email: () => {
        const v = val('email');
        if (!v) return 'Escribe tu correo electrónico.';
        return emailPattern.test(v) ? '' : 'Escribe un correo válido, por ejemplo nombre@correo.com.';
      },
      telefono: () => {
        const v = val('telefono');
        if (!v) return 'Escribe tu teléfono.';
        if (/[^\d\s+()-]/.test(v)) return 'Usa solo números, espacios y el signo +.';
        const d = v.replace(/\D/g, '');
        if (d.length < 10 || d.length > 13) return 'Revisa el número: por ejemplo +58 414 1234567 o 0414 1234567.';
        return '';
      },
      cedula: () => {
        if (cedNum.disabled) return '';
        const v = cedNum.value.replace(/\D/g, '');
        if (!v) return 'Escribe el número de tu cédula.';
        if (v.length < 6 || v.length > 9) return 'La cédula debe tener entre 6 y 9 dígitos.';
        return '';
      },
      nacimiento: () => {
        const v = val('nacimiento');
        if (!v) return 'Indica tu fecha de nacimiento.';
        const edad = edadDe(v);
        if (edad === null || new Date(v + 'T00:00:00') > new Date()) return 'Revisa la fecha.';
        if (edad < 18) return 'Para donar necesitas tener 18 años o más.';
        if (edad > 65) return 'Para donar debes tener 65 años o menos.';
        return '';
      },
      sexo: () => (val('sexo') ? '' : 'Selecciona tu sexo.'),
      sangre: () => (val('sangre') ? '' : 'Selecciona tu tipo de sangre. Si no lo sabes, aparece en tus exámenes o pregunta en el centro.'),
      ciudad: () => {
        const v = val('ciudad');
        return !v || NOMBRE.test(v) ? '' : 'Usa solo letras.';
      },
    };
    const CAMPOS = Object.keys(REGLAS) as Campo[];
    const inputDe = (k: Campo) => form.elements.namedItem(k) as HTMLElement;
    const errDe = (k: Campo) => q(`#err-${k}`, root)!;
    /** Valida un campo y pinta su error. Devuelve true si está bien. */
    function validar(k: Campo): boolean {
      const msg = REGLAS[k]();
      if (msg) setError(inputDe(k), errDe(k), msg);
      else clearError(inputDe(k), errDe(k));
      return !msg;
    }
    const tocados = new Set<Campo>();
    CAMPOS.forEach((k) => {
      const el = inputDe(k);
      el.setAttribute('aria-describedby', [el.getAttribute('aria-describedby'), `err-${k}`].filter(Boolean).join(' '));
      // Se valida al salir del campo; después, mientras se corrige, en cada cambio.
      el.addEventListener('blur', () => { tocados.add(k); validar(k); });
      el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', () => { if (tocados.has(k)) validar(k); });
    });

    // ---------- Foto ----------
    const fotoInput = q<HTMLInputElement>('#foto-input', root)!;
    const fotoBtn = q('#foto-btn', root)!;
    fotoBtn.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fotoInput.click(); }
    });
    fotoInput.addEventListener('change', async () => {
      const file = fotoInput.files?.[0];
      fotoInput.value = '';
      if (!file) return;
      fotoBtn.setAttribute('aria-busy', 'true');
      fotoBtn.classList.add('opacity-60', 'pointer-events-none');
      const txt = q('#foto-btn-txt', root)!;
      const antes = txt.textContent;
      txt.textContent = 'Subiendo…';
      const res = await subirFoto(file);
      fotoBtn.removeAttribute('aria-busy');
      fotoBtn.classList.remove('opacity-60', 'pointer-events-none');
      txt.textContent = antes;
      if (!res.ok) return toast(res.error);
      donor = { ...donor, foto: res.donor.foto };
      renderCard(donor);
      toast('Foto guardada. Ya aparece en tu carnet.');
    });

    // ---------- Datos ----------
    const submitBtn = q<HTMLButtonElement>('button[type="submit"]', form)!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      const fd = new FormData(form);
      const get = (k: string) => String(fd.get(k) ?? '').trim();

      // Todos los campos a la vez: se marcan los que fallan y se lleva el foco al primero.
      CAMPOS.forEach((k) => tocados.add(k));
      const malos = CAMPOS.filter((k) => !validar(k));
      if (malos.length) {
        fail(malos.length === 1 ? 'Revisa el campo marcado en rojo.' : `Revisa los ${malos.length} campos marcados en rojo.`);
        inputDe(malos[0]).focus();
        return;
      }
      const ced = donor.kyc === 'verified' ? donor.cedula : getCedula();
      const nac = get('nacimiento');

      submitBtn.disabled = true;
      const label = submitBtn.textContent;
      submitBtn.textContent = 'Guardando…';
      const res = await guardarPerfil({
        firstname: get('firstname'),
        lastname: get('lastname'),
        email: get('email'),
        telefono: get('telefono'),
        cedula: donor.kyc === 'verified' ? donor.cedula : ced.toUpperCase(),
        nacimiento: nac,
        sexo: (get('sexo') || undefined) as Donor['sexo'],
        sangre: get('sangre'),
        ciudad: get('ciudad'),
      });
      submitBtn.disabled = false;
      submitBtn.textContent = label;
      if (!res.ok) return fail(res.error);
      donor = res.donor;
      fillForm(donor);
      renderCard(donor);
      toast(res.aviso ?? 'Datos guardados.');
    });

    const carnet = q('#carnet', root)!;
    const flipBtn = q<HTMLButtonElement>('#flip-btn', root)!;
    const flipLabel = q('#flip-label', root)!;
    flipBtn.addEventListener('click', () => {
      const next = carnet.dataset.flipped !== 'true';
      carnet.dataset.flipped = String(next);
      flipBtn.setAttribute('aria-pressed', String(next));
      flipLabel.textContent = next ? 'Ver el frente' : 'Ver el QR grande';
      q('#face-front', root)?.setAttribute('aria-hidden', String(next));
      q('#face-back', root)?.setAttribute('aria-hidden', String(!next));
    });

    const scene = q('#carnet-scene', root)!;
    const tilt = q('#carnet-tilt', root)!;
    const canTilt = matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (canTilt) {
      scene.addEventListener('pointermove', (e) => {
        const r = scene.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        tilt.style.setProperty('--ry', `${(x - 0.5) * 14}deg`);
        tilt.style.setProperty('--rx', `${(0.5 - y) * 14}deg`);
        qa('.shine', scene).forEach((s) => {
          s.style.setProperty('--mx', `${x * 100}%`);
          s.style.setProperty('--my', `${y * 100}%`);
        });
      });
      scene.addEventListener('pointerleave', () => {
        tilt.style.setProperty('--rx', '0deg');
        tilt.style.setProperty('--ry', '0deg');
      });
    }

    // ---------- Verificación de identidad ----------
    const dlg = q<HTMLDialogElement>('#kyc-dialog')!;
    const nextBtn = q<HTMLButtonElement>('#kyc-next', dlg)!;
    const backBtn = q<HTMLButtonElement>('#kyc-back', dlg)!;
    const stepN = q('#kyc-step-n', dlg)!;
    const consent = q<HTMLInputElement>('#kyc-consent', dlg)!;
    const urls: Record<'front' | 'selfie', string | null> = { front: null, selfie: null };
    const files: Record<'front' | 'selfie', File | null> = { front: null, selfie: null };
    let step = 1;

    function canContinue() {
      if (step === 1) return !!files.front;
      if (step === 2) return !!files.selfie;
      return consent.checked;
    }

    function showStep(n: number) {
      step = n;
      stepN.textContent = String(n);
      qa('[data-step]', dlg).forEach((el) => (el.hidden = Number(el.dataset.step) !== n));
      qa('[data-dot]', dlg).forEach((el) => (el.dataset.on = String(Number(el.dataset.dot) <= n)));
      backBtn.hidden = n === 1;
      nextBtn.textContent = n === 3 ? 'Enviar verificación' : 'Continuar';
      nextBtn.disabled = !canContinue();
      if (n === 3) {
        qa<HTMLImageElement>('[data-summary]', dlg).forEach((img) => {
          img.src = urls[img.dataset.summary as 'front' | 'selfie'] ?? '';
        });
      }
    }

    function resetKyc() {
      (['front', 'selfie'] as const).forEach((k) => {
        if (urls[k]) URL.revokeObjectURL(urls[k]!);
        urls[k] = null;
        files[k] = null;
        const img = q<HTMLImageElement>(`[data-preview="${k}"]`, dlg);
        const empty = q(`[data-empty="${k}"]`, dlg);
        if (img) { img.hidden = true; img.removeAttribute('src'); }
        if (empty) empty.hidden = false;
      });
      q<HTMLFormElement>('#kyc-form')?.reset();
      showStep(1);
    }

    (['front', 'selfie'] as const).forEach((k) => {
      const input = q<HTMLInputElement>(k === 'front' ? '#kyc-front' : '#kyc-selfie', dlg)!;
      input.addEventListener('change', () => {
        const file = input.files?.[0];
        if (!file) return;
        if (!file.type.startsWith('image/') || file.size > 8 * 1024 * 1024) {
          input.value = '';
          toast('Sube una imagen de menos de 8 MB.');
          return;
        }
        if (urls[k]) URL.revokeObjectURL(urls[k]!);
        urls[k] = URL.createObjectURL(file);
        files[k] = file;
        const img = q<HTMLImageElement>(`[data-preview="${k}"]`, dlg)!;
        img.src = urls[k]!;
        img.hidden = false;
        q(`[data-empty="${k}"]`, dlg)!.hidden = true;
        nextBtn.disabled = !canContinue();
      });
    });

    consent.addEventListener('change', () => (nextBtn.disabled = !canContinue()));
    backBtn.addEventListener('click', () => showStep(step - 1));

    nextBtn.addEventListener('click', async () => {
      if (step < 3) return showStep(step + 1);
      if (!canContinue()) return;
      nextBtn.disabled = true;
      nextBtn.textContent = 'Enviando…';

      await new Promise((r) => setTimeout(r, 900));

      // El sello definitivo lo pone el personal al escanear el QR en el centro.
      donor = { ...loadDonor(), kyc: 'review' };
      try { localStorage.setItem('blud-donor', JSON.stringify(donor)); } catch {}
      renderCard(donor);
      dlg.close();
      resetKyc();
      toast('Fotos enviadas. Te avisaremos cuando revisemos tu identidad.');
    });

    q('#kyc-open', root)?.addEventListener('click', () => {
      if (!donor.cedula || !donor.nacimiento) {
        toast('Primero guarda tu cédula y tu fecha de nacimiento.');
        setVista('datos');
        (form.elements.namedItem(donor.cedula ? 'nacimiento' : 'cedula') as HTMLElement)?.focus();
        return;
      }
      resetKyc();
      dlg.showModal();
    });

    q('[data-kyc-cancel]', dlg)?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', resetKyc);
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

    // ---------- Índice lateral (pestañas) ----------
    type Vista = 'carnet' | 'datos' | 'kyc';
    const frames = root.querySelectorAll<HTMLElement>('[data-frame]');
    const botones = root.querySelectorAll<HTMLButtonElement>('[data-vista]');

    function setVista(v: Vista) {
      frames.forEach((f) => f.classList.toggle('hidden', f.dataset.frame !== v));
      botones.forEach((b) => {
        const on = b.dataset.vista === v;
        b.setAttribute('aria-selected', String(on));
        b.classList.toggle('text-ink', on);
        b.classList.toggle('bg-sunken', on);
        b.classList.toggle('text-ink-2', !on);
        b.classList.toggle('hover:bg-sunken', !on);
      });
      if (v === 'datos') {
        // Lleva al primer dato que falta (o a Nombres).
        const falta = requisitos(donor).find((r) => !r.ok)?.key;
        const target = falta === 'foto' ? q('#foto-btn', root) : q<HTMLElement>(`#${falta}`, root) ?? q('#firstname', root);
        target?.focus({ preventScroll: true });
      }
    }

    botones.forEach((b) => b.addEventListener('click', () => setVista(b.dataset.vista as Vista)));
    qa('[data-ir-datos]', root).forEach((b) => b.addEventListener('click', () => setVista('datos')));

    const pedida = new URLSearchParams(location.search).get('vista');
    setVista(pedida === 'datos' || pedida === 'kyc' ? pedida : 'carnet');
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
