---
// elegibilidad.astro - Test de elegibilidad para donar sangre (20 preguntas)
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BackButton from '../components/BackButton.astro';
import EligibilityQuiz from '../components/eligibility/EligibilityQuiz.astro';
import { questions } from '../data/eligibility';
---

<Layout
  title="BLUD | Test de elegibilidad"
  description="Responde 20 preguntas y descubre si puedes donar sangre o cuánto tiempo debes esperar. Es una guía orientativa; la decisión final es del personal médico."
>
  <!-- Encabezado con color estilo Footer -->
  <section data-cursor-white class="relative overflow-hidden bg-[color-mix(in_srgb,var(--accent)_86%,black)] text-white py-6 sm:py-8 lg:py-10 shadow-md">
    <!-- Sutil iluminación de fondo -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/5 via-transparent to-black/20 pointer-events-none"></div>

    <div class="container-blud relative z-10">
      
      <!-- Fila superior: Botón Atrás a la izquierda y Badge -->
      <div class="relative flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-4">
        <div class="flex-shrink-0">
          <BackButton href="/" label="Volver al inicio" />
        </div>

        <span class="inline-flex self-start sm:self-auto items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-xs font-bold text-white border border-white/15 backdrop-blur-sm">
          <Icon name="clipboard-text" class="size-3.5" />
          Test rápido de evaluación
        </span>
      </div>

      <!-- Contenido del encabezado -->
      <div class="max-w-3xl mx-auto flex flex-col items-center text-center">
        <!-- Título Principal -->
        <h1 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl lg:text-4xl drop-shadow-xs">
          ¿Puedes donar sangre?
        </h1>

        <!-- Subtítulo -->
        <p class="mt-2 max-w-2xl text-xs sm:text-sm leading-relaxed text-white/90">
          {questions.length} preguntas basadas en los criterios oficiales de selección de donantes. Al finalizar obtendrás un resultado orientativo inmediato.
        </p>

        <!-- Métricas / Badges centrados -->
        <ul class="mt-4 flex flex-wrap justify-center gap-2 sm:gap-3 text-xs font-medium text-white">
          <li class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1 backdrop-blur-sm shadow-xs">
            <Icon name="clipboard-text" class="size-3.5 text-white" />
            <span>{questions.length} preguntas</span>
          </li>
          <li class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 backdrop-blur-sm shadow-xs">
            <Icon name="clock" class="size-3.5 text-white" />
            <span>Unos 4 minutos</span>
          </li>
          <li class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 backdrop-blur-sm shadow-xs">
            <Icon name="shield-check" class="size-3.5 text-white" />
            <span>100% privado</span>
          </li>
        </ul>

        <!-- Aviso Médico Compacto -->
        <div class="mt-5 flex max-w-2xl items-start gap-3 rounded-panel border border-white/20 bg-black/20 p-3 sm:p-4 text-left text-xs leading-relaxed text-white/95 backdrop-blur-md shadow-xs">
          <Icon name="first-aid-kit" class="mt-0.5 size-4 shrink-0 text-white" />
          <p>
            <strong class="font-bold text-white">Guía orientativa:</strong> No reemplaza la entrevista médica presencial. La decisión final la toma el personal del banco de sangre tras la prueba física y de hemoglobina.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Sección del Quiz con Patrón Diagonal (Stripes) -->
  <section class="stripe-section relative isolate py-8 lg:py-14 border-b border-line overflow-hidden">
    <div class="container-blud relative z-10">
      <EligibilityQuiz />
    </div>
  </section>
</Layout>

<style>
  /* Patrón de fondo con líneas diagonales en la sección del quiz */
  .stripe-section {
    position: relative;
    background-color: var(--canvas);
  }

  .stripe-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--accent, #e53e3e) 6%, transparent),
      color-mix(in srgb, var(--accent, #e53e3e) 6%, transparent) 2px,
      transparent 2px,
      transparent 16px
    );
  }
</style>