---
// elegibilidad.astro - Test de elegibilidad para donar sangre (ficha de datos físicos + preguntas)
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import DropField from '../components/DropField.astro';
import EligibilityQuiz from '../components/eligibility/EligibilityQuiz.astro';
import { questions } from '../data/eligibility';
---

<Layout
  title="BLUD | Test de elegibilidad"
  description={`Indica tu edad, peso y altura, responde ${questions.length} preguntas y descubre si puedes donar sangre o cuánto tiempo debes esperar. Es una guía orientativa; la decisión final es del personal médico.`}
>
  <!-- Encabezado: mismo lenguaje que Infórmate y el resto del sitio -->
  <header class="relative isolate overflow-hidden border-b border-line bg-sunken">
    <DropField seed={4} />
    <div class="container-blud relative z-10 py-10 lg:py-16">
      <div class="flex flex-wrap items-center justify-between gap-3" data-reveal>
        <a href="/" class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm font-semibold text-ink-2 transition-colors hover:border-ink-3 hover:text-ink">
          <Icon name="arrow-left" class="size-4" />
          Volver al inicio
        </a>
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-sm font-medium text-ink-2">
          <Icon name="clipboard-text" class="size-4 text-accent" />
          Test rápido de evaluación
        </span>
      </div>

      <div class="section-head mt-10" data-reveal style="--reveal-delay:1">
        <h1 class="section-title text-[clamp(2.5rem,1.6rem+3.6vw,4.25rem)]">¿Puedes donar <span class="text-accent">sangre</span>?</h1>
        <p class="section-lead">
          {questions.length} preguntas basadas en los criterios oficiales de selección de donantes. Al finalizar obtendrás un resultado orientativo inmediato.
        </p>
        <ul class="mt-6 flex flex-wrap justify-center gap-2 text-sm font-medium text-ink-2" data-reveal style="--reveal-delay:2">
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5"><Icon name="clipboard-text" class="size-4 text-accent" />{questions.length} preguntas</li>
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5"><Icon name="clock" class="size-4 text-accent" />Unos 4 minutos</li>
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5"><Icon name="shield-check" class="size-4 text-accent" />100% privado</li>
        </ul>
      </div>

      <div class="mx-auto mt-8 flex max-w-2xl items-start gap-3 rounded-panel border border-accent/15 bg-accent-soft p-4 text-left text-sm leading-relaxed text-ink-2" data-reveal style="--reveal-delay:3">
        <Icon name="first-aid-kit" class="mt-0.5 size-5 shrink-0 text-accent" />
        <p>
          <strong class="font-bold text-ink">Guía orientativa:</strong> no reemplaza la entrevista médica presencial. La decisión final la toma el personal del banco de sangre tras la prueba física y de hemoglobina.
        </p>
      </div>
    </div>
  </header>

  <!-- Sección del Quiz con Patrón Diagonal (Stripes) -->
  <section class="stripe-section relative isolate py-6 lg:py-10 border-b border-line overflow-hidden">
    <div class="container-blud relative z-10">
      <EligibilityQuiz />
    </div>
  </section>
</Layout>

<style>
  /* Patrón de fondo con líneas diagonales en la sección del quiz */
  .stripe-section {
    position: relative;
    background-color: var(--canvas);
  }

  .stripe-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--accent, #e53e3e) 6%, transparent),
      color-mix(in srgb, var(--accent, #e53e3e) 6%, transparent) 2px,
      transparent 2px,
      transparent 16px
    );
  }
</style>