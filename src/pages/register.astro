---
// register.astro - Registro de nuevos donantes de BLUD
import Layout from '../layouts/Layout.astro';
import AuthShell from '../components/auth/AuthShell.astro';
import PasswordInput from '../components/auth/PasswordInput.astro';
import SubmitButton from '../components/auth/SubmitButton.astro';
import Icon from '../components/Icon.astro';

const bloodTypes = ["O-", "O+", "A-", "A+", "B-", "B+", "AB-", "AB+"];
const pretty = (t: string) => t.replace('-', '−');
---

<Layout title="BLUD | Crear cuenta">
  <AuthShell title="Únete a la red" subtitle="Crea tu cuenta de donante en menos de un minuto.">
    <div
      id="form-success"
      role="status"
      class="mb-6 hidden items-start gap-3 rounded-control bg-ok-soft px-4 py-3 text-sm font-medium text-ok"
    >
      <Icon name="check-circle" class="mt-0.5 size-5 shrink-0" />
      <span data-success-text>Cuenta creada. Te avisaremos cuando un centro cercano necesite tu tipo de sangre.</span>
    </div>

    <form id="register-form" novalidate class="flex flex-col gap-6">
      <div>
        <label for="register-name" class="mb-2 block text-sm font-semibold text-ink">Nombre completo</label>
        <input
          type="text"
          id="register-name"
          name="name"
          autocomplete="name"
          placeholder="Ej. María Fernández"
          aria-describedby="register-name-error"
          class="field"
        />
        <p id="register-name-error" class="mt-2 hidden text-sm font-medium text-accent-ink"></p>
      </div>

      <div>
        <label for="register-email" class="mb-2 block text-sm font-semibold text-ink">Correo electrónico</label>
        <input
          type="email"
          id="register-email"
          name="email"
          autocomplete="email"
          inputmode="email"
          placeholder="tucorreo@ejemplo.com"
          aria-describedby="register-email-error"
          class="field"
        />
        <p id="register-email-error" class="mt-2 hidden text-sm font-medium text-accent-ink"></p>
      </div>

      <fieldset id="register-blood-type">
        <legend class="mb-2 text-sm font-semibold text-ink">
          Tipo de sangre <span class="font-normal text-ink-3">(si lo conoces)</span>
        </legend>
        <div class="grid grid-cols-4 gap-2">
          {bloodTypes.map((type) => (
            <label class="cursor-pointer">
              <input type="radio" name="bloodType" value={type} class="peer sr-only" />
              <span class="flex h-11 items-center justify-center rounded-control border border-line-strong bg-surface font-semibold text-ink transition-colors duration-150 hover:border-ink-3 peer-checked:border-accent peer-checked:bg-accent peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
                {pretty(type)}
              </span>
            </label>
          ))}
          <label class="col-span-4 cursor-pointer">
            <input type="radio" name="bloodType" value="" class="peer sr-only" checked />
            <span class="flex h-11 items-center justify-center rounded-control border border-line-strong bg-surface text-sm font-medium text-ink-2 transition-colors duration-150 hover:border-ink-3 peer-checked:border-ink peer-checked:bg-ink peer-checked:text-canvas peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
              Aún no lo sé
            </span>
          </label>
        </div>
      </fieldset>

      <div>
        <label for="register-password" class="mb-2 block text-sm font-semibold text-ink">Contraseña</label>
        <PasswordInput
          id="register-password"
          name="password"
          autocomplete="new-password"
          placeholder="Mínimo 8 caracteres"
          describedby="register-password-hint register-password-error"
        />
        <div class="mt-3 flex items-center gap-3" aria-hidden="true">
          <div class="grid flex-1 grid-cols-3 gap-1.5">
            <span class="strength-seg h-1 rounded-full bg-line" data-seg="0"></span>
            <span class="strength-seg h-1 rounded-full bg-line" data-seg="1"></span>
            <span class="strength-seg h-1 rounded-full bg-line" data-seg="2"></span>
          </div>
          <span id="strength-label" class="w-16 text-right text-xs font-medium text-ink-3"></span>
        </div>
        <p id="register-password-hint" class="mt-2 text-sm text-ink-3">
          Usa al menos 8 caracteres. Mezclar números y símbolos la hace más segura.
        </p>
        <p id="register-password-error" class="mt-2 hidden text-sm font-medium text-accent-ink"></p>
      </div>

      <div>
        <label for="register-password-confirm" class="mb-2 block text-sm font-semibold text-ink">Confirmar contraseña</label>
        <input
          type="password"
          id="register-password-confirm"
          name="passwordConfirm"
          autocomplete="new-password"
          placeholder="Repite tu contraseña"
          aria-describedby="register-password-confirm-error"
          class="field"
        />
        <p id="register-password-confirm-error" class="mt-2 hidden text-sm font-medium text-accent-ink"></p>
      </div>

      <div>
        <label class="flex cursor-pointer items-start gap-3 text-sm leading-relaxed text-ink-2">
          <input
            type="checkbox"
            id="register-terms"
            name="terms"
            aria-describedby="register-terms-error"
            class="mt-0.5 size-[1.125rem] shrink-0 accent-(--accent)"
          />
          <span>
            Acepto los <a href="/terminos" class="font-semibold text-accent-ink underline-offset-4 hover:underline">Términos y condiciones</a>{' '}
            y la <a href="/privacidad" class="font-semibold text-accent-ink underline-offset-4 hover:underline">Política de privacidad</a>.
          </span>
        </label>
        <p id="register-terms-error" class="mt-2 hidden text-sm font-medium text-accent-ink"></p>
      </div>

      <SubmitButton label="Crear cuenta" loadingLabel="Creando cuenta" />
    </form>

    <p class="mt-10 border-t border-line pt-6 text-ink-2">
      ¿Ya tienes cuenta?
      <a href="/login" class="link-arrow ml-1" data-keep-next>
        Iniciar sesión
        <Icon name="arrow-right" class="size-4" />
      </a>
    </p>
  </AuthShell>
</Layout>

<style>
  .strength-seg { transition: background-color 240ms ease; }
  .strength-seg[data-on="weak"] { background: var(--accent); }
  .strength-seg[data-on="fair"] { background: var(--warn); }
  .strength-seg[data-on="strong"] { background: var(--ok); }
</style>

<script>
  import {
    bindPasswordToggles,
    clearError,
    isShowingError,
    setError,
    validateEmailField,
    withSubmitting,
  } from '../lib/forms';
  import { emailExists, register, safeNext } from '../lib/auth';

  const form = document.getElementById('register-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('form-success');

  if (form) {
    const nameInput = document.getElementById('register-name') as HTMLInputElement;
    const emailInput = document.getElementById('register-email') as HTMLInputElement;
    const passwordInput = document.getElementById('register-password') as HTMLInputElement;
    const confirmInput = document.getElementById('register-password-confirm') as HTMLInputElement;
    const termsInput = document.getElementById('register-terms') as HTMLInputElement;

    const nameError = document.getElementById('register-name-error') as HTMLElement;
    const emailError = document.getElementById('register-email-error') as HTMLElement;
    const passwordError = document.getElementById('register-password-error') as HTMLElement;
    const confirmError = document.getElementById('register-password-confirm-error') as HTMLElement;
    const termsError = document.getElementById('register-terms-error') as HTMLElement;
    const strengthLabel = document.getElementById('strength-label');
    const segments = document.querySelectorAll<HTMLElement>('.strength-seg');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    function validateName(): boolean {
      const value = nameInput.value.trim();
      if (!value) {
        setError(nameInput, nameError, 'Ingresa tu nombre completo.');
        return false;
      }
      if (value.length < 3) {
        setError(nameInput, nameError, 'El nombre debe tener al menos 3 caracteres.');
        return false;
      }
      clearError(nameInput, nameError);
      return true;
    }

    function validateEmail(): boolean {
      if (!validateEmailField(emailInput, emailError)) return false;
      if (emailExists(emailInput.value)) {
        setError(emailInput, emailError, 'Ya existe una cuenta con este correo. Inicia sesión.');
        return false;
      }
      return true;
    }

    function validatePassword(): boolean {
      const value = passwordInput.value;
      if (!value) {
        setError(passwordInput, passwordError, 'Crea una contraseña.');
        return false;
      }
      if (value.length < 8) {
        setError(passwordInput, passwordError, 'La contraseña debe tener al menos 8 caracteres.');
        return false;
      }
      clearError(passwordInput, passwordError);
      return true;
    }

    function validateConfirm(): boolean {
      const value = confirmInput.value;
      if (!value) {
        setError(confirmInput, confirmError, 'Confirma tu contraseña.');
        return false;
      }
      if (value !== passwordInput.value) {
        setError(confirmInput, confirmError, 'Las contraseñas no coinciden.');
        return false;
      }
      clearError(confirmInput, confirmError);
      return true;
    }

    function validateTerms(): boolean {
      if (!termsInput.checked) {
        setError(termsInput, termsError, 'Debes aceptar los términos para continuar.');
        return false;
      }
      clearError(termsInput, termsError);
      return true;
    }

    // Medidor simple: longitud + variedad de caracteres.
    function updateStrength() {
      const value = passwordInput.value;
      let score = 0;
      if (value.length >= 8) score++;
      if (value.length >= 12) score++;
      if (/\d/.test(value) && /[A-Za-z]/.test(value)) score++;
      if (/[^A-Za-z0-9]/.test(value)) score++;
      const level = !value ? 0 : score <= 1 ? 1 : score <= 2 ? 2 : 3;
      const names = ['', 'weak', 'fair', 'strong'];
      const labels = ['', 'Débil', 'Aceptable', 'Segura'];
      segments.forEach((seg, i) => {
        if (i < level) seg.dataset.on = names[level];
        else delete seg.dataset.on;
      });
      if (strengthLabel) strengthLabel.textContent = labels[level];
    }

    nameInput.addEventListener('input', () => { if (isShowingError(nameError)) validateName(); });
    emailInput.addEventListener('blur', () => { if (emailInput.value) validateEmail(); });
    emailInput.addEventListener('input', () => { if (isShowingError(emailError)) validateEmail(); });
    passwordInput.addEventListener('input', () => {
      updateStrength();
      if (isShowingError(passwordError)) validatePassword();
      if (confirmInput.value && isShowingError(confirmError)) validateConfirm();
    });
    confirmInput.addEventListener('input', () => { if (isShowingError(confirmError)) validateConfirm(); });
    termsInput.addEventListener('change', () => { if (isShowingError(termsError)) validateTerms(); });

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const checks = [
        { valid: validateName(), input: nameInput },
        { valid: validateEmail(), input: emailInput },
        { valid: validatePassword(), input: passwordInput },
        { valid: validateConfirm(), input: confirmInput },
        { valid: validateTerms(), input: termsInput },
      ];

      const firstInvalid = checks.find((c) => !c.valid);
      if (firstInvalid) return firstInvalid.input.focus();
      if (!submit) return;

      const bloodType = (new FormData(form).get('bloodType') as string | null) ?? '';

      withSubmitting(submit, async () => {
        const result = await register({
          name: nameInput.value,
          email: emailInput.value,
          password: passwordInput.value,
          bloodType,
        });
        if (!result.ok) {
          submit.disabled = false;
          setError(emailInput, emailError, result.error);
          emailInput.focus();
          return;
        }
        const firstName = result.user.name.split(/\s+/)[0];
        const text = successBanner?.querySelector('[data-success-text]');
        if (text) text.textContent = `¡Te damos la bienvenida, ${firstName}! Tu cuenta está lista y ya iniciaste sesión.`;
        successBanner?.classList.remove('hidden');
        successBanner?.classList.add('flex');
        form.classList.add('opacity-60', 'pointer-events-none');
        successBanner?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        const next = safeNext(new URLSearchParams(location.search).get('next'));
        window.setTimeout(() => location.assign(next), 1600);
      });
    });

    bindPasswordToggles(form);
  }

  // Conserva el destino (?next=) al cambiar entre registro e inicio de sesión.
  const nextParam = new URLSearchParams(location.search).get('next');
  if (nextParam) {
    document.querySelectorAll<HTMLAnchorElement>('[data-keep-next]').forEach((link) => {
      link.href = `${link.pathname}?next=${encodeURIComponent(nextParam)}`;
    });
  }
</script>
