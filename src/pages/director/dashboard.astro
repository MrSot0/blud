---
// src/pages/director/dashboard.astro
// Resumen del banco de sangre con datos reales: stock por tipo, solicitudes por aprobar, vencimientos y actividad de la red.
import Layout from '../../layouts/LayoutD.astro';
import { BLOOD_TYPES } from '../../lib/db';
---

<Layout title="BLUD | Panel de dirección">
  <div class="container-blud py-8 space-y-8">

    <div class="pb-6 border-b border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Panel de dirección</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1" id="sede-txt">Resumen del banco de sangre.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/director/solicitudes/historial" class="btn btn-primary">Revisar solicitudes</a>
        <a href="/director/reportes" class="btn btn-secondary">Generar reporte</a>
      </div>
    </div>

    <!-- KPIs -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/director/solicitudes/historial" class="panel p-5 transition-transform hover:-translate-y-0.5">
        <p class="text-xs font-bold uppercase text-ink-3">Por aprobar</p>
        <p class="mt-1 text-3xl font-extrabold text-accent-ink tabular" data-kpi="porAprobar">0</p>
        <p class="text-xs text-ink-3">Por despachar: <span data-kpi="porDespachar">0</span></p>
      </a>
      <a href="/director/inventario" class="panel p-5 transition-transform hover:-translate-y-0.5">
        <p class="text-xs font-bold uppercase text-ink-3">Stock vigente</p>
        <p class="mt-1 text-3xl font-extrabold text-ink tabular" data-kpi="stockTotal">0</p>
        <p class="text-xs text-ink-3">Tipos en nivel crítico: <span data-kpi="tiposCriticos">0</span></p>
      </a>
      <a href="/director/inventario#vencimientos" class="panel p-5 transition-transform hover:-translate-y-0.5">
        <p class="text-xs font-bold uppercase text-ink-3">Por vencer</p>
        <p class="mt-1 text-3xl font-extrabold text-warn tabular" data-kpi="porVencer">0</p>
        <p class="text-xs text-ink-3">Vencidas por retirar: <span data-kpi="vencidas">0</span></p>
      </a>
      <div class="panel p-5">
        <p class="text-xs font-bold uppercase text-ink-3">Este mes</p>
        <p class="mt-1 text-3xl font-extrabold text-ink tabular" data-kpi="donacionesMes">0</p>
        <p class="text-xs text-ink-3">donaciones · entregadas: <span data-kpi="entregasMes">0</span> u.</p>
      </div>
    </div>

    <!-- Stock por tipo -->
    <section class="panel p-6 sm:p-8 space-y-4" aria-labelledby="h-stock">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="h-stock" class="text-lg font-bold text-ink">Stock vigente por tipo de sangre</h2>
        <p class="text-sm text-ink-3"><span class="font-semibold text-ink" data-kpi="cuarentena">0</span> bolsas en cuarentena del laboratorio</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="stock">
        {BLOOD_TYPES.map((t) => (
          <div class="rounded-control bg-sunken p-4" data-tipo={t}>
            <div class="flex items-center justify-between">
              <span class="blood-chip">{t}</span>
              <span class="hidden text-[0.6875rem] font-bold uppercase text-warn" data-bajo>Crítico</span>
            </div>
            <p class="mt-2 text-2xl font-extrabold text-ink tabular"><span data-n>0</span> <span class="text-xs font-semibold text-ink-3">u.</span></p>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line"><span class="block h-full w-0 rounded-full bg-accent transition-[width] duration-500" data-bar></span></div>
          </div>
        ))}
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <section class="panel p-6 sm:p-8 space-y-4" aria-labelledby="h-aprobar">
        <div class="flex items-center justify-between border-b border-line pb-3">
          <h2 id="h-aprobar" class="text-lg font-bold text-ink">Solicitudes por aprobar</h2>
          <a href="/director/solicitudes/historial" class="link-arrow text-sm">Ver todas</a>
        </div>
        <ul id="lista-aprobar" class="divide-y divide-line"></ul>
      </section>

      <section class="panel p-6 sm:p-8 space-y-4" aria-labelledby="h-vence">
        <div class="flex items-center justify-between border-b border-line pb-3">
          <h2 id="h-vence" class="text-lg font-bold text-ink">Próximos vencimientos</h2>
          <a href="/director/inventario#vencimientos" class="link-arrow text-sm">Ver inventario</a>
        </div>
        <ul id="lista-vence" class="divide-y divide-line"></ul>
      </section>
    </div>

    <section class="panel p-6 sm:p-8 space-y-4" aria-labelledby="h-act">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3">
        <h2 id="h-act" class="text-lg font-bold text-ink">Actividad de la red</h2>
        <p class="text-sm text-ink-3">
          <span class="font-semibold text-ink" data-kpi="casosSinNotificar">0</span> casos del laboratorio sin notificar ·
          <span class="font-semibold text-ink" data-kpi="ticketsAbiertos">0</span> solicitudes de soporte abiertas
        </p>
      </div>
      <ul id="lista-actividad" class="divide-y divide-line"></ul>
    </section>
  </div>
</Layout>

<script>
  import {
    PRIORIDAD_LABEL, STOCK_BAJO, actividadRed, aprobarSolicitud, codigoPedido, directorActual, esc, fmtFecha,
    kpisDirector, onDb, resumenInventario, solicitudesPorAprobar, toast,
  } from '../../lib/director';

  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
  const corto = (iso: string) => fmtFecha(iso, { day: 'numeric', month: 'short' });
  const prioridadChip = (p?: string) =>
    p === 'critica' ? 'bg-accent text-white' : p === 'urgente' ? 'bg-accent-soft text-accent-ink' : 'bg-sunken text-ink-2';

  function render() {
    const k = kpisDirector();
    (Object.keys(k) as (keyof typeof k)[]).forEach((key) =>
      document.querySelectorAll(`[data-kpi="${key}"]`).forEach((el) => (el.textContent = String(k[key])))
    );
    $('#sede-txt').textContent = `${directorActual().sede} · resumen de hoy`;

    const inv = resumenInventario();
    const max = Math.max(10, ...Object.values(inv.porTipo));
    document.querySelectorAll<HTMLElement>('#stock [data-tipo]').forEach((card) => {
      const n = inv.porTipo[card.dataset.tipo!] ?? 0;
      card.querySelector('[data-n]')!.textContent = String(n);
      (card.querySelector('[data-bar]') as HTMLElement).style.width = `${Math.round((n / max) * 100)}%`;
      card.querySelector('[data-bajo]')!.classList.toggle('hidden', n >= STOCK_BAJO);
    });

    const pend = solicitudesPorAprobar().slice(0, 5);
    $('#lista-aprobar').innerHTML = pend.length
      ? pend.map((p) => `<li class="flex items-center justify-between gap-3 py-3">
          <div class="min-w-0">
            <p class="flex flex-wrap items-center gap-2"><span class="font-mono text-xs font-bold text-ink-3">${esc(codigoPedido(p.id))}</span>
              <span class="rounded-full px-2 py-0.5 text-[0.6875rem] font-bold ${prioridadChip(p.prioridad)}">${esc(PRIORIDAD_LABEL[p.prioridad ?? 'normal'])}</span></p>
            <p class="mt-0.5 truncate font-semibold text-ink">${p.unidades} u. ${esc(p.tipoSangre)} · ${esc(p.tipoHemocomponente)}</p>
            <p class="truncate text-xs text-ink-3">${esc(p.pacienteNombre)} → ${esc(p.hospitalDestino)} · ${esc(p.creadoPorNombre ?? '')}</p>
          </div>
          <button type="button" class="btn btn-secondary btn-sm shrink-0" data-aprobar="${esc(p.id)}">Aprobar</button>
        </li>`).join('')
      : '<li class="py-6 text-center text-sm text-ink-3">No hay solicitudes esperando tu aprobación.</li>';

    const vence = [...inv.vencidas, ...inv.porVencer].slice(0, 6);
    $('#lista-vence').innerHTML = vence.length
      ? vence.map((u) => `<li class="flex items-center justify-between gap-3 py-3">
          <div class="min-w-0"><p class="truncate font-semibold text-ink">${esc(u.componente)} · ${esc(u.tipoSangre)}</p>
          <p class="truncate text-xs text-ink-3">${esc(u.codigo)} · vence ${esc(corto(u.vence))}</p></div>
          <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-bold ${u.estado === 'vencida' ? 'bg-accent-soft text-accent-ink' : 'bg-warn-soft text-warn'}">${u.estado === 'vencida' ? 'Vencida' : u.dias === 0 ? 'Vence hoy' : `${u.dias} d`}</span>
        </li>`).join('')
      : '<li class="py-6 text-center text-sm text-ink-3">Ninguna unidad vence en los próximos días.</li>';

    const act = actividadRed().slice(0, 8);
    $('#lista-actividad').innerHTML = act.length
      ? act.map((e) => `<li class="py-3"><p class="text-sm font-semibold text-ink">${esc(e.titulo)}</p>
          <p class="truncate text-xs text-ink-3">${esc(e.detalle)} · ${esc(corto(e.fecha))}</p></li>`).join('')
      : '<li class="py-6 text-center text-sm text-ink-3">Todavía no hay actividad.</li>';
  }

  $('#lista-aprobar').addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-aprobar]')?.dataset.aprobar;
    if (!id) return;
    const r = aprobarSolicitud(id);
    toast(r.ok ? `Solicitud ${codigoPedido(id)} aprobada.` : r.motivo);
  });

  render();
  onDb(render);
</script>
