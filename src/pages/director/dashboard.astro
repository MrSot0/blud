---
// src/pages/director/dashboard.astro
import Layout from '../../layouts/LayoutD.astro';
import Icon from '../../components/Icon.astro';

const metrics = [
  { 
    label: 'Stock Crítico / Agotado', 
    value: '4', 
    color: 'text-accent-ink', 
    bg: 'bg-accent-soft',
    border: 'border-accent/20',
    icon: 'first-aid-kit'
  },
  { 
    label: 'Lotes Próximos a Vencer (<30 días)', 
    value: '7', 
    color: 'text-warn', 
    bg: 'bg-warn-soft',
    border: 'border-warn/30',
    icon: 'calendar-check'
  },
  { 
    label: 'Requisiciones Pendientes', 
    value: '3', 
    color: 'text-ink-2', 
    bg: 'bg-sunken',
    border: 'border-line-strong',
    icon: 'caret-down'
  },
  { 
    label: 'Movimientos Hoy', 
    value: '18', 
    color: 'text-ok', 
    bg: 'bg-ok-soft',
    border: 'border-ok/30',
    icon: 'arrow-right'
  },
];

const lowStockItems = [
  { code: 'INS-0284', name: 'Plasma', presentation: 'Frasco 1000g', stock: 0, min: 20 },
  { code: 'INS-4326', name: 'Glóbulos Rojos', presentation: 'Frasco 500ml', stock: 2, min: 30 },
  { code: 'INS-6650', name: 'Plaquetas', presentation: 'Prueba 3 Unidades', stock: 5, min: 25 },
];

const expiringLots = [
  { lot: 'LOT-98382', name: 'Plasma', presentation: '2 Unidades', exp: '2026-10-05', status: 'red', statusText: 'Crítico (<3 meses)' },
  { lot: 'LOT-AUS00', name: 'Glóbulos Rojos', presentation: 'Unidad 1L', exp: '2026-11-12', status: 'yellow', statusText: 'Precaución (3-6 meses)' },
  { lot: 'LOT-OP234', name: 'Plaquetas', presentation: 'Bolsa 450ml', exp: '2026-12-01', status: 'green', statusText: 'Óptimo (>6 meses)' },
];

const recentMovements = [
  { type: 'Ingreso', code: 'INS-6436', name: 'Plaquetas', lot: 'LOT-1029', qty: '+50', area: 'Stock Principal', user: 'Pedro Castro', time: '10:15 AM' },
  { type: 'Egreso', code: 'INS-4326', name: 'Glóbulos Rojos', lot: 'LOT-9345', qty: '-5', area: 'Hematología y Coagulación', user: 'Ana Castro', time: '09:30 AM' },
  { type: 'Egreso', code: 'INS-0284', name: 'Plasma', lot: 'LOT-7732', qty: '-2', area: 'Microbiología', user: 'Pedro Castro', time: '08:45 AM' },
];
---

<Layout title="BLUD | Dashboard Director">
  <section class="min-h-[calc(100vh-var(--header-h))] w-full bg-canvas px-4 py-8 sm:px-8 text-ink">
    <div class="container-blud space-y-8">
      
      <!-- Encabezado con acciones -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-line pb-6">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">
            Panel de Control BLUD
          </h1>
          <p class="mt-1 text-sm text-ink-2">
            Gestión integral de insumos, hemoderivados y trazabilidad en tiempo real.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <a href="/director/inventario" class="btn btn-secondary text-xs sm:text-sm">
            <Icon name="first-aid-kit" class="size-4" />
            Gestionar Stock
          </a>
          <a href="/director/reportes" class="btn btn-primary text-xs sm:text-sm">
            <Icon name="caret-down" class="size-4 -rotate-90" />
            Generar Reporte
          </a>
        </div>
      </div>

      <!-- Métricas del Sistema -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 py-1">
        {metrics.map(m => (
          <div class={`p-5 panel border ${m.border} flex items-center justify-between shadow-xs`}>
            <div>
              <p class="text-xs font-semibold text-ink-3 uppercase tracking-wider">{m.label}</p>
              <p class={`text-3xl font-black mt-2 tabular ${m.color}`}>{m.value}</p>
            </div>
            <div class={`p-3 rounded-control ${m.bg} ${m.color}`}>
              <Icon name={m.icon} class="size-6" />
            </div>
          </div>
        ))}
      </div>

      <!-- Secciones de Tabla Principal -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 py-2">
        
        <!-- Control FIFO / Vencimientos -->
        <div class="panel p-6 space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-ink flex items-center gap-2">
              <Icon name="calendar-check" class="size-5 text-accent-ink" />
              Control de Vencimientos (FIFO)
            </h2>
            <a href="/director/inventario" class="text-xs font-semibold text-accent-ink hover:underline">Ver todo</a>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-ink">
              <thead class="text-xs uppercase bg-sunken text-ink-3 border-b border-line">
                <tr>
                  <th class="p-3 rounded-l-control">Lote / Insumo</th>
                  <th class="p-3">Vencimiento</th>
                  <th class="p-3 rounded-r-control">Estado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {expiringLots.map(item => (
                  <tr class="hover:bg-sunken/50 transition-colors">
                    <td class="p-3">
                      <p class="font-bold text-ink">{item.name}</p>
                      <p class="text-xs text-ink-3">{item.lot} • {item.presentation}</p>
                    </td>
                    <td class="p-3 font-mono text-xs text-ink-2 tabular">{item.exp}</td>
                    <td class="p-3">
                      <span class={`inline-block px-2.5 py-1 text-xs font-bold rounded-full border ${
                        item.status === 'red' ? 'bg-accent-soft text-accent-ink border-accent/30' :
                        item.status === 'yellow' ? 'bg-warn-soft text-warn border-warn/30' :
                        'bg-ok-soft text-ok border-ok/30'
                      }`}>
                        {item.statusText}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Alertas de Stock Crítico -->
        <div class="panel p-6 space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-ink flex items-center gap-2">
              <Icon name="first-aid-kit" class="size-5 text-accent-ink" />
              Alertas de Stock Mínimo
            </h2>
            <a href="/director/inventario" class="text-xs font-semibold text-accent-ink hover:underline">Gestionar Stock</a>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-ink">
              <thead class="text-xs uppercase bg-sunken text-ink-3 border-b border-line">
                <tr>
                  <th class="p-3 rounded-l-control">Código e Insumo</th>
                  <th class="p-3 text-center">Actual</th>
                  <th class="p-3 text-center rounded-r-control">Mínimo</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line">
                {lowStockItems.map(item => (
                  <tr class="hover:bg-sunken/50 transition-colors">
                    <td class="p-3">
                      <p class="font-bold text-ink">{item.name}</p>
                      <p class="text-xs text-ink-3">{item.code} • {item.presentation}</p>
                    </td>
                    <td class="p-3 text-center font-bold text-accent-ink tabular">{item.stock}</td>
                    <td class="p-3 text-center text-ink-3 tabular">{item.min}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- Bitácora Reciente -->
      <div class="panel p-6 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-ink">Últimos Movimientos del Sistema</h2>
          <a href="/director/reportes" class="text-xs font-semibold text-accent-ink hover:underline">Ver Bitácora Completa</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-ink">
            <thead class="text-xs uppercase bg-sunken text-ink-3 border-b border-line">
              <tr>
                <th class="p-3 rounded-l-control">Tipo</th>
                <th class="p-3">Insumo / Lote</th>
                <th class="p-3">Cantidad</th>
                <th class="p-3">Origen / Destino</th>
                <th class="p-3">Usuario</th>
                <th class="p-3 rounded-r-control">Hora</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {recentMovements.map(m => (
                <tr class="hover:bg-sunken/50 transition-colors">
                  <td class="p-3">
                    <span class={`inline-block px-2 py-0.5 text-xs font-bold rounded-control ${
                      m.type === 'Ingreso' ? 'bg-ok-soft text-ok' : 'bg-sunken text-ink-2'
                    }`}>
                      {m.type}
                    </span>
                  </td>
                  <td class="p-3">
                    <p class="font-semibold text-ink">{m.name}</p>
                    <p class="text-xs text-ink-3">{m.code} | {m.lot}</p>
                  </td>
                  <td class={`p-3 font-mono font-bold tabular ${m.type === 'Ingreso' ? 'text-ok' : 'text-accent-ink'}`}>
                    {m.qty}
                  </td>
                  <td class="p-3 text-ink-2">{m.area}</td>
                  <td class="p-3 text-ink font-medium">{m.user}</td>
                  <td class="p-3 text-xs text-ink-3 font-mono tabular">{m.time}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>
</Layout>