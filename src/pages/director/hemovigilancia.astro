---
// src/pages/director/hemovigilancia.astro
// RF-H2, H4: la dirección consulta los registros transfusionales de su sede o de toda la red, con su tasa de
// eventos adversos, y descarga el PDF de cada registro o el consolidado del periodo. Ver lib/hemovigilancia.
import Layout from '../../layouts/LayoutD.astro';
import Filtros from '../../components/app/Filtros.astro';
import { SEVERIDADES } from '../../lib/hemovigilancia';
---

<Layout title="BLUD | Hemovigilancia" description="Registros transfusionales y eventos adversos de la sede y de la red.">
  <div class="container-blud py-8 space-y-6" data-hvd>
    <div class="page-head">
      <div class="min-w-0">
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Hemovigilancia</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Cada transfusión que registran los operadores: verificación, signos vitales y eventos adversos.</p>
      </div>
      <div class="page-head-acciones">
        <button type="button" class="btn btn-secondary btn-sm" id="btn-csv">Exportar CSV</button>
        <button type="button" class="btn btn-primary btn-sm" id="btn-pdf">Consolidado PDF</button>
      </div>
    </div>

    <p id="aviso" class="hidden rounded-control bg-warn-soft px-4 py-3 text-sm font-medium text-warn" role="status"></p>

    <div class="flex flex-wrap items-end justify-between gap-3">
      <div class="inline-flex rounded-full border border-line bg-surface p-1" role="group" aria-label="Alcance">
        <button type="button" class="hvd-alcance" data-alcance="sede" aria-pressed="true">Mi sede</button>
        <button type="button" class="hvd-alcance" data-alcance="red" aria-pressed="false">Toda la red</button>
      </div>
      <div class="grid w-full grid-cols-2 gap-2 text-sm sm:w-auto">
        <label class="min-w-0"><span class="block text-xs font-bold uppercase text-ink-3">Desde</span><input id="desde" type="date" class="field !min-h-10 w-full min-w-0" /></label>
        <label class="min-w-0"><span class="block text-xs font-bold uppercase text-ink-3">Hasta</span><input id="hasta" type="date" class="field !min-h-10 w-full min-w-0" /></label>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 lg:grid-cols-4" id="kpis" aria-live="polite">
      <div class="panel p-4"><p class="text-xs font-bold uppercase text-ink-3">Transfusiones</p><p class="mt-1 text-2xl font-extrabold text-ink tabular" data-kpi="total">—</p><p class="text-xs text-ink-3">unidades registradas</p></div>
      <div class="panel p-4"><p class="text-xs font-bold uppercase text-ink-3">Con evento</p><p class="mt-1 text-2xl font-extrabold text-ink tabular" data-kpi="eventos">—</p><p class="text-xs text-ink-3" data-kpi="tasa">tasa —</p></div>
      <div class="panel p-4"><p class="text-xs font-bold uppercase text-ink-3">Graves</p><p class="mt-1 text-2xl font-extrabold tabular" data-kpi="graves">—</p><p class="text-xs text-ink-3">grave, amenaza la vida o muerte</p></div>
      <div class="panel p-4"><p class="text-xs font-bold uppercase text-ink-3">En curso</p><p class="mt-1 text-2xl font-extrabold text-ink tabular" data-kpi="curso">—</p><p class="text-xs text-ink-3">registros sin cerrar</p></div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <section class="panel p-4 sm:p-6 space-y-4 min-w-0" aria-labelledby="h-lista">
        <h2 id="h-lista" class="text-lg font-bold text-ink">Registros <span class="text-sm font-semibold text-ink-3">(<span id="n-vis">0</span>)</span></h2>
        <Filtros>
          <input type="search" id="q" class="field filtro-ancho" placeholder="Folio, paciente, unidad o sede" aria-label="Buscar" />
          <select id="f-tipo" class="field" aria-label="Resultado">
            <option value="">Todo resultado</option>
            <option value="sin_reaccion">Sin reacción</option>
            <option value="reaccion">Reacción adversa</option>
            <option value="incidente">Incidente</option>
            <option value="en_curso">En curso</option>
          </select>
          <select id="f-sev" class="field" aria-label="Severidad">
            <option value="">Toda severidad</option>
            {SEVERIDADES.map((s) => <option value={s}>{s}</option>)}
          </select>
        </Filtros>
        <div class="tabla-apilable" role="region" aria-labelledby="h-lista" tabindex="0">
          <table class="w-full min-w-[44rem] text-left text-sm">
            <thead class="border-b border-line bg-sunken text-xs uppercase text-ink-3">
              <tr><th class="p-3 font-bold">Folio</th><th class="p-3 font-bold">Fecha</th><th class="p-3 font-bold">Sede</th><th class="p-3 font-bold">Unidad</th><th class="p-3 font-bold">Resultado</th><th class="p-3"></th></tr>
            </thead>
            <tbody id="filas" class="divide-y divide-line"></tbody>
          </table>
        </div>
        <p id="vacio" class="hidden py-8 text-center text-sm text-ink-3">No hay registros que coincidan.</p>
      </section>

      <section class="panel p-4 sm:p-6 space-y-4 self-start" aria-labelledby="h-cat">
        <h2 id="h-cat" class="text-lg font-bold text-ink">Eventos por categoría</h2>
        <ul id="categorias" class="space-y-3"></ul>
        <p id="sin-cat" class="hidden text-sm text-ink-3">Sin eventos adversos en el periodo.</p>
      </section>
    </div>
  </div>

  <dialog id="dlg" class="hvd-dialog" aria-labelledby="d-titulo">
    <div class="flex max-h-[inherit] flex-col">
      <header class="flex items-start justify-between gap-4 border-b border-line p-5">
        <div class="min-w-0">
          <p class="font-mono text-xs font-bold text-ink-3" id="d-folio"></p>
          <h2 id="d-titulo" class="text-lg font-bold text-ink">Registro de transfusión</h2>
          <p class="mt-1 flex flex-wrap gap-2" id="d-chips"></p>
        </div>
        <button type="button" class="grid size-9 shrink-0 place-items-center rounded-full text-ink-3 hover:bg-sunken" data-cerrar aria-label="Cerrar">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </header>
      <div class="flex-1 space-y-6 overflow-y-auto p-5" id="d-cuerpo"></div>
      <footer class="flex flex-col-reverse gap-2 border-t border-line p-4 sm:flex-row sm:justify-end">
        <button type="button" class="btn btn-secondary" data-cerrar>Cerrar</button>
        <button type="button" class="btn btn-primary" id="d-pdf">Descargar PDF</button>
      </footer>
    </div>
  </dialog>
</Layout>

<style is:global>
  [data-hvd] .hvd-alcance { padding: .4rem 1rem; border-radius: 9999px; font-size: .875rem; font-weight: 600; color: var(--ink-2); cursor: pointer; }
  [data-hvd] .hvd-alcance[aria-pressed="true"] { background: var(--ink); color: var(--surface); }
  .hvd-dialog { width: min(48rem, calc(100vw - 1rem)); max-height: min(92dvh, 60rem); padding: 0; margin: auto; border: 1px solid var(--line); border-radius: 1.25rem; background: var(--surface); color: var(--ink); box-shadow: 0 30px 60px -20px rgb(0 0 0 / .45); }
  .hvd-dialog::backdrop { background: rgb(0 0 0 / .5); backdrop-filter: blur(4px); }
  @media (max-width: 639px) { .hvd-dialog { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; border-radius: 0; border: 0; } .hvd-dialog > div { height: 100%; } }
</style>

<script>
  import { HVNoDisponible, TIPO_EVENTO, esGrave, fmtFechaHora, listarHV, seedHVDemo } from '../../lib/hemovigilancia';
  import type { RegistroHV } from '../../lib/hemovigilancia';
  import { chipEstadoHV, chipEvento, detalleHTML } from '../../lib/hemovigilancia-vista';
  import { downloadFile, esc, hoyISO, sumarDias, toCSV, toast } from '../../lib/ui';

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;

  function init() {
    const raiz = document.querySelector<HTMLElement>('[data-hvd]');
    if (!raiz || raiz.dataset.ready) return;
    raiz.dataset.ready = '1';
    seedHVDemo();

    let red = false;
    let registros: RegistroHV[] = [];
    let abierto: RegistroHV | null = null;
    const dlg = $<HTMLDialogElement>('#dlg');
    $<HTMLInputElement>('#hasta').value = hoyISO();
    $<HTMLInputElement>('#desde').value = sumarDias(hoyISO(), -90);

    const conEvento = (r: RegistroHV) => !!r.tipoEvento && r.tipoEvento !== 'sin_reaccion';

    const visibles = () => {
      const q = $<HTMLInputElement>('#q').value.trim().toLowerCase();
      const tipo = $<HTMLSelectElement>('#f-tipo').value;
      const sev = $<HTMLSelectElement>('#f-sev').value;
      return registros.filter((r) =>
        (!tipo || (tipo === 'en_curso' ? r.estado === 'en_curso' : r.tipoEvento === tipo)) &&
        (!sev || r.severidad === sev) &&
        (!q || `${r.id} ${r.paciente?.nombre ?? ''} ${r.paciente?.cedula ?? ''} ${r.unidadCodigo ?? ''} ${r.sede?.nombre ?? ''} ${r.solicitudId}`.toLowerCase().includes(q)));
    };

    function pintar() {
      const total = registros.length;
      const eventos = registros.filter(conEvento);
      const graves = registros.filter(esGrave).length;
      $('[data-kpi="total"]').textContent = String(total);
      $('[data-kpi="eventos"]').textContent = String(eventos.length);
      $('[data-kpi="tasa"]').textContent = total ? `tasa ${(Math.round((eventos.length / total) * 1000) / 10).toLocaleString('es-VE')} %` : 'tasa —';
      const g = $('[data-kpi="graves"]');
      g.textContent = String(graves);
      g.className = `mt-1 text-2xl font-extrabold tabular ${graves ? 'text-accent-ink' : 'text-ink'}`;
      $('[data-kpi="curso"]').textContent = String(registros.filter((r) => r.estado === 'en_curso').length);

      const vis = visibles();
      $('#n-vis').textContent = String(vis.length);
      $('#filas').innerHTML = vis.map((r) => `<tr class="${esGrave(r) ? 'bg-accent-soft/40' : ''}">
        <td class="p-3 celda-titulo celda-corta" data-label="Folio"><span class="font-mono text-xs font-bold">${esc(r.id)}</span><span class="block text-xs font-normal text-ink-3">${esc(r.paciente?.nombre ?? '')}</span></td>
        <td class="p-3 celda-estado" data-label="Estado">${chipEstadoHV(r)}</td>
        <td class="p-3 text-xs text-ink-2 tabular" data-label="Fecha">${esc(fmtFechaHora(r.registrado))}</td>
        <td class="p-3" data-label="Sede">${esc(r.sede?.nombre ?? '—')}</td>
        <td class="p-3" data-label="Unidad"><span class="block">${esc(r.componente ?? '')} · ${esc(r.tipoSangre ?? '')}</span><span class="font-mono text-xs text-ink-3">${esc(r.unidadCodigo ?? '')}</span></td>
        <td class="p-3 celda-ancha" data-label="Resultado">${chipEvento(r)}${r.categoria ? `<span class="mt-1 block text-xs text-ink-2">${esc(r.categoria)}</span>` : ''}</td>
        <td class="p-3 celda-acciones text-right"><button type="button" class="btn btn-secondary btn-sm" data-abrir="${esc(r.id)}">Ver registro</button></td>
      </tr>`).join('');
      $('#vacio').classList.toggle('hidden', vis.length > 0);

      const cat = new Map<string, number>();
      eventos.forEach((r) => cat.set(r.categoria ?? 'Sin categoría', (cat.get(r.categoria ?? 'Sin categoría') ?? 0) + 1));
      const max = Math.max(1, ...cat.values());
      $('#categorias').innerHTML = [...cat.entries()].sort((a, b) => b[1] - a[1]).map(([c, n]) => `<li>
        <div class="flex items-baseline justify-between gap-3 text-sm"><span class="text-ink-2">${esc(c)}</span><span class="font-bold text-ink tabular">${n}</span></div>
        <div class="mt-1 h-1.5 rounded-full bg-sunken"><div class="h-1.5 rounded-full bg-accent" style="width:${Math.round((n / max) * 100)}%"></div></div></li>`).join('');
      $('#sin-cat').classList.toggle('hidden', cat.size > 0);
    }

    async function cargar() {
      const desde = $<HTMLInputElement>('#desde').value, hasta = $<HTMLInputElement>('#hasta').value;
      if (desde && hasta && desde > hasta) {
        registros = [];
        $('#aviso').textContent = 'La fecha «Desde» no puede ser posterior a «Hasta».';
        $('#aviso').classList.remove('hidden');
        return pintar();
      }
      try {
        const r = await listarHV({ desde: $<HTMLInputElement>('#desde').value, hasta: $<HTMLInputElement>('#hasta').value, red });
        registros = r.registros;
        $('#aviso').classList.add('hidden');
      } catch (e) {
        registros = [];
        const aviso = $('#aviso');
        aviso.textContent = e instanceof HVNoDisponible
          ? 'El registro de hemovigilancia todavía no está habilitado en el servidor. Aquí verás las transfusiones en cuanto los operadores empiecen a registrarlas.'
          : (e as Error).message;
        aviso.classList.remove('hidden');
      }
      pintar();
    }

    raiz.querySelectorAll<HTMLElement>('[data-alcance]').forEach((b) => b.addEventListener('click', () => {
      red = b.dataset.alcance === 'red';
      raiz.querySelectorAll('[data-alcance]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cargar();
    }));
    ['#desde', '#hasta'].forEach((s) => $(s).addEventListener('change', cargar));
    $('#q').addEventListener('input', pintar);
    ['#f-tipo', '#f-sev'].forEach((s) => $(s).addEventListener('change', pintar));

    $('#filas').addEventListener('click', (e) => {
      const id = (e.target as HTMLElement).closest<HTMLElement>('[data-abrir]')?.dataset.abrir;
      abierto = registros.find((r) => r.id === id) ?? null;
      if (!abierto) return;
      $('#d-folio').textContent = abierto.id;
      $('#d-chips').innerHTML = `${chipEstadoHV(abierto)} ${chipEvento(abierto)}`;
      $('#d-cuerpo').innerHTML = detalleHTML(abierto);
      dlg.showModal();
    });
    dlg.querySelectorAll('[data-cerrar]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    $('#d-pdf').addEventListener('click', async () => {
      if (abierto) await (await import('../../lib/reportes-pdf')).pdfHemovigilancia(abierto);
    });

    $('#btn-csv').addEventListener('click', () => {
      const vis = visibles();
      if (!vis.length) return toast('No hay registros para exportar.');
      downloadFile(`blud-hemovigilancia-${hoyISO()}.csv`, toCSV(vis.map((r) => ({
        Folio: r.id, Fecha: r.registrado, Sede: r.sede?.nombre ?? '', Estado: r.estado === 'cerrado' ? 'Cerrado' : 'En curso',
        Solicitud: r.solicitudId, Unidad: r.unidadCodigo ?? '', Componente: r.componente ?? '', Grupo: r.tipoSangre ?? '',
        Resultado: r.tipoEvento ? TIPO_EVENTO[r.tipoEvento] : '', Categoria: r.categoria ?? '', Severidad: r.severidad ?? '',
        Imputabilidad: r.imputabilidad ?? '', VolumenMl: r.volumenMl ?? '', SegundoVerificador: r.verificacion.segundoVerificador,
      }))), 'text/csv');
    });
    $('#btn-pdf').addEventListener('click', async () => {
      const { pdfConsolidadoHV } = await import('../../lib/reportes-pdf');
      await pdfConsolidadoHV(registros, { desde: $<HTMLInputElement>('#desde').value, hasta: $<HTMLInputElement>('#hasta').value, alcance: red ? 'Toda la red' : 'Mi sede' });
    });

    cargar();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  @container (width >= 40rem) { [data-hvd] .tabla-apilable td.celda-estado { display: none; } }
</style>
