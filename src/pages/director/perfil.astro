---
// src/pages/director/perfil.astro
import LayoutD from '../../layouts/LayoutD.astro';
import Icon from '../../components/Icon.astro';
---

<LayoutD title="BLUD | Perfil del Director">
  <div class="container-blud py-8 space-y-8">
    
    <!-- Encabezado de sección -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-line">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">
          Perfil del Director
        </h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">
          Gestiona tu información personal, credenciales y preferencias de cuenta.
        </p>
      </div>
      <button
        type="button"
        class="btn btn-primary self-start sm:self-auto"
      >
        <Icon name="caret-down" class="size-4 -rotate-90" />
        Guardar cambios
      </button>
    </div>

    <!-- Grid principal -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Columna Izquierda: Tarjeta Resumen y Rol -->
      <div class="space-y-6">
        <div class="panel p-6 flex flex-col items-center text-center relative overflow-hidden">
          <!-- Fondo decorativo superior -->
          <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-r from-accent/20 to-accent-strong/10 border-b border-line"></div>
          
          <!-- Avatar con borde e indicador de estado -->
          <div class="relative mt-8 mb-4">
            <span class="grid size-24 place-items-center rounded-full bg-accent font-bold text-3xl text-white shadow-lg border-4 border-surface">
              MF
            </span>
            <span class="absolute bottom-1 right-1 size-4 rounded-full bg-ok border-2 border-surface" title="Cuenta activa"></span>
          </div>

          <h2 class="text-xl font-bold text-ink">Dra. María Fernández</h2>
          <p class="text-sm font-medium text-ink-3 mt-0.5">Director Médico / Banco de Sangre</p>
          
          <div class="mt-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent-soft text-accent-ink text-xs font-semibold">
            <Icon name="first-aid-kit" class="size-3.5" />
            Hospital Central Maracaibo
          </div>

          <hr class="w-full border-line my-6" />

          <!-- Métricas de cuenta / gestión -->
          <div class="grid grid-cols-2 w-full gap-4 text-center">
            <div class="p-3 rounded-control bg-sunken">
              <span class="block text-2xl font-extrabold text-ink tabular">1,240</span>
              <span class="text-xs font-semibold text-ink-3 uppercase">Unidades</span>
            </div>
            <div class="p-3 rounded-control bg-sunken">
              <span class="block text-2xl font-extrabold text-ink tabular">125</span>
              <span class="text-xs font-semibold text-ink-3 uppercase">Donantes</span>
            </div>
          </div>
        </div>

        <!-- Opciones de Seguridad y Sesión -->
        <div class="panel p-6 space-y-4">
          <h3 class="text-base font-bold text-ink flex items-center gap-2">
            Seguridad de la cuenta
          </h3>
          <p class="text-xs text-ink-3">
            Último acceso registrado el 28 de sep, 2026 a las 08:30 AM desde Maracaibo, Venezuela.
          </p>
          <div class="space-y-2 pt-2">
            <button type="button" class="btn btn-secondary w-full justify-start text-sm">
              Cambiar contraseña
            </button>
            <button type="button" class="btn btn-secondary w-full justify-start text-sm">
              Autenticación en 2 Pasos (2FA)
            </button>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Formulario de Perfil e Institución -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- Formulario Datos Personales -->
        <div class="panel p-6 sm:p-8 space-y-6">
          <div class="border-b border-line pb-4">
            <h3 class="text-lg font-bold text-ink">Información Personal</h3>
            <p class="text-xs sm:text-sm text-ink-3">Actualiza tus nombres, correo de contacto y datos institucionales.</p>
          </div>

          <form class="space-y-4" onsubmit="event.preventDefault();">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="firstname" class="block text-xs font-bold uppercase tracking-wider text-ink-2">
                  Nombres
                </label>
                <input
                  type="text"
                  id="firstname"
                  class="field"
                  value="María Alexandra"
                />
              </div>

              <div class="space-y-1.5">
                <label for="lastname" class="block text-xs font-bold uppercase tracking-wider text-ink-2">
                  Apellidos
                </label>
                <input
                  type="text"
                  id="lastname"
                  class="field"
                  value="Fernández Rincón"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-ink-2">
                  Correo Electrónico
                </label>
                <input
                  type="email"
                  id="email"
                  class="field"
                  value="maria.fernandez@hospitalcentral.org"
                />
              </div>

              <div class="space-y-1.5">
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-ink-2">
                  Teléfono de Contacto
                </label>
                <input
                  type="tel"
                  id="phone"
                  class="field"
                  value="+58 414 1234567"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="mpps" class="block text-xs font-bold uppercase tracking-wider text-ink-2">
                  Código MPPS / Colegiado
                </label>
                <input
                  type="text"
                  id="mpps"
                  class="field"
                  value="MPPS-84920"
                />
              </div>

              <div class="space-y-1.5">
                <label for="cargo" class="block text-xs font-bold uppercase tracking-wider text-ink-2">
                  Cargo Institucional
                </label>
                <input
                  type="text"
                  id="cargo"
                  class="field"
                  value="Director General de Banco de Sangre"
                />
              </div>
            </div>
          </form>
        </div>

        <!-- Formulario Preferencias de Notificación -->
        <div class="panel p-6 sm:p-8 space-y-6">
          <div class="border-b border-line pb-4">
            <h3 class="text-lg font-bold text-ink">Preferencias de Alertas</h3>
            <p class="text-xs sm:text-sm text-ink-3">Configura cómo deseas recibir avisos críticos de stock y solicitudes.</p>
          </div>

          <div class="space-y-4">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" checked class="size-4 mt-1 rounded text-accent border-line-strong focus:ring-accent" />
              <div>
                <span class="block text-sm font-semibold text-ink">Alertas de Stock Mínimo Crítico</span>
                <span class="block text-xs text-ink-3">Recibe un correo electrónico cuando el stock de algún tipo de sangre caiga del límite.</span>
              </div>
            </label>

            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" checked class="size-4 mt-1 rounded text-accent border-line-strong focus:ring-accent" />
              <div>
                <span class="block text-sm font-semibold text-ink">Solicitudes de Emergencia Urgentes</span>
                <span class="block text-xs text-ink-3">Notificaciones inmediatas cuando un centro hospitalario requiera donaciones urgentes.</span>
              </div>
            </label>

            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" class="size-4 mt-1 rounded text-accent border-line-strong focus:ring-accent" />
              <div>
                <span class="block text-sm font-semibold text-ink">Resumen Semanal de Transacciones</span>
                <span class="block text-xs text-ink-3">Recibe un reporte digest cada lunes con métricas de egresos e ingresos.</span>
              </div>
            </label>
          </div>
        </div>

      </div>

    </div>
  </div>
</LayoutD>