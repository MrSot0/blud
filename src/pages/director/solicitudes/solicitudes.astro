---
// src/pages/director/solicitudes/solicitudes.astro
// Solicitudes que registró la dirección: seguimiento, edición y eliminación mientras no se despachen.
import Layout from '../../../layouts/LayoutD.astro';
---

<Layout title="BLUD | Mis solicitudes">
  <div class="container-blud py-8 space-y-6">
    <div class="pb-6 border-b border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Mis solicitudes</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Las que registraste tú. Puedes cambiarlas o quitarlas hasta que se despachen.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/director/solicitudes/registro" class="btn btn-primary">Nueva solicitud</a>
        <a href="/director/solicitudes/historial" class="btn btn-secondary">Todas las solicitudes</a>
      </div>
    </div>

    <label class="sr-only" for="buscar">Buscar</label>
    <input id="buscar" type="search" class="field sm:max-w-sm" placeholder="Folio, paciente o centro" autocomplete="off" />

    <div class="panel overflow-hidden">
      <div class="relative overflow-x-auto">
        <table class="w-full min-w-[46rem] text-left text-sm">
          <thead class="border-b border-line bg-sunken text-xs uppercase text-ink-3">
            <tr>
              <th class="p-4 font-bold">Folio</th>
              <th class="p-4 font-bold">Pedido</th>
              <th class="p-4 font-bold">Paciente y destino</th>
              <th class="p-4 font-bold">Estado</th>
              <th class="p-4 font-bold"><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody id="filas" class="divide-y divide-line"></tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { ESTADO_PEDIDO, PRIORIDAD_LABEL, codigoPedido, eliminarSolicitud, esc, fmtFecha, misSolicitudes, onDb, toast } from '../../../lib/director';
  import type { PedidoOp } from '../../../lib/director';

  const buscar = document.getElementById('buscar') as HTMLInputElement;
  const filas = document.getElementById('filas')!;
  const chip: Record<PedidoOp['estado'], string> = {
    pendiente: 'bg-warn-soft text-warn',
    aprobado: 'bg-ok-soft text-ok',
    rechazado: 'bg-accent-soft text-accent-ink',
    despachado: 'bg-sunken text-ink-2',
  };

  function render() {
    const q = buscar.value.trim().toLowerCase();
    const lista = misSolicitudes().filter((p) => !q || `${codigoPedido(p.id)} ${p.pacienteNombre} ${p.hospitalDestino}`.toLowerCase().includes(q));
    filas.innerHTML = lista.length
      ? lista.map((p) => `<tr class="align-top">
          <td class="p-4"><p class="font-mono text-xs font-bold text-ink">${esc(codigoPedido(p.id))}</p>
            <p class="text-xs text-ink-3">${esc(fmtFecha(p.fecha, { day: 'numeric', month: 'short' }))}</p></td>
          <td class="p-4"><p class="font-semibold text-ink">${p.unidades} u. ${esc(p.tipoSangre)}</p>
            <p class="text-xs text-ink-3">${esc(p.tipoHemocomponente)} · ${esc(PRIORIDAD_LABEL[p.prioridad ?? 'normal'])}</p></td>
          <td class="p-4"><p class="text-ink">${esc(p.pacienteNombre)}</p><p class="text-xs text-ink-3">${esc(p.hospitalDestino)}</p></td>
          <td class="p-4"><span class="rounded-full px-2 py-0.5 text-xs font-bold ${chip[p.estado]}">${esc(ESTADO_PEDIDO[p.estado])}</span></td>
          <td class="p-4 text-right whitespace-nowrap">${p.estado === 'despachado'
            ? '<span class="text-xs text-ink-3">Entregada</span>'
            : `<a class="btn btn-secondary btn-sm" href="/director/solicitudes/registro?id=${encodeURIComponent(p.id)}">Editar</a>
               <button type="button" class="btn btn-secondary btn-sm" data-eliminar="${esc(p.id)}">Eliminar</button>`}</td>
        </tr>`).join('')
      : `<tr><td colspan="5" class="p-10 text-center text-sm text-ink-3">${q ? 'Nada coincide con tu búsqueda.' : 'Todavía no registraste solicitudes.'}</td></tr>`;
  }

  filas.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-eliminar]')?.dataset.eliminar;
    if (!id) return;
    if (!confirm(`¿Eliminar la solicitud ${codigoPedido(id)}? No se puede deshacer.`)) return;
    const r = eliminarSolicitud(id);
    toast(r.ok ? 'Solicitud eliminada.' : r.motivo);
  });
  buscar.addEventListener('input', render);

  render();
  onDb(render);
</script>
