---
import Layout from '../../../layouts/LayoutD.astro';
import Icon from '../../../components/Icon.astro';
import SolicitudEstado from '../../../components/director/SolicitudEstado.astro';
---

<Layout title="BLUD | Registrar solicitud">
	<section class="min-h-[calc(100vh-var(--header-h))] w-full bg-canvas px-4 py-8 text-ink sm:px-8">
		<div class="container-blud max-w-5xl space-y-6">
			<header class="border-b border-line pb-6">
				<a href="/director/solicitudes/solicitudes" class="mb-4 inline-flex items-center gap-2 text-sm font-semibold text-ink-2 hover:text-accent-ink">
					<Icon name="caret-down" class="size-4 rotate-90" />
					Volver a solicitudes
				</a>
				<p class="text-xs font-bold uppercase tracking-wider text-accent-ink">Gestión de insumos</p>
				<h1 class="mt-1 text-2xl font-extrabold tracking-tight sm:text-3xl">Registrar solicitud</h1>
				<p class="mt-1 text-sm text-ink-2">Registra la necesidad de un centro para incorporarla a la cola de revisión.</p>
			</header>

			<div id="form-panel" class="panel p-5 sm:p-7">
				<form id="request-form" class="space-y-7">
					<fieldset class="space-y-4">
						<legend class="text-sm font-bold text-ink">Centro y responsable</legend>
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
							<div class="space-y-1.5">
								<label for="center" class="text-xs font-bold uppercase tracking-wider text-ink-2">Centro solicitante</label>
								<select id="center" name="center" class="field" required>
									<option value="">Selecciona un centro</option>
									<option>Hospital Central</option>
									<option>Clínica San José</option>
									<option>Clínica del Valle</option>
									<option>Otro centro autorizado</option>
								</select>
							</div>
							<div class="space-y-1.5">
								<label for="requester" class="text-xs font-bold uppercase tracking-wider text-ink-2">Nombre del solicitante</label>
								<input id="requester" name="requester" class="field" autocomplete="name" placeholder="Nombre y apellido" required maxlength="100" />
							</div>
							<div class="space-y-1.5">
								<label for="service" class="text-xs font-bold uppercase tracking-wider text-ink-2">Servicio o área</label>
								<input id="service" name="service" class="field" placeholder="Ej. Unidad de cuidados intensivos" required maxlength="100" />
							</div>
							<div class="space-y-1.5">
								<label for="patient-code" class="text-xs font-bold uppercase tracking-wider text-ink-2">Código interno del paciente</label>
								<input id="patient-code" name="patientCode" class="field" placeholder="Sin datos identificables" maxlength="40" />
							</div>
						</div>
					</fieldset>

					<fieldset class="space-y-4 border-t border-line pt-6">
						<legend class="text-sm font-bold text-ink">Requisición</legend>
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
							<div class="space-y-1.5">
								<label for="component" class="text-xs font-bold uppercase tracking-wider text-ink-2">Hemocomponente</label>
								<select id="component" name="component" class="field" required>
									<option value="">Selecciona un componente</option>
									<option>Glóbulos rojos</option>
									<option>Plaquetas</option>
									<option>Plasma fresco</option>
									<option>Crioprecipitado</option>
								</select>
							</div>
							<div class="space-y-1.5">
								<label for="group" class="text-xs font-bold uppercase tracking-wider text-ink-2">Grupo sanguíneo</label>
								<select id="group" name="group" class="field" required>
									<option value="">Selecciona el grupo</option>
									<option>O+</option><option>O-</option><option>A+</option><option>A-</option>
									<option>B+</option><option>B-</option><option>AB+</option><option>AB-</option>
								</select>
							</div>
							<div class="space-y-1.5">
								<label for="quantity" class="text-xs font-bold uppercase tracking-wider text-ink-2">Unidades requeridas</label>
								<input id="quantity" name="quantity" type="number" class="field" min="1" max="100" step="1" value="1" required />
							</div>
							<div class="space-y-1.5">
								<label for="priority" class="text-xs font-bold uppercase tracking-wider text-ink-2">Prioridad clínica</label>
								<select id="priority" name="priority" class="field" required>
									<option>Normal</option><option>Urgente</option><option>Crítica</option>
								</select>
							</div>
							<div class="space-y-1.5 sm:col-span-1 lg:col-span-2">
								<label for="needed-by" class="text-xs font-bold uppercase tracking-wider text-ink-2">Requerido para</label>
								<input id="needed-by" name="neededBy" type="datetime-local" class="field" required />
							</div>
							<div class="space-y-1.5 sm:col-span-2 lg:col-span-3">
								<label for="reason" class="text-xs font-bold uppercase tracking-wider text-ink-2">Justificación clínica</label>
								<textarea id="reason" name="reason" class="field min-h-28 resize-y" placeholder="Describe brevemente la necesidad, sin incluir datos personales sensibles." required maxlength="600"></textarea>
							</div>
						</div>
					</fieldset>

					<div class="flex flex-col-reverse gap-3 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between">
						<p class="max-w-xl text-xs leading-relaxed text-ink-3">La solicitud se registrará como pendiente. No incluyas nombres, documentos ni otros datos personales del paciente.</p>
						<button type="submit" class="btn btn-primary text-sm">
							<Icon name="first-aid-kit" class="size-4" />
							Enviar solicitud
						</button>
					</div>
				</form>
			</div>

			<section id="request-success" class="panel hidden border border-ok/30 p-6" role="status" aria-live="polite">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-start">
					<span class="grid size-11 shrink-0 place-items-center rounded-control bg-ok-soft text-ok"><Icon name="arrow-right" class="size-5" /></span>
					<div class="flex-1">
						<h2 class="text-lg font-bold">Solicitud registrada</h2>
						<p class="mt-1 text-sm text-ink-2">Folio <strong id="created-request-id" class="font-mono text-ink"></strong> · <SolicitudEstado status="Pendiente" /></p>
						<p class="mt-2 text-sm text-ink-2">Ya está en la cola de solicitudes pendientes para su revisión.</p>
						<a href="/director/solicitudes/solicitudes" class="btn btn-secondary mt-5 text-sm">Ver solicitudes</a>
					</div>
				</div>
			</section>
		</div>
	</section>
</Layout>

<script>
	import { solicitudesIniciales, type Solicitud } from '../../../data/solicitudes';

	type RequestItem = Solicitud;
	const storageKey = 'blud-director-solicitudes';
	const form = document.querySelector<HTMLFormElement>('#request-form');
	const neededBy = document.querySelector<HTMLInputElement>('#needed-by');
	const date = new Date();
	date.setMinutes(date.getMinutes() - date.getTimezoneOffset());
	if (neededBy) neededBy.min = date.toISOString().slice(0, 16);

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!form.reportValidity()) return;
		const formData = new FormData(form);
		let requests: RequestItem[] = solicitudesIniciales.map((request) => ({ ...request }));
		try {
			const saved = localStorage.getItem(storageKey);
			if (saved) requests = JSON.parse(saved) as RequestItem[];
		} catch {}
		const id = `REQ-${new Date().getFullYear()}-${String(Date.now()).slice(-5)}`;
		const request: RequestItem = {
			id,
			component: String(formData.get('component')),
			group: String(formData.get('group')),
			quantity: Number(formData.get('quantity')),
			center: `${String(formData.get('center'))} · ${String(formData.get('service'))}`,
			requester: String(formData.get('requester')),
			priority: String(formData.get('priority')),
			createdAt: new Date().toISOString(),
			status: 'Pendiente',
			service: String(formData.get('service')),
			patientCode: String(formData.get('patientCode')),
			neededBy: String(formData.get('neededBy')),
			reason: String(formData.get('reason')),
		};
		requests.unshift(request);
		try { localStorage.setItem(storageKey, JSON.stringify(requests)); } catch {}
		document.querySelector('#created-request-id')!.textContent = id;
		document.querySelector('#form-panel')?.classList.add('hidden');
		document.querySelector('#request-success')?.classList.remove('hidden');
		document.querySelector('#request-success')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
	});
</script>
