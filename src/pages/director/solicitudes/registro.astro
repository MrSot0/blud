---
// src/pages/director/solicitudes/registro.astro
// Solicitud de transfusión cargada por la dirección (nace aprobada). Con ?id= edita una existente.
import Layout from '../../../layouts/LayoutD.astro';
import { BLOOD_TYPES, COMPONENTES } from '../../../lib/db';
import { centers } from '../../../data/centers';

const prioridades = [
  { id: 'normal', label: 'Normal', hint: 'Programada' },
  { id: 'urgente', label: 'Urgente', hint: 'En las próximas horas' },
  { id: 'critica', label: 'Crítica', hint: 'Riesgo vital inmediato' },
];
const laboratorio = [
  { id: 'Hb', label: 'Hemoglobina', unidad: 'g/dL' },
  { id: 'Hcto', label: 'Hematocrito', unidad: '%' },
  { id: 'Plaquetas', label: 'Plaquetas', unidad: '/mm³' },
  { id: 'TP', label: 'TP', unidad: 's' },
  { id: 'TPT', label: 'TPT', unidad: 's' },
];
---

<Layout title="BLUD | Nueva solicitud">
  <div class="container-blud max-w-4xl py-8 space-y-6">
    <div class="pb-6 border-b border-line">
      <a href="/director/solicitudes/historial" class="link-arrow text-sm">← Volver a solicitudes</a>
      <h1 class="mt-3 text-2xl sm:text-3xl font-extrabold tracking-tight text-ink" id="titulo">Nueva solicitud de transfusión</h1>
      <p class="text-ink-2 text-sm sm:text-base mt-1" id="subtitulo">Lo que registra la dirección queda aprobado y pasa directo a despacho.</p>
    </div>

    <form id="form" class="space-y-6" novalidate>
      <section class="panel p-6 sm:p-8 space-y-5" aria-labelledby="h-paciente">
        <h2 id="h-paciente" class="text-lg font-bold text-ink">Paciente</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block sm:col-span-2"><span class="mb-1.5 block text-sm font-semibold text-ink">Nombre completo</span>
            <input name="pacienteNombre" class="field" required autocomplete="off" placeholder="Ej. Roberto Gómez" /></label>
          <label class="block"><span class="mb-1.5 block text-sm font-semibold text-ink">Cédula</span>
            <input name="pacienteCedula" class="field" autocomplete="off" placeholder="V-12345678" /></label>
          <label class="block"><span class="mb-1.5 block text-sm font-semibold text-ink">Servicio</span>
            <input name="servicio" class="field" autocomplete="off" placeholder="Ej. UCI, Emergencia" /></label>
          <label class="block"><span class="mb-1.5 block text-sm font-semibold text-ink">Médico solicitante</span>
            <input name="medico" class="field" autocomplete="off" placeholder="Ej. Dra. Elena Ríos" /></label>
          <label class="block"><span class="mb-1.5 block text-sm font-semibold text-ink">Diagnóstico</span>
            <input name="diagnostico" class="field" autocomplete="off" placeholder="Motivo de la transfusión" /></label>
        </div>
      </section>

      <section class="panel p-6 sm:p-8 space-y-5" aria-labelledby="h-pedido">
        <h2 id="h-pedido" class="text-lg font-bold text-ink">Qué se necesita</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block sm:col-span-2"><span class="mb-1.5 block text-sm font-semibold text-ink">Centro de destino</span>
            <input name="hospitalDestino" class="field" required list="centros" autocomplete="off" placeholder="Escribe o elige un centro" />
            <datalist id="centros">{centers.map((c) => <option value={c.name} />)}</datalist></label>
          <label class="block"><span class="mb-1.5 block text-sm font-semibold text-ink">Tipo de sangre</span>
            <select name="tipoSangre" class="field" required>
              <option value="">Elige el tipo</option>
              {BLOOD_TYPES.map((t) => <option value={t}>{t}</option>)}
            </select></label>
          <label class="block"><span class="mb-1.5 block text-sm font-semibold text-ink">Hemocomponente</span>
            <select name="tipoHemocomponente" class="field" required>
              {COMPONENTES.map((c) => <option value={c}>{c}</option>)}
            </select></label>
          <label class="block"><span class="mb-1.5 block text-sm font-semibold text-ink">Unidades</span>
            <input name="unidades" type="number" min="1" max="20" value="1" class="field" required /></label>
          <p class="self-end rounded-control bg-sunken px-4 py-3 text-sm text-ink-2" id="stock-hint" aria-live="polite">Elige tipo y hemocomponente para ver el stock.</p>
        </div>
        <fieldset>
          <legend class="mb-2 text-sm font-semibold text-ink">Prioridad</legend>
          <div class="grid gap-2 sm:grid-cols-3">
            {prioridades.map((p, i) => (
              <label class="prio cursor-pointer">
                <input type="radio" name="prioridad" value={p.id} class="sr-only" checked={i === 0} />
                <span class="block rounded-control border border-line-strong p-3">
                  <span class="block font-semibold text-ink">{p.label}</span>
                  <span class="block text-xs text-ink-3">{p.hint}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
        <label class="flex items-start gap-2 text-sm text-ink-2">
            <input type="checkbox" name="consentimiento" class="mt-0.5 size-4 accent-[var(--accent)]" />
            <span>El paciente (o su representante) firmó el consentimiento informado. <span class="text-ink-3">En emergencias puede omitirse.</span></span>
          </label>
      </section>

      <section class="panel p-6 sm:p-8 space-y-5" aria-labelledby="h-lab">
        <div>
          <h2 id="h-lab" class="text-lg font-bold text-ink">Laboratorio del paciente <span class="text-sm font-normal text-ink-3">(opcional)</span></h2>
          <p class="mt-1 text-sm text-ink-3">Ayuda a justificar la indicación.</p>
        </div>
        <div class="grid gap-4 grid-cols-2 sm:grid-cols-5">
          {laboratorio.map((l) => (
            <label class="block"><span class="mb-1.5 block text-sm font-semibold text-ink">{l.label} <span class="font-normal text-ink-3">{l.unidad}</span></span>
              <input name={`lab-${l.id}`} data-lab={l.id} inputmode="decimal" class="field" autocomplete="off" /></label>
          ))}
        </div>
      </section>

      <p id="error" class="hidden rounded-control bg-accent-soft px-4 py-3 text-sm font-medium text-accent-ink" role="alert"></p>
      <div class="flex flex-wrap justify-end gap-2">
        <a href="/director/solicitudes/historial" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary" id="btn-guardar">Registrar solicitud</button>
      </div>
    </form>
  </div>
</Layout>

<style>
  .prio input:checked + span { border-color: var(--accent); background: var(--accent-soft); }
  .prio input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>

<script>
  import { actualizarSolicitud, codigoPedido, crearSolicitud, getSolicitud, toast, unidadesInventario } from '../../../lib/director';
  import type { DatosPedido, Hemocomponente } from '../../../lib/director';

  const form = document.getElementById('form') as HTMLFormElement;
  const error = document.getElementById('error')!;
  const hint = document.getElementById('stock-hint')!;
  const editId = new URLSearchParams(location.search).get('id');
  const campo = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;

  function actualizarHint() {
    const tipo = campo('tipoSangre').value;
    const comp = campo('tipoHemocomponente').value;
    if (!tipo) return void (hint.textContent = 'Elige tipo y hemocomponente para ver el stock.');
    const n = unidadesInventario().filter((u) => u.estado !== 'vencida' && u.tipoSangre === tipo && u.componente === comp).length;
    hint.textContent = n ? `Hay ${n} u. vigentes de ${tipo} · ${comp}.` : `No hay ${tipo} · ${comp} en stock: se despachará cuando haya.`;
  }

  if (editId) {
    const p = getSolicitud(editId);
    if (!p) {
      toast('No encontramos esa solicitud.');
    } else {
      document.getElementById('titulo')!.textContent = `Editar solicitud ${codigoPedido(p.id)}`;
      document.getElementById('subtitulo')!.textContent = 'Los cambios no alteran su estado de aprobación.';
      document.getElementById('btn-guardar')!.textContent = 'Guardar cambios';
      (['pacienteNombre', 'pacienteCedula', 'servicio', 'medico', 'diagnostico', 'hospitalDestino', 'tipoSangre', 'tipoHemocomponente'] as const)
        .forEach((k) => (campo(k).value = String(p[k] ?? '')));
      campo('unidades').value = String(p.unidades);
      form.querySelector<HTMLInputElement>(`input[name="prioridad"][value="${p.prioridad ?? 'normal'}"]`)!.checked = true;
      Object.entries(p.clinica ?? {}).forEach(([k, v]) => {
        const el = form.querySelector<HTMLInputElement>(`[data-lab="${k}"]`);
        if (el) el.value = v;
      });
      form.querySelector<HTMLInputElement>('[name="consentimiento"]')!.checked = p.clinica?.consentimiento === 'si';
    }
  }

  form.addEventListener('change', actualizarHint);
  actualizarHint();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const clinica: Record<string, string> = {};
    form.querySelectorAll<HTMLInputElement>('[data-lab]').forEach((el) => {
      if (el.value.trim()) clinica[el.dataset.lab!] = el.value.trim();
    });
    if (f.get('consentimiento')) clinica.consentimiento = 'si';
    const datos: DatosPedido = {
      pacienteNombre: String(f.get('pacienteNombre') ?? ''),
      pacienteCedula: String(f.get('pacienteCedula') ?? ''),
      servicio: String(f.get('servicio') ?? '').trim() || undefined,
      medico: String(f.get('medico') ?? '').trim() || undefined,
      diagnostico: String(f.get('diagnostico') ?? '').trim() || undefined,
      hospitalDestino: String(f.get('hospitalDestino') ?? ''),
      tipoSangre: String(f.get('tipoSangre') ?? ''),
      tipoHemocomponente: String(f.get('tipoHemocomponente') ?? '') as Hemocomponente,
      unidades: Number(f.get('unidades')),
      prioridad: (String(f.get('prioridad') ?? 'normal') as DatosPedido['prioridad']),
      clinica: Object.keys(clinica).length ? clinica : undefined,
    };
    const r = editId ? actualizarSolicitud(editId, datos) : crearSolicitud(datos);
    if (!r.ok) {
      error.textContent = r.motivo;
      error.classList.remove('hidden');
      return;
    }
    toast(editId ? 'Cambios guardados.' : `Solicitud ${codigoPedido(r.data.id)} registrada y aprobada.`);
    setTimeout(() => (location.href = '/director/solicitudes/solicitudes'), 700);
  });
</script>
