---
// src/pages/director/solicitudes/historial.astro
// Todas las solicitudes de hemocomponentes. La dirección aprueba o rechaza las que cargan los operadores.
import Layout from '../../../layouts/LayoutD.astro';

const filtros = [
  { id: 'pendiente', label: 'Por aprobar' },
  { id: 'aprobado', label: 'Aprobadas' },
  { id: 'rechazado', label: 'Rechazadas' },
  { id: 'despachado', label: 'Despachadas' },
  { id: 'todas', label: 'Todas' },
];
---

<Layout title="BLUD | Solicitudes">
  <div class="container-blud py-8 space-y-6">
    <div class="pb-6 border-b border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Solicitudes</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Las que carga el operador esperan tu aprobación antes del despacho.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/director/solicitudes/registro" class="btn btn-primary">Nueva solicitud</a>
        <a href="/director/solicitudes/solicitudes" class="btn btn-secondary">Mis solicitudes</a>
      </div>
    </div>

    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por estado">
        {filtros.map((f, i) => (
          <button type="button" class="estado-chip" data-estado={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label} <span class="tabular opacity-70" data-count={f.id}></span>
          </button>
        ))}
      </div>
      <div class="flex flex-col gap-2 sm:flex-row">
        <label class="sr-only" for="buscar">Buscar solicitud</label>
        <input id="buscar" type="search" class="field sm:w-72" placeholder="Folio, paciente, centro o médico" autocomplete="off" />
        <label class="sr-only" for="prioridad">Prioridad</label>
        <select id="prioridad" class="field sm:w-44">
          <option value="">Toda prioridad</option>
          <option value="critica">Crítica</option>
          <option value="urgente">Urgente</option>
          <option value="normal">Normal</option>
        </select>
      </div>
    </div>

    <ul id="lista" class="space-y-3" aria-live="polite"></ul>
  </div>
</Layout>

<style>
  .estado-chip {
    display: inline-flex; align-items: center; gap: 0.375rem; min-height: 2.25rem; padding: 0 0.875rem;
    border-radius: 999px; border: 1px solid var(--line-strong); background: var(--surface);
    font-size: 0.875rem; font-weight: 600; color: var(--ink-2); transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .estado-chip:hover { border-color: var(--ink-3); color: var(--ink); }
  .estado-chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--canvas); }
</style>

<script>
  import {
    ESTADO_PEDIDO, PRIORIDAD_LABEL, aprobarSolicitud, codigoPedido, esc, fmtFecha, onDb, rechazarSolicitud,
    todasLasSolicitudes, toast, unidadesInventario,
  } from '../../../lib/director';
  import type { PedidoOp } from '../../../lib/director';

  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
  const buscar = $('#buscar') as HTMLInputElement;
  const prioridad = $('#prioridad') as HTMLSelectElement;
  let estado = 'pendiente';
  let rechazando: string | null = null;
  const abiertas = new Set<string>();

  const chipEstado: Record<PedidoOp['estado'], string> = {
    pendiente: 'bg-warn-soft text-warn',
    aprobado: 'bg-ok-soft text-ok',
    rechazado: 'bg-accent-soft text-accent-ink',
    despachado: 'bg-sunken text-ink-2',
  };
  const chipPrioridad = (p?: string) =>
    p === 'critica' ? 'bg-accent text-white' : p === 'urgente' ? 'bg-accent-soft text-accent-ink' : 'bg-sunken text-ink-2';
  const fecha = (iso?: string) => (iso ? fmtFecha(iso, { day: 'numeric', month: 'short', year: 'numeric' }) : '—');

  /** Unidades vigentes del tipo y componente pedidos: ayuda a decidir si aprobar. */
  function stockPara(p: PedidoOp) {
    return unidadesInventario().filter((u) => u.estado !== 'vencida' && u.tipoSangre === p.tipoSangre && u.componente === p.tipoHemocomponente).length;
  }

  function detalle(p: PedidoOp) {
    const clinica = Object.entries(p.clinica ?? {}).filter(([, v]) => v);
    const filas: [string, string | undefined][] = [
      ['Paciente', `${p.pacienteNombre}${p.pacienteCedula ? ' · ' + p.pacienteCedula : ''}`],
      ['Servicio', p.servicio], ['Médico', p.medico], ['Diagnóstico', p.diagnostico],
      ['Cargada por', `${p.creadoPorNombre ?? '—'} · ${fecha(p.fecha)}`],
      ['Revisión', p.fechaRevision ? `${p.revisadoPorNombre ?? 'Dirección'} · ${fecha(p.fechaRevision)}` : undefined],
      ['Motivo del rechazo', p.motivoRechazo],
    ];
    return `<dl class="mt-4 grid gap-x-6 gap-y-2 border-t border-line pt-4 text-sm sm:grid-cols-2">
      ${filas.filter(([, v]) => v).map(([k, v]) => `<div><dt class="text-xs font-bold uppercase text-ink-3">${esc(k)}</dt><dd class="text-ink">${esc(v)}</dd></div>`).join('')}
      ${clinica.length ? `<div class="sm:col-span-2"><dt class="text-xs font-bold uppercase text-ink-3">Laboratorio del paciente</dt><dd class="text-ink">${clinica.map(([k, v]) => `${esc(k)}: ${esc(v)}`).join(' · ')}</dd></div>` : ''}
    </dl>`;
  }

  function fila(p: PedidoOp) {
    const stock = stockPara(p);
    const acciones = p.estado === 'pendiente'
      ? `<button type="button" class="btn btn-primary btn-sm" data-accion="aprobar" data-id="${esc(p.id)}">Aprobar</button>
         <button type="button" class="btn btn-secondary btn-sm" data-accion="rechazar" data-id="${esc(p.id)}">Rechazar</button>`
      : p.estado === 'aprobado'
        ? `<button type="button" class="btn btn-secondary btn-sm" data-accion="rechazar" data-id="${esc(p.id)}">Anular</button>`
        : '';
    const formRechazo = rechazando === p.id
      ? `<form class="mt-4 flex flex-col gap-2 border-t border-line pt-4 sm:flex-row" data-form-rechazo="${esc(p.id)}">
          <label class="sr-only" for="motivo-${esc(p.id)}">Motivo del rechazo</label>
          <input id="motivo-${esc(p.id)}" name="motivo" class="field flex-1" placeholder="Motivo (lo verá el operador)" required minlength="5" />
          <div class="flex gap-2"><button type="submit" class="btn btn-primary btn-sm">Confirmar</button>
          <button type="button" class="btn btn-secondary btn-sm" data-accion="cancelar">Cancelar</button></div>
        </form>`
      : '';
    return `<li class="panel p-5">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <button type="button" class="min-w-0 text-left" data-accion="detalle" data-id="${esc(p.id)}" aria-expanded="${abiertas.has(p.id)}">
          <p class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs font-bold text-ink-3">${esc(codigoPedido(p.id))}</span>
            <span class="rounded-full px-2 py-0.5 text-[0.6875rem] font-bold ${chipEstado[p.estado]}">${esc(ESTADO_PEDIDO[p.estado])}</span>
            <span class="rounded-full px-2 py-0.5 text-[0.6875rem] font-bold ${chipPrioridad(p.prioridad)}">${esc(PRIORIDAD_LABEL[p.prioridad ?? 'normal'])}</span>
          </p>
          <p class="mt-1 font-semibold text-ink">${p.unidades} u. ${esc(p.tipoSangre)} · ${esc(p.tipoHemocomponente)}</p>
          <p class="text-sm text-ink-3">${esc(p.pacienteNombre)} → ${esc(p.hospitalDestino)} · ${esc(fecha(p.fecha))}</p>
        </button>
        <div class="flex shrink-0 flex-wrap items-center gap-2">
          ${p.estado === 'pendiente' || p.estado === 'aprobado'
            ? `<span class="rounded-full px-2 py-0.5 text-xs font-bold ${stock >= p.unidades ? 'bg-ok-soft text-ok' : 'bg-warn-soft text-warn'}">${stock >= p.unidades ? `Hay stock (${stock})` : `Stock ${stock}`}</span>`
            : ''}
          ${acciones}
        </div>
      </div>
      ${abiertas.has(p.id) ? detalle(p) : ''}
      ${formRechazo}
    </li>`;
  }

  function render() {
    const todas = todasLasSolicitudes();
    const q = buscar.value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const id = el.dataset.count!;
      const n = id === 'todas' ? todas.length : todas.filter((p) => p.estado === id).length;
      el.textContent = String(n);
    });
    const lista = todas
      .filter((p) => estado === 'todas' || p.estado === estado)
      .filter((p) => !prioridad.value || (p.prioridad ?? 'normal') === prioridad.value)
      .filter((p) => !q || `${codigoPedido(p.id)} ${p.pacienteNombre} ${p.hospitalDestino} ${p.medico ?? ''} ${p.creadoPorNombre ?? ''}`.toLowerCase().includes(q));
    $('#lista').innerHTML = lista.length
      ? lista.map(fila).join('')
      : `<li class="panel p-10 text-center text-sm text-ink-3">${estado === 'pendiente' ? 'No hay solicitudes esperando tu aprobación.' : 'No hay solicitudes con esos filtros.'}</li>`;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-estado]').forEach((b) =>
    b.addEventListener('click', () => {
      estado = b.dataset.estado!;
      document.querySelectorAll('[data-estado]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    })
  );
  buscar.addEventListener('input', render);
  prioridad.addEventListener('change', render);

  $('#lista').addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-accion]');
    if (!el) return;
    const id = el.dataset.id!;
    switch (el.dataset.accion) {
      case 'detalle':
        abiertas.has(id) ? abiertas.delete(id) : abiertas.add(id);
        render();
        break;
      case 'aprobar': {
        const r = aprobarSolicitud(id);
        toast(r.ok ? `Solicitud ${codigoPedido(id)} aprobada: ya puede despacharse.` : r.motivo);
        break;
      }
      case 'rechazar':
        rechazando = id;
        render();
        document.querySelector<HTMLInputElement>(`#motivo-${CSS.escape(id)}`)?.focus();
        break;
      case 'cancelar':
        rechazando = null;
        render();
        break;
    }
  });

  $('#lista').addEventListener('submit', (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('[data-form-rechazo]');
    if (!form) return;
    e.preventDefault();
    const id = form.dataset.formRechazo!;
    const r = rechazarSolicitud(id, String(new FormData(form).get('motivo') ?? ''));
    if (!r.ok) return toast(r.motivo);
    rechazando = null;
    toast(`Solicitud ${codigoPedido(id)} rechazada.`);
  });

  render();
  onDb(render);
</script>
