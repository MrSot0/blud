---
// src/pages/director/estadisticas.astro
// Mapa de calor de donaciones: qué centros donan más y cuándo. Matriz centro × periodo, mapa de la red,
// ranking y un resumen en texto que se puede copiar o descargar como PDF con la marca de BLUD.
import Layout from '../../layouts/LayoutD.astro';
---

<Layout title="BLUD | Mapa de calor de donaciones">
  <div class="container-blud py-6 sm:py-8 space-y-6" data-estadisticas>
    <div class="page-head">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Mapa de calor de donaciones</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Dónde se concentran las donaciones de la red y qué centros captan más.</p>
      </div>
      <div class="page-head-acciones">
        <button type="button" class="btn btn-secondary" data-copiar>Copiar resumen</button>
        <button type="button" class="btn btn-primary" data-pdf>
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="m7 10 5 5 5-5"/><path d="M21 21H3"/></svg>
          Descargar PDF
        </button>
      </div>
    </div>

    <!-- Filtros: una fila sobre todo lo que filtran -->
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between" aria-label="Filtros">
      <div class="chips-scroll" role="group" aria-label="Periodo">
        <button type="button" class="seg-chip" data-rango="3m">3 meses</button>
        <button type="button" class="seg-chip" data-rango="6m" aria-pressed="true">6 meses</button>
        <button type="button" class="seg-chip" data-rango="12m">12 meses</button>
        <button type="button" class="seg-chip" data-rango="todo">Todo</button>
      </div>
      <div class="grid grid-cols-2 gap-2 sm:flex">
        <div class="segmentado" role="group" aria-label="Agrupar por">
          <button type="button" data-agr="mes" aria-pressed="true">Mes</button>
          <button type="button" data-agr="semana" aria-pressed="false">Semana</button>
        </div>
        <div class="segmentado" role="group" aria-label="Medir">
          <button type="button" data-met="donaciones" aria-pressed="true">Donaciones</button>
          <button type="button" data-met="litros" aria-pressed="false">Litros</button>
        </div>
      </div>
    </div>

    <!-- Mapa de calor geográfico: densidad de donaciones sobre el mapa de la red -->
    <section class="panel overflow-hidden" aria-labelledby="h-mapa">
      <div class="flex flex-wrap items-end justify-between gap-3 p-4 sm:px-6 sm:pt-5 sm:pb-4">
        <div>
          <h2 id="h-mapa" class="text-lg font-bold text-ink">Mapa de calor de la red</h2>
          <p class="text-xs text-ink-3" data-mapa-nota>Cada donación suma calor alrededor del centro donde se hizo.</p>
        </div>
        <div class="flex items-center gap-2 text-xs text-ink-3">
          <span>Menos</span><span class="h-2.5 w-28 rounded-full" data-leyenda></span><span>Más</span>
        </div>
      </div>
      <div class="relative">
        <div class="mapa-calor h-[26rem] sm:h-[34rem] bg-sunken" data-mapa></div>
        <!-- Controles: flotan sobre el mapa en escritorio; en móvil van debajo, plegables -->
        <details class="controles-calor" data-controles>
          <summary class="flex cursor-pointer items-center justify-between gap-3 text-sm font-bold text-ink">
            Controles del mapa
            <svg viewBox="0 0 24 24" class="chev size-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="mt-3 space-y-3 text-sm">
            <label class="block"><span class="flex justify-between text-xs font-semibold text-ink-2">Radio <span class="tabular text-ink-3" data-v="radio"></span></span>
              <input type="range" min="15" max="90" step="1" value="40" class="w-full accent-[var(--accent)]" data-ctl="radio" /></label>
            <label class="block"><span class="flex justify-between text-xs font-semibold text-ink-2">Desenfoque <span class="tabular text-ink-3" data-v="blur"></span></span>
              <input type="range" min="5" max="45" step="1" value="25" class="w-full accent-[var(--accent)]" data-ctl="blur" /></label>
            <label class="block"><span class="flex justify-between text-xs font-semibold text-ink-2">Opacidad <span class="tabular text-ink-3" data-v="opacidad"></span></span>
              <input type="range" min="20" max="100" step="5" value="85" class="w-full accent-[var(--accent)]" data-ctl="opacidad" /></label>
            <fieldset>
              <legend class="mb-1.5 text-xs font-semibold text-ink-2">Escala de color</legend>
              <div class="grid grid-cols-2 gap-1.5">
                <label class="escala"><input type="radio" name="escala" value="clasica" class="sr-only" checked /><span class="block h-3 rounded-full escala-clasica"></span><span class="text-xs">Clásica</span></label>
                <label class="escala"><input type="radio" name="escala" value="blud" class="sr-only" /><span class="block h-3 rounded-full escala-blud"></span><span class="text-xs">BLUD</span></label>
              </div>
            </fieldset>
            <label class="flex items-center gap-2 text-sm text-ink"><input type="checkbox" checked class="size-4 accent-[var(--accent)]" data-ctl="puntos" /> Mostrar centros y totales</label>
            <button type="button" class="text-xs font-semibold text-accent-ink hover:underline" data-ctl="reset">Restablecer</button>
          </div>
        </details>
      </div>
    </section>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4" data-kpis aria-live="polite"></div>

    <div class="grid gap-6 lg:grid-cols-2 items-start">
      <section class="panel p-4 sm:p-6 space-y-4" aria-labelledby="h-ranking">
        <h2 id="h-ranking" class="text-lg font-bold text-ink">Ranking de centros</h2>
        <ol class="space-y-3" data-ranking></ol>
      </section>
      <section class="panel p-4 sm:p-6 space-y-3" aria-labelledby="h-resumen">
        <h2 id="h-resumen" class="text-lg font-bold text-ink">Resumen</h2>
        <ul class="space-y-2 text-sm leading-relaxed text-ink-2" data-resumen></ul>
      </section>
    </div>

    <section class="panel p-4 sm:p-6 space-y-4" aria-labelledby="h-calor">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="h-calor" class="text-lg font-bold text-ink">Detalle por centro y periodo</h2>
          <p class="text-xs text-ink-3" data-calor-nota></p>
        </div>
        <div class="flex items-center gap-2 text-xs text-ink-3" aria-hidden="true">
          <span>Menos</span>
          <span class="flex gap-0.5">{[1, 2, 3, 4, 5, 6].map((n) => <span class={`h-3 w-4 rounded-[3px] calor-${n}`}></span>)}</span>
          <span>Más</span>
        </div>
      </div>
      <div class="calor-scroll" role="region" aria-labelledby="h-calor" tabindex="0">
        <table class="calor" data-calor></table>
      </div>
      <p class="hidden py-8 text-center text-sm text-ink-3" data-calor-vacio>No hay donaciones registradas en este periodo.</p>
    </section>

  </div>

  <div class="calor-tip" role="tooltip" data-tip hidden></div>
</Layout>

<style is:global>
  /* Escala secuencial de una sola tonalidad (rojo BLUD), de la superficie al acento. En modo oscuro
     parte de la superficie oscura, así que el ancla se invierte sola: poco = cerca del fondo. */
  [data-estadisticas] .calor-0 { background: var(--sunken); }
  [data-estadisticas] .calor-1 { background: color-mix(in oklab, var(--accent) 12%, var(--surface)); }
  [data-estadisticas] .calor-2 { background: color-mix(in oklab, var(--accent) 26%, var(--surface)); }
  [data-estadisticas] .calor-3 { background: color-mix(in oklab, var(--accent) 42%, var(--surface)); }
  [data-estadisticas] .calor-4 { background: color-mix(in oklab, var(--accent) 60%, var(--surface)); }
  [data-estadisticas] .calor-5 { background: color-mix(in oklab, var(--accent) 80%, var(--surface)); }
  [data-estadisticas] .calor-6 { background: var(--accent); }

  [data-estadisticas] .controles-calor {
    border-top: 1px solid var(--line); background: var(--surface); padding: 0.875rem 1rem;
  }
  [data-estadisticas] .controles-calor[open] .chev { transform: rotate(180deg); }
  @media (min-width: 768px) {
    [data-estadisticas] .controles-calor {
      position: absolute; top: 0.75rem; left: 3.5rem; z-index: 500; width: 15rem; border: 1px solid var(--line);
      border-radius: 0.75rem; box-shadow: 0 12px 32px -14px rgb(0 0 0 / 0.35);
    }
  }
  [data-estadisticas] .escala { display: grid; gap: 0.25rem; padding: 0.375rem; border-radius: 0.5rem; border: 1px solid var(--line); cursor: pointer; }
  [data-estadisticas] .escala:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  [data-estadisticas] .escala:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  [data-estadisticas] .escala-clasica { background: linear-gradient(90deg, #2b2bd9, #00c8ff, #22d36b, #ffe600, #ff7a00, #e00000); }
  [data-estadisticas] .escala-blud { background: linear-gradient(90deg, #fbe0e0, #f29c9c, #e2574f, #ca2b2b, #8a0006); }
  [data-estadisticas] .punto-centro {
    display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 999px; background: #fff;
    border: 2px solid #ca2b2b; color: #151a23; font: 800 0.6875rem/1 system-ui, sans-serif; box-shadow: 0 2px 6px rgb(0 0 0 / 0.3);
  }
  [data-estadisticas] .punto-centro.vacio { border-color: #8b95a5; color: #616b7c; width: 1.25rem; height: 1.25rem; }
  [data-estadisticas] .calor-scroll { overflow-x: auto; overscroll-behavior-x: contain; }
  [data-estadisticas] .calor { border-collapse: separate; border-spacing: 2px; min-width: 100%; font-size: 0.8125rem; }
  [data-estadisticas] .calor th { font-weight: 600; color: var(--ink-3); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.03em; padding: 0 0.25rem 0.25rem; white-space: nowrap; }
  [data-estadisticas] .calor tbody th, [data-estadisticas] .calor tfoot th {
    position: sticky; left: 0; z-index: 1; background: var(--surface); text-align: left; text-transform: none; letter-spacing: 0;
    font-size: 0.8125rem; color: var(--ink); max-width: 11rem; overflow: hidden; text-overflow: ellipsis; padding-right: 0.75rem;
  }
  [data-estadisticas] .calor td { padding: 0; }
  [data-estadisticas] .calor thead th:first-child { text-align: left; position: sticky; left: 0; z-index: 1; background: var(--surface); }
  [data-estadisticas] .calor .celda {
    display: grid; place-items: center; width: 100%; min-width: 2.75rem; height: 2.25rem; border-radius: 6px;
    font-variant-numeric: tabular-nums; font-weight: 700; color: var(--ink); cursor: default; outline-offset: 2px;
  }
  [data-estadisticas] .calor .celda.calor-0 { color: var(--ink-3); font-weight: 500; }
  [data-estadisticas] .calor .celda.calor-4, [data-estadisticas] .calor .celda.calor-5, [data-estadisticas] .calor .celda.calor-6 { color: #fff; }
  [data-estadisticas] .calor .celda:hover, [data-estadisticas] .calor .celda:focus-visible { box-shadow: 0 0 0 2px var(--ink); }
  [data-estadisticas] .calor .total { font-weight: 800; color: var(--ink); text-align: right; padding-left: 0.5rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  [data-estadisticas] .calor tfoot td { font-weight: 700; color: var(--ink-2); text-align: center; font-variant-numeric: tabular-nums; padding-top: 0.375rem; font-size: 0.75rem; }

  .calor-tip {
    position: fixed; z-index: 60; pointer-events: none; max-width: 15rem; padding: 0.5rem 0.75rem; border-radius: 0.5rem;
    background: var(--ink); color: var(--canvas); font-size: 0.75rem; line-height: 1.35; box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.4);
  }
  .calor-tip strong { display: block; font-size: 1rem; font-variant-numeric: tabular-nums; }

  [data-estadisticas] .seg-chip {
    display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; white-space: nowrap;
    border-radius: 999px; border: 1px solid var(--line-strong); background: var(--surface);
    font-size: 0.875rem; font-weight: 600; color: var(--ink-2);
  }
  [data-estadisticas] .seg-chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--canvas); }
  [data-estadisticas] .segmentado { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; padding: 3px; gap: 2px; border-radius: 999px; background: var(--sunken); }
  [data-estadisticas] .segmentado button { min-height: 2.25rem; padding: 0 0.875rem; border-radius: 999px; font-size: 0.8125rem; font-weight: 600; color: var(--ink-2); white-space: nowrap; }
  [data-estadisticas] .segmentado button[aria-pressed="true"] { background: var(--surface); color: var(--ink); box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
</style>

<script>
  import { fmtFechaLarga, fmtNum, matriz, rangoDe, resumen, sedesMapa, variacion } from '../../lib/estadisticas';
  import type { Agrupacion, Matriz, Metrica, SedeMapa } from '../../lib/estadisticas';
  import { onDb, toast } from '../../lib/director';
  import { createMap, loadLeafletHeat, whenNearViewport } from '../../lib/map';

  type Rango = '3m' | '6m' | '12m' | 'todo';
  const root = document.querySelector<HTMLElement>('[data-estadisticas]')!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  let rango: Rango = '6m';
  let agr: Agrupacion = 'mes';
  let met: Metrica = 'donaciones';
  let sedes: SedeMapa[] = [];
  let m: Matriz | null = null;
  let lineasResumen: string[] = [];

  const paso = (v: number, max: number) => (!v || !max ? 0 : Math.min(6, Math.ceil((v / max) * 6)));
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', txt?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (txt !== undefined) n.textContent = txt;
    return n;
  };

  function kpis(mx: Matriz) {
    const v = variacion(mx);
    const lider = mx.filas[0];
    const iPico = mx.totalesPeriodo.indexOf(Math.max(0, ...mx.totalesPeriodo));
    const tarjetas: [string, string, string, string?][] = [
      [met === 'litros' ? 'Litros extraídos' : 'Donaciones', fmtNum(mx.total, met),
        v === null ? 'sin periodo anterior para comparar' : `${v >= 0 ? '+' : '−'}${Math.abs(Math.round(v))} % vs. periodo anterior`, v === null ? undefined : v >= 0 ? 'text-ok' : 'text-accent-ink'],
      ['Centros activos', `${mx.filas.length} de ${sedes.length || mx.filas.length}`, 'registraron al menos una donación'],
      ['Centro líder', lider ? lider.sede : '—', lider && mx.total ? `${Math.round((lider.total / mx.total) * 100)} % del total` : 'sin actividad'],
      ['Periodo pico', mx.total ? mx.periodos[iPico].label : '—', mx.total ? `${fmtNum(mx.totalesPeriodo[iPico], met)}${met === 'donaciones' ? ' donaciones' : ''}` : 'sin actividad'],
    ];
    const box = $('[data-kpis]');
    box.replaceChildren(...tarjetas.map(([t, val, nota, cls]) => {
      const c = el('div', 'panel p-4 sm:p-5 min-w-0');
      c.append(el('p', 'text-[0.6875rem] sm:text-xs font-bold uppercase text-ink-3', t),
        el('p', `mt-0.5 truncate font-extrabold text-ink tabular ${val.length > 12 ? 'text-base sm:text-lg leading-snug' : 'text-2xl sm:text-3xl'}`, val),
        el('p', `text-xs ${cls ?? 'text-ink-3'}`, nota));
      return c;
    }));
  }

  function tabla(mx: Matriz) {
    const t = $<HTMLTableElement>('[data-calor]');
    $('[data-calor-vacio]').classList.toggle('hidden', mx.filas.length > 0);
    $('.calor-scroll').classList.toggle('hidden', !mx.filas.length);
    $('[data-calor-nota]').textContent = `${fmtFechaLarga(mx.desde)} — ${fmtFechaLarga(mx.hasta)} · por ${agr === 'mes' ? 'mes' : 'semana'} · ${met === 'litros' ? 'litros extraídos' : 'número de donaciones'}`;
    const thead = el('thead'), trh = el('tr');
    trh.append(el('th', '', 'Centro'), ...mx.periodos.map((p) => { const th = el('th', '', p.corto); th.scope = 'col'; th.title = p.label; return th; }), el('th', 'total', 'Total'));
    thead.append(trh);
    const tbody = el('tbody');
    mx.filas.forEach((f) => {
      const tr = el('tr');
      const th = el('th', '', f.sede); th.scope = 'row'; th.title = f.sede;
      tr.append(th);
      f.celdas.forEach((v, j) => {
        const td = el('td');
        const c = el('span', `celda calor-${paso(v, mx.max)}`, v ? fmtNum(v, met).replace(' L', '') : '·');
        c.tabIndex = 0;
        c.dataset.sede = f.sede; c.dataset.periodo = mx.periodos[j].label; c.dataset.valor = fmtNum(v, met);
        c.dataset.cuota = f.total ? `${Math.round((v / f.total) * 100)} % del centro` : '';
        c.setAttribute('aria-label', `${f.sede}, ${mx.periodos[j].label}: ${fmtNum(v, met)}`);
        td.append(c);
        tr.append(td);
      });
      tr.append(el('td', 'total', fmtNum(f.total, met)));
      tbody.append(tr);
    });
    const tfoot = el('tfoot'), trf = el('tr');
    trf.append(el('th', '', 'Red'), ...mx.totalesPeriodo.map((v) => el('td', '', v ? fmtNum(v, met).replace(' L', '') : '')), el('td', 'total', fmtNum(mx.total, met)));
    tfoot.append(trf);
    t.replaceChildren(thead, tbody, tfoot);
  }

  function ranking(mx: Matriz) {
    const box = $('[data-ranking]');
    if (!mx.filas.length) return box.replaceChildren(el('li', 'text-sm text-ink-3', 'Sin donaciones en el periodo.'));
    const max = mx.filas[0].total;
    box.replaceChildren(...mx.filas.slice(0, 8).map((f, i) => {
      const li = el('li');
      const fila = el('div', 'flex items-baseline justify-between gap-3 text-sm');
      const nom = el('span', 'flex min-w-0 items-baseline gap-2');
      nom.append(el('span', 'w-5 shrink-0 text-xs font-bold text-ink-3 tabular', String(i + 1)), el('span', 'truncate font-semibold text-ink', f.sede));
      fila.append(nom, el('span', 'shrink-0 font-bold tabular text-ink', fmtNum(f.total, met)));
      const pista = el('div', 'mt-1.5 ml-7 h-2 overflow-hidden rounded-full bg-sunken');
      const barra = el('span', 'block h-full rounded-full bg-accent');
      barra.style.width = `${Math.max(3, (f.total / max) * 100)}%`;
      pista.append(barra);
      li.append(fila, pista);
      return li;
    }));
  }

  // ------------------------------------------------------------------ Mapa de calor geográfico
  // Cada donación es un punto de calor alrededor de su centro (repartido en espiral para que más
  // donaciones den una mancha más amplia, como en un mapa de densidad). Encima, el total de cada centro.
  const ESCALAS: Record<string, Record<number, string>> = {
    clasica: { 0.15: '#2b2bd9', 0.35: '#00c8ff', 0.55: '#22d36b', 0.72: '#ffe600', 0.86: '#ff7a00', 1: '#e00000' },
    blud: { 0.2: '#fbe0e0', 0.45: '#f29c9c', 0.65: '#e2574f', 0.85: '#ca2b2b', 1: '#8a0006' },
  };
  const DEF = { radio: 40, blur: 25, opacidad: 85, escala: 'clasica', puntos: true };
  const ctl = { ...DEF };
  try { Object.assign(ctl, JSON.parse(localStorage.getItem('blud-calor-ctl') || '{}')); } catch {}
  const guardarCtl = () => { try { localStorage.setItem('blud-calor-ctl', JSON.stringify(ctl)); } catch {} };

  let mapa: any = null, calor: any = null, capaPuntos: any = null, encuadrado = false;
  const leyenda = () => {
    const e = ESCALAS[ctl.escala] ?? ESCALAS.clasica;
    // Las claves numéricas no garantizan orden («1» va primero): se ordenan por posición.
    const paradas = Object.entries(e).sort(([a], [b]) => Number(a) - Number(b)).map(([, c]) => c);
    $('[data-leyenda]').style.background = `linear-gradient(90deg, ${paradas.join(', ')})`;
  };
  const pintarValores = () => {
    (['radio', 'blur', 'opacidad'] as const).forEach((k) => {
      root.querySelector<HTMLInputElement>(`[data-ctl="${k}"]`)!.value = String(ctl[k]);
      $(`[data-v="${k}"]`).textContent = k === 'opacidad' ? `${ctl[k]} %` : `${ctl[k]} px`;
    });
    root.querySelector<HTMLInputElement>('[data-ctl="puntos"]')!.checked = ctl.puntos;
    root.querySelectorAll<HTMLInputElement>('input[name="escala"]').forEach((r) => (r.checked = r.value === ctl.escala));
    leyenda();
  };

  async function pintarMapa(mx: Matriz) {
    const box = $('[data-mapa]');
    try {
      const L = await loadLeafletHeat();
      if (!mapa) mapa = createMap(L, box, { zoom: 11, attribution: 'bottomleft' });
      const porSede = new Map(mx.filas.map((f) => [f.sede, f]));
      const puntos: [number, number, number][] = [];
      const coords: [number, number][] = [];
      capaPuntos?.remove();
      capaPuntos = L.layerGroup();
      const maxSede = Math.max(1, ...mx.filas.map((f) => f.total));
      for (const s of sedes) {
        if (s.lat == null || s.lng == null) continue;
        coords.push([s.lat, s.lng]);
        const f = porSede.get(s.nombre);
        const n = f?.donaciones ?? 0;
        const peso = f ? f.total / Math.max(1, n) / (mx.metrica === 'litros' ? 0.45 : 1) : 0;
        for (let i = 0; i < n; i++) {
          // Espiral de Vogel: ~350 m entre puntos, más donaciones = mancha más ancha e intensa.
          const r = 0.0032 * Math.sqrt(i), a = i * 2.39996;
          puntos.push([s.lat + r * Math.sin(a), s.lng + r * Math.cos(a), Math.min(1, peso)]);
        }
        const icono = L.divIcon({
          className: '', iconSize: n ? [28, 28] : [20, 20],
          html: `<span class="punto-centro ${n ? '' : 'vacio'}">${n ? (f!.total >= 100 ? Math.round(f!.total) : fmtNum(f!.total, mx.metrica).replace(' L', '')) : ''}</span>`,
        });
        const mk = L.marker([s.lat, s.lng], { icon: icono, keyboard: true, title: s.nombre, zIndexOffset: Math.round((f?.total ?? 0) / maxSede * 1000) });
        const pop = el('div');
        pop.append(el('p', 'font-bold', s.nombre), el('p', '', n ? `${fmtNum(f!.total, mx.metrica)} en el periodo` : 'Sin donaciones en el periodo'));
        if (s.direccion) pop.append(el('p', 'text-xs opacity-70', s.direccion));
        mk.bindPopup(pop);
        capaPuntos.addLayer(mk);
      }
      calor?.remove();
      calor = L.heatLayer(puntos, {
        radius: ctl.radio, blur: ctl.blur, maxZoom: 13, minOpacity: 0.25,
        max: Math.max(1.2, Math.sqrt(puntos.length) / 2), gradient: ESCALAS[ctl.escala] ?? ESCALAS.clasica,
      }).addTo(mapa);
      const lienzo = calor._canvas as HTMLCanvasElement | undefined;
      if (lienzo) lienzo.style.opacity = String(ctl.opacidad / 100);
      if (ctl.puntos) capaPuntos.addTo(mapa);
      $('[data-mapa-nota]').textContent = puntos.length
        ? `${mx.totalDonaciones} donaciones en ${mx.filas.length} centros · cada donación suma calor alrededor de su centro.`
        : 'No hay donaciones en el periodo elegido.';
      if (!encuadrado && coords.length) {
        encuadrado = true;
        if (coords.length > 1) mapa.fitBounds(L.latLngBounds(coords), { padding: [36, 36], maxZoom: 13 });
        else mapa.setView(coords[0], 12);
      }
    } catch {
      box.replaceChildren(el('p', 'grid h-full place-items-center p-6 text-center text-sm text-ink-3', 'No se pudo cargar el mapa. Revisa tu conexión.'));
    }
  }

  // Controles del mapa
  root.querySelectorAll<HTMLInputElement>('input[data-ctl="radio"], input[data-ctl="blur"], input[data-ctl="opacidad"]').forEach((inp) =>
    inp.addEventListener('input', () => {
      const k = inp.dataset.ctl as 'radio' | 'blur' | 'opacidad';
      ctl[k] = Number(inp.value);
      pintarValores(); guardarCtl();
      if (k === 'opacidad') { const c = calor?._canvas as HTMLCanvasElement | undefined; if (c) c.style.opacity = String(ctl.opacidad / 100); }
      else calor?.setOptions({ radius: ctl.radio, blur: ctl.blur });
    }));
  root.querySelectorAll<HTMLInputElement>('input[name="escala"]').forEach((r) => r.addEventListener('change', () => {
    ctl.escala = r.value; pintarValores(); guardarCtl(); calor?.setOptions({ gradient: ESCALAS[ctl.escala] });
  }));
  root.querySelector<HTMLInputElement>('[data-ctl="puntos"]')!.addEventListener('change', (e) => {
    ctl.puntos = (e.target as HTMLInputElement).checked; guardarCtl();
    if (!mapa || !capaPuntos) return;
    ctl.puntos ? capaPuntos.addTo(mapa) : capaPuntos.remove();
  });
  $('[data-ctl="reset"]').addEventListener('click', () => { Object.assign(ctl, DEF); guardarCtl(); pintarValores(); if (m) pintarMapa(m); });
  // Escritorio: controles abiertos sobre el mapa; móvil: plegados debajo.
  if (matchMedia('(min-width: 768px)').matches) $<HTMLDetailsElement>('[data-controles]').open = true;
  pintarValores();

  function render() {
    const { desde, hasta } = rangoDe(rango);
    m = matriz(desde, hasta, agr, met);
    kpis(m);
    tabla(m);
    ranking(m);
    lineasResumen = resumen(m, sedes.length || m.filas.length);
    $('[data-resumen]').replaceChildren(...lineasResumen.map((l) => el('li', 'flex gap-2', l)));
    if (mapa || $('[data-mapa]').dataset.listo) pintarMapa(m);
  }

  // Tooltip de cada celda (puntero y teclado). Texto con textContent: los nombres vienen de la base.
  const tip = document.querySelector<HTMLElement>('[data-tip]')!;
  const mostrarTip = (c: HTMLElement, x: number, y: number) => {
    tip.replaceChildren(el('strong', '', c.dataset.valor ?? ''), el('span', 'block', c.dataset.sede ?? ''), el('span', 'block opacity-75', `${c.dataset.periodo}${c.dataset.cuota ? ' · ' + c.dataset.cuota : ''}`));
    tip.hidden = false;
    const r = tip.getBoundingClientRect();
    tip.style.left = `${Math.min(window.innerWidth - r.width - 8, Math.max(8, x - r.width / 2))}px`;
    tip.style.top = `${Math.max(8, y - r.height - 12)}px`;
  };
  root.addEventListener('pointerover', (e) => { const c = (e.target as HTMLElement).closest<HTMLElement>('.celda'); if (c) { const r = c.getBoundingClientRect(); mostrarTip(c, r.left + r.width / 2, r.top); } });
  root.addEventListener('pointerout', (e) => { if ((e.target as HTMLElement).closest('.celda')) tip.hidden = true; });
  root.addEventListener('focusin', (e) => { const c = (e.target as HTMLElement).closest<HTMLElement>('.celda'); if (c) { const r = c.getBoundingClientRect(); mostrarTip(c, r.left + r.width / 2, r.top); } });
  root.addEventListener('focusout', () => (tip.hidden = true));
  window.addEventListener('scroll', () => (tip.hidden = true), { passive: true });

  const marcar = (sel: string, b: HTMLElement) => root.querySelectorAll(sel).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  root.querySelectorAll<HTMLButtonElement>('[data-rango]').forEach((b) => b.addEventListener('click', () => { rango = b.dataset.rango as Rango; marcar('[data-rango]', b); render(); }));
  root.querySelectorAll<HTMLButtonElement>('[data-agr]').forEach((b) => b.addEventListener('click', () => { agr = b.dataset.agr as Agrupacion; marcar('[data-agr]', b); render(); }));
  root.querySelectorAll<HTMLButtonElement>('[data-met]').forEach((b) => b.addEventListener('click', () => { met = b.dataset.met as Metrica; marcar('[data-met]', b); render(); }));

  $('[data-copiar]').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(lineasResumen.join('\n')); toast('Resumen copiado.'); }
    catch { toast('No se pudo copiar. Selecciona el texto del resumen.'); }
  });
  $('[data-pdf]').addEventListener('click', async (e) => {
    if (!m) return;
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    try {
      const { pdfEstadisticas } = await import('../../lib/reportes-pdf');
      await pdfEstadisticas(m, lineasResumen, sedes.length || m.filas.length);
    } catch (err) {
      toast('No se pudo generar el PDF.');
      console.error(err);
    } finally { b.disabled = false; }
  });

  whenNearViewport($('[data-mapa]'), () => { $('[data-mapa]').dataset.listo = '1'; if (m) pintarMapa(m); });
  sedesMapa().then((s) => { sedes = s; render(); });
  render();
  onDb(render);
</script>
