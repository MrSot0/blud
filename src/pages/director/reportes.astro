---
// src/pages/director/reportes.astro
// Reporte consolidado de la red en un rango de fechas: donaciones, entregas, solicitudes y laboratorio (agregado).
import Layout from '../../layouts/LayoutD.astro';
---

<Layout title="BLUD | Reportes">
  <div class="container-blud py-8 space-y-8">
    <div class="no-print pb-6 border-b border-line flex flex-col lg:flex-row lg:items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Reportes consolidados</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Lo que registraron operadores y laboratorio en el periodo que elijas.</p>
      </div>
      <form id="form" class="flex flex-wrap items-end gap-2">
        <label class="block"><span class="mb-1.5 block text-xs font-bold uppercase text-ink-3">Desde</span><input type="date" name="desde" class="field" required /></label>
        <label class="block"><span class="mb-1.5 block text-xs font-bold uppercase text-ink-3">Hasta</span><input type="date" name="hasta" class="field" required /></label>
        <button type="submit" class="btn btn-primary">Actualizar</button>
        <button type="button" id="btn-csv" class="btn btn-secondary">CSV</button>
        <button type="button" id="btn-print" class="btn btn-secondary">Imprimir</button>
      </form>
    </div>

    <p class="text-sm font-semibold text-ink" id="periodo"></p>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" id="kpis"></div>

    <div class="grid gap-8 lg:grid-cols-2 items-start">
      <section class="panel p-6 space-y-4"><h2 class="text-lg font-bold text-ink">Donaciones por tipo</h2><ul id="por-tipo" class="space-y-2"></ul></section>
      <section class="panel p-6 space-y-4"><h2 class="text-lg font-bold text-ink">Donaciones por hemocomponente</h2><ul id="por-comp" class="space-y-2"></ul></section>
      <section class="panel p-6 space-y-4"><h2 class="text-lg font-bold text-ink">Unidades entregadas por destino</h2><ul id="por-destino" class="space-y-2"></ul></section>
      <section class="panel p-6 space-y-4"><h2 class="text-lg font-bold text-ink">Solicitudes por estado</h2><ul id="por-estado" class="space-y-2"></ul></section>
    </div>
    <p class="text-xs text-ink-3">El detalle de los casos reactivos (qué prueba y de quién) solo lo ve el laboratorio.</p>
  </div>
</Layout>

<style is:global>
  @media print {
    #site-header, #sidebar-drawer, #sidebar-overlay, .no-print, #blud-toast { display: none !important; }
    body { background: #fff; }
  }
</style>

<script>
  import { downloadFile, esc, fmtFecha, hoyISO, onDb, reporteDirector, sumarDias, toCSV } from '../../lib/director';
  import type { ReporteDirector } from '../../lib/director';

  const form = document.getElementById('form') as HTMLFormElement;
  const input = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  input('hasta').value = hoyISO();
  input('desde').value = sumarDias(hoyISO(), -29);
  let ultimo: ReporteDirector | null = null;

  const barras = (datos: Record<string, number> | { k: string; v: number }[], vacio: string) => {
    const filas = Array.isArray(datos) ? datos : Object.entries(datos).map(([k, v]) => ({ k, v })).sort((a, b) => b.v - a.v);
    if (!filas.length) return `<li class="text-sm text-ink-3">${vacio}</li>`;
    const max = Math.max(...filas.map((f) => f.v));
    return filas.map((f) => `<li><div class="flex justify-between text-sm"><span class="text-ink">${esc(f.k)}</span><span class="font-bold text-ink tabular">${f.v}</span></div>
      <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-line"><span class="block h-full rounded-full bg-accent" style="width:${Math.round((f.v / max) * 100)}%"></span></div></li>`).join('');
  };

  function render() {
    const desde = input('desde').value, hasta = input('hasta').value;
    if (!desde || !hasta || desde > hasta) return;
    const r = reporteDirector(desde, hasta);
    ultimo = r;
    const f = (iso: string) => fmtFecha(iso, { day: 'numeric', month: 'long', year: 'numeric' });
    document.getElementById('periodo')!.textContent = `Del ${f(desde)} al ${f(hasta)}`;
    const kpis: [string, string | number, string][] = [
      ['Donaciones', r.donaciones, `${(r.volumenMl / 1000).toLocaleString('es-VE', { maximumFractionDigits: 1 })} L extraídos`],
      ['Unidades entregadas', r.unidadesEntregadas, `${r.entregasPorDestino.length} destinos`],
      ['Pruebas de laboratorio', r.pruebas, `${r.descartadas} bolsas descartadas`],
      ['Donantes nuevos', r.donantesNuevos, 'registrados en el periodo'],
    ];
    document.getElementById('kpis')!.innerHTML = kpis.map(([t, v, s]) => `<div class="panel p-5"><p class="text-xs font-bold uppercase text-ink-3">${esc(t)}</p>
      <p class="mt-1 text-3xl font-extrabold text-ink tabular">${esc(v)}</p><p class="text-xs text-ink-3">${esc(s)}</p></div>`).join('');
    document.getElementById('por-tipo')!.innerHTML = barras(r.donacionesPorTipo, 'Sin donaciones en el periodo.');
    document.getElementById('por-comp')!.innerHTML = barras(r.donacionesPorComponente, 'Sin donaciones en el periodo.');
    document.getElementById('por-destino')!.innerHTML = barras(r.entregasPorDestino.map((d) => ({ k: d.destino, v: d.unidades })), 'Sin entregas en el periodo.');
    document.getElementById('por-estado')!.innerHTML = barras(r.solicitudesPorEstado, 'Sin solicitudes en el periodo.');
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); render(); });
  document.getElementById('btn-print')!.addEventListener('click', () => print());
  document.getElementById('btn-csv')!.addEventListener('click', () => {
    if (!ultimo) return;
    const r = ultimo;
    const filas = [
      { seccion: 'Resumen', concepto: 'Donaciones', valor: r.donaciones },
      { seccion: 'Resumen', concepto: 'Volumen (ml)', valor: r.volumenMl },
      { seccion: 'Resumen', concepto: 'Unidades entregadas', valor: r.unidadesEntregadas },
      { seccion: 'Resumen', concepto: 'Pruebas', valor: r.pruebas },
      { seccion: 'Resumen', concepto: 'Bolsas descartadas', valor: r.descartadas },
      { seccion: 'Resumen', concepto: 'Donantes nuevos', valor: r.donantesNuevos },
      ...Object.entries(r.donacionesPorTipo).map(([k, v]) => ({ seccion: 'Donaciones por tipo', concepto: k, valor: v })),
      ...Object.entries(r.donacionesPorComponente).map(([k, v]) => ({ seccion: 'Donaciones por componente', concepto: k, valor: v })),
      ...r.entregasPorDestino.map((d) => ({ seccion: 'Entregas por destino', concepto: d.destino, valor: d.unidades })),
      ...Object.entries(r.solicitudesPorEstado).map(([k, v]) => ({ seccion: 'Solicitudes por estado', concepto: k, valor: v })),
    ];
    downloadFile(`blud-reporte-${r.desde}_${r.hasta}.csv`, toCSV(filas), 'text/csv');
  });

  render();
  onDb(render);
</script>
