---
// src/pages/director/inventario.astro
// Inventario real: unidades liberadas por el laboratorio (y sus fracciones) menos lo entregado, con vencimientos (FIFO).
import Layout from '../../layouts/LayoutD.astro';
import Filtros from '../../components/app/Filtros.astro';
import Paginador from '../../components/app/Paginador.astro';
import { BLOOD_TYPES, COMPONENTES } from '../../lib/db';
---

<Layout title="BLUD | Inventario">
  <div class="container-blud py-6 sm:py-8 space-y-6 sm:space-y-8">
    <div class="page-head">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Inventario</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Solo cuenta lo que el laboratorio liberó. Sale primero lo que vence antes.</p>
      </div>
      <div class="page-head-acciones">
        <button type="button" id="btn-csv" class="btn btn-secondary">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="m7 10 5 5 5-5"/><path d="M21 21H3"/></svg>
          CSV
        </button>
        <button type="button" id="btn-pdf" class="btn btn-primary">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="m7 10 5 5 5-5"/><path d="M21 21H3"/></svg>
          Descargar PDF
        </button>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <div class="panel p-4 sm:p-5"><p class="text-[0.6875rem] sm:text-xs font-bold uppercase text-ink-3">Vigentes</p><p class="mt-0.5 text-2xl sm:text-3xl font-extrabold text-ink tabular" data-k="vigentes">0</p><p class="text-xs text-ink-3">unidades disponibles</p></div>
      <div class="panel p-4 sm:p-5"><p class="text-[0.6875rem] sm:text-xs font-bold uppercase text-ink-3">Por vencer</p><p class="mt-0.5 text-2xl sm:text-3xl font-extrabold text-warn tabular" data-k="porVencer">0</p><p class="text-xs text-ink-3">eritrocitos 7 d, plasma 30 d, plaquetas 48 h</p></div>
      <div class="panel p-4 sm:p-5"><p class="text-[0.6875rem] sm:text-xs font-bold uppercase text-ink-3">Vencidas</p><p class="mt-0.5 text-2xl sm:text-3xl font-extrabold text-accent-ink tabular" data-k="vencidas">0</p><p class="text-xs text-ink-3">por retirar del stock</p></div>
      <div class="panel p-4 sm:p-5"><p class="text-[0.6875rem] sm:text-xs font-bold uppercase text-ink-3">En cuarentena</p><p class="mt-0.5 text-2xl sm:text-3xl font-extrabold text-ink tabular" data-k="cuarentena">0</p><p class="text-xs text-ink-3">esperan al laboratorio</p></div>
    </div>

    <section class="panel p-4 sm:p-8 space-y-4" aria-labelledby="h-matriz">
      <h2 id="h-matriz" class="text-lg font-bold text-ink">Vigentes por tipo y hemocomponente</h2>
      <!-- Móvil: una fila por componente con los grupos que tienen unidades -->
      <ul id="matriz-movil" class="divide-y divide-line sm:hidden"></ul>
      <div class="hidden overflow-x-auto sm:block">
        <table class="w-full min-w-[40rem] text-sm">
          <thead class="text-xs uppercase text-ink-3">
            <tr>
              <th class="p-2 text-left font-bold">Componente</th>
              {BLOOD_TYPES.map((t) => <th class="p-2 text-center font-bold">{t}</th>)}
              <th class="p-2 text-center font-bold">Total</th>
            </tr>
          </thead>
          <tbody id="matriz" class="divide-y divide-line">
            {COMPONENTES.map((c) => (
              <tr data-comp={c}>
                <th scope="row" class="p-2 text-left font-semibold text-ink">{c}</th>
                {BLOOD_TYPES.map((t) => <td class="p-2 text-center tabular" data-celda={`${t}|${c}`}>0</td>)}
                <td class="p-2 text-center font-bold text-ink tabular" data-total>0</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-ink-3">En ámbar, combinaciones con menos de 3 unidades.</p>
    </section>

    <section id="vencimientos" class="panel p-4 sm:p-8 space-y-4 scroll-mt-24" aria-labelledby="h-unidades">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <h2 id="h-unidades" class="text-lg font-bold text-ink">Unidades y vencimientos <span class="text-sm font-semibold text-ink-3" id="n-unidades"></span></h2>
        <Filtros class="lg:w-[38rem]">
          <label class="sr-only" for="f-estado">Estado</label>
          <select id="f-estado" class="field">
            <option value="">Todo estado</option>
            <option value="por_vencer">Por vencer</option>
            <option value="vencida">Vencidas</option>
            <option value="disponible">Disponibles</option>
          </select>
          <label class="sr-only" for="f-comp">Componente</label>
          <select id="f-comp" class="field filtro-ancho">
            <option value="">Todo componente</option>
            {COMPONENTES.map((c) => <option value={c}>{c}</option>)}
          </select>
          <label class="sr-only" for="f-tipo">Tipo</label>
          <select id="f-tipo" class="field">
            <option value="">Todo tipo</option>
            {BLOOD_TYPES.map((t) => <option value={t}>{t}</option>)}
          </select>
        </Filtros>
      </div>
      <div class="tabla-apilable" role="region" aria-labelledby="h-unidades" tabindex="0">
        <table class="w-full min-w-[56rem] text-left text-sm">
          <thead class="border-b border-line bg-sunken text-xs uppercase text-ink-3">
            <tr>
              <th class="p-3 font-bold">Bolsa</th>
              <th class="p-3 font-bold">Componente</th>
              <th class="p-3 font-bold">Tipo</th>
              <th class="p-3 font-bold">Extracción</th>
              <th class="p-3 font-bold">Vence</th>
              <th class="p-3 font-bold">Estado</th>
              <th class="p-3 font-bold">Ubicación</th>
              <th class="p-3"><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody id="unidades" class="divide-y divide-line"></tbody>
        </table>
      </div>
      <Paginador id="pag-unidades" />
    </section>
  </div>

  <!-- RF-I3 e I7: mover una unidad o darla de baja -->
  <dialog id="dlg-unidad" class="blud-dialog blud-dialog-angosto" aria-labelledby="du-titulo">
    <form id="form-unidad" class="blud-dialog-marco" novalidate>
      <header class="flex items-start justify-between gap-4 border-b border-line p-5">
        <div class="min-w-0"><h2 id="du-titulo" class="text-lg font-bold text-ink"></h2><p id="du-sub" class="text-sm text-ink-2"></p></div>
        <button type="button" class="grid size-9 shrink-0 place-items-center rounded-full text-ink-3 hover:bg-sunken" data-du-cerrar aria-label="Cerrar">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </header>
      <div class="blud-dialog-cuerpo space-y-4">
        <div data-du="mover"><label for="du-ubic" class="etiqueta-campo">Nueva ubicación</label><input id="du-ubic" class="field" list="du-equipos" placeholder="Equipo · estante · gradilla · posición" /><datalist id="du-equipos"></datalist></div>
        <div data-du="baja" class="space-y-3">
          <div><label for="du-causa" class="etiqueta-campo">Causa</label><select id="du-causa" class="field"></select></div>
          <div><label for="du-detalle" class="etiqueta-campo">Detalle <span class="font-normal normal-case text-ink-3">(obligatorio si eliges «Otra»)</span></label><input id="du-detalle" class="field" /></div>
          <div><label for="du-metodo" class="etiqueta-campo">Método de disposición</label><select id="du-metodo" class="field"></select></div>
          <div><label for="du-firma" class="etiqueta-campo">Firma del responsable</label><input id="du-firma" class="field" placeholder="Nombre completo" autocomplete="name" /></div>
          <p class="text-xs text-ink-3">La unidad sale del inventario de forma definitiva y queda en la bitácora.</p>
        </div>
        <p id="du-error" class="hidden rounded-control bg-accent-soft px-3 py-2 text-sm font-medium text-accent-ink" role="alert"></p>
      </div>
      <footer class="grid grid-cols-2 gap-2 border-t border-line p-4 sm:flex sm:justify-end">
        <button type="button" class="btn btn-secondary" data-du-cerrar>Cancelar</button>
        <button type="submit" class="btn btn-primary" id="du-ok"></button>
      </footer>
    </form>
  </dialog>
</Layout>

<script>
  import { downloadFile, esc, fmtFecha, hoyISO, onDb, resumenInventario, toCSV } from '../../lib/director';
  import type { Unidad } from '../../lib/director';
  import { Paginador } from '../../lib/paginacion';
  import { BLOOD_TYPES } from '../../lib/db';
  import { CAUSAS_BAJA, METODOS_DISPOSICION, darDeBaja, detalleInventario, ubicarUnidad, variantesTexto } from '../../lib/inventario';
  import type { DetalleUnidad } from '../../lib/inventario';
  import { toast } from '../../lib/ui';

  let detalle = new Map<string, DetalleUnidad>();
  const horaVence = (d?: DetalleUnidad) => d?.venceHora ? new Date(d.venceHora).toLocaleTimeString('es-VE', { hour: '2-digit', minute: '2-digit', hour12: false }) : '';

  const sel = (id: string) => document.getElementById(id) as HTMLSelectElement;
  const TIPOS = BLOOD_TYPES;
  const fecha = (iso: string) => fmtFecha(iso, { day: 'numeric', month: 'short', year: 'numeric' });
  const etiqueta = (u: Unidad) =>
    u.estado === 'vencida' ? ['Vencida', 'bg-accent-soft text-accent-ink']
      : u.estado === 'por_vencer' ? [u.dias === 0 ? 'Vence hoy' : `Vence en ${u.dias} d`, 'bg-warn-soft text-warn']
      : ['Disponible', 'bg-ok-soft text-ok'];

  function render() {
    const inv = resumenInventario();
    const vigentes = inv.unidades.filter((u) => u.estado !== 'vencida');
    const k = { vigentes: vigentes.length, porVencer: inv.porVencer.length, vencidas: inv.vencidas.length, cuarentena: inv.cuarentena };
    Object.entries(k).forEach(([key, v]) => document.querySelectorAll(`[data-k="${key}"]`).forEach((el) => (el.textContent = String(v))));

    document.querySelectorAll<HTMLElement>('#matriz tr').forEach((tr) => {
      let total = 0;
      tr.querySelectorAll<HTMLElement>('[data-celda]').forEach((td) => {
        const n = inv.matriz[td.dataset.celda!] ?? 0;
        total += n;
        td.textContent = String(n);
        td.className = `p-2 text-center tabular ${n === 0 ? 'text-ink-3' : n < 3 ? 'font-semibold text-warn' : 'font-semibold text-ink'}`;
      });
      tr.querySelector('[data-total]')!.textContent = String(total);
    });

    // Móvil: la misma matriz como lista (solo grupos con unidades; en ámbar, menos de 3).
    const comps = [...document.querySelectorAll<HTMLElement>('#matriz tr')].map((tr) => tr.dataset.comp!);
    document.getElementById('matriz-movil')!.innerHTML = comps.map((c) => {
      const tipos = TIPOS.map((t) => [t, inv.matriz[`${t}|${c}`] ?? 0] as const).filter(([, n]) => n > 0);
      const total = tipos.reduce((a, [, n]) => a + n, 0);
      return `<li class="py-3 first:pt-0 last:pb-0">
        <p class="flex items-baseline justify-between gap-3"><span class="font-semibold text-ink">${esc(c)}</span>
          <span class="text-sm font-bold tabular ${total ? 'text-ink' : 'text-ink-3'}">${total} u.</span></p>
        <p class="mt-1.5 flex flex-wrap gap-1.5">${tipos.length
          ? tipos.map(([t, n]) => `<span class="rounded-full px-2 py-0.5 text-xs font-bold tabular ${n < 3 ? 'bg-warn-soft text-warn' : 'bg-accent-soft text-accent-ink'}">${esc(t)} · ${n}</span>`).join('')
          : '<span class="text-xs text-ink-3">Sin unidades vigentes</span>'}</p>
      </li>`;
    }).join('');

    const fe = sel('f-estado').value, fc = sel('f-comp').value, ft = sel('f-tipo').value;
    const lista = inv.unidades.filter((u) => (!fe || u.estado === fe) && (!fc || u.componente === fc) && (!ft || u.tipoSangre === ft));
    pagUnidades.mostrar(lista, `${fe}|${fc}|${ft}`);
    document.getElementById('n-unidades')!.textContent = `(${lista.length})`;
  }

  // Unidades: 25 por tanda (las tarjetas apiladas en móvil se vuelven muy largas con todo el stock).
  const pagUnidades = new Paginador<Unidad>({
    lista: document.getElementById('unidades')!, pie: document.getElementById('pag-unidades')!, tam: 25, nombre: 'unidades', clave: (u) => u.id,
    vacio: () => '<tr><td colspan="8" class="celda-vacia p-8 text-center text-sm text-ink-3">No hay unidades con esos filtros.</td></tr>',
    render: (vis) => vis.map((u) => {
          const [txt, cls] = etiqueta(u);
          return `<tr><td class="celda-titulo celda-corta p-3 font-mono text-xs font-bold text-ink">${esc(u.codigo)}</td>
            <td class="p-3 text-ink" data-label="Componente">${esc(u.componente)}</td><td class="p-3" data-label="Tipo"><span class="blood-chip">${esc(u.tipoSangre)}</span></td>
            <td class="celda-movil-oculta p-3 text-ink-2" data-label="Extracción">${esc(fecha(u.extraccion))}</td><td class="p-3 text-ink-2" data-label="Vence">${esc(fecha(u.vence))}${horaVence(detalle.get(u.id)) ? ` <span class="text-xs text-ink-3">${esc(horaVence(detalle.get(u.id)))}</span>` : ''}</td>
            <td class="celda-estado p-3"><span class="rounded-full px-2 py-0.5 text-xs font-bold ${cls}">${esc(txt)}</span></td>
            <td class="p-3 text-xs text-ink-2" data-label="Ubicación">${esc(detalle.get(u.id)?.ubicacion ?? 'Sin registrar')}${variantesTexto(detalle.get(u.id)) ? `<span class="block text-ink-3">${esc(variantesTexto(detalle.get(u.id)))}</span>` : ''}</td>
            <td class="celda-acciones p-3 text-right whitespace-nowrap"><button type="button" class="btn btn-secondary btn-sm" data-mover="${esc(u.id)}" aria-label="Mover la unidad ${esc(u.codigo)}">Mover</button>
              <button type="button" class="btn btn-secondary btn-sm" data-baja="${esc(u.id)}" aria-label="Dar de baja la unidad ${esc(u.codigo)}">Dar de baja</button></td></tr>`;
        }).join(''),
  });

  ['f-estado', 'f-comp', 'f-tipo'].forEach((id) => sel(id).addEventListener('change', render));

  // ---------- RF-I3 e I7: detalle, mover y dar de baja
  const cargarDetalle = async () => { try { detalle = await detalleInventario(); render(); } catch {} };
  cargarDetalle();
  const dlgU = document.getElementById('dlg-unidad') as HTMLDialogElement;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  q('#du-causa').innerHTML = '<option value="">Elegir</option>' + CAUSAS_BAJA.map((c) => `<option>${esc(c)}</option>`).join('');
  q('#du-metodo').innerHTML = '<option value="">Elegir</option>' + METODOS_DISPOSICION.map((c) => `<option>${esc(c)}</option>`).join('');
  import('../../lib/equipos').then(async ({ listarEquipos }) => {
    try { q('#du-equipos').innerHTML = (await listarEquipos()).filter((e) => e.activo).map((e) => `<option value="${esc(e.nombre)} · estante "></option>`).join(''); } catch {}
  });
  let accion: { tipo: 'mover' | 'baja'; id: string } | null = null;
  document.getElementById('unidades')!.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const mover = t.closest<HTMLElement>('[data-mover]')?.dataset.mover;
    const baja = t.closest<HTMLElement>('[data-baja]')?.dataset.baja;
    const id = mover ?? baja;
    if (!id) return;
    const u = resumenInventario().unidades.find((x) => x.id === id);
    accion = { tipo: mover ? 'mover' : 'baja', id };
    q<HTMLFormElement>('#form-unidad').reset();
    q('#du-error').classList.add('hidden');
    q('#du-titulo').textContent = mover ? 'Mover la unidad' : 'Dar de baja la unidad';
    q('#du-sub').textContent = u ? `${u.codigo} · ${u.componente} · ${u.tipoSangre}` : id;
    dlgU.querySelectorAll<HTMLElement>('[data-du]').forEach((b) => b.classList.toggle('hidden', b.dataset.du !== accion!.tipo));
    q('#du-ok').textContent = mover ? 'Guardar ubicación' : 'Dar de baja';
    if (mover) q<HTMLInputElement>('#du-ubic').value = detalle.get(id)?.ubicacion ?? '';
    if (baja && u?.estado === 'vencida') q<HTMLSelectElement>('#du-causa').value = 'Caducidad';
    dlgU.showModal();
  });
  dlgU.querySelectorAll('[data-du-cerrar]').forEach((b) => b.addEventListener('click', () => dlgU.close()));
  q('#form-unidad').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!accion) return;
    const btn = q<HTMLButtonElement>('#du-ok');
    btn.disabled = true;
    try {
      if (accion.tipo === 'mover') { await ubicarUnidad(accion.id, q<HTMLInputElement>('#du-ubic').value); toast('Ubicación actualizada.'); }
      else {
        await darDeBaja(accion.id, { causa: q<HTMLSelectElement>('#du-causa').value, detalle: q<HTMLInputElement>('#du-detalle').value,
          metodo: q<HTMLSelectElement>('#du-metodo').value, firma: q<HTMLInputElement>('#du-firma').value });
        toast('Unidad dada de baja.');
        const { sincronizar } = await import('../../lib/supabase');
        await sincronizar();
      }
      dlgU.close();
      await cargarDetalle();
    } catch (ex) {
      q('#du-error').textContent = (ex as Error).message;
      q('#du-error').classList.remove('hidden');
    } finally { btn.disabled = false; }
  });
  document.getElementById('btn-pdf')!.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    try {
      const inv = resumenInventario();
      const fe = sel('f-estado'), fc = sel('f-comp'), ft = sel('f-tipo');
      const lista = inv.unidades.filter((u) => (!fe.value || u.estado === fe.value) && (!fc.value || u.componente === fc.value) && (!ft.value || u.tipoSangre === ft.value));
      const filtros = [fe, fc, ft].filter((s) => s.value).map((s) => s.selectedOptions[0].text).join(' · ');
      const { pdfInventario } = await import('../../lib/reportes-pdf');
      await pdfInventario(lista, filtros, {
        vigentes: inv.unidades.filter((u) => u.estado !== 'vencida').length, porVencer: inv.porVencer.length, vencidas: inv.vencidas.length, cuarentena: inv.cuarentena,
      });
    } finally { b.disabled = false; }
  });
  document.getElementById('btn-csv')!.addEventListener('click', () => {
    const rows = resumenInventario().unidades.map((u) => ({
      bolsa: u.codigo, componente: u.componente, tipo: u.tipoSangre, extraccion: u.extraccion, vence: u.vence, estado: u.estado,
    }));
    if (!rows.length) return;
    downloadFile(`blud-inventario-${hoyISO()}.csv`, toCSV(rows), 'text/csv');
  });

  render();
  onDb(render);
</script>
