---
// src/pages/director/inventario.astro
// Inventario real: unidades liberadas por el laboratorio (y sus fracciones) menos lo entregado, con vencimientos (FIFO).
import Layout from '../../layouts/LayoutD.astro';
import { BLOOD_TYPES, COMPONENTES } from '../../lib/db';
---

<Layout title="BLUD | Inventario">
  <div class="container-blud py-8 space-y-8">
    <div class="pb-6 border-b border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">Inventario de hemocomponentes</h1>
        <p class="text-ink-2 text-sm sm:text-base mt-1">Solo cuenta lo que el laboratorio liberó. Sale primero lo que vence antes.</p>
      </div>
      <button type="button" id="btn-csv" class="btn btn-secondary">Exportar CSV</button>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="panel p-5"><p class="text-xs font-bold uppercase text-ink-3">Vigentes</p><p class="mt-1 text-3xl font-extrabold text-ink tabular" data-k="vigentes">0</p><p class="text-xs text-ink-3">unidades disponibles</p></div>
      <div class="panel p-5"><p class="text-xs font-bold uppercase text-ink-3">Por vencer</p><p class="mt-1 text-3xl font-extrabold text-warn tabular" data-k="porVencer">0</p><p class="text-xs text-ink-3">en 7 días o menos</p></div>
      <div class="panel p-5"><p class="text-xs font-bold uppercase text-ink-3">Vencidas</p><p class="mt-1 text-3xl font-extrabold text-accent-ink tabular" data-k="vencidas">0</p><p class="text-xs text-ink-3">por retirar del stock</p></div>
      <div class="panel p-5"><p class="text-xs font-bold uppercase text-ink-3">En cuarentena</p><p class="mt-1 text-3xl font-extrabold text-ink tabular" data-k="cuarentena">0</p><p class="text-xs text-ink-3">esperan al laboratorio</p></div>
    </div>

    <section class="panel p-6 sm:p-8 space-y-4" aria-labelledby="h-matriz">
      <h2 id="h-matriz" class="text-lg font-bold text-ink">Unidades vigentes por tipo y hemocomponente</h2>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[40rem] text-sm">
          <thead class="text-xs uppercase text-ink-3">
            <tr>
              <th class="p-2 text-left font-bold">Componente</th>
              {BLOOD_TYPES.map((t) => <th class="p-2 text-center font-bold">{t}</th>)}
              <th class="p-2 text-center font-bold">Total</th>
            </tr>
          </thead>
          <tbody id="matriz" class="divide-y divide-line">
            {COMPONENTES.map((c) => (
              <tr data-comp={c}>
                <th scope="row" class="p-2 text-left font-semibold text-ink">{c}</th>
                {BLOOD_TYPES.map((t) => <td class="p-2 text-center tabular" data-celda={`${t}|${c}`}>0</td>)}
                <td class="p-2 text-center font-bold text-ink tabular" data-total>0</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-ink-3">En ámbar, combinaciones con menos de 3 unidades.</p>
    </section>

    <section id="vencimientos" class="panel p-6 sm:p-8 space-y-4 scroll-mt-24" aria-labelledby="h-unidades">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <h2 id="h-unidades" class="text-lg font-bold text-ink">Unidades y vencimientos</h2>
        <div class="flex flex-col gap-2 sm:flex-row">
          <label class="sr-only" for="f-estado">Estado</label>
          <select id="f-estado" class="field sm:w-44">
            <option value="">Todas</option>
            <option value="por_vencer">Por vencer</option>
            <option value="vencida">Vencidas</option>
            <option value="disponible">Disponibles</option>
          </select>
          <label class="sr-only" for="f-comp">Componente</label>
          <select id="f-comp" class="field sm:w-56">
            <option value="">Todo componente</option>
            {COMPONENTES.map((c) => <option value={c}>{c}</option>)}
          </select>
          <label class="sr-only" for="f-tipo">Tipo</label>
          <select id="f-tipo" class="field sm:w-32">
            <option value="">Todo tipo</option>
            {BLOOD_TYPES.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[40rem] text-left text-sm">
          <thead class="border-b border-line bg-sunken text-xs uppercase text-ink-3">
            <tr>
              <th class="p-3 font-bold">Bolsa</th>
              <th class="p-3 font-bold">Componente</th>
              <th class="p-3 font-bold">Tipo</th>
              <th class="p-3 font-bold">Extracción</th>
              <th class="p-3 font-bold">Vence</th>
              <th class="p-3 font-bold">Estado</th>
            </tr>
          </thead>
          <tbody id="unidades" class="divide-y divide-line"></tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { downloadFile, esc, fmtFecha, hoyISO, onDb, resumenInventario, toCSV } from '../../lib/director';
  import type { Unidad } from '../../lib/director';

  const sel = (id: string) => document.getElementById(id) as HTMLSelectElement;
  const fecha = (iso: string) => fmtFecha(iso, { day: 'numeric', month: 'short', year: 'numeric' });
  const etiqueta = (u: Unidad) =>
    u.estado === 'vencida' ? ['Vencida', 'bg-accent-soft text-accent-ink']
      : u.estado === 'por_vencer' ? [u.dias === 0 ? 'Vence hoy' : `Vence en ${u.dias} d`, 'bg-warn-soft text-warn']
      : ['Disponible', 'bg-ok-soft text-ok'];

  function render() {
    const inv = resumenInventario();
    const vigentes = inv.unidades.filter((u) => u.estado !== 'vencida');
    const k = { vigentes: vigentes.length, porVencer: inv.porVencer.length, vencidas: inv.vencidas.length, cuarentena: inv.cuarentena };
    Object.entries(k).forEach(([key, v]) => document.querySelectorAll(`[data-k="${key}"]`).forEach((el) => (el.textContent = String(v))));

    document.querySelectorAll<HTMLElement>('#matriz tr').forEach((tr) => {
      let total = 0;
      tr.querySelectorAll<HTMLElement>('[data-celda]').forEach((td) => {
        const n = inv.matriz[td.dataset.celda!] ?? 0;
        total += n;
        td.textContent = String(n);
        td.className = `p-2 text-center tabular ${n === 0 ? 'text-ink-3' : n < 3 ? 'font-semibold text-warn' : 'font-semibold text-ink'}`;
      });
      tr.querySelector('[data-total]')!.textContent = String(total);
    });

    const fe = sel('f-estado').value, fc = sel('f-comp').value, ft = sel('f-tipo').value;
    const lista = inv.unidades.filter((u) => (!fe || u.estado === fe) && (!fc || u.componente === fc) && (!ft || u.tipoSangre === ft));
    document.getElementById('unidades')!.innerHTML = lista.length
      ? lista.map((u) => {
          const [txt, cls] = etiqueta(u);
          return `<tr><td class="p-3 font-mono text-xs font-bold text-ink">${esc(u.codigo)}</td>
            <td class="p-3 text-ink">${esc(u.componente)}</td><td class="p-3"><span class="blood-chip">${esc(u.tipoSangre)}</span></td>
            <td class="p-3 text-ink-2">${esc(fecha(u.extraccion))}</td><td class="p-3 text-ink-2">${esc(fecha(u.vence))}</td>
            <td class="p-3"><span class="rounded-full px-2 py-0.5 text-xs font-bold ${cls}">${esc(txt)}</span></td></tr>`;
        }).join('')
      : '<tr><td colspan="6" class="p-8 text-center text-sm text-ink-3">No hay unidades con esos filtros.</td></tr>';
  }

  ['f-estado', 'f-comp', 'f-tipo'].forEach((id) => sel(id).addEventListener('change', render));
  document.getElementById('btn-csv')!.addEventListener('click', () => {
    const rows = resumenInventario().unidades.map((u) => ({
      bolsa: u.codigo, componente: u.componente, tipo: u.tipoSangre, extraccion: u.extraccion, vence: u.vence, estado: u.estado,
    }));
    if (!rows.length) return;
    downloadFile(`blud-inventario-${hoyISO()}.csv`, toCSV(rows), 'text/csv');
  });

  render();
  onDb(render);
</script>
