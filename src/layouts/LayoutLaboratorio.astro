---
// src/layouts/LayoutLaboratorio.astro
import '../styles/global.css'; // ajusta la ruta si tu CSS global está en otro lado
import Navbar from '../components/app/Navbar.astro';
import CustomCursor from '../components/CustomCusor.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'BLUD | Laboratorio', description = 'Laboratorio de BLUD.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    <!-- Tema antes de pintar (mismo key que usa el Navbar) -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('blud-theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="min-h-dvh antialiased">
    <CustomCursor />
    <Navbar role="laboratorio" />
    <main id="main">
      <slot />
    </main>

    <!-- Solo personal de laboratorio: sin sesión va a /login; con otro rol, a su propia zona -->
    <script>
      import { guard } from '../lib/roles';
      guard(['laboratorio']);
    </script>
  </body>
</html>